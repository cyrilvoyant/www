<https://www.cyrilvoyant.com/data/#glossary-bsd> a schema:DefinedTerm ;
    schema:description "A family of permissive licences close to MIT; the three-clause version also forbids using the authors' names to promote a derived product." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/data/#glossary> ;
    schema:name "BSD" .

<https://www.cyrilvoyant.com/data/#glossary-cc-by> a schema:DefinedTerm ;
