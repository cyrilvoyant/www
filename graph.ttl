                        [ a schema:Person ;
                            schema:name "Nadjem Bailek" ;
                            schema:sameAs "https://orcid.org/0000-0001-9051-8548" ],
                        <https://person.cyrilvoyant.com/#cyril-voyant> ;
                    schema:datePublished "2025-09-25" ;
                    schema:headline "Métriques NICEᵏ : un cadre unifié pour évaluer les prévisions solaires déterministes" ;
