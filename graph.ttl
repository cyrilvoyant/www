[] a schema:DefinedTermSet ;
    schema:hasDefinedTerm [ a schema:DefinedTerm ;
            schema:description "Un langage et un environnement de calcul numérique." ;
            schema:name "MATLAB" ],
        [ a schema:DefinedTerm ;
            schema:description "Photovoltaïque ; Électricité de France." ;
            schema:name "PV, EDF" ],
        [ a schema:DefinedTerm ;
            schema:description "Thérapie par capture neutronique du bore." ;
            schema:name "BNCT" ],
        [ a schema:DefinedTerm ;
            schema:description "Parcours d'accès spécifique santé (première année des études de santé) ; unité d'enseignement ; bachelor universitaire de technologie." ;
            schema:name "PASS, UE, B.U.T." ],
        [ a schema:DefinedTerm ;
            schema:description "Modèles linéaire-quadratique et linéaire-quadratique-linéaire de l'effet d'une dose de rayonnement sur les tissus." ;
            schema:name "LQ, LQL" ],
        [ a schema:DefinedTerm ;
            schema:description "Deux mélanges de références simples : la persistance avec la valeur d'un cycle plus tôt (BLEND), ou avec la moyenne (CLIPER)." ;
            schema:name "BLEND, CLIPER" ],
        [ a schema:DefinedTerm ;
            schema:description "Licence Creative Commons Attribution : réutilisation libre, à condition de citer les auteurs." ;
            schema:name "CC BY 4.0" ],
        [ a schema:DefinedTerm ;
            schema:description "L'erreur d'une prévision divisée par celle de la persistance ; entre 0 et 1, la prévision apporte quelque chose." ;
            schema:name "NICE" ],
        [ a schema:DefinedTerm ;
            schema:description "Plusieurs entrées, plusieurs sorties : un seul modèle prévoit plusieurs signaux." ;
            schema:name "MIMO" ],
        [ a schema:DefinedTerm ;
            schema:description "Sept critères : rigueur, transparence, visibilité, adoption, collaboration, diffusion, pertinence sociétale." ;
            schema:name "RTVACOS" ],
        [ a schema:DefinedTerm ;
            schema:description "Extreme learning machine : réseau de neurones à une couche cachée, aux poids d'entrée tirés au hasard ; seuls les poids de sortie sont calculés." ;
            schema:name "ELM" ],
        [ a schema:DefinedTerm ;
            schema:description "Courbe ROC (receiver operating characteristic) : la sensibilité d'un test selon son taux de faux positifs." ;
            schema:name "ROC" ],
        [ a schema:DefinedTerm ;
            schema:description "Identifiant permanent d'un article ou d'un logiciel archivé : le lien reste valable même si le site change." ;
            schema:name "DOI" ],
        [ a schema:DefinedTerm ;
            schema:description "Le règlement européen sur l'intelligence artificielle." ;
            schema:name "AI Act" ],
        [ a schema:DefinedTerm ;
            schema:description "Un test qui accepte de petits décalages en espace, en temps et en intensité." ;
            schema:name "Indice γ / γ-index" ],
        [ a schema:DefinedTerm ;
            schema:description "La variabilité due aux nuages et la prévisibilité d'un signal, calculées avant tout modèle." ;
            schema:name "sCV, F" ],
        [ a schema:DefinedTerm ;
            schema:description "La prévision recopie la dernière valeur connue ; c'est la référence à battre." ;
            schema:name "Persistance / persistence" ] ;
    schema:inLanguage "fr" ;
    schema:name "Les mots de cette page" .

