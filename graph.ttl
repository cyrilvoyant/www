<https://www.cyrilvoyant.com/latest-publications-and-news/gamma-index-forecast-validation#page> a schema:Article ;
    schema:about <https://cyrilvoyant.github.io/approach.html#principle-5> ;
    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:description "In the gamma-index paper’s synthetic experiment, more than 80% of pixels remain acceptable despite an approximately two-kilometre spatial displacement, a ten-minute time shift and added noise. Pixelwise RMSE nevertheless suggests substantial error." ;
    schema:inLanguage "en" ;
    schema:isPartOf <https://www.cyrilvoyant.com/#website> ;
    schema:keywords "Demonstrate trust",
        "Energy" ;
    schema:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema:name "The γ-index: validating displaced solar forecasts beyond pointwise errors" ;
    schema:publisher <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:url "https://www.cyrilvoyant.com/latest-publications-and-news/gamma-index-forecast-validation/" ;
    schema:workTranslation <https://www.cyrilvoyant.com/fr/actualites/gamma-index-forecast-validation#page> .

