<https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary-apc-article-processing-charge> a schema:DefinedTerm ;
    schema:description "Fee paid by authors, or their institution, to publish an article in open access." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary> ;
    schema:name "APC (Article Processing Charge)" .

<https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary-coara> a schema:DefinedTerm ;
    schema:description "European coalition to reform research assessment: recognize the diversity of contributions, not only article counts." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary> ;
    schema:name "CoARA" .

<https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary-codecheck> a schema:DefinedTerm ;
    schema:description "A third party runs an article's code and certifies that the reported figures and tables are regenerated; it does not judge scientific validity." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary> ;
    schema:name "CODECHECK" .

<https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary-diamond-open-access> a schema:DefinedTerm ;
    schema:description "Journals free for both authors and readers, funded by institutions." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary> ;
    schema:name "Diamond open access" .

<https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary-doi> a schema:DefinedTerm ;
    schema:description "Persistent identifier of an article, a dataset or a software version." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary> ;
    schema:name "DOI" .

<https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary-fair> a schema:DefinedTerm ;
    schema:description "Findable, accessible, interoperable, reusable: principles for data, not a licence." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary> ;
    schema:name "FAIR" .

<https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary-mlops> a schema:DefinedTerm ;
    schema:description "Engineering practices to version, trace, deploy and monitor learning models." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary> ;
    schema:name "MLOps" .

<https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary-paper-mill> a schema:DefinedTerm ;
    schema:description "Organization selling fabricated or falsified articles, often slipped into special issues." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary> ;
    schema:name "Paper mill" .

<https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary-reproducibility> a schema:DefinedTerm ;
    schema:description "Recovering a result with the same data and code; replication recovers it with new data." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary> ;
    schema:name "Reproducibility" .

<https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary-retraction> a schema:DefinedTerm ;
    schema:description "Official withdrawal of a published article for serious error or fraud; the article stays visible, marked as retracted." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary> ;
    schema:name "Retraction" .

