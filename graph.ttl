    schema:inDefinedTermSet <https://www.cyrilvoyant.com/data/#glossary> ;
    schema:name "CC BY-NC" .

<https://www.cyrilvoyant.com/data/#glossary-doi> a schema:DefinedTerm ;
    schema:description "A persistent identifier for a digital object (article, dataset, software); the address remains valid even if the website changes. DataCite assigns them to research data." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/data/#glossary> ;
    schema:name "DOI" .

<https://www.cyrilvoyant.com/data/#glossary-fair> a schema:DefinedTerm ;
    schema:description "Findable, accessible, interoperable, reusable: four principles so that data serve beyond those who produced them." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/data/#glossary> ;
    schema:name "FAIR" .

<https://www.cyrilvoyant.com/data/#glossary-geo-copernicus-cams-c3s> a schema:DefinedTerm ;
    schema:description "The Group on Earth Observations (an intergovernmental partnership), the European Earth observation programme and two of its services: atmosphere (CAMS) and climate change (C3S)." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/data/#glossary> ;
    schema:name "GEO, Copernicus, CAMS, C3S" .

<https://www.cyrilvoyant.com/data/#glossary-gpl> a schema:DefinedTerm ;
    schema:description "A copyleft licence: any derived software that is distributed must be under the GPL, with its source code." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/data/#glossary> ;
    schema:name "GPL" .

<https://www.cyrilvoyant.com/data/#glossary-inspire-iso-19115> a schema:DefinedTerm ;
    schema:description "The European directive on geographic information and the international standard for its metadata." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/data/#glossary> ;
    schema:name "INSPIRE, ISO 19115" .

<https://www.cyrilvoyant.com/data/#glossary-metadata> a schema:DefinedTerm ;
    schema:description "Data about the data: origin, instrument, units, period, time step, processing, licence." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/data/#glossary> ;
    schema:name "Metadata" .

<https://www.cyrilvoyant.com/data/#glossary-mit> a schema:DefinedTerm ;
    schema:description "A very permissive software licence: free use, modification, redistribution and sale, provided the copyright notice and the licence text are kept; no warranty." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/data/#glossary> ;
    schema:name "MIT" .

<https://www.cyrilvoyant.com/data/#glossary-netcdf-cf> a schema:DefinedTerm ;
