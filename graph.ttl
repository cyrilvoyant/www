[] a schema:ItemList ;
    schema:itemListElement [ a schema:ListItem ;
            schema:item [ a schema:BlogPosting ;
                    schema:abstract "La production scientifique mondiale connaît une croissance sans précédent, amplifiée par l’essor des modèles d’intelligence artificielle générative. Dans ce contexte, la question n’est plus seulement de produire du savoir, mais d’en garantir la visibilité, la robustesse et la réutilisabilité." ;
                    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
                    schema:datePublished "2026" ;
                    schema:headline "Excellence scientifique à l’ère de l’IA : du SEO au GEO" ;
                    schema:image "https://www.cyrilvoyant.com/assets/img/0983e8b6d15c.jpg" ;
                    schema:inLanguage "fr" ;
                    schema:url "https://www.cyrilvoyant.com/fr/actualites/" ] ;
            schema:position 8 ],
        [ a schema:ListItem ;
            schema:item [ a schema:BlogPosting ;
                    schema:abstract "Nommé professeur invité à la faculté d'ingénierie de l'université de Kragujevac, avec mon collègue et ami Gilles Notton." ;
                    schema:author [ a schema:Person ;
                            schema:name "Gilles Notton" ;
                            schema:sameAs "https://orcid.org/0000-0002-6267-9632" ],
                        <https://person.cyrilvoyant.com/#cyril-voyant> ;
                    schema:datePublished "2026" ;
                    schema:headline "Professeur invité à l'université de Kragujevac (Serbie)" ;
                    schema:image "https://www.cyrilvoyant.com/assets/img/e127601c2891.png" ;
                    schema:inLanguage "en" ;
                    schema:url "https://www.cyrilvoyant.com/fr/actualites/" ] ;
            schema:position 3 ],
        [ a schema:ListItem ;
            schema:item [ a schema:BlogPosting ;
                    schema:abstract "Application libre (Streamlit), développée dans le projet SmartTunnel, qui produit des profils de charge électrique synthétiques pour les tunnels routiers : éclairage, ventilation, auxiliaires, trafic, saisons et événements aléatoires." ;
                    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
                    schema:datePublished "2026-05-08" ;
                    schema:headline "Tunnel Load Simulator : générer la consommation électrique des tunnels routiers" ;
                    schema:image "https://www.cyrilvoyant.com/assets/img/e326492cab74.jpg" ;
                    schema:inLanguage "en" ;
                    schema:url "https://www.cyrilvoyant.com/fr/actualites/" ] ;
            schema:position 4 ],
        [ a schema:ListItem ;
            schema:item [ a schema:BlogPosting ;
                    schema:abstract "Les articles indexés ont crû d'environ 47 % entre 2016 et 2022, la relecture repose sur un travail gratuit et 2023 a battu le record des rétractations. Un court essai sur ce qui existe, des données FAIR à l'AI Act, et ce qui manque : vérifier les données et le code publiés." ;
                    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
                    schema:datePublished "2026-10-24" ;
                    schema:headline "Édition scientifique : sans vérification des données et du code, pas de confiance" ;
                    schema:image "https://www.cyrilvoyant.com/assets/articles/scientific-publishing-growth.svg" ;
                    schema:inLanguage "fr" ;
                    schema:url "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance/" ] ;
            schema:position 1 ],
        [ a schema:ListItem ;
            schema:item [ a schema:BlogPosting ;
                    schema:abstract "Les métriques classiques comme la RMSE (racine de l'erreur quadratique moyenne) jugent une prévision comme si chaque pixel devait coïncider parfaitement dans l'espace et le temps. L'indice γ accepte un décalage toléré, comme le fait un expert." ;
                    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
                    schema:datePublished "2026-03-28" ;
                    schema:headline "Des pixels aux tolérances : valider les prévisions avec l'indice γ" ;
                    schema:image "https://www.cyrilvoyant.com/assets/img/7f20ac04a02f.png" ;
                    schema:inLanguage "en" ;
                    schema:url "https://www.cyrilvoyant.com/fr/actualites/gamma-index-forecast-validation/" ] ;
            schema:position 7 ],
        [ a schema:ListItem ;
            schema:item [ a schema:BlogPosting ;
                    schema:abstract "ELECTRE fédère une quinzaine de laboratoires, centres et instituts de l'institut Carnot M.I.N.E.S autour de 13 projets de recherche (2023-2026) sur l'électrification des usages, des matériaux au stockage, aux procédés industriels et aux limites de l'électrification. Sa journée de clôture a lieu le 18 novembre 2026 à Mines Paris – PSL, Sophia Antipolis." ;
                    schema:author [ a schema:Person ;
                            schema:name "Annette Massias" ;
                            schema:sameAs "https://www.linkedin.com/in/annette-massias-46544630/" ],
                        [ a schema:Person ;
                            schema:name "Delphine Gilges-Crampont" ;
                            schema:sameAs "https://www.idref.fr/292140282" ],
                        <https://person.cyrilvoyant.com/#cyril-voyant> ;
                    schema:datePublished "2026-10-23" ;
                    schema:headline "ELECTRE, projet phare de l'institut Carnot M.I.N.E.S : électrifier les usages, journée de clôture le 18 novembre 2026" ;
                    schema:image "https://www.cyrilvoyant.com/assets/news/electre.png" ;
                    schema:inLanguage "fr" ;
                    schema:url "https://www.cyrilvoyant.com/fr/actualites/" ] ;
            schema:position 2 ],
        [ a schema:ListItem ;
            schema:item [ a schema:BlogPosting ;
                    schema:abstract "La persistance revisitée pour les séries à statistiques périodiques, comme le cycle journalier de l'éclairement solaire. BLEND combine la dernière observation et l'observation alignée sur la même phase du cycle. La persistance est la prévision qui recopie la dernière valeur connue." ;
                    schema:author [ a schema:Person ;
                            schema:name "Luis Garcia-Gutierrez" ;
                            schema:sameAs "https://orcid.org/0000-0002-3480-1784" ],
                        [ a schema:Person ;
                            schema:name "Gilles Notton" ;
                            schema:sameAs "https://orcid.org/0000-0002-6267-9632" ],
                        [ a schema:Person ;
                            schema:name "Milan Despotovic" ;
                            schema:sameAs "https://orcid.org/0000-0003-3144-5945" ],
                        [ a schema:Person ;
                            schema:name "Candice Banes" ;
                            schema:sameAs "https://orcid.org/0009-0003-6656-8168" ],
                        [ a schema:Person ;
                            schema:name "Zaher Mundher Yaseen" ;
                            schema:sameAs "https://orcid.org/0000-0003-3344-214X" ],
                        <https://person.cyrilvoyant.com/#cyril-voyant> ;
                    schema:datePublished "2026-04-24" ;
                    schema:headline "Revisiter la persistance : BLEND, une prévision sous contrainte de symétrie pour les processus énergétiques périodiques" ;
                    schema:image "https://www.cyrilvoyant.com/assets/img/e8e0bf76adbb.jpg" ;
                    schema:inLanguage "en" ;
                    schema:url "https://www.cyrilvoyant.com/fr/actualites/forecasting-with-less/" ] ;
            schema:position 6 ],
        [ a schema:ListItem ;
            schema:item [ a schema:BlogPosting ;
                    schema:abstract "Le sCV (coefficient de variation stochastique) et la prévisibilité F (comprise entre 1 − sCV et 1) séparent les fluctuations aléatoires des tendances déterministes que l'écart-type mélange, pour caractériser un site avant de comparer des modèles." ;
