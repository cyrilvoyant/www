<https://www.cyrilvoyant.com/scientific-publishing-trust#faq> a schema:FAQPage ;
    schema:inLanguage "en" ;
    schema:mainEntity [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "The number of indexed articles grew by about 47% between 2016 and 2022, faster than the number of researchers; unpaid peer review no longer keeps up, and more than 10,000 papers were retracted in 2023, a record." ] ;
            schema:name "Is scientific publishing really in trouble?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "No: it should be declared. As with any other tool, authors state what was used and for what; what matters is that results are checked, data and code included." ] ;
            schema:name "Should AI be banned from writing and reviewing?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Because it requires of high-risk AI systems what articles lack: data governance, technical documentation, record-keeping, a quality management system and post-market monitoring." ] ;
            schema:name "Why bring the AI Act into a discussion of articles?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Not necessarily. What is missing is verification and recognition of editorial work, not more titles." ] ;
            schema:name "Do we need new journals?" ] .

