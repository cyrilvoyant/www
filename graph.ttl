<https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques/#faq> a schema:FAQPage ;
    schema:inLanguage "fr" ;
    schema:mainEntity [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "La borne de Carnot Tf/(Tc − Tf) diminue quand l'écart grandit : congeler à −30 °C en été coûte bien plus de travail par kilojoule extrait que conserver à +4 °C ; d'où l'intérêt de condenser le plus froid possible et des cycles étagés pour les grands écarts." ] ;
            schema:name "Pourquoi le COP chute-t-il quand l'écart entre chambre froide et extérieur augmente ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Elle protège le compresseur contre une arrivée de liquide. Elle augmente la chaleur utile seulement si elle se produit dans la zone à refroidir ; dans la conduite extérieure, elle ajoute une charge parasite. Son effet sur le COP dépend du fluide et du cycle." ] ;
            schema:name "La surchauffe à l’aspiration est-elle toujours utile ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "À pressions et état d’aspiration inchangés, il diminue l’enthalpie à l’entrée du détendeur et augmente q0 sans changer le travail massique du compresseur. Le bilan réel doit aussi compter les auxiliaires et les éventuels changements du fonctionnement." ] ;
            schema:name "Dans quelles conditions le sous-refroidissement augmente-t-il le COP ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Le détendeur lamine le fluide sans échange de travail ni de chaleur : h se conserve, mais la détente est irréversible ; le travail qu'une turbine de détente aurait récupéré est perdu, ce qui justifie les éjecteurs ou les détendeurs à récupération sur les grandes installations, notamment au CO₂." ] ;
            schema:name "Pourquoi la détente est-elle isenthalpe et que perd-on ?" ] .

<https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques/#lexique> a schema:DefinedTermSet ;
    schema:hasDefinedTerm [ a schema:DefinedTerm ;
            schema:description "Fraction massique de vapeur dans le mélange liquide-vapeur : 0 sur la courbe de liquide saturé, 1 sur la courbe de vapeur saturée." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques/#lexique" ;
            schema:name "Titre en vapeur x" ],
        [ a schema:DefinedTerm ;
            schema:description "Refroidissement du liquide sous sa température de saturation, avant le détendeur ; il augmente le froid produit par kilogramme." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques/#lexique" ;
            schema:name "Sous-refroidissement" ],
        [ a schema:DefinedTerm ;
            schema:description "Diagramme enthalpique des frigoristes : enthalpie massique en abscisse, pression absolue en ordonnée logarithmique. Chaque fluide a le sien." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques/#lexique" ;
            schema:name "Diagramme de Mollier (ln p, h)" ],
        [ a schema:DefinedTerm ;
            schema:description "Courbes à pression, température, enthalpie, entropie, volume massique ou titre constants." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques/#lexique" ;
            schema:name "Isobare, isotherme, isenthalpe, isentrope, isochore, isotitre" ],
        [ a schema:DefinedTerm ;
            schema:description "Chlorofluorocarbures (entièrement halogénés), hydrochlorofluorocarbures (contiennent du chlore et de l'hydrogène), hydrofluorocarbures (sans chlore) : définitions du polycopié. Les CFC puis les HCFC ont été interdits pour leur action sur la couche d'ozone." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques/#lexique" ;
            schema:name "CFC, HCFC, HFC" ],
        [ a schema:DefinedTerm ;
            schema:description "En kJ/(kg·K) ; une compression idéale (adiabatique et réversible) se fait à s constante." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques/#lexique" ;
            schema:name "Entropie massique s" ],
        [ a schema:DefinedTerm ;
            schema:description "Les trois zones du diagramme, séparées par les courbes de saturation qui se rejoignent au point critique." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques/#lexique" ;
            schema:name "Liquide sous-refroidi, mélange, vapeur surchauffée" ],
        [ a schema:DefinedTerm ;
            schema:description "Haute pression (côté condenseur) et basse pression (côté évaporateur) ; les manomètres HP et BP les mesurent." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques/#lexique" ;
            schema:name "HP, BP" ],
        [ a schema:DefinedTerm ;
            schema:description "Volume occupé par 1 kg de fluide, en m³/kg." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques/#lexique" ;
            schema:name "Volume massique v" ],
        [ a schema:DefinedTerm ;
            schema:description "Échauffement de la vapeur au-delà de la saturation, avant le compresseur ; elle le protège contre une aspiration de liquide." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques/#lexique" ;
            schema:name "Surchauffe" ],
        [ a schema:DefinedTerm ;
            schema:description "Bachelor universitaire de technologie : diplôme en trois ans préparé dans un IUT (institut universitaire de technologie)." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques/#lexique" ;
            schema:name "B.U.T." ],
        [ a schema:DefinedTerm ;
            schema:description "Énergie contenue dans 1 kg de fluide pour une pression et une température données, en kJ/kg ; sur le diagramme, les énergies échangées se lisent comme des longueurs horizontales." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques/#lexique" ;
            schema:name "Enthalpie massique h" ],
        [ a schema:DefinedTerm ;
            schema:description "Les quatre organes de la machine : le compresseur aspire la vapeur et la comprime ; le condenseur la liquéfie ; le détendeur abaisse la pression et règle le débit ; l'évaporateur vaporise le fluide en refroidissant l'enceinte." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques/#lexique" ;
            schema:name "Compresseur, condenseur, détendeur, évaporateur" ],
        [ a schema:DefinedTerm ;
            schema:description "Froid produit divisé par le travail fourni au compresseur, COP = q0/Wth. Il dépasse 1 : on ne parle donc pas de rendement. Borne de Carnot : COPC = Tf/(Tc − Tf), en kelvins." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques/#lexique" ;
            schema:name "COP (coefficient de performance)" ],
        [ a schema:DefinedTerm ;
            schema:description "La même machine, utilisée pour la chaleur rejetée au condenseur plutôt que pour le froid de l'évaporateur." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques/#lexique" ;
            schema:name "PAC (pompe à chaleur)" ],
        [ a schema:DefinedTerm ;
            schema:description "Zéotrope (série R400) : la température change pendant le changement d'état à pression constante (glissement). Azéotrope (série R500) : il se comporte comme un corps pur." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques/#lexique" ;
            schema:name "Mélange zéotrope, azéotrope" ],
        [ a schema:DefinedTerm ;
            schema:description "Dans le polycopié (§ 2.5), rapport du COP du cycle réel à celui du cycle de Carnot inverse entre les mêmes températures (entre 0 et 1). Sur les diapositives, « efficacité frigorifique » désigne aussi le COP lui-même : vérifier le sens à chaque usage." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques/#lexique" ;
            schema:name "Efficacité" ],
        [ a schema:DefinedTerm ;
            schema:description "Fluide qui parcourt le circuit et change d'état : il s'évapore à basse pression en prenant de la chaleur et se condense à haute pression en la rejetant." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques/#lexique" ;
            schema:name "Fluide frigorigène" ] ;
    schema:inLanguage "fr" ;
    schema:name "Les mots du chapitre" .

<https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques/#page> a schema:LearningResource ;
    schema:about <https://www.cyrilvoyant.com/ontology/#cop> ;
    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:description "Le cycle en quatre étapes, les états du fluide, le cycle sur le diagramme de Mollier, COP (coefficient de performance) et efficacité, froid industriel…" ;
    schema:inLanguage "fr" ;
    schema:isPartOf <https://www.cyrilvoyant.com/#website> ;
    schema:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema:name "Chapitre 5 : les cycles frigorifiques" ;
    schema:publisher <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:url "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques/" .

<https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-moteurs/#faq> a schema:FAQPage ;
    schema:inLanguage "fr" ;
    schema:mainEntity [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Préchauffer l'eau d'alimentation avec de la vapeur soutirée élève la température moyenne à laquelle la chaudière apporte la chaleur ; le cycle se rapproche d'un cycle de Carnot entre des températures plus élevées." ] ;
            schema:name "Pourquoi la régénération améliore-t-elle le rendement d'un cycle à vapeur ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Le cycle de Carnot suppose des échanges de chaleur réversibles, donc à écart de température nul et infiniment lents ; un moteur réel échange sous des écarts finis, avec frottements et détentes irréversibles, qui créent de l'entropie et dégradent le travail récupérable." ] ;
            schema:name "Pourquoi aucun moteur réel n'atteint-il le rendement de Carnot ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "La compression chauffe l’air avant l’injection, afin de permettre l’auto-inflammation du carburant injecté. Dans un moteur à allumage commandé, l’auto-inflammation du mélange non brûlé peut provoquer du cliquetis ; il ne s’agit pas de classer simplement les carburants par facilité d’inflammation." ] ;
            schema:name "Pourquoi comprimer fortement l’air dans un moteur Diesel ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Elle est abondante, non toxique, stable, et sa chaleur latente de vaporisation est élevée : on transporte beaucoup d'énergie par kilogramme, et la pompe, qui comprime un liquide, consomme très peu de travail." ] ;
            schema:name "Pourquoi l'eau est-elle le fluide de travail des grandes centrales ?" ] .

<https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-moteurs/#lexique> a schema:DefinedTermSet ;
    schema:hasDefinedTerm [ a schema:DefinedTerm ;
            schema:description "Machine qui échange de la chaleur avec deux sources : une source chaude (température Tc) et une source froide (Tf)." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-moteurs/#lexique" ;
            schema:name "Machine ditherme" ],
        [ a schema:DefinedTerm ;
            schema:description "Cycle théorique du moteur à allumage commandé : compression isentrope, apport de chaleur à volume constant, détente isentrope, rejet de chaleur à volume constant." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-moteurs/#lexique" ;
            schema:name "Cycle de Beau de Rochas (Otto)" ],
        [ a schema:DefinedTerm ;
            schema:description "Pour un moteur, travail fourni divisé par la chaleur reçue de la source chaude. Borne de Carnot : ηC = 1 − Tf/Tc, en kelvins." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-moteurs/#lexique" ;
            schema:name "Rendement η" ],
        [ a schema:DefinedTerm ;
            schema:description "La production d'entropie est positive ou nulle ; elle est nulle seulement pour une transformation réversible (idéale, sans frottement ni écart fini de température)." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-moteurs/#lexique" ;
            schema:name "Second principe" ],
        [ a schema:DefinedTerm ;
            schema:description "Hypothèses du cycle théorique (diapositive 19) : le fluide est de l'air assimilé à un gaz parfait à capacités thermiques constantes, et les transformations sont réversibles." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-moteurs/#lexique" ;
            schema:name "Modèle air standard" ],
        [ a schema:DefinedTerm ;
            schema:description "Volume maximal du cylindre divisé par son volume minimal, r = V1/V2." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-moteurs/#lexique" ;
            schema:name "Rapport volumétrique de compression r" ],
        [ a schema:DefinedTerm ;
            schema:description "H = U + pV ; pour un fluide qui traverse une machine, la variation d'enthalpie donne le travail ou la chaleur échangés (bilans des diapositives 31 et 37)." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-moteurs/#lexique" ;
            schema:name "Enthalpie H" ],
        [ a schema:DefinedTerm ;
            schema:description "Transformation à entropie constante : adiabatique et réversible." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-moteurs/#lexique" ;
            schema:name "Isentrope" ],
        [ a schema:DefinedTerm ;
            schema:description "Conservation de l'énergie : pour un système fermé immobile, ΔU = Q + W, avec Q et W comptés positivement quand ils sont reçus." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-moteurs/#lexique" ;
            schema:name "Premier principe" ],
        [ a schema:DefinedTerm ;
            schema:description "Cycles des machines à vapeur : pompe, chaudière (vaporisation), turbine, condenseur ; Hirn ajoute une surchauffe de la vapeur avant la turbine." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-moteurs/#lexique" ;
            schema:name "Cycles de Rankine et de Hirn" ],
        [ a schema:DefinedTerm ;
            schema:description "Grandeur d'état extensive (J/K) ; pour une transformation réversible, dS = δQ/T. Elle mesure ce que l'on ne peut plus récupérer sous forme de travail." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-moteurs/#lexique" ;
            schema:name "Entropie S" ],
        [ a schema:DefinedTerm ;
            schema:description "Resurchauffe : réchauffer la vapeur entre deux étages de détente. Régénération : prélever de la vapeur pendant la détente pour préchauffer l'eau envoyée à la chaudière." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-moteurs/#lexique" ;
            schema:name "Resurchauffe, régénération (soutirages)" ],
        [ a schema:DefinedTerm ;
            schema:description "Bachelor universitaire de technologie : diplôme en trois ans préparé dans un IUT (institut universitaire de technologie)." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-moteurs/#lexique" ;
            schema:name "B.U.T." ] ;
    schema:inLanguage "fr" ;
    schema:name "Les mots du chapitre" .

<https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-moteurs/#page> a schema:LearningResource ;
    schema:about <https://www.cyrilvoyant.com/ontology/#cop> ;
