    schema:name "Bases de thermique pour le génie industriel alimentaire : transferts, refroidissement et congélation" ;
    schema:provider <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:teaches "bilan énergétique",
        "conduction",
