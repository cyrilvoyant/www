        "https://www.cyrilvoyant.com/glossary/#macroscopic-cross-section" .

<https://www.cyrilvoyant.com/ontology/#malr> a schema:DefinedTerm ;
    schema:alternateName "mean absolute log return",
        "rendement logarithmique absolu moyen" ;
    schema:description "A parameter borrowed from econometrics that describes the size of relative changes. This empirical diagnostic does not replace testing the model at the intended site and horizon.",
        "Un paramètre issu de l'économétrie qui décrit l'amplitude des changements relatifs. Ce diagnostic empirique ne dispense pas de tester le modèle sur le site et à l'horizon visés." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/ontology/#cv-concepts> ;
    schema:inLanguage "en",
        "fr" ;
