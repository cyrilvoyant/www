<https://www.cyrilvoyant.com/ontology/#forecasting> a schema:DefinedTerm ;
    schema:alternateName "prévision solaire",
        "solar forecasting" ;
    schema:description "An error only makes sense against a reference: describe the signal, choose simple references, measure the gain, then add complexity only if the gain justifies it.",
        "Une erreur n'a de sens que face à une référence : on décrit le signal, on choisit des références simples, on mesure le gain, puis on complexifie si ce gain le justifie." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/ontology/#cv-concepts> ;
    schema:inLanguage "en",
        "fr" ;
    schema:name "Forecasting and evaluation",
        "Prévision et évaluation" ;
    schema:termCode "forecasting" ;
    schema:url "https://www.cyrilvoyant.com/fr/lexique/#forecasting",
        "https://www.cyrilvoyant.com/glossary/#forecasting" .

<https://www.cyrilvoyant.com/ontology/#fractionation> a schema:DefinedTerm ;
    schema:alternateName "fractions",
        "schéma de traitement",
        "treatment schedule" ;
    schema:description "For n fractions (the number of treatment sessions), each delivering a dose d in grays, physical dose is not enough to predict the biological effect, which also depends on the dose received at each fraction.",
        "Pour n fractions (le nombre de séances), chacune délivrant une dose d en grays, la dose physique ne suffit pas à prédire l'effet biologique, qui dépend aussi de la dose reçue à chaque fraction." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/ontology/#cv-concepts> ;
    schema:inLanguage "en",
        "fr" ;
    schema:name "Fractionation",
        "Fractionnement" ;
    schema:termCode "fractionation" ;
    schema:url "https://www.cyrilvoyant.com/fr/lexique/#fractionation",
        "https://www.cyrilvoyant.com/glossary/#fractionation" .

<https://www.cyrilvoyant.com/ontology/#gti> a schema:DefinedTerm ;
    schema:description "Incident solar power per unit area in the tilted plane of a photovoltaic array, measured in W/m².",
        "Puissance solaire incidente par unité de surface dans le plan incliné du champ photovoltaïque, en W/m²." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/ontology/#cv-concepts> ;
