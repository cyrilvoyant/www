<https://www.cyrilvoyant.com/fr/edition-scientifique-confiance#faq> a schema:FAQPage ;
    schema:inLanguage "fr" ;
    schema:mainEntity [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Pas forcément. Le manque est dans la vérification et dans la reconnaissance du travail d'édition, pas dans le nombre de titres." ] ;
            schema:name "Faut-il créer de nouvelles revues ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Parce qu'il impose aux systèmes d'IA à haut risque ce qui manque aux articles : gouvernance des données, documentation technique, journalisation, système de gestion de la qualité et surveillance après la mise sur le marché." ] ;
            schema:name "Pourquoi parler de l'AI Act à propos d'articles ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Non : il faut l'afficher. Comme pour tout autre outil, on déclare ce qui a été utilisé et pour quoi ; ce qui compte est que les résultats soient vérifiés, données et code compris." ] ;
            schema:name "Faut-il interdire l'IA dans l'écriture et la relecture ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Le nombre d'articles indexés a crû d'environ 47 % entre 2016 et 2022, plus vite que le nombre de chercheurs ; la relecture, gratuite, ne suit plus, et plus de 10 000 articles ont été rétractés en 2023, un record." ] ;
            schema:name "L'édition scientifique va-t-elle si mal ?" ] .

<https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/#page> a schema:CollectionPage ;
    schema:about <https://www.cyrilvoyant.com/ontology/#freezing> ;
    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:description "Bases thermiques des aliments : un cours de 24 diapositives, B.U.T. Génie biologique, Sciences de l'aliment et biotechnologie (SAB), 1ʳᵉ année." ;
    schema:inLanguage "fr" ;
    schema:isPartOf <https://www.cyrilvoyant.com/#website> ;
    schema:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema:mentions <https://www.cyrilvoyant.com/ontology/#biot-number> ;
    schema:name "Bases de thermique pour le génie industriel alimentaire : transferts, refroidissement et congélation" ;
    schema:publisher <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:url "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/" .

<https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours/#faq> a schema:FAQPage ;
    schema:inLanguage "fr" ;
    schema:mainEntity [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Seulement tant que la résistance de surface 1/h domine ; quand le Biot devient grand, la conduction interne limite et souffler plus fort ne gagne presque rien, il vaut mieux réduire l'épaisseur du produit." ] ;
            schema:name "Augmenter la vitesse de l'air suffit-il à accélérer un refroidissement ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Le palier de changement d'état ajoute la chaleur latente de l'eau congelée, environ 334 kJ par kilogramme de glace formée, soit l'équivalent de dizaines de degrés de refroidissement ; à durée égale, la puissance doit suivre." ] ;
            schema:name "Pourquoi la puissance de congélation est-elle si supérieure à celle de réfrigération pour une même masse ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "La résistance interne domine : la surface suit vite le fluide tandis que le cœur traîne ; la loi exponentielle à température uniforme ne vaut plus, il faut une solution de conduction transitoire et surveiller la température à cœur, qui fixe la sécurité sanitaire." ] ;
            schema:name "Que change concrètement un nombre de Biot élevé ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Les solutés abaissent le point de congélation de l'eau ; à mesure que la glace se forme, la solution restante se concentre et son point de congélation baisse encore, si bien qu'une fraction d'eau reste liquide même à basse température." ] ;
            schema:name "Pourquoi la température de début de congélation d'un aliment est-elle inférieure à 0 °C ?" ] .

<https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours/#lexique> a schema:DefinedTermSet ;
    schema:hasDefinedTerm [ a schema:DefinedTerm ;
            schema:description "Dimension qui fixe le chemin de la chaleur dans l'aliment, notée D sur la diapositive 12 ; souvent le volume divisé par la surface d'échange." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours/#lexique" ;
            schema:name "Longueur caractéristique Lc" ],
        [ a schema:DefinedTerm ;
            schema:description "Φ : puissance thermique qui traverse une surface, en watts (W). φ = Φ/S : la même puissance par mètre carré (W/m²)." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours/#lexique" ;
            schema:name "Flux Φ, densité de flux φ" ],
        [ a schema:DefinedTerm ;
            schema:description "Par analogie avec l'électricité, l'écart de température divisé par la densité de flux : e/λ pour une paroi d'épaisseur e, 1/h pour un échange de surface, en K·m²/W." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours/#lexique" ;
            schema:name "Résistance thermique R" ],
        [ a schema:DefinedTerm ;
            schema:description "Aptitude d'un matériau à conduire la chaleur, en W/(m·K) ; elle figure dans la loi de Fourier φ = −λ dT/dx. (Dans ce cours, λ n'est pas une longueur d'onde.)" ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours/#lexique" ;
            schema:name "Conductivité thermique λ" ],
        [ a schema:DefinedTerm ;
            schema:description "Énergie pour élever de 1 °C la température de 1 kg, en kJ/(kg·°C) ; elle diffère avant et après congélation." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours/#lexique" ;
            schema:name "Capacité thermique massique cp" ],
        [ a schema:DefinedTerm ;
            schema:description "Une part de l'eau ne gèle pas, même très froide. La relation de Chen (voir les sources) estime G, la masse de glace formée selon la température, d'où l'eau qui reste à congeler." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours/#lexique" ;
            schema:name "Eau non congelable ; teneur en glace G" ],
        [ a schema:DefinedTerm ;
            schema:description "Les trois modes de transfert : par chocs entre particules voisines, par mouvement d'un fluide, par ondes électromagnétiques." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours/#lexique" ;
            schema:name "Conduction, convection, rayonnement" ],
        [ a schema:DefinedTerm ;
            schema:description "Libre : le fluide bouge sous l'effet des écarts de température (courants, orages). Forcée : une pompe, un ventilateur ou une turbine le met en mouvement. h, en W/(m²·K), mesure l'échange entre la paroi et le fluide." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours/#lexique" ;
            schema:name "Convection libre, forcée ; coefficient h" ],
        [ a schema:DefinedTerm ;
            schema:description "Bachelor universitaire de technologie, diplôme en trois ans préparé dans un IUT (institut universitaire de technologie)." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours/#lexique" ;
            schema:name "B.U.T., IUT" ],
        [ a schema:DefinedTerm ;
            schema:description "Énergie à extraire par unité de temps, en watts ; elle sert à dimensionner l'installation pour une masse et une durée données." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours/#lexique" ;
            schema:name "Puissance frigorifique P" ],
        [ a schema:DefinedTerm ;
            schema:description "Énergie absorbée ou libérée par un changement d'état à température constante, ici la solidification de l'eau." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours/#lexique" ;
            schema:name "Chaleur latente" ],
        [ a schema:DefinedTerm ;
            schema:description "τ = m cp/(h S) : durée caractéristique d'un refroidissement à température uniforme, T(t) = T∞ + (Ti − T∞) e−t/τ." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours/#lexique" ;
            schema:name "Constante de temps τ" ],
        [ a schema:DefinedTerm ;
            schema:description "Température où la glace commence à se former, souvent sous 0 °C car l'eau de l'aliment contient des solutés ; elle baisse ensuite à mesure que la solution restante se concentre." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours/#lexique" ;
            schema:name "Température de début de congélation Tc" ],
        [ a schema:DefinedTerm ;
            schema:description "Génie biologique, la spécialité du B.U.T. ; Sciences de l'aliment et biotechnologie, son parcours." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours/#lexique" ;
            schema:name "GB, SAB" ],
        [ a schema:DefinedTerm ;
            schema:description "Énergie contenue par kilogramme ; pour une congélation, Δh additionne le refroidissement du produit frais, la chaleur latente de l'eau qui gèle et le refroidissement du produit congelé." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours/#lexique" ;
            schema:name "Enthalpie massique, Δh" ],
        [ a schema:DefinedTerm ;
            schema:description "Ensemble des points qui ont, à un instant donné, la même température." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours/#lexique" ;
            schema:name "Surface isotherme" ],
        [ a schema:DefinedTerm ;
            schema:description "Masse d'eau rapportée à la masse totale de l'aliment (base humide) ; c'est d'elle que dépendent d'abord les propriétés thermiques." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours/#lexique" ;
            schema:name "Teneur en eau H" ],
        [ a schema:DefinedTerm ;
            schema:description "Bi = h Lc/λ, sans dimension : résistance interne de l'aliment divisée par sa résistance de surface. Moins de 0,1 : température uniforme ; plus de 40 : le cœur limite." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours/#lexique" ;
            schema:name "Nombre de Biot Bi" ] ;
    schema:inLanguage "fr" ;
    schema:name "Les mots du cours" .

