<https://www.cyrilvoyant.com/ontology/#macroscopic-cross-section> a schema:DefinedTerm ;
    schema:alternateName "Σ" ;
    schema:description "La section efficace multipliée par le nombre de noyaux par unité de volume : l'inverse d'une longueur. Pour un mélange, Σ additionne ces produits noyau par noyau.",
