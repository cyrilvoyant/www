<https://www.cyrilvoyant.com/ai-in-research#page> a schema:Article ;
    schema:about <https://cyrilvoyant.github.io/approach.html#principle-5> ;
    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:dateModified "2026-10-24" ;
    schema:datePublished "2026-10-23" ;
    schema:description "Generative AI now writes code, drafts papers and reviews data in every laboratory. The European AI Act sets rules for what we build and what we transfer. Here is what changes for researchers, the timeline in Europe and in France, how the rest of the world compares, who is responsible when research code becomes a product, and a toolbox a lab can adopt in a few hours per project." ;
    schema:inLanguage "en" ;
    schema:isPartOf <https://www.cyrilvoyant.com/#website> ;
    schema:keywords "Demonstrate trust",
        "Research practice" ;
    schema:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema:name "AI in research: the AI Act, a lab charter and a toolbox for researchers" ;
    schema:publisher <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:url "https://www.cyrilvoyant.com/ai-in-research/" ;
    schema:version "1.2" ;
    schema:workTranslation <https://www.cyrilvoyant.com/fr/ia-dans-la-recherche#page> .

<https://www.cyrilvoyant.com/approach#page> a schema:AboutPage ;
    schema:about <https://cyrilvoyant.github.io/approach.html#principle-2> ;
    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:description "Medicine, energy, language: very different questions, one method. People and their question at the centre; a model we understand at the core; every tool, artificial intelligence included, around it. Complexity is added only when it brings a measurable gain." ;
    schema:inLanguage "en" ;
    schema:isPartOf <https://www.cyrilvoyant.com/#website> ;
    schema:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema:name "Understand before you compute: the approach of Cyril Voyant" ;
    schema:publisher <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:url "https://www.cyrilvoyant.com/approach/" ;
    schema:workTranslation <https://www.cyrilvoyant.com/fr/approche#page> .

