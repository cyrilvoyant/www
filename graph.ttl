<https://www.cyrilvoyant.com/fr/ia-dans-la-recherche#page> a schema:Article ;
    schema:about <https://cyrilvoyant.github.io/approach.html#principle-5> ;
    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:dateModified "2026-10-24" ;
    schema:datePublished "2026-10-23" ;
    schema:description "L'IA générative écrit du code, rédige des articles et trie des données dans tous les laboratoires. Le règlement européen sur l'IA (AI Act) encadre ce que nous construisons et ce que nous transférons. Voici ce qui change pour les chercheurs, le calendrier européen et français, la comparaison avec le reste du monde, la question de la responsabilité quand un code de recherche devient un produit, et une boîte à outils qu'un laboratoire peut adopter en quelques heures par projet." ;
    schema:inLanguage "fr" ;
    schema:isPartOf <https://www.cyrilvoyant.com/#website> ;
    schema:keywords "Démontrer la confiance",
        "Pratique de la recherche" ;
    schema:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema:name "L'IA dans la recherche : AI Act, charte de laboratoire et boîte à outils" ;
    schema:publisher <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:translationOfWork <https://www.cyrilvoyant.com/ai-in-research#page> ;
    schema:url "https://www.cyrilvoyant.com/fr/ia-dans-la-recherche/" ;
    schema:version "1.2" .

