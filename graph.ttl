<https://www.cyrilvoyant.com/teaching/solar-forecasting-course/#course> a schema:Course ;
    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:courseCode "UE14" ;
    schema:description "A 59-slide course on forecasting solar irradiance one hour ahead, taught in the UE14 applied research project of the Mines Paris – PSL engineering curriculum, built on ten years of hourly measurements from Ajaccio (Corsica). It goes from the solar signal and the clear-sky index to autoregressive models fitted by least squares, then to Extreme Learning Machines, online learning and frugality, every model judged against persistence; on the 2007 test year, the daytime nRMSE is 22.0 % for smart persistence, 21.3 % for AR(2) and 20.5 % for an ELM." ;
    schema:educationalLevel "Engineering curriculum (Mines Paris – PSL)" ;
    schema:hasPart [ a schema:LearningResource ;
            schema:contentUrl "https://www.cyrilvoyant.com/assets/course/Forecasting-the-Intermittent-Solar-Resource_EN.pdf" ;
            schema:encodingFormat "application/pdf" ;
            schema:name "Solar forecasting course: forecasting the intermittent solar resource (PDF)" ],
        [ a schema:LearningResource ;
            schema:contentUrl "https://www.cyrilvoyant.com/assets/course/Forecasting-the-Intermittent-Solar-Resource_EN.pptx" ;
            schema:encodingFormat "application/vnd.openxmlformats-officedocument.presentationml.presentation" ;
            schema:name "Solar forecasting course: forecasting the intermittent solar resource (PowerPoint)" ] ;
    schema:inLanguage "en" ;
    schema:isBasedOn "https://cyrilvoyant.github.io/teaching/solar-forecasting-basics.html" ;
    schema:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema:name "Solar forecasting course: forecasting the intermittent solar resource" ;
    schema:provider [ a schema:CollegeOrUniversity ;
            schema:name "Mines Paris – PSL" ;
            schema:url "https://www.minesparis.psl.eu/" ] ;
    schema:teaches "Extreme Learning Machine",
        "autoregressive model",
        "clear-sky index",
        "forecast evaluation (nRMSE, skill score, NICE)",
        "frugality",
        "least squares",
        "online learning",
        "persistence" .

