<https://www.cyrilvoyant.com/ontology/#monte-carlo> a schema:DefinedTerm ;
    schema:alternateName "Monte Carlo method",
        "Monte-Carlo",
        "méthode de Monte-Carlo" ;
    schema:description "Simulating many times with different random draws. More histories reduce the statistical error, as 1/√N for N histories; they correct neither a wrong geometry nor wrong physical data.",
        "Simuler de nombreuses fois avec des tirages aléatoires différents. Plus d'histoires réduisent l'erreur statistique, comme 1/√N pour N histoires ; elles ne corrigent ni une mauvaise géométrie ni de mauvaises données physiques." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/ontology/#cv-concepts>,
        "https://www.cyrilvoyant.com/ontology/" ;
    schema:inLanguage "en",
        "fr" ;
