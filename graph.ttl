                            schema:sameAs "https://orcid.org/0009-0004-0183-2156" ],
                        <https://person.cyrilvoyant.com/#cyril-voyant> ;
                    schema:datePublished "2025-10-01" ;
                    schema:headline "From Trends to Insights: A Text Mining Analysis of Solar Energy Forecasting (2017–2023)" ;
                    schema:image "https://www.cyrilvoyant.com/assets/img/b0d486d8a45b.png" ;
                    schema:inLanguage "en" ;
                    schema:url "https://www.cyrilvoyant.com/latest-publications-and-news/" ] ;
            schema:position 16 ],
        [ a schema:ListItem ;
            schema:item [ a schema:BlogPosting ;
                    schema:abstract "This paper demonstrates that transfer learning can accurately forecast wind speed in data-scarce regions by reusing models trained on data-rich sites. Across 4,830 experiments, transfer learning (TL) achieved accuracy comparable to direct learning (ΔnRMSE < 0.01). The approach offers a scalable, low-data solution for expanding wind forecasting to under-instrumented areas." ;
                    schema:author [ a schema:Person ;
                            schema:name "Gilles Notton" ;
                            schema:sameAs "https://orcid.org/0000-0002-6267-9632" ],
                        [ a schema:Person ;
                            schema:name "Milan Despotović" ;
                            schema:sameAs "https://orcid.org/0000-0003-3144-5945" ],
                        <https://person.cyrilvoyant.com/#cyril-voyant> ;
                    schema:datePublished "2025-10-13" ;
                    schema:headline "Transfer Learning for Wind Speed Forecasting: A Scalable Approach for Data-Scarce Environments" ;
                    schema:image "https://www.cyrilvoyant.com/assets/img/435a8e9d3433.png" ;
                    schema:inLanguage "en" ;
                    schema:url "https://www.cyrilvoyant.com/latest-publications-and-news/" ] ;
            schema:position 15 ],
        [ a schema:ListItem ;
