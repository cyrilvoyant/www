<https://www.cyrilvoyant.com/latest-publications-and-news/nice-forecast-evaluation#page> a schema:Article ;
    schema:about <https://cyrilvoyant.github.io/approach.html#principle-5> ;
    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:description "At a thirty-minute horizon, the NICE study reports a rounded median nRMSE of 0.19 for both an ELM and an autoregressive model. The composite NICEΣ score nevertheless gives 0.75 versus 0.77, with a statistically significant difference in the reported test." ;
    schema:inLanguage "en" ;
    schema:isPartOf <https://www.cyrilvoyant.com/#website> ;
    schema:keywords "Demonstrate trust",
        "Energy" ;
    schema:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema:name "NICE metrics: when RMSE hides a difference between solar forecasts" ;
    schema:publisher <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:url "https://www.cyrilvoyant.com/latest-publications-and-news/nice-forecast-evaluation/" ;
    schema:workTranslation <https://www.cyrilvoyant.com/fr/actualites/nice-forecast-evaluation#page> .

<https://www.cyrilvoyant.com/latest-publications-and-news/why-extreme-learning-machines#page> a schema:Article ;
    schema:about <https://cyrilvoyant.github.io/approach.html#principle-3> ;
    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:description "At a one-hour horizon, our MIMO-ELM model achieves nRMSE values of 0.179 for solar generation and 0.051 for thermal generation, with R² above 0.98 for both series. Total-demand forecasts remain reliable up to five hours ahead within the study." ;
    schema:inLanguage "en" ;
    schema:isPartOf <https://www.cyrilvoyant.com/#website> ;
    schema:keywords "Energy",
        "Learn frugally" ;
    schema:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema:name "MIMO-ELM: seven energy signals of Corsica forecast by one model" ;
    schema:publisher <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:url "https://www.cyrilvoyant.com/latest-publications-and-news/why-extreme-learning-machines/" ;
