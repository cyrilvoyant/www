<https://www.cyrilvoyant.com/ontology/#carnot-efficiency> a schema:DefinedTerm ;
    schema:alternateName "Carnot engine",
        "Carnot limit",
        "limite de Carnot",
        "moteur de Carnot" ;
    schema:description "Efficiency η is the work W divided by the heat received Qhot; ηCarnot is its limit, reached by a reversible cycle, with no friction and no temperature gap during exchanges.",
        "Le rendement η est le travail W divisé par la chaleur reçue Qchaud ; ηCarnot est sa borne, atteinte par un cycle réversible, sans frottement ni écart de température lors des échanges." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/ontology/#cv-concepts>,
        "https://www.cyrilvoyant.com/ontology/" ;
    schema:inLanguage "en",
        "fr" ;
    schema:name "Carnot efficiency",
        "Rendement de Carnot" ;
    schema:sameAs "http://www.wikidata.org/entity/Q93949862" ;
    schema:termCode "carnot-efficiency" ;
    schema:url "https://www.cyrilvoyant.com/fr/animations/moteur-carnot/",
        "https://www.cyrilvoyant.com/fr/lexique/#carnot-efficiency",
        "https://www.cyrilvoyant.com/glossary/#carnot-efficiency",
        "https://www.cyrilvoyant.com/tools/carnot-heat-engine/" .

<https://www.cyrilvoyant.com/ontology/#cross-section> a schema:DefinedTerm ;
    schema:alternateName "neutron cross section",
        "σ(E)" ;
    schema:description "Elle dit à quel point un noyau réagit facilement avec un neutron d'énergie E. Elle s'exprime comme une surface, souvent en barns, sans être la taille du noyau ni, à elle seule, la probabilité de capture.",
        "It says how readily a nucleus reacts with a neutron of energy E. It is expressed as an area, often in barns, without being the size of the nucleus or, by itself, the probability of capture." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/ontology/#cv-concepts>,
        "https://www.cyrilvoyant.com/ontology/" ;
    schema:inLanguage "en",
        "fr" ;
