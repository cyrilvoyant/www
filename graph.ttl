        "fr" ;
    schema:name "Global tilted irradiance (GTI)",
        "Éclairement dans le plan des panneaux (GTI)" ;
    schema:termCode "gti" ;
    schema:url "https://www.cyrilvoyant.com/fr/lexique/#gti",
        "https://www.cyrilvoyant.com/glossary/#gti" .

<https://www.cyrilvoyant.com/ontology/#jarque-bera> a schema:DefinedTerm ;
    schema:description "Combine l’asymétrie et l’excès d’aplatissement pour évaluer la normalité. Le seuil du χ² est asymptotique.",
