                    schema:image "https://www.cyrilvoyant.com/assets/img/e127601c2891.png" ;
                    schema:inLanguage "en" ;
                    schema:url "https://www.cyrilvoyant.com/latest-publications-and-news/" ] ;
            schema:position 3 ],
        [ a schema:ListItem ;
            schema:item [ a schema:BlogPosting ;
                    schema:abstract "This work is part of the doctoral research of Mohammed Asloune (University of Corsica & Mines Paris – PSL)." ;
                    schema:author [ a schema:Person ;
                            schema:name "Gilles Notton" ;
                            schema:sameAs "https://orcid.org/0000-0002-6267-9632" ],
                        [ a schema:Person ;
                            schema:name "Mohammed Asloune" ;
                            schema:sameAs "https://orcid.org/0009-0004-0183-2156" ],
                        <https://person.cyrilvoyant.com/#cyril-voyant> ;
                    schema:datePublished "2025-12-20" ;
                    schema:headline "Quality Control Framework for Tilted Solar Irradiance" ;
                    schema:image "https://www.cyrilvoyant.com/assets/img/597be8654483.jpg" ;
                    schema:inLanguage "en" ;
                    schema:url "https://www.cyrilvoyant.com/latest-publications-and-news/" ] ;
            schema:position 12 ],
        [ a schema:ListItem ;
            schema:item [ a schema:BlogPosting ;
                    schema:abstract "I've experienced this troubling phenomenon firsthand: an article I had little hope for exploded with hundreds of citations, while another piece I considered my best work remained in obscurity. After twenty years of research, one thing is clear: in a rapidly evolving academic ecosystem, publishing alone is no longer sufficient." ;
                    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
                    schema:datePublished "2025" ;
                    schema:headline "Academic Visibility: Why Publishing Isn't Enough Anymore" ;
                    schema:image "https://www.cyrilvoyant.com/assets/img/0e72a8bbd5be.png" ;
                    schema:inLanguage "en" ;
                    schema:url "https://www.cyrilvoyant.com/latest-publications-and-news/" ] ;
            schema:position 24 ] ;
