<https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques#page> a schema:LearningResource ;
    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:description "Le cycle en quatre étapes, les états du fluide, le cycle sur le diagramme de Mollier, COP et efficacité, froid industriel, fluides frigorigènes et réglementation." ;
    schema:inLanguage "fr" ;
    schema:isPartOf <https://www.cyrilvoyant.com/#website> ;
    schema:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema:name "Chapitre 5 : les cycles frigorifiques" ;
    schema:publisher <https://person.cyrilvoyant.com/#cyril-voyant> ;
