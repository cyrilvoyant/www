<https://www.cyrilvoyant.com/ontology/#gamma-index> a schema:DefinedTerm ;
    schema:alternateName "gamma index",
        "indice gamma" ;
    schema:description "For each forecast pixel, the distance to the nearest observation in space, time and intensity, each divided by its tolerance. γ ≤ 1: accepted.",
        "Pour chaque pixel prévu, la distance à l'observation la plus proche dans l'espace, le temps et l'intensité, chacun divisé par sa tolérance. γ ≤ 1 : accepté." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/ontology/#cv-concepts>,
        "https://www.cyrilvoyant.com/ontology/" ;
    schema:inLanguage "en",
        "fr" ;
    schema:name "Indice γ",
        "γ-index" ;
    schema:termCode "gamma-index" ;
    schema:url "https://www.cyrilvoyant.com/fr/lexique/#gamma-index",
        "https://www.cyrilvoyant.com/fr/outils/indice-gamma/",
        "https://www.cyrilvoyant.com/glossary/#gamma-index",
        "https://www.cyrilvoyant.com/latest-publications-and-news/gamma-index-forecast-validation/" .

