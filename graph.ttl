<https://www.cyrilvoyant.com/prevision-pv-reduction-dimension/#page> a schema:Article ;
    schema:about <https://cyrilvoyant.github.io/approach.html#principle-3>,
        <https://www.cyrilvoyant.com/ontology/#elm> ;
    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:description "Prévoir la puissance électrique directement à partir de son historique évite de reconstruire toute la chaîne rayonnement–panneaux–onduleur. Mais une journée de mesures n’est pas nécessairement une journée d’informations indépendantes : réduire la dimension, c’est la résumer par moins de valeurs…" ;
    schema:inLanguage "fr" ;
    schema:isPartOf <https://www.cyrilvoyant.com/#website> ;
    schema:keywords "Apprendre frugalement",
        "Énergie" ;
    schema:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema:name "Prévision PV : réduire la dimension" ;
    schema:publisher <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:url "https://www.cyrilvoyant.com/prevision-pv-reduction-dimension/" .

<https://www.cyrilvoyant.com/prevision-solaire-faire-simple/#page> a schema:Article ;
    schema:about <https://cyrilvoyant.github.io/approach.html#principle-2>,
        <https://www.cyrilvoyant.com/ontology/#blend>,
        <https://www.cyrilvoyant.com/ontology/#cliper>,
        <https://www.cyrilvoyant.com/ontology/#persistence> ;
    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:description "Prévoir le solaire, c’est distinguer ce que l’on sait déjà — le mouvement du Soleil — de ce qu’il reste à anticiper : les nuages, la dynamique locale et l’état réel du système." ;
    schema:inLanguage "fr" ;
    schema:isPartOf <https://www.cyrilvoyant.com/#website> ;
    schema:keywords "Calculer directement",
        "Énergie" ;
    schema:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema:mentions <https://www.cyrilvoyant.com/ontology/#artu>,
        <https://www.cyrilvoyant.com/ontology/#climatological-mean>,
