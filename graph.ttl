        <https://www.cyrilvoyant.com/ontology/#cyclic-persistence>,
        <https://www.cyrilvoyant.com/ontology/#elm>,
        <https://www.cyrilvoyant.com/ontology/#nice>,
        <https://www.cyrilvoyant.com/ontology/#nrmse>,
        <https://www.cyrilvoyant.com/ontology/#ratio-to-trend>,
        <https://www.cyrilvoyant.com/ontology/#scv>,
        <https://www.cyrilvoyant.com/ontology/#simulated-data> ;
    schema:name "Prévision solaire : faire simple" ;
    schema:publisher <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:url "https://www.cyrilvoyant.com/prevision-solaire-faire-simple/" .

<https://www.cyrilvoyant.com/prevision-solaire-modeles-frugaux/#page> a schema:Article ;
    schema:about <https://cyrilvoyant.github.io/approach.html#principle-3>,
        <https://www.cyrilvoyant.com/ontology/#elm> ;
    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:description "Un modèle de prévision ne se juge pas uniquement sur son erreur. Il doit aussi tenir dans le dispositif, répondre à temps et rester maintenable. La frugalité consiste à rechercher la capacité utile, en démontrant ce que chaque supplément de complexité apporte." ;
    schema:inLanguage "fr" ;
    schema:isPartOf <https://www.cyrilvoyant.com/#website> ;
    schema:keywords "Apprendre frugalement",
        "Énergie" ;
    schema:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema:mentions <https://www.cyrilvoyant.com/ontology/#persistence> ;
    schema:name "Prévision solaire : modèles frugaux" ;
    schema:publisher <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:url "https://www.cyrilvoyant.com/prevision-solaire-modeles-frugaux/" .

