                            schema:sameAs "https://orcid.org/0000-0002-2813-150X" ],
                        <https://person.cyrilvoyant.com/#cyril-voyant> ;
                    schema:datePublished "2025-09-25" ;
                    schema:headline "NICE^k Metrics: Unified and Multidimensional Framework for Evaluating Deterministic Solar Forecasting Accuracy" ;
                    schema:image "https://www.cyrilvoyant.com/assets/img/82ce1d4d17e8.png" ;
                    schema:inLanguage "en" ;
                    schema:url "https://www.cyrilvoyant.com/latest-publications-and-news/nice-forecast-evaluation/" ] ;
            schema:position 21 ],
        [ a schema:ListItem ;
            schema:item [ a schema:BlogPosting ;
                    schema:abstract "The 2025 update of the Stanford–Elsevier database of standardized citation indicators (Ioannidis, version 8) includes Cyril Voyant: a composite citation score in the top 100,000 overall or the top 2 % of the sub-field. What it measures, and what it does not, is below." ;
                    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
                    schema:datePublished "2025" ;
                    schema:headline "Listed in the 2025 update of the Stanford–Elsevier citation database (top 2 %)" ;
                    schema:image "https://www.cyrilvoyant.com/assets/img/c8454c0e0d6c.png" ;
                    schema:inLanguage "en" ;
                    schema:url "https://www.cyrilvoyant.com/latest-publications-and-news/" ] ;
            schema:position 14 ],
        [ a schema:ListItem ;
            schema:item [ a schema:BlogPosting ;
                    schema:abstract "Indexed articles grew by about 47% between 2016 and 2022, peer review relies on unpaid work and 2023 set a record of retractions. A short essay on what exists, from FAIR data to the AI Act, and what is missing: checking the data and code behind what is published." ;
                    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
                    schema:datePublished "2026-10-24" ;
                    schema:headline "Scientific publishing: no verification of data and code, no trust" ;
                    schema:image "https://www.cyrilvoyant.com/assets/articles/scientific-publishing-growth.svg" ;
                    schema:inLanguage "en" ;
                    schema:url "https://www.cyrilvoyant.com/scientific-publishing-trust/" ] ;
            schema:position 1 ],
        [ a schema:ListItem ;
            schema:item [ a schema:BlogPosting ;
                    schema:abstract "The team developed linear models that predict solar irradiance forecast errors using only solar variability at a specific location. This variability is measured by the standard deviation of hourly changes in the clear sky index, essentially capturing how much solar conditions fluctuate hour to hour." ;
                    schema:author [ a schema:Person ;
                            schema:name "Richard Perez" ;
                            schema:sameAs "https://orcid.org/0000-0001-8064-3281" ],
                        [ a schema:Person ;
                            schema:name "Philippe Lauret" ;
                            schema:sameAs "https://orcid.org/0000-0003-2959-6146" ],
                        [ a schema:Person ;
                            schema:name "Elke Lorenz" ;
