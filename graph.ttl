<https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours#page> a schema:LearningResource ;
    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:description "Concepts fondamentaux, conduction, convection, nombre de Biot, propriétés thermiques des aliments, puissance frigorifique, quantité d'eau à congeler et bilan énergétique." ;
    schema:inLanguage "fr" ;
    schema:isPartOf <https://www.cyrilvoyant.com/#website> ;
    schema:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema:name "Cours : transferts thermiques, refroidissement et congélation des aliments" ;
    schema:publisher <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:url "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours/" .

<https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours/#faq> a schema:FAQPage ;
    schema:inLanguage "fr" ;
    schema:mainEntity [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Le palier de changement d'état ajoute la chaleur latente de l'eau congelée, environ 333 kJ par kilogramme de glace formée, soit l'équivalent de dizaines de degrés de refroidissement ; à durée égale, la puissance doit suivre." ] ;
            schema:name "Pourquoi la puissance de congélation est-elle si supérieure à celle de réfrigération pour une même masse ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Seulement tant que la résistance de surface 1/h domine ; quand le Biot devient grand, la conduction interne limite et souffler plus fort ne gagne presque rien, il vaut mieux réduire l'épaisseur du produit." ] ;
            schema:name "Augmenter la vitesse de l'air suffit-il à accélérer un refroidissement ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "La résistance interne domine : la surface suit vite le fluide tandis que le cœur traîne ; la loi exponentielle à température uniforme ne vaut plus, il faut une solution de conduction transitoire et surveiller la température à cœur, qui fixe la sécurité sanitaire." ] ;
            schema:name "Que change concrètement un nombre de Biot élevé ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Les solutés abaissent le point de congélation de l'eau ; à mesure que la glace se forme, la solution restante se concentre et son point de congélation baisse encore, si bien qu'une fraction d'eau reste liquide même à basse température." ] ;
            schema:name "Pourquoi la température de début de congélation d'un aliment est-elle inférieure à 0 °C ?" ] .

