[] a schema:LearningResource ;
    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:citation <https://doi.org/10.1016/j.clon.2025.103893>,
        <https://doi.org/10.1016/j.meddos.2026.08.002>,
