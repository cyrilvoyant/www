            schema:position 12 ],
        [ a schema:ListItem ;
            schema:item [ a schema:BlogPosting ;
                    schema:abstract "Une revue pluridisciplinaire qui couvre tous les domaines scientifiques ; ce rôle prolonge mon parcours de directeur de recherche à Mines Paris – PSL (centre O.I.E.)." ;
                    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
                    schema:datePublished "2026" ;
