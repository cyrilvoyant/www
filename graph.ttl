    schema:name "L'indice γ : valider des prévisions solaires décalées au-delà des erreurs ponctuelles" ;
    schema:publisher <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:translationOfWork <https://www.cyrilvoyant.com/latest-publications-and-news/gamma-index-forecast-validation#page> ;
    schema:url "https://www.cyrilvoyant.com/fr/actualites/gamma-index-forecast-validation/" .

