<https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/#course> a schema:Course ;
    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:description "Physique industrielle : un cours en 5 chapitres et 139 diapositives, B.U.T. Génie biologique, parcours Sciences de l'aliment et biotechnologie (SAB), 2ᵉ année. Les bases de thermodynamique d'un technicien de l'agroalimentaire : grandeurs et changements d'état, gaz parfaits et réels, diagrammes de Clapeyron, entropique et de Mollier, vapeur d'eau et humidité, cycles moteurs, puis le cycle frigorifique, son COP et ses fluides." ;
    schema:educationalLevel "B.U.T. Génie biologique, parcours Sciences de l'aliment et biotechnologie (SAB), 2ᵉ année" ;
    schema:hasPart <https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques/#chapter>,
        <https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-moteurs/#chapter>,
        <https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/gaz-parfaits-et-reels/#chapter>,
        <https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/notions-de-thermodynamique/#chapter>,
        <https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/vapeur-d-eau/#chapter> ;
    schema:inLanguage "fr" ;
    schema:license "https://creativecommons.org/licenses/by/4.0/deed.fr" ;
    schema:name "Physique industrielle : thermodynamique, vapeur d'eau et production de froid" ;
    schema:provider <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:teaches "changement d'état",
        "coefficient de performance",
        "cycle frigorifique",
        "cycle thermodynamique",
        "diagramme de Mollier",
        "fluides frigorigènes",
        "gaz parfait",
        "humidité relative",
        "thermodynamique",
        "vapeur d'eau" .

