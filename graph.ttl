<https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed1-corrige/#faq> a schema:FAQPage ;
    schema:inLanguage "fr" ;
    schema:mainEntity [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Parce que les traversées successives se composent par multiplication : 2 CDA de tumeur puis 3 CDA de tissu sain transmettent 1/2⁵ = 1/32, sans calculatrice ; l'exponentielle n'est nécessaire que pour une épaisseur qui n'est pas un multiple simple de la CDA." ] ;
            schema:name "Pourquoi raisonner en nombre de CDA plutôt qu'avec l'exponentielle ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Pour une onde plane sinusoïdale isolée, moyennée sur de nombreuses périodes, ⟨E²⟩ = E0²/2 ne dépend pas de la phase initiale et I = ε0 c E0²/2 dans le vide. En superposition, les phases relatives interviennent dans les interférences." ] ;
            schema:name "L’intensité d’une onde dépend-elle de sa phase ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "L’exposant μx doit être sans dimension. Si μ est en cm⁻¹, exprimer x en cm ; une épaisseur en millimètres non convertie introduit un facteur dix dans l’exposant." ] ;
            schema:name "Pourquoi préciser les unités avant un calcul d’atténuation ?" ] .

<https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed1-corrige/#page> a schema:LearningResource ;
