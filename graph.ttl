<https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed2-corrige/#faq> a schema:FAQPage ;
    schema:inLanguage "fr" ;
    schema:mainEntity [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Non : l'énergie est une condition nécessaire, pas suffisante ; l'interaction a une probabilité (section efficace) qui dépend de l'énergie et de la couche, d'où une lecture statistique de l'atténuation." ] ;
            schema:name "Un photon d'énergie supérieure à l'énergie d'ionisation ionise-t-il forcément l'atome ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "La loi −13,6 Z²/n² eV décrit un système à un électron. He⁺ en possède un ; He neutre en possède deux et les interactions électroniques empêchent d’utiliser directement cette formule pour sa première ionisation." ] ;
            schema:name "Pourquoi distinguer He et He⁺ dans un modèle hydrogénoïde ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "La création de paires, nulle sous 1,022 MeV, croît avec l'énergie et avec Z² ; dans le plomb (Z = 82) elle devient dominante et rend un faisceau de 100 MeV moins pénétrant qu'un faisceau de quelques MeV." ] ;
            schema:name "Pourquoi le coefficient d'atténuation massique du plomb remonte-t-il au-delà de quelques MeV ?" ] .

<https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed2-corrige/#lexique> a schema:DefinedTermSet ;
    schema:hasDefinedTerm [ a schema:DefinedTerm ;
            schema:description "Électron éjecté à la place du photon de fluorescence : après une lacune K comblée par un électron L, Ec = (WK − WL) − WL si l'électron éjecté vient aussi de L." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed2-corrige/#lexique" ;
            schema:name "Électron Auger" ],
        [ a schema:DefinedTerm ;
            schema:description "Séance d'exercices en petit groupe qui suit le cours magistral ; l'équivalent des TD (travaux dirigés)." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed2-corrige/#lexique" ;
            schema:name "ED (exercices dirigés)" ],
        [ a schema:DefinedTerm ;
            schema:description "Atome ou ion réduit à un seul électron (H, He⁺, Li²⁺…) : la formule En = −13,6 Z²/n² eV y vaut sans constante d'écran." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed2-corrige/#lexique" ;
            schema:name "Atome hydrogénoïde" ],
        [ a schema:DefinedTerm ;
            schema:description "Au plus 2n² électrons sur la couche n : 2 sur K, 8 sur L (exercice 4)." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed2-corrige/#lexique" ;
            schema:name "Principe d'exclusion de Pauli" ],
        [ a schema:DefinedTerm ;
            schema:description "Les trois interactions des photons : absorption totale par un électron lié (domine à basse énergie et grand Z), diffusion sur un électron peu lié, puis, au-delà de 1,022 MeV, transformation en électron et positon près d'un noyau." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed2-corrige/#lexique" ;
            schema:name "Effet photoélectrique, effet Compton, création de paires" ],
        [ a schema:DefinedTerm ;
            schema:description "Parcours d'accès spécifique santé : l'une des voies de première année vers les études de santé." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed2-corrige/#lexique" ;
            schema:name "PASS" ],
        [ a schema:DefinedTerm ;
            schema:description "Raies de l'hydrogène qui finissent sur n = 1 (Lyman, dans l'UV) ou sur n = 2 (Balmer, dont plusieurs dans le visible)." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed2-corrige/#lexique" ;
            schema:name "Séries de Lyman, de Balmer" ],
        [ a schema:DefinedTerm ;
            schema:description "Ultraviolet (10 à 380 nm), visible (380 à 780 nm), infrarouge (au-delà), bornes de la diapositive 28 du cours." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed2-corrige/#lexique" ;
            schema:name "UV, visible, IR" ],
        [ a schema:DefinedTerm ;
            schema:description "Tube à rayons X. La filtration, une fine couche de métal en sortie, retire les photons de basse énergie : le faisceau durcit et le patient reçoit moins de dose inutile." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed2-corrige/#lexique" ;
            schema:name "Tube RX ; filtration" ],
        [ a schema:DefinedTerm ;
            schema:description "Correction de la charge du noyau vue par un électron, masquée par les autres ; on la suppose nulle dans les exercices 6 et suivants." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed2-corrige/#lexique" ;
            schema:name "Constante d'écran b" ],
        [ a schema:DefinedTerm ;
            schema:description "Électron-volt, 1 eV = 1,6·10⁻¹⁹ J ; 1 keV = 10³ eV, 1 MeV = 10⁶ eV." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed2-corrige/#lexique" ;
            schema:name "eV, keV, MeV" ],
        [ a schema:DefinedTerm ;
            schema:description "Place laissée vide sur une couche après une ionisation ; un électron d'une couche plus éloignée vient la combler." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed2-corrige/#lexique" ;
            schema:name "Lacune" ],
        [ a schema:DefinedTerm ;
            schema:description "Différence de potentiel, ou tension U, entre la cathode et l'anode du tube ; i : courant d'électrons. U fixe l'énergie maximale des photons, i leur nombre." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed2-corrige/#lexique" ;
            schema:name "d.d.p. ; U, i" ],
        [ a schema:DefinedTerm ;
            schema:description "Photon émis quand un électron comble une lacune ; son énergie est l'écart entre les deux niveaux." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed2-corrige/#lexique" ;
            schema:name "Photon de fluorescence" ],
        [ a schema:DefinedTerm ;
            schema:description "Wn = −En : l'énergie à fournir pour arracher l'électron (ionisation). Une énergie égale à un écart entre couches le fait seulement monter d'une couche (excitation)." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed2-corrige/#lexique" ;
            schema:name "Énergie de liaison W, ionisation, excitation" ],
        [ a schema:DefinedTerm ;
            schema:description "Z : numéro atomique (nombre de protons du noyau). n : nombre quantique principal, le numéro de la couche (1 pour K, 2 pour L, 3 pour M, 4 pour N)." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed2-corrige/#lexique" ;
            schema:name "Z, n" ],
        [ a schema:DefinedTerm ;
            schema:description "Coefficients d'atténuation linéique (cm⁻¹) et massique (cm²/g) ; CDA, couche de demi-atténuation, = ln 2/μ." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed2-corrige/#lexique" ;
            schema:name "μ, μ/ρ ; CDA" ] ;
    schema:inLanguage "fr" ;
    schema:name "Les mots de la séance" .

<https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed2-corrige/#page> a schema:LearningResource ;
    schema:about <https://www.cyrilvoyant.com/ontology/#attenuation>,
        <https://www.cyrilvoyant.com/ontology/#half-value-layer> ;
    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:description "Neuf exercices corrigés pas à pas : niveaux d'énergie, absorption et émission, rayons X, atténuation et couche de demi-atténuation, avec l'énoncé en PDF." ;
    schema:inLanguage "fr" ;
    schema:isPartOf <https://www.cyrilvoyant.com/#website> ;
    schema:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema:mentions <https://www.cyrilvoyant.com/ontology/#compton-effect>,
        <https://www.cyrilvoyant.com/ontology/#cross-section> ;
    schema:name "Exercices dirigés 2 : les ondes électromagnétiques, corrigé" ;
    schema:publisher <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:url "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed2-corrige/" .

<https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#faq> a schema:FAQPage ;
    schema:inLanguage "fr" ;
    schema:mainEntity [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Dans l’approximation F = KiZU², à matériau et coefficient K inchangés, doubler U et diviser i par quatre conserve F. L’énergie maximale double ; le spectre et le rendement changent aussi. La proportionnalité du nombre de photons au courant vaut à tension et durée fixées." ] ;
            schema:name "Comment doubler l’énergie maximale sans changer la puissance rayonnée du tube ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "À basse énergie l'effet photoélectrique domine, en Z³/E³ : le calcium de l'os absorbe beaucoup plus que les tissus mous. À haute énergie l'effet Compton domine, qui dépend surtout de la densité électronique, presque identique d'un tissu à l'autre." ] ;
            schema:name "Pourquoi l'os est-il si contrasté à basse tension et beaucoup moins à haute tension ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "La conservation de l'énergie et de la quantité de mouvement impose un photon diffusé ; l'énergie transférée est maximale en rétrodiffusion, E_c,max = E₀ · 2α/(1 + 2α) avec α = E₀/(m_e c²), toujours inférieure à E₀." ] ;
            schema:name "Pourquoi l'électron Compton n'emporte-t-il jamais toute l'énergie du photon ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Les photons de basse énergie sont absorbés dans les premiers centimètres de tissu : ils irradient le patient sans contribuer à l'image. La filtration les retire et durcit le faisceau, au prix d'une légère perte de contraste." ] ;
            schema:name "Pourquoi filtrer le faisceau à la sortie du tube ?" ] .

<https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique> a schema:DefinedTermSet ;
    schema:hasDefinedTerm [ a schema:DefinedTerm ;
            schema:description "Coefficient d'atténuation linéique (m⁻¹) et coefficient massique (m²/kg), avec ρ la masse volumique ; ils dépendent du matériau et de l'énergie des photons." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "μ, μ/ρ" ],
        [ a schema:DefinedTerm ;
            schema:description "Énergie minimale à fournir pour arracher un électron de sa couche : Wn = −En." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "Énergie de liaison W" ],
        [ a schema:DefinedTerm ;
            schema:description "Le photon cède toute son énergie à un électron lié, éjecté ; probabilité en Z³/E³ environ, d'où le contraste de l'os à basse énergie." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "Effet photoélectrique" ],
        [ a schema:DefinedTerm ;
            schema:description "Unité de la tension U du tube à rayons X ; les électrons y gagnent une énergie en keV numériquement égale à U en kV." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "kV (kilovolt)" ],
        [ a schema:DefinedTerm ;
            schema:description "Une fine plaque de métal en sortie de tube retire les photons de basse énergie, qui irradient la peau sans servir à l'image ; l'énergie moyenne du faisceau augmente." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "Filtration, durcissement du faisceau" ],
        [ a schema:DefinedTerm ;
            schema:description "Traitements par rayonnements ionisants : faisceaux externes (radiothérapie) ou sources radioactives placées au contact de la tumeur (curiethérapie)." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "Radiothérapie, curiethérapie" ],
        [ a schema:DefinedTerm ;
            schema:description "Imagerie X en coupes : la source tourne autour du patient, un anneau de détecteurs mesure l'atténuation sous de nombreux angles, et l'ordinateur reconstruit μ en chaque point. Scanner hélicoïdal : la table avance pendant la rotation." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "TDM (tomodensitométrie), scanner X" ],
        [ a schema:DefinedTerm ;
            schema:description "Une onde EM propage un champ électrique E et un champ magnétique B, perpendiculaires entre eux et à la direction de propagation." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "EM (électromagnétique)" ],
        [ a schema:DefinedTerm ;
            schema:description "Image de projection sur un récepteur (film ou capteur) ; en radioscopie, l'image est suivie en temps réel." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "Radiologie conventionnelle, radioscopie" ],
        [ a schema:DefinedTerm ;
            schema:description "Électron-volt : l'énergie gagnée par un électron sous une différence de potentiel de 1 volt, 1 eV = 1,6·10⁻¹⁹ J ; 1 keV = 10³ eV, 1 MeV = 10⁶ eV." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "eV, keV, MeV" ],
        [ a schema:DefinedTerm ;
            schema:description "Z : numéro atomique (nombre de protons) ; A : nombre de masse. b corrige la charge du noyau vue par un électron, masquée par les autres électrons." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "Z, A ; constante d'écran b" ],
        [ a schema:DefinedTerm ;
            schema:description "Ici, unité de chaleur (heat unit) qui mesure l'échauffement de l'anode du tube. À ne pas confondre avec les UH du scanner, que l'anglais note aussi HU (Hounsfield units)." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "HU sur la diapositive 103" ],
        [ a schema:DefinedTerm ;
            schema:description "Analyse du rayonnement émis ou absorbé par des atomes ou des molécules ; chaque élément a ses raies (séries de Lyman dans l'UV, de Balmer dans le visible pour l'hydrogène)." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "Spectroscopie" ],
        [ a schema:DefinedTerm ;
            schema:description "Gray : dose absorbée, 1 Gy = 1 J/kg. Sievert : dose équivalente ou efficace, qui pondère la dose selon le rayonnement et l'organe (diapositive 103)." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "Gy (gray), Sv (sievert)" ],
        [ a schema:DefinedTerm ;
            schema:description "Ultraviolet (10 à 380 nm sur la diapositive 28) et infrarouge (au-delà de 780 nm), de part et d'autre de la lumière visible." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "UV, IR" ],
        [ a schema:DefinedTerm ;
            schema:description "Ionisation : l'électron est éjecté de l'atome. Excitation : il passe sur une couche plus éloignée et l'atome reste entier." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "Ionisation, excitation" ],
        [ a schema:DefinedTerm ;
            schema:description "PASS : parcours d'accès spécifique santé, l'une des voies de première année vers les études de santé (médecine, maïeutique, odontologie, pharmacie). PACES : première année commune aux études de santé, qui l'a précédée (le support porte encore les deux noms)." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "PASS, PACES" ],
        [ a schema:DefinedTerm ;
            schema:description "Mesure de l'oxygénation du sang par la lumière transmise à 660 nm (rouge) et 990 nm (IR) : la désoxyhémoglobine Hb absorbe surtout dans le rouge, l'oxyhémoglobine HbO2 dans l'infrarouge." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "Oxymétrie de pouls ; Hb, HbO2" ],
        [ a schema:DefinedTerm ;
            schema:description "Le photon cède une partie de son énergie à un électron peu lié et repart dévié ; il dépend surtout du nombre d'électrons par unité de volume, peu de Z." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "Effet Compton" ],
        [ a schema:DefinedTerm ;
            schema:description "ν en hertz (Hz, oscillations par seconde) ; T = 1/ν en secondes ; ω = 2πν en radians par seconde." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "Fréquence ν, période T, pulsation ω" ],
        [ a schema:DefinedTerm ;
            schema:description "Photons émis par un électron dévié près d'un noyau : spectre continu, jusqu'à l'énergie maximale eU, soit λmin = hc/(eU)." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "Rayonnement de freinage (Bremsstrahlung)" ],
        [ a schema:DefinedTerm ;
            schema:description "Le grain d'énergie associé à l'onde EM, de masse nulle : E = hν = hc/λ, avec h la constante de Planck." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "Photon" ],
        [ a schema:DefinedTerm ;
            schema:description "Noircissement d'un film radiographique, mesuré par le logarithme décimal du rapport de la lumière incidente à la lumière transmise." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "DO (densité optique)" ],
        [ a schema:DefinedTerm ;
            schema:description "Au-delà de 2 mec² = 1,022 MeV, près d'un noyau, le photon devient un électron et un positon (l'antiparticule de l'électron) ; le positon s'annihile ensuite avec un électron en deux photons de 0,511 MeV." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "Création de paires (matérialisation), positon, annihilation" ],
        [ a schema:DefinedTerm ;
            schema:description "p = h/λ : toute particule de quantité de mouvement p a une onde associée, et inversement." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "Relation de de Broglie" ],
        [ a schema:DefinedTerm ;
            schema:description "Imageries fonctionnelles : un traceur radioactif injecté émet des rayons γ (scintigraphie) ou des positons, détectés par leurs deux photons d'annihilation (TEP)." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "Scintigraphie, TEP (tomographie par émission de positons ; PET en anglais)" ],
        [ a schema:DefinedTerm ;
            schema:description "Source de rayons X : un filament chauffé (cathode) émet des électrons, accélérés par la tension U vers une cible métallique (anode), où ils produisent les rayons X." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "Tube de Coolidge (tube radiogène)" ],
        [ a schema:DefinedTerm ;
            schema:description "Imagerie qui utilise des ondes radio dans un champ magnétique intense, sans rayons X ; c'est l'application médicale des grandes longueurs d'onde citée sur la diapositive 27." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "IRM (imagerie par résonance magnétique)" ],
        [ a schema:DefinedTerm ;
            schema:description "Échelle du scanner, UH = 1000 (μ − μeau)/μeau : eau 0, air −1000, graisse environ −100, poumon environ −700, tissus mous +40 à +80, os de +400 à +1000 (diapositive 107)." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "UH (unités Hounsfield)" ],
        [ a schema:DefinedTerm ;
            schema:description "Même nature et mêmes énergies possibles ; les rayons X ont une origine atomique (ou viennent d'électrons freinés), les rayons γ une origine nucléaire." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "Rayons X, rayons γ (gamma)" ],
        [ a schema:DefinedTerm ;
            schema:description "Épaisseur qui divise par deux le nombre de photons, CDA = ln 2/μ ; 10 CDA en laissent passer environ un sur mille." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "CDA (couche de demi-atténuation)" ],
        [ a schema:DefinedTerm ;
            schema:description "Les niveaux d'énergie des électrons de l'atome, n = 1 (K), 2 (L), 3 (M)… ; au plus 2n² électrons par couche (principe d'exclusion de Pauli)." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "Couches K, L, M ; nombre quantique n" ],
        [ a schema:DefinedTerm ;
            schema:description "Pixel : point de l'image affichée. Voxel : petit volume de tissu qu'il représente, dont l'épaisseur est celle de la coupe." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "Pixel, voxel" ],
        [ a schema:DefinedTerm ;
            schema:description "Après une lacune, l'atome se réorganise : soit il émet un photon de fluorescence, soit il éjecte un électron Auger, d'énergie Ec = (Wi − Wj) − Wx." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "Fluorescence, électron Auger" ],
        [ a schema:DefinedTerm ;
            schema:description "λ = c/ν, distance parcourue pendant une période ; k = 2π/λ, en radians par mètre." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "Longueur d'onde λ, nombre d'onde k" ],
        [ a schema:DefinedTerm ;
            schema:description "Choix d'une plage d'UH étalée sur les niveaux de gris de l'écran, pour distinguer des tissus voisins (poumon, tissus mous, os)." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#lexique" ;
            schema:name "Fenêtrage" ] ;
    schema:inLanguage "fr" ;
    schema:name "Les mots du cours" .

