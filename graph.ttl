<https://www.cyrilvoyant.com/latest-publications-and-news/forecasting-with-less#page> a schema:Article ;
    schema:about <https://cyrilvoyant.github.io/approach.html#principle-2> ;
    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:description "Accounting for daily phase improves persistence forecasts on the solar series studied, with differences widening at longer lead times. In our Applied Mathematical Modelling paper, BLEND supplies this baseline directly from raw irradiance, without normalising observations by an external clear-sky…" ;
    schema:inLanguage "en" ;
    schema:isPartOf <https://www.cyrilvoyant.com/#website> ;
    schema:keywords "Energy",
        "Hybridize" ;
    schema:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema:name "BLEND: a better persistence forecast without training a neural network" ;
    schema:publisher <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:url "https://www.cyrilvoyant.com/latest-publications-and-news/forecasting-with-less/" ;
    schema:workTranslation <https://www.cyrilvoyant.com/fr/actualites/forecasting-with-less#page> .

<https://www.cyrilvoyant.com/latest-publications-and-news/forecasting-with-less/> a schema:WebPage ;
