[] a schema:DefinedTermSet ;
    schema:hasDefinedTerm [ a schema:DefinedTerm ;
            schema:description "ROC (receiver operating characteristic) curve: a test's sensitivity against its false-positive rate." ;
            schema:name "ROC" ],
        [ a schema:DefinedTerm ;
            schema:description "Boron neutron capture therapy." ;
            schema:name "BNCT" ],
        [ a schema:DefinedTerm ;
            schema:description "Two mixes of simple references: persistence with the value one cycle earlier (BLEND), or with the mean (CLIPER)." ;
            schema:name "BLEND, CLIPER" ],
        [ a schema:DefinedTerm ;
            schema:description "Linear-quadratic and linear-quadratic-linear models of the effect of a radiation dose on tissue." ;
            schema:name "LQ, LQL" ],
        [ a schema:DefinedTerm ;
            schema:description "A numerical computing language and environment." ;
            schema:name "MATLAB" ],
        [ a schema:DefinedTerm ;
            schema:description "The French first-year health program; teaching unit; French bachelor of technology." ;
            schema:name "PASS, UE, B.U.T." ],
        [ a schema:DefinedTerm ;
            schema:description "Cloud-driven variability and the forecastability of a signal, computed before any model." ;
            schema:name "sCV, F" ],
        [ a schema:DefinedTerm ;
            schema:description "Creative Commons Attribution license: free reuse, provided the authors are credited." ;
            schema:name "CC BY 4.0" ],
        [ a schema:DefinedTerm ;
            schema:description "Seven criteria: rigor, transparency, visibility, adoption, collaboration, outreach, societal relevance." ;
            schema:name "RTVACOS" ],
        [ a schema:DefinedTerm ;
            schema:description "Extreme learning machine: a one-hidden-layer neural network with random input weights; only the output weights are computed." ;
            schema:name "ELM" ],
        [ a schema:DefinedTerm ;
            schema:description "A test that accepts small shifts in space, time and intensity." ;
            schema:name "Indice γ / γ-index" ],
        [ a schema:DefinedTerm ;
            schema:description "Multiple inputs, multiple outputs: one model forecasts several signals." ;
            schema:name "MIMO" ],
        [ a schema:DefinedTerm ;
            schema:description "A forecast's error divided by that of persistence; between 0 and 1, the forecast adds something." ;
            schema:name "NICE" ],
        [ a schema:DefinedTerm ;
            schema:description "Permanent identifier of a paper or archived software: the link stays valid even if the website changes." ;
            schema:name "DOI" ],
        [ a schema:DefinedTerm ;
            schema:description "Photovoltaic; Électricité de France, the French utility." ;
            schema:name "PV, EDF" ],
        [ a schema:DefinedTerm ;
            schema:description "The forecast copies the last known value; it is the reference to beat." ;
            schema:name "Persistance / persistence" ],
        [ a schema:DefinedTerm ;
            schema:description "The European Union regulation on artificial intelligence." ;
            schema:name "AI Act" ] ;
    schema:inLanguage "en" ;
    schema:name "Words used on this page" .

