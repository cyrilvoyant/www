            schema:position 11 ],
        [ a schema:ListItem ;
            schema:item [ a schema:BlogPosting ;
                    schema:abstract "La RMSE (racine de l'erreur quadratique moyenne), la MAE (erreur absolue moyenne) et les scores de compétence ne saisissent pas toute la qualité d'une prévision solaire. Les métriques NICEᵏ rapportent les erreurs à celles d'une référence explicite, la persistance (qui recopie la dernière valeur connue)." ;
                    schema:author [ a schema:Person ;
                            schema:name "Milan Despotovic" ;
                            schema:sameAs "https://orcid.org/0000-0003-3144-5945" ],
