<https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/vapeur-d-eau/#faq> a schema:FAQPage ;
    schema:inLanguage "fr" ;
    schema:mainEntity [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "C'est le rapport des masses molaires de l'eau et de l'air sec, 18,0/28,96 : il convertit un rapport de pressions partielles en rapport de masses." ] ;
            schema:name "D'où vient le coefficient 0,622 ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Sur une surface froide sous 0 °C, de la vapeur peut se déposer en glace ou des gouttelettes se condenser puis geler. Le dépôt ajoute une résistance thermique et perturbe l’écoulement de l’air ; l’humidité entrante joue donc sur le besoin de dégivrage." ] ;
            schema:name "Pourquoi un évaporateur peut-il givrer ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "À pression et rapport de mélange approximativement constants, la baisse de température réduit la pression de saturation : HR = 100 e/es augmente. À saturation, de l’eau peut se condenser ; sous zéro, une déposition de glace est également possible." ] ;
            schema:name "Pourquoi l’humidité relative peut-elle monter la nuit sans apport d’eau ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Elle permet de transporter beaucoup d'énergie à température constante : condenser de la vapeur chauffe fortement une paroi sans la surchauffer, ce qui explique l'usage de la vapeur en cuisson et en stérilisation, et des fluides diphasiques en froid." ] ;
            schema:name "Pourquoi la chaleur latente intéresse-t-elle autant les procédés ?" ] .

<https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/vapeur-d-eau/#page> a schema:LearningResource ;
    schema:about <https://www.cyrilvoyant.com/ontology/#latent-heat> ;
