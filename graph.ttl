                    schema:inLanguage "en" ;
                    schema:url "https://www.cyrilvoyant.com/latest-publications-and-news/why-forecast-solar-power/" ] ;
            schema:position 20 ],
        [ a schema:ListItem ;
            schema:item [ a schema:BlogPosting ;
                    schema:abstract "This work revisits persistence forecasting (repeating the last observation) for periodically varying statistics, including the daily cycle of solar irradiance. BLEND combines the latest observation with an observation aligned to the target phase of the cycle." ;
                    schema:author [ a schema:Person ;
                            schema:name "Milan Despotovic" ;
                            schema:sameAs "https://orcid.org/0000-0003-3144-5945" ],
                        [ a schema:Person ;
