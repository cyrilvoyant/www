[] a schema:ScholarlyArticle ;
    schema:about [ a schema:DefinedTerm ;
            schema:description "Foundation" ;
            schema:name "Rigor (R)" ],
        [ a schema:DefinedTerm ;
            schema:description "Foundation" ;
            schema:name "Visibility (V)" ],
        [ a schema:DefinedTerm ;
            schema:description "Amplifier" ;
            schema:name "Collaboration (C)" ],
        [ a schema:DefinedTerm ;
            schema:description "Foundation" ;
            schema:name "Adoption potential (A)" ],
        [ a schema:DefinedTerm ;
            schema:description "Equation 1 of the preprint. E: research excellence operationalized as impact capacity; R Rigor, T Transparency, V Visibility, A Adoption potential (foundations); C Collaboration, O Outreach, S Societal relevance (amplifiers). Proportionality, not equality: a heuristic for reflection, not a score; no empirical validation yet." ;
            schema:name "RTVACOS framework equation" ;
            schema:termCode "E ∝ (R × T × V × A) × (1 + C + O + S)" ],
        [ a schema:DefinedTerm ;
            schema:description "Foundation" ;
            schema:name "Transparency (T)" ],
        [ a schema:DefinedTerm ;
            schema:description "Amplifier" ;
            schema:name "Societal relevance (S)" ],
        [ a schema:DefinedTerm ;
            schema:description "Amplifier" ;
            schema:name "Outreach (O)" ] ;
    schema:author [ a schema:Person ;
            schema:name "Nicolas Fichaux" ;
            schema:sameAs "https://orcid.org/0009-0008-2824-0387" ],
        [ a schema:Person ;
            schema:name "Rodrigo Amaro e Silva" ;
            schema:sameAs "https://orcid.org/0000-0002-2813-150X" ],
        [ a schema:Person ;
            schema:name "Lionel Ménard" ;
            schema:sameAs "https://orcid.org/0009-0002-2156-8538" ],
        [ a schema:Person ;
            schema:name "Sylvain Cros" ;
            schema:sameAs "https://orcid.org/0000-0002-7702-2123" ],
        [ a schema:Person ;
            schema:name "Rodanthi-Elisavet Mamouri" ;
            schema:sameAs "https://orcid.org/0000-0003-4836-8560" ],
        <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:datePublished "2026" ;
    schema:description "Research excellence modeled as a multiplicative system, E ∝ (R × T × V × A) × (1 + C + O + S): four foundations (Rigor, Transparency, Visibility, Adoption potential) whose product collapses if any one approaches zero, and three amplifiers (Collaboration, Outreach, Societal relevance) that scale a solid foundation. A tool for reflection, not for ranking." ;
    schema:identifier "doi:10.2139/ssrn.6877118" ;
    schema:name "Beyond Publish and Pray: Engineering Research Excellence" ;
    schema:teaches "E ∝ (R × T × V × A) × (1 + C + O + S)" ;
    schema:url "https://doi.org/10.2139/ssrn.6877118" .

