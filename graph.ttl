                        <https://person.cyrilvoyant.com/#cyril-voyant> ;
                    schema:datePublished "2026-04-24" ;
                    schema:headline "Revisiting Persistence: Symmetry-Constrained Forecasting of Periodically Correlated Energy Processes" ;
                    schema:image "https://www.cyrilvoyant.com/assets/img/e8e0bf76adbb.jpg" ;
                    schema:inLanguage "en" ;
                    schema:url "https://www.cyrilvoyant.com/latest-publications-and-news/forecasting-with-less/" ] ;
            schema:position 6 ],
        [ a schema:ListItem ;
            schema:item [ a schema:BlogPosting ;
                    schema:abstract "Accurate solar energy output prediction is fundamental to integrating renewable energy sources into electrical grids, maintaining system stability, and enabling effective energy management. However, conventional error metrics—such as Root Mean Squared Error (RMSE), Mean Absolute Error (MAE), and Skill Scores (SS)—fail to capture the multidimensional complexity of solar irradiance forecasting. These metrics lack sensitivity to forecastability, rely on arbitrary baselines (e.g., clear-sky models)," ;
                    schema:author [ a schema:Person ;
                            schema:name "Ted Soubdhan" ;
                            schema:sameAs "https://orcid.org/0000-0002-6402-8438" ],
                        [ a schema:Person ;
                            schema:name "Milan Despotovic" ;
                            schema:sameAs "https://orcid.org/0000-0003-3144-5945" ],
                        [ a schema:Person ;
                            schema:name "Philippe Lauret" ;
                            schema:sameAs "https://orcid.org/0000-0003-2959-6146" ],
                        [ a schema:Person ;
