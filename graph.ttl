[] a schema:ItemList ;
    schema:itemListElement [ a schema:ListItem ;
            schema:item [ a schema:Course ;
                    schema:description "Probabilities and Bayesian reasoning, diagnostic tests (sensitivity, specificity, ROC curves: receiver operating characteristic, the share of sick people detected against the share of healthy people wrongly flagged as the threshold varies), descriptive statistics, the normal distribution and hypothesis tests, correlation, linear regression and χ² tests, with medical examples." ;
                    schema:hasPart [ a schema:CreativeWork ;
                            schema:name "Descriptive statistics, the normal distribution and hypothesis tests" ;
                            schema:url "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/statistiques-descriptives/" ],
                        [ a schema:CreativeWork ;
                            schema:name "Correlation, linear regression and χ² tests" ;
                            schema:url "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/correlation-regression/" ],
                        [ a schema:CreativeWork ;
                            schema:name "Probabilities, conditional probabilities, contingency tables and ROC curves" ;
                            schema:url "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/probabilites/" ] ;
                    schema:inLanguage "fr" ;
                    schema:license "https://creativecommons.org/licenses/by/4.0/" ;
                    schema:name "Biostatistics for health studies" ;
                    schema:provider <https://person.cyrilvoyant.com/#cyril-voyant> ;
                    schema:url "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/" ] ;
            schema:position 1 ],
        [ a schema:ListItem ;
            schema:item [ a schema:Course ;
                    schema:description "Conduction, convection and the Biot number, thermal properties of foods, refrigeration power and the amount of water to freeze, then the energy balance of cooling or freezing a product." ;
                    schema:hasPart [ a schema:CreativeWork ;
                            schema:name "Lecture: heat transfer, cooling and freezing of foods" ;
                            schema:url "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours/" ] ;
                    schema:inLanguage "fr" ;
                    schema:license "https://creativecommons.org/licenses/by/4.0/" ;
                    schema:name "Heat transfer for food engineering: cooling and freezing" ;
                    schema:provider <https://person.cyrilvoyant.com/#cyril-voyant> ;
                    schema:url "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/" ] ;
            schema:position 4 ],
        [ a schema:ListItem ;
            schema:item [ a schema:Course ;
                    schema:description "The nature of electromagnetic waves and of the photon, the energy levels of the atom, absorption, emission and spectroscopy (up to pulse oximetry), the production of X-rays, their interactions with matter and attenuation, then radiography and computed tomography (CT) scanning; two corrected exercise sessions." ;
                    schema:hasPart [ a schema:CreativeWork ;
                            schema:name "Exercise session 1, corrected" ;
                            schema:url "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed1-corrige/" ],
                        [ a schema:CreativeWork ;
                            schema:name "Exercise session 2, corrected" ;
                            schema:url "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed2-corrige/" ],
                        [ a schema:CreativeWork ;
                            schema:name "Course: electromagnetic waves and the physical bases of imaging" ;
                            schema:url "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/" ] ;
                    schema:inLanguage "fr" ;
                    schema:license "https://creativecommons.org/licenses/by/4.0/" ;
                    schema:name "Physics for health studies: electromagnetic waves, X-rays and imaging" ;
                    schema:provider <https://person.cyrilvoyant.com/#cyril-voyant> ;
                    schema:url "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/" ] ;
            schema:position 2 ],
        [ a schema:ListItem ;
            schema:item [ a schema:Course ;
                    schema:description "Quantities and changes of state, ideal and real gases, Clapeyron, entropy and Mollier diagrams, water vapor and humidity, engine cycles, then the refrigeration cycle, its coefficient of performance and its refrigerants; with the handouts." ;
