[] a ns1:ItemList ;
    ns1:inLanguage "en" ;
    ns1:itemListElement [ a ns1:ListItem ;
            ns1:description "The link between inputs and outputs is known: a physical law, a published and validated model. When no measurements exist, simulate from what is known." ;
            ns1:name "Compute directly" ;
            ns1:position 1 ;
            ns1:url "https://www.cyrilvoyant.com/stories/lql-equiv/" ],
        [ a ns1:ListItem ;
            ns1:description "An explicit model exists but does not explain everything: keep it, and let learning estimate only what is missing." ;
            ns1:name "Hybridize" ;
            ns1:position 2 ;
            ns1:url "https://www.cyrilvoyant.com/stories/thyroid-radioiodine/" ],
        [ a ns1:ListItem ;
            ns1:description "At every step, before any use: evaluate against an explicit reference, publish code, data and limits." ;
            ns1:name "Demonstrate trust" ;
            ns1:position 5 ;
            ns1:url "https://www.cyrilvoyant.com/latest-publications-and-news/nice-forecast-evaluation/" ],
        [ a ns1:ListItem ;
            ns1:description "Deep networks, only if they beat frugal learning under the same protocol. Language models, to read a request written in plain language, never to compute." ;
            ns1:name "AI in its place" ;
            ns1:position 4 ;
            ns1:url "https://www.cyrilvoyant.com/stories/websemantic/" ],
        [ a ns1:ListItem ;
            ns1:description "The useful relations are not known well enough, but data exist. Start with the lightest tool that does the job, such as an ELM (extreme learning machine: a small neural network whose output weights alone are fitted)." ;
            ns1:name "Learn frugally" ;
            ns1:position 3 ;
            ns1:url "https://www.cyrilvoyant.com/latest-publications-and-news/why-extreme-learning-machines/" ] ;
    ns1:itemListOrder "https://schema.org/ItemListOrderAscending" ;
    ns1:name "The complexity ladder, step by step" .

