<https://www.cyrilvoyant.com/teaching/biostatistics/#course> a schema:Course ;
    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:courseCode "UE8" ;
    schema:description "A biostatistics course in three chapters and 246 slides, for the first year of health studies (PASS, teaching unit UE8). The chapters are read here in English; the slides are in French. It goes from probability and Bayesian reasoning to diagnostic tests (sensitivity, specificity, ROC curves), descriptive statistics, the normal distribution and hypothesis tests, then correlation, linear regression and χ² tests, with medical examples." ;
    schema:educationalLevel "First year of health studies (PASS)" ;
    schema:hasPart <https://www.cyrilvoyant.com/teaching/biostatistics/correlation-regression/#chapter>,
        <https://www.cyrilvoyant.com/teaching/biostatistics/descriptive-statistics/#chapter>,
        <https://www.cyrilvoyant.com/teaching/biostatistics/probabilities/#chapter> ;
    schema:inLanguage "en" ;
    schema:isBasedOn <https://www.cyrilvoyant.com/fr/enseignement/biostatistique/#course> ;
    schema:license "https://creativecommons.org/licenses/by/4.0/deed.en" ;
    schema:name "Biostatistics for health studies (PASS, UE8)" ;
    schema:provider <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:teaches "Bayes' theorem",
        "Pearson correlation",
        "ROC curve",
        "Student's t-test",
        "chi-square test",
        "conditional probability",
        "confidence interval",
        "descriptive statistics",
        "hypothesis testing",
        "linear regression",
        "normal distribution",
        "probability",
        "sensitivity and specificity" .

