<https://www.cyrilvoyant.com/data/#glossary-open-source-osi> a schema:DefinedTerm ;
    schema:description "The Open Source Initiative definition: an open-source licence may not restrict any field of use; a non-commercial licence is therefore not \"open source\", even if the code is open to read." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/data/#glossary> ;
    schema:name "Open source (OSI)" .

<https://www.cyrilvoyant.com/data/#glossary-polyform-noncommercial> a schema:DefinedTerm ;
    schema:description "A software licence that allows any non-commercial use: personal use, research, experiment, teaching, and use by non-commercial organizations (educational institutions, public research, charities, government bodies). Commercial use needs another agreement with the author. The licence must travel with redistributed code." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/data/#glossary> ;
