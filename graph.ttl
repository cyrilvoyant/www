<https://www.cyrilvoyant.com/fr/enseignement/biostatistique/#course> a schema:Course ;
    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:courseCode "UE8" ;
    schema:description "Un cours de biostatistique en trois chapitres et 246 diapositives, pour la première année des études de santé (PASS, unité d'enseignement UE8). Il va des probabilités et du raisonnement bayésien aux tests diagnostiques (sensibilité, spécificité, courbes ROC), à la statistique descriptive, à la loi normale et aux tests d'hypothèses, puis à la corrélation, à la régression linéaire et aux tests du χ², avec des exemples médicaux." ;
    schema:educationalLevel "Première année des études de santé (PASS)" ;
    schema:hasPart <https://www.cyrilvoyant.com/fr/enseignement/biostatistique/correlation-regression/#chapter>,
        <https://www.cyrilvoyant.com/fr/enseignement/biostatistique/probabilites/#chapter>,
        <https://www.cyrilvoyant.com/fr/enseignement/biostatistique/statistiques-descriptives/#chapter> ;
    schema:inLanguage "fr" ;
    schema:license "https://creativecommons.org/licenses/by/4.0/deed.fr" ;
    schema:name "Biostatistique pour les études de santé (PASS, UE8)" ;
    schema:provider <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:teaches "corrélation de Pearson",
        "courbe ROC",
        "loi normale",
        "probabilités",
        "probabilités conditionnelles",
        "régression linéaire",
        "sensibilité et spécificité",
        "statistique descriptive",
        "test d'hypothèses",
        "test du χ²",
        "théorème de Bayes" .

<https://www.cyrilvoyant.com/fr/enseignement/biostatistique/probabilites/#chapter> a schema:LearningResource ;
    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
