<https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/gaz-parfaits-et-reels/#faq> a schema:FAQPage ;
    schema:inLanguage "fr" ;
    schema:mainEntity [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Seulement loin de la saturation et à basse pression ; dans un cycle frigorifique le fluide travaille justement au voisinage de la saturation, ce qui impose les diagrammes." ] ;
            schema:name "Peut-on traiter la vapeur d'un fluide frigorigène comme un gaz parfait ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Par la règle des moments : h = h_l + x (h_v − h_l), où h_l et h_v sont les enthalpies des liquide et vapeur saturés à la même pression ; le titre x se lit sur les isotitres ou se déduit d'un bilan." ] ;
            schema:name "Comment calculer l'enthalpie d'un mélange liquide-vapeur ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Les échanges au condenseur et à l'évaporateur y sont des horizontales (isobares), la détente un trait vertical (isenthalpe), et les énergies échangées se lisent directement comme des longueurs sur l'axe des enthalpies : le bilan du cycle se fait à la règle." ] ;
            schema:name "Pourquoi les frigoristes préfèrent-ils le diagramme (ln p, h) ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Près de la courbe de saturation et surtout du point critique, où les propriétés varient fortement et de façon non linéaire : il faut alors resserrer les pas de la table ou utiliser une équation d'état, plutôt que d'interpoler sur un grand intervalle." ] ;
            schema:name "Quand l'interpolation linéaire dans une table devient-elle risquée ?" ] .

<https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/gaz-parfaits-et-reels/#page> a schema:LearningResource ;
    schema:author <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:description "Le gaz parfait et ses limites, enthalpie et entropie, diagrammes de Clapeyron, entropique et de Mollier, lecture du diagramme P-h (pression-enthalpie)…" ;
    schema:inLanguage "fr" ;
    schema:isPartOf <https://www.cyrilvoyant.com/#website> ;
    schema:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema:name "Chapitre 2 : gaz parfaits, gaz réels et diagrammes" ;
    schema:publisher <https://person.cyrilvoyant.com/#cyril-voyant> ;
    schema:url "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/gaz-parfaits-et-reels/" .

<https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/notions-de-thermodynamique/#faq> a schema:FAQPage ;
    schema:inLanguage "fr" ;
    schema:mainEntity [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Les relations d'état (gaz parfaits, tables de vapeur, relation pression-température de saturation) portent sur la pression absolue ; oublier la pression atmosphérique fausse d'environ 1 bar tous les points du cycle, ce qui est énorme côté basse pression." ] ;
            schema:name "Pourquoi raisonner en pression absolue alors que les manomètres affichent une pression relative ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Elle doit être inférieure à celle du milieu à refroidir. La pression de saturation correspondante, la sécurité, l’impact environnemental et le cycle guident le choix ; bouillir sous 0 °C à pression atmosphérique n’est pas une condition universelle." ] ;
            schema:name "Quelle température d’évaporation faut-il choisir pour un fluide frigorigène ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Geler 1 kg d’eau pure demande d’extraire 334 kJ, sans que la température change (palier à 0 °C). C’est autant d’énergie que pour refroidir ce même kilo d’eau liquide d’environ 80 °C (334 ÷ 4,18 ≈ 80) : le changement d’état pèse donc lourd dans le bilan. Dans un aliment, il faut multiplier par la masse d’eau effectivement congelée et ajouter les autres échanges ; la durée dépend aussi des résistances thermiques et de la géométrie." ] ;
            schema:name "Pourquoi la chaleur latente compte-t-elle dans une congélation ?" ],
        [ a schema:Question ;
            schema:acceptedAnswer [ a schema:Answer ;
                    schema:text "Oui : un produit peut rester liquide sous sa température de congélation puis cristalliser brusquement ; la température mesurée remonte alors au palier, ce qui fausse une lecture naïve des courbes de congélation et influe sur la taille des cristaux." ] ;
            schema:name "La surfusion a-t-elle une conséquence pratique pour les aliments ?" ] .

<https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/notions-de-thermodynamique/#lexique> a schema:DefinedTermSet ;
    schema:hasDefinedTerm [ a schema:DefinedTerm ;
            schema:description "Grandeur macroscopique qui décrit l'état d'un système à l'équilibre : pression p, volume V, température T, masse m." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/notions-de-thermodynamique/#lexique" ;
            schema:name "Variable d'état" ],
        [ a schema:DefinedTerm ;
            schema:description "Fermé : n'échange pas de matière ; calorifugé : n'échange pas de chaleur ; isolé : n'échange ni matière ni énergie." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/notions-de-thermodynamique/#lexique" ;
            schema:name "Système fermé, calorifugé, isolé" ],
        [ a schema:DefinedTerm ;
            schema:description "Transformation à température constante, à pression constante, à volume constant." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/notions-de-thermodynamique/#lexique" ;
            schema:name "Isotherme, isobare, isochore" ],
        [ a schema:DefinedTerm ;
            schema:description "Unité de température absolue : T (K) = θ (°C) + 273,15. Les formules de Carnot, des gaz parfaits et de Laplace s'écrivent en kelvins." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/notions-de-thermodynamique/#lexique" ;
            schema:name "Kelvin (K)" ],
        [ a schema:DefinedTerm ;
            schema:description "Rapport des capacités thermiques à pression constante et à volume constant, γ = cp/cv ; pour un gaz parfait, 5/3 s'il est monoatomique et 7/5 = 1,4 s'il est diatomique (l'air, en bonne approximation)." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/notions-de-thermodynamique/#lexique" ;
            schema:name "γ (indice adiabatique)" ],
        [ a schema:DefinedTerm ;
            schema:description "Énergie à fournir pour élever de 1 °C la température de 1 kg d'un corps sans changer d'état (eau liquide : environ 4186 J·kg⁻¹·°C⁻¹)." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/notions-de-thermodynamique/#lexique" ;
            schema:name "Capacité thermique massique c" ],
        [ a schema:DefinedTerm ;
            schema:description "Bachelor universitaire de technologie : diplôme en trois ans préparé dans un IUT (institut universitaire de technologie)." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/notions-de-thermodynamique/#lexique" ;
            schema:name "B.U.T." ],
        [ a schema:DefinedTerm ;
            schema:description "La pression relative se mesure à partir de la pression atmosphérique (c'est ce qu'affiche un manomètre) ; pabs = prel + patm. Les lois des gaz et les tables s'écrivent en pression absolue." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/notions-de-thermodynamique/#lexique" ;
            schema:name "Pression absolue, pression relative" ],
        [ a schema:DefinedTerm ;
            schema:description "Pression à laquelle liquide et vapeur d'un corps pur coexistent à une température donnée ; elle croît avec la température." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/notions-de-thermodynamique/#lexique" ;
            schema:name "Pression de vapeur saturante" ],
        [ a schema:DefinedTerm ;
            schema:description "Énergie microscopique stockée dans le système (agitation et interactions des molécules) ; premier principe : ΔU = Q + W." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/notions-de-thermodynamique/#lexique" ;
            schema:name "Énergie interne U" ],
        [ a schema:DefinedTerm ;
            schema:description "Sensible : fait varier la température sans changement d'état (Q = m c ΔT). Latente : accompagne un changement d'état à température constante (Q = m L)." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/notions-de-thermodynamique/#lexique" ;
            schema:name "Chaleur sensible, chaleur latente" ],
        [ a schema:DefinedTerm ;
            schema:description "Transformation sans échange de chaleur avec l'extérieur. Réversible et pour un gaz parfait, elle suit la loi de Laplace p Vγ = constante." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/notions-de-thermodynamique/#lexique" ;
            schema:name "Adiabatique" ],
        [ a schema:DefinedTerm ;
            schema:description "Point triple : solide, liquide et vapeur coexistent. Point critique : au-delà de sa température et de sa pression, liquide et vapeur ne se distinguent plus (fluide supercritique)." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/notions-de-thermodynamique/#lexique" ;
            schema:name "Point triple, point critique" ],
        [ a schema:DefinedTerm ;
            schema:description "État d'un liquide maintenu sous sa température de solidification ; une agitation peut la faire cesser brusquement." ;
            schema:inDefinedTermSet "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/notions-de-thermodynamique/#lexique" ;
            schema:name "Surfusion" ] ;
    schema:inLanguage "fr" ;
    schema:name "Les mots du chapitre" .

<https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/notions-de-thermodynamique/#page> a schema:LearningResource ;
    schema:about <https://www.cyrilvoyant.com/ontology/#freezing>,
        <https://www.cyrilvoyant.com/ontology/#latent-heat>,
