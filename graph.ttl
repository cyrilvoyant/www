[] a schema:LearningResource ;
    schema:inLanguage "fr" ;
    schema:isBasedOn <https://doi.org/10.1016/j.energy.2015.07.089>,
        <https://doi.org/10.1016/j.renene.2025.123913>,
        <https://doi.org/10.1016/j.seta.2025.104588>,
        <https://doi.org/10.1016/j.solener.2025.113821> ;
    schema:learningResourceType "interactive experiment" ;
    schema:name "Quelle prévision pour quel signal ?" ;
    schema:teaches "forecastability",
        "model reference comparison",
        "temporal ordering",
        "training and test separation",
        "variability" ;
    schema:url "https://www.cyrilvoyant.com/fr/recits/variabilite-memoire-previsibilite/#experience" .

[] a ns1:ItemList ;
    ns1:inLanguage "fr" ;
    ns1:itemListElement [ a ns1:ListItem ;
            ns1:description "Un modèle explicite existe mais n'explique pas tout : on le garde, et l'apprentissage n'estime que ce qui manque." ;
            ns1:name "Hybrider" ;
            ns1:position 2 ;
            ns1:url "https://www.cyrilvoyant.com/fr/recits/thyroid-radioiodine/" ],
        [ a ns1:ListItem ;
            ns1:description "Le lien entre les entrées et les sorties est connu : une loi physique, un modèle publié et validé. Quand aucune mesure n'existe, on simule à partir de ce que l'on sait." ;
            ns1:name "Calculer directement" ;
            ns1:position 1 ;
            ns1:url "https://www.cyrilvoyant.com/fr/recits/lql-equiv/" ],
        [ a ns1:ListItem ;
            ns1:description "Les réseaux profonds, seulement s'ils battent l'apprentissage frugal sur le même protocole. Les modèles de langage, pour lire une demande en langage courant, jamais pour calculer." ;
            ns1:name "L'IA à sa place" ;
            ns1:position 4 ;
            ns1:url "https://www.cyrilvoyant.com/fr/recits/websemantic/" ],
        [ a ns1:ListItem ;
            ns1:description "À chaque marche, avant tout usage : évaluer contre une référence explicite, publier le code, les données et les limites." ;
            ns1:name "Démontrer la confiance" ;
            ns1:position 5 ;
            ns1:url "https://www.cyrilvoyant.com/fr/actualites/nice-forecast-evaluation/" ],
        [ a ns1:ListItem ;
            ns1:description "Les relations utiles sont mal connues, mais des données existent. On commence par l'outil le plus léger qui suffit, par exemple une ELM (machine à apprentissage extrême : un petit réseau de neurones dont seuls les poids de sortie sont ajustés)." ;
            ns1:name "Apprendre frugalement" ;
            ns1:position 3 ;
            ns1:url "https://www.cyrilvoyant.com/fr/actualites/why-extreme-learning-machines/" ] ;
    ns1:itemListOrder "https://schema.org/ItemListOrderAscending" ;
    ns1:name "L'échelle de la complexité, marche par marche" .

