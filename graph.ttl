<https://www.cyrilvoyant.com/ontology/#normal-distribution> a schema:DefinedTerm ;
    schema:alternateName "Gaussian distribution",
        "loi de Gauss",
        "score z",
        "z-score" ;
    schema:description "Le score z est le nombre d'écarts-types entre x et la moyenne ; Φ(z) est la probabilité qu'une variable normale centrée réduite reste en dessous de z : l'aire à gauche de z.",
        "The z-score is the number of standard deviations between x and the mean; Φ(z) is the probability that a standard normal variable stays below z: the area to the left of z." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/ontology/#cv-concepts>,
        "https://www.cyrilvoyant.com/ontology/" ;
    schema:inLanguage "en",
        "fr" ;
    schema:name "Loi normale",
        "Normal distribution" ;
    schema:sameAs "http://www.wikidata.org/entity/Q133871" ;
    schema:termCode "normal-distribution" ;
    schema:url "https://www.cyrilvoyant.com/fr/animations/loi-normale/",
        "https://www.cyrilvoyant.com/fr/lexique/#normal-distribution",
        "https://www.cyrilvoyant.com/glossary/#normal-distribution",
        "https://www.cyrilvoyant.com/tools/normal-distribution/" .

<https://www.cyrilvoyant.com/ontology/#fair> a schema:DefinedTerm ;
    schema:alternateName "FAIR",
        "FAIR data",
        "données FAIR" ;
    schema:description "Four principles that make data findable, accessible, interoperable and reusable, by humans and by machines.",
        "Quatre principes pour que des données soient trouvables (Findable), accessibles (Accessible), interopérables (Interoperable) et réutilisables (Reusable), par les humains comme par les machines." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/ontology/#cv-concepts>,
        "https://www.cyrilvoyant.com/ontology/" ;
    schema:inLanguage "en",
        "fr" ;
    schema:name "FAIR principles",
        "Principes FAIR" ;
    schema:termCode "fair" ;
    schema:url "https://www.cyrilvoyant.com/fr/lexique/#fair",
        "https://www.cyrilvoyant.com/fr/outils/autoevaluation-fair/",
        "https://www.cyrilvoyant.com/glossary/#fair",
        "https://www.cyrilvoyant.com/tools/fair-self-assessment/" .

<https://www.cyrilvoyant.com/ontology/#rmse> a schema:DefinedTerm ;
    schema:alternateName "racine de l'erreur quadratique moyenne",
        "root mean squared error" ;
    schema:description "La racine de l'erreur quadratique moyenne. Elle donne plus de poids aux grandes erreurs que la MAE.",
        "The root mean squared error. It gives large errors more weight than the MAE." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/ontology/#cv-concepts>,
        "https://www.cyrilvoyant.com/ontology/" ;
    schema:inLanguage "en",
        "fr" ;
    schema:name "RMSE" ;
    schema:sameAs "http://www.wikidata.org/entity/Q29037" ;
    schema:termCode "rmse" ;
    schema:url "https://www.cyrilvoyant.com/fr/lexique/#rmse",
        "https://www.cyrilvoyant.com/fr/recits/evaluer-prevision-solaire-persistance/",
        "https://www.cyrilvoyant.com/glossary/#rmse",
        "https://www.cyrilvoyant.com/stories/evaluate-solar-forecast-persistence/" .

<https://www.cyrilvoyant.com/ontology/#p-value> a schema:DefinedTerm ;
    schema:alternateName "p value",
        "valeur p" ;
    schema:description "La probabilité, si les moyennes sont égales (ou ρ = 0) et le modèle correct, d'un résultat au moins aussi extrême. Ce n'est pas la probabilité que l'hypothèse soit vraie ; elle ne mesure pas l'importance d'un lien.",
        "The probability, if the means are equal (or ρ = 0) and the model is correct, of a result at least as extreme. It is not the probability that the hypothesis is true; it does not measure the importance of an association." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/ontology/#cv-concepts>,
        "https://www.cyrilvoyant.com/ontology/" ;
    schema:inLanguage "en",
        "fr" ;
    schema:name "p-value" ;
    schema:sameAs "http://www.wikidata.org/entity/Q253255" ;
    schema:termCode "p-value" ;
    schema:url "https://www.cyrilvoyant.com/fr/animations/test-student/",
        "https://www.cyrilvoyant.com/fr/lexique/#p-value",
        "https://www.cyrilvoyant.com/glossary/#p-value",
        "https://www.cyrilvoyant.com/tools/student-t-test/" .

<https://www.cyrilvoyant.com/ontology/#blend> a schema:DefinedTerm ;
    schema:alternateName "cyclostationary persistence",
        "persistance cyclostationnaire" ;
    schema:description "La combinaison convexe de la persistance et de la persistance cyclique : deux poids positifs de somme 1, λ et 1 − λ, calculés à chaque moment du cycle.",
        "The convex combination of persistence and cyclic persistence: two positive weights adding up to 1, λ and 1 − λ, computed at each moment of the cycle." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/ontology/#cv-concepts>,
        "https://www.cyrilvoyant.com/ontology/" ;
    schema:inLanguage "en",
        "fr" ;
    schema:name "BLEND" ;
    schema:termCode "blend" ;
    schema:url "https://www.cyrilvoyant.com/fr/lexique/#blend",
        "https://www.cyrilvoyant.com/fr/outils/blend/",
        "https://www.cyrilvoyant.com/glossary/#blend",
        "https://www.cyrilvoyant.com/latest-publications-and-news/forecasting-with-less/" .

<https://www.cyrilvoyant.com/ontology/#nrmse> a schema:DefinedTerm ;
    schema:alternateName "RMSE normalisée",
        "normalized RMSE" ;
    schema:description "La RMSE rapportée à la moyenne du signal (0 pour une prévision parfaite).",
        "The RMSE divided by the mean of the signal (0 for a perfect forecast)." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/ontology/#cv-concepts>,
        "https://www.cyrilvoyant.com/ontology/" ;
    schema:inLanguage "en",
        "fr" ;
    schema:name "nRMSE" ;
    schema:termCode "nrmse" ;
    schema:url "https://www.cyrilvoyant.com/fr/lexique/#nrmse",
        "https://www.cyrilvoyant.com/fr/recits/variabilite-memoire-previsibilite/",
        "https://www.cyrilvoyant.com/glossary/#nrmse",
        "https://www.cyrilvoyant.com/stories/variability-memory-forecastability/" .

<https://www.cyrilvoyant.com/ontology/#scv> a schema:DefinedTerm ;
    schema:alternateName "coefficient de variation stochastique",
        "stochastic coefficient of variation" ;
    schema:description "A dimensionless departure from the clear-sky curve, normalized by that curve’s scale and the chosen diffuse floor. 0: clear sky; 1: the reference case of equally likely random switching between clear sky and that floor, not an upper bound.",
        "Indice sans unité d’écart à la courbe de ciel clair, normalisé par l’échelle de cette courbe et le plancher diffus retenu. 0 : ciel clair ; 1 : repère d’une alternance aléatoire équiprobable entre ciel clair et ce plancher, pas une borne supérieure." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/ontology/#cv-concepts>,
        "https://www.cyrilvoyant.com/ontology/" ;
    schema:inLanguage "en",
        "fr" ;
    schema:name "sCV" ;
    schema:termCode "scv" ;
    schema:url "https://www.cyrilvoyant.com/fr/lexique/#scv",
        "https://www.cyrilvoyant.com/fr/outils/variabilite-previsibilite/",
        "https://www.cyrilvoyant.com/glossary/#scv",
        "https://www.cyrilvoyant.com/latest-publications-and-news/why-forecast-solar-power/" .

<https://www.cyrilvoyant.com/ontology/#forecastability-f> a schema:DefinedTerm ;
    schema:alternateName "F indicator",
        "forecastability",
        "indicateur F",
        "prévisibilité" ;
    schema:description "F = 1 + sCV × (ρmax − 1), between 1 − sCV and 1. The higher it is, the easier that horizon is to forecast.",
        "F = 1 + sCV × (ρmax − 1), comprise entre 1 − sCV et 1. Plus elle est haute, plus cet horizon est facile à prévoir." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/ontology/#cv-concepts>,
        "https://www.cyrilvoyant.com/ontology/" ;
    schema:inLanguage "en",
        "fr" ;
    schema:name "Forecastability F",
        "Prévisibilité F" ;
    schema:termCode "forecastability-f" ;
    schema:url "https://www.cyrilvoyant.com/fr/lexique/#forecastability-f",
        "https://www.cyrilvoyant.com/fr/outils/variabilite-previsibilite/",
        "https://www.cyrilvoyant.com/glossary/#forecastability-f",
        "https://www.cyrilvoyant.com/latest-publications-and-news/why-forecast-solar-power/" .

<https://orcid.org/0000-0003-0242-7377> a schema:Person ;
    schema:name "Cyril Voyant" .

<https://www.cyrilvoyant.com/ontology/#nice> a schema:DefinedTerm ;
    schema:alternateName "NICE index",
        "NICEΣ",
        "NICEᵏ",
        "indice NICE" ;
    schema:description "L'erreur de la prévision divisée par celle de la persistance, aux mêmes dates et au même horizon. 0 : parfaite. 1 : autant d'erreur que la persistance. Au-dessus de 1, on l'écrit « > 1 » : moins bonne que la persistance.",
        "The forecast error divided by that of persistence, at the same dates and horizon. 0: perfect. 1: as much error as persistence. Above 1 it is written “> 1”: worse than persistence." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/ontology/#cv-concepts>,
        "https://www.cyrilvoyant.com/ontology/" ;
    schema:inLanguage "en",
        "fr" ;
    schema:name "NICE" ;
    schema:termCode "nice" ;
    schema:url "https://www.cyrilvoyant.com/fr/lexique/#nice",
        "https://www.cyrilvoyant.com/fr/outils/nice/",
        "https://www.cyrilvoyant.com/glossary/#nice",
        "https://www.cyrilvoyant.com/latest-publications-and-news/nice-forecast-evaluation/" .

<https://www.cyrilvoyant.com/ontology/#elm> a schema:DefinedTerm ;
    schema:alternateName "ELM",
        "apprentissage frugal",
        "frugal learner" ;
    schema:description "The Extreme Learning Machine retains a random hidden layer and fits its output coefficients analytically, avoiding iterative deep-network training.",
        "Une Extreme Learning Machine garde une couche cachée aléatoire et ajuste les sorties par une résolution analytique, ce qui évite un entraînement profond itératif." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/ontology/#cv-concepts>,
        "https://www.cyrilvoyant.com/ontology/" ;
    schema:inLanguage "en",
        "fr" ;
    schema:name "Extreme Learning Machine (ELM)",
        "Extreme learning machine (ELM)" ;
    schema:sameAs "http://www.wikidata.org/entity/Q21948731" ;
    schema:termCode "elm" ;
    schema:url "https://www.cyrilvoyant.com/fr/actualites/why-extreme-learning-machines/",
        "https://www.cyrilvoyant.com/fr/lexique/#elm",
        "https://www.cyrilvoyant.com/glossary/#elm",
        "https://www.cyrilvoyant.com/latest-publications-and-news/why-extreme-learning-machines/" .

<https://www.cyrilvoyant.com/ontology/#persistence> a schema:DefinedTerm ;
    schema:alternateName "naive forecast",
        "persistance simple",
        "simple persistence" ;
    schema:description "La prévision recopie la dernière valeur connue. C'est la référence minimale de toute prévision.",
        "The forecast copies the last known value. It is the minimal reference of any forecast." ;
    schema:inDefinedTermSet <https://www.cyrilvoyant.com/ontology/#cv-concepts>,
        "https://www.cyrilvoyant.com/ontology/" ;
    schema:inLanguage "en",
        "fr" ;
    schema:name "Persistance",
        "Persistence" ;
    schema:termCode "persistence" ;
    schema:url "https://www.cyrilvoyant.com/fr/lexique/#persistence",
        "https://www.cyrilvoyant.com/fr/recits/variabilite-memoire-previsibilite/",
        "https://www.cyrilvoyant.com/glossary/#persistence",
        "https://www.cyrilvoyant.com/stories/variability-memory-forecastability/" .

