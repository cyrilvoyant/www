s://orcid.org/0000-0003-3144-5945"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "name": "Luis Antonio Garcia-Gutierrez", "sameAs": "https://orcid.org/0000-0002-3480-1784"}, {"@type": "Person", "name": "Claudio Francesco Nicolosi", "sameAs": "https://orcid.org/0009-0001-2962-6643"}, {"@type": "Person", "name": "Philippe Blanc", "sameAs": "https://orcid.org/0000-0002-6345-0004"}, {"@type": "Person", "name": "Jamie Bright", "sameAs": "https://orcid.org/0000-0002-9465-3453"}]}, {"@type": "LearningResource", "name": "Quelle prévision pour quel signal ?", "inLanguage": "fr", "learningResourceType": "interactive experiment", "isBasedOn": [{"@id": "https://doi.org/10.1016/j.seta.2025.104588"}, {"@id": "https://doi.org/10.1016/j.energy.2015.07.089"}, {"@id": "https://doi.org/10.1016/j.solener.2025.113821"}, {"@id": "https://doi.org/10.1016/j.renene.2025.123913"}], "url": "https://www.cyrilvoyant.com/fr/recits/variabilite-memoire-previsibilite/#experience", "teaches": ["temporal ordering", "variability", "forecastability", "training and test separation", "model reference comparison"]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/fr/recits/websemantic/#page", "url": "https://www.cyrilvoyant.com/fr/recits/websemantic/", "name": "Au modèle de langage la lecture, au code validé le calcul : WebSemantic", "description": "Demander une simulation scientifique en mots simples, sans qu'une IA devine les valeurs manquantes. WebSemantic laisse le modèle de langage traduire la demande en variables, demande à la personne ce qui manque, et confie chaque nombre à un code scientifique validé et figé.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyri