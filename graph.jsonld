rmSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/stories/variability-memory-forecastability/"}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Research", "item": "https://www.cyrilvoyant.com/stories/"}, {"@type": "ListItem", "position": 3, "name": "Variability and memory", "item": "https://www.cyrilvoyant.com/stories/variability-memory-forecastability/"}]}, {"@type": "ScholarlyArticle", "@id": "https://doi.org/10.1016/j.seta.2025.104588", "name": "NICEᵏ metrics: Unified and multidimensional framework for evaluating deterministic solar forecasting accuracy", "url": "https://doi.org/10.1016/j.seta.2025.104588", "identifier": "10.1016/j.seta.2025.104588", "datePublished": "2025", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Milan Despotovic", "sameAs": "https://orcid.org/0000-0003-3144-5945"}, {"@type": "Person", "name": "Luis Garcia-Gutierrez", "sameAs": "https://orcid.org/0000-0002-3480-1784"}, {"@type": "Person", "name": "Rodrigo Amaro e Silva", "sameAs": "https://orcid.org/0000-0002-2813-150X"}, {"@type": "Person", "name": "Philippe Lauret", "sameAs": "https://orcid.org/0000-0003-2959-6146"}, {"@type": "Person", "name": "Ted Soubdhan", "sameAs": "https://orcid.org/0000-0002-6402-8438"}, {"@type": "Person", "name": "Nadjem Bailek", "sameAs": "https://orcid.org/0000-0001-9051-8548"}]}, {"@type": "ScholarlyArticle", "@id": "https://doi.org/10.1016/j.energy.2015.07.089", "name": "Statistical parameters as a means to a priori assess the accuracy of solar forecasting models", "url": "https://doi.org/10.1016/j.energy.2015.07.089", "identifier": "10.1016/j.energy.2015.07.089", "datePublished": "2015", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Ted Soubdhan", "sameAs": "https://orcid.org/0000-0002-6402-8438"}, {"@type": "Person", "name": "Philippe Lauret", "sameAs": "https://orcid.org/0000-0003-2959-6146"}, {"@type": "Person", "name": "Mathieu David", "sameAs": "https://orcid.org/0000-0002-7382-1294"}, {"@type": "Person", "name": "Marc Muselli", "sameAs": "https://orcid.org/0000-0002-2786-2749"}]}, {"@type": "ScholarlyArticle", "@id": "https://doi.org/10.1016/j.solener.2025.113821", "name": "A simple method for quickly estimating solar irradiance forecast errors", "url": "https://doi.org/10.1016/j.solener.2025.113821", "identifier": "10.1016/j.solener.2025.113821", "datePublished": "2025", "author": [{"@type": "Person", "name": "Philippe Lauret", "sameAs": "https://orcid.org/0000-0003-2959-6146"}, {"@type": "Person", "name": "Mathieu David", "sameAs": "https://orcid.org/0000-0002-7382-1294"}, {"@type": "Person", "name": "Josselin Le Gal La Salle", "sameAs": "https://orcid.org/0000-0003-0126-3796"}, {"@type": "Person", "name": "Elke Lorenz", "sameAs": "https://orcid.org/0000-0002-7475-1048"}, {"@type": "Person", "name": "Richard Perez", "sameAs": "https://orcid.org/0000-0001-8064-3281"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}]}, {"@type": "ScholarlyArticle", "@id": "https://doi.org/10.1016/j.renene.2025.123913", "name": "Stochastic coefficient of variation: Assessing the variability and forecastability of solar irradiance", "url": "https://doi.org/10.1016/j.renene.2025.123913", "identifier": "10.1016/j.renene.2025.123913", "datePublished": "2026", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Alan Julien", "sameAs": "https://orcid.org/0009-0003-0247-0663"}, {"@type": "Person", "name": "Milan Despotovic", "sameAs": "https://orcid.org/0000-0003-3144-5945"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "name": "Luis Antonio Garcia-Gutierrez", "sameAs": "https://orcid.org/0000-0002-3480-1784"}, {"@type": "Person", "name": "Claudio Francesco Nicolosi", "sameAs": "https://orcid.org/0009-0001-2962-6643"}, {"@type": "Person", "name": "Philippe Blanc", "sameAs": "https://orcid.org/0000-0002-6345-0004"}, {"@type": "Person", "name": "Jamie Bright", "sameAs": "https://orcid.org/0000-0002-9465-3453"}]}, {"@type": "LearningResource", "name": "Which forecast for which signal?", "inLanguage": "en", "learningResourceType": "interactive experiment", "isBasedOn": [{"@id": "https://doi.org/10.1016/j.seta.2025.104588"}, {"@id": "https://doi.org/10.1016/j.energy.2015.07.089"}, {"@id": "https://doi.org/10.1016/j.solener.2025.113821"}, {"@id": "https://doi.org/10.1016/j.renene.2025.123913"}], "url": "https://www.cyrilvoyant.com/stories/variability-memory-forecastability/#experience", "teaches": ["temporal ordering", "variability", "forecastability", "training and test separation", "model reference comparison"]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/stories/websemantic/#page", "url": "https://www.cyrilvoyant.com/stories/websemantic/", "name": "Let the language model read, let the validated code compute: WebSemantic", "description": "Ask for a scientific simulation in plain words, without an AI guessing the missing values. WebSemantic lets the language model translate the request into variables, asks the person for whatever is missing, and leaves every number to a validated, pinned scientific code.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-4"}], "keywords": ["AI in its place", "Language"], "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/recits/websemantic/#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Stories", "item": "https://www.cyrilvoyant.com/stories/"}, {"@type": "ListItem", "position": 3, "name": "Let the language model read, let the validated code compute: WebSemantic", "item": "https://www.cyrilvoyant.com/stories/websemantic/"}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/teaching/biostatistics/correlation-regression/#page", "url": "https://www.cyrilvoyant.com/teaching/biostatistics/correlation-regression/", "name": "Biostatistics 3: correlation, regression and chi-square tests", "description": "Covariance and Pearson correlation, the regression line and R², the significance of r, the χ² goodness-of-fit and independence tests, with exercises.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/correlation-regression/#page"}, "about": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#chi-square-test", "name": "Chi-square test", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/chi-square-test/"}], "mentions": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#r-squared", "name": "Coefficient of determination R²", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/correlation-significance-r-squared/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#prediction-interval", "name": "Prediction interval", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/regression-intervals/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#confidence-interval", "name": "Confidence interval", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/regression-intervals/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#p-value", "name": "p-value", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/student-t-test/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#pearson-correlation", "name": "Pearson correlation", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/correlation-significance-r-squared/"}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Teaching", "item": "https://www.cyrilvoyant.com/teaching/"}, {"@type": "ListItem", "position": 3, "name": "Biostatistics", "item": "https://www.cyrilvoyant.com/teaching/biostatistics/"}, {"@type": "ListItem", "position": 4, "name": "Chapter 3", "item": "https://www.cyrilvoyant.com/teaching/biostatistics/correlation-regression/"}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/teaching/biostatistics/correlation-regression/#chapter", "name": "Biostatistics 3: correlation, regression and chi-square tests", "description": "Covariance and Pearson correlation, the regression line and R², the significance of r, the χ² goodness-of-fit and independence tests, with exercises.", "inLanguage": "en", "learningResourceType": "Course chapter (summary, interactive experiments and FAQ; slides in French)", "educationalLevel": "First year of health studies (PASS, UE8)", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/deed.en", "isBasedOn": {"@id": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/correlation-regression/#chapter"}, "isPartOf": {"@id": "https://www.cyrilvoyant.com/teaching/biostatistics/#course"}, "encoding": {"@type": "MediaObject", "encodingFormat": "application/pdf", "inLanguage": "fr", "contentUrl": "https://www.cyrilvoyant.com/assets/biostat/Biostatistique-correlation-regression.pdf"}}, {"@type": "FAQPage", "@id": "https://www.cyrilvoyant.com/teaching/biostatistics/correlation-regression/#faq", "inLanguage": "en", "mainEntity": [{"@type": "Question", "name": "What is the difference between a confidence interval and a prediction interval?", "acceptedAnswer": {"@type": "Answer", "text": "In simple linear regression with independent normal errors of constant variance: 95% confidence interval (CI) of the mean at x0 = ŷ0 ± t(n−2; 0.975) se √[1/n + (x0−x̄)²/Sxx], where ŷ0 is the value predicted by the line at x0 and t(n−2; 0.975) the Student quantile with n − 2 degrees of freedom. For a future observation, add 1 under the root. Here Sxx = Σ(xi−x̄)² and se² = Σresidual²/(n−2). The prediction interval therefore keeps the individual scatter; 1.96 is only an asymptotic approximation of the quantile."}}, {"@type": "Question", "name": "Is a significant r enough to make a prediction useful?", "acceptedAnswer": {"@type": "Answer", "text": "No: with 1000 pairs, r = 0.1 can be significant while explaining only 1% of the variation in a simple regression with an intercept. Rejecting ρ = 0 under a model proves neither causation nor predictive usefulness; the latter is also measured on data not used to fit the model."}}, {"@type": "Question", "name": "Why can a single outlier change everything?", "acceptedAnswer": {"@type": "Answer", "text": "Least squares weigh the square of the deviations: a point far away in x can strongly change the fitted slope and correlation, increasing or decreasing the apparent relationship depending on its position. Always look at the scatter plot and the residuals before concluding."}}, {"@type": "Question", "name": "What to do when the expected counts of a χ² are small?", "acceptedAnswer": {"@type": "Answer", "text": "The asymptotic approximation can be poor; examine the size and structure of the table. A justified grouping or an exact method may be suitable, notably Fisher's test for a 2×2 table in its setting. Yates' continuity correction does not guarantee to solve the small-count problem."}}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/teaching/biostatistics/descriptive-statistics/#page", "url": "https://www.cyrilvoyant.com/teaching/biostatistics/descriptive-statistics/", "name": "Biostatistics 2: normal distribution and hypothesis tests", "description": "Measurement scales, graphs, central tendency and dispersion, the normal distribution and the z table, confidence intervals, hypotheses and the comparison of means.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/statistiques-descriptives/#page"}, "about": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#normal-distribution", "name": "Normal distribution", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/normal-distribution/"}], "mentions": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#p-value", "name": "p-value", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/student-t-test/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#confidence-interval", "name": "Confidence interval", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/regression-intervals/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#student-t-test", "name": "Student t-test", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/student-t-test/"}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Teaching", "item": "https://www.cyrilvoyant.com/teaching/"}, {"@type": "ListItem", "position": 3, "name": "Biostatistics", "item": "https://www.cyrilvoyant.com/teaching/biostatistics/"}, {"@type": "ListItem", "position": 4, "name": "Chapter 2", "item": "https://www.cyrilvoyant.com/teaching/biostatistics/descriptive-statistics/"}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/teaching/biostatistics/descriptive-statistics/#chapter", "name": "Biostatistics 2: normal distribution and hypothesis tests", "description": "Measurement scales, graphs, central tendency and dispersion, the normal distribution and the z table, confidence intervals, hypotheses and the comparison of means.", "inLanguage": "en", "learningResourceType": "Course chapter (summary, interactive experiments and FAQ; slides in French)", "educationalLevel": "First year of health studies (PASS, UE8)", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/deed.en", "isBasedOn": {"@id": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/statistiques-descriptives/#chapter"}, "isPartOf": {"@id": "https://www.cyrilvoyant.com/teaching/biostatistics/#course"}, "encoding": {"@type": "MediaObject", "encodingFormat": "application/pdf", "inLanguage": "fr", "contentUrl": "https://www.cyrilvoyant.com/assets/biostat/Biostatistique-statistiques-descriptives.pdf"}}, {"@type": "FAQPage", "@id": "https://www.cyrilvoyant.com/teaching/biostatistics/descriptive-statistics/#faq", "inLanguage": "en", "mainEntity": [{"@type": "Question", "name": "Why divide by n − 1 and not by n?", "acceptedAnswer": {"@type": "Answer", "text": "The deviations are measured from the sample mean, which is as close to them as possible: dividing by n underestimates the population variance in expectation. Dividing by n − 1 corrects this bias, because one degree of freedom was used to estimate the mean."}}, {"@type": "Question", "name": "Does a p-value of 0.03 give the probability that H0 is true?", "acceptedAnswer": {"@type": "Answer", "text": "No. Under H0 and the assumptions of the model, it is the probability of a statistic at least as extreme as the one observed, for the chosen test. It is neither P(H0 | data) nor a measure of the practical importance of the effect. A small one only says that the data are poorly compatible with H0."}}, {"@type": "Question", "name": "When is Student's distribution used for a mean?", "acceptedAnswer": {"@type": "Answer", "text": "For independent normal observations with an unknown variance, (x̄ − μ0)/(s/√n) follows exactly a Student distribution with n − 1 degrees of freedom (df), even for large n. Without normality, the approximation depends on the size and on the distribution; two-group and paired tests have their own conditions."}}, {"@type": "Question", "name": "Is a normality test enough to choose a method?", "acceptedAnswer": {"@type": "Answer", "text": "No: a large sample detects small departures and a small sample lacks power. One must look at the graphs, the extreme values, the independence and the inference question; the central limit theorem does not repair biased data collection or any dependence."}}]}, {"@type": "CollectionPage", "@id": "https://www.cyrilvoyant.com/teaching/biostatistics/#page", "url": "https://www.cyrilvoyant.com/teaching/biostatistics/", "name": "Biostatistics for health studies: a three-chapter course", "description": "A biostatistics course in three chapters and 246 slides, for the first year of health studies (PASS, teaching unit UE8). The chapters are read here in English; the slides are in French.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/#page"}, "about": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#chi-square-test", "name": "Chi-square test", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/chi-square-test/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#normal-distribution", "name": "Normal distribution", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/normal-distribution/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#roc-curve", "name": "ROC curve", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/roc-curve/"}], "mentions": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#r-squared", "name": "Coefficient of determination R²", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/correlation-significance-r-squared/"}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Teaching", "item": "https://www.cyrilvoyant.com/teaching/"}, {"@type": "ListItem", "position": 3, "name": "Biostatistics", "item": "https://www.cyrilvoyant.com/teaching/biostatistics/"}]}, {"@type": "Course", "@id": "https://www.cyrilvoyant.com/teaching/biostatistics/#course", "name": "Biostatistics for health studies (PASS, UE8)", "description": "A biostatistics course in three chapters and 246 slides, for the first year of health studies (PASS, teaching unit UE8). The chapters are read here in English; the slides are in French. It goes from probability and Bayesian reasoning to diagnostic tests (sensitivity, specificity, ROC curves), descriptive statistics, the normal distribution and hypothesis tests, then correlation, linear regression and χ² tests, with medical examples.", "inLanguage": "en", "courseCode": "UE8", "educationalLevel": "First year of health studies (PASS)", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/deed.en", "provider": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "isBasedOn": {"@id": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/#course"}, "hasPart": [{"@id": "https://www.cyrilvoyant.com/teaching/biostatistics/probabilities/#chapter", "@type": "LearningResource", "name": "Biostatistics 1: probability, Bayes' theorem and ROC curves"}, {"@id": "https://www.cyrilvoyant.com/teaching/biostatistics/descriptive-statistics/#chapter", "@type": "LearningResource", "name": "Biostatistics 2: normal distribution and hypothesis tests"}, {"@id": "https://www.cyrilvoyant.com/teaching/biostatistics/correlation-regression/#chapter", "@type": "LearningResource", "name": "Biostatistics 3: correlation, regression and chi-square tests"}], "teaches": ["probability", "conditional probability", "Bayes' theorem", "sensitivity and specificity", "ROC curve", "descriptive statistics", "normal distribution", "hypothesis testing", "Student's t-test", "confidence interval", "Pearson correlation", "linear regression", "chi-square test"]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/teaching/biostatistics/probabilities/#page", "url": "https://www.cyrilvoyant.com/teaching/biostatistics/probabilities/", "name": "Biostatistics 1: probability, Bayes' theorem and ROC curves", "description": "Why health needs statistics, probability vocabulary, counting, conditional probability and Bayes' theorem, contingency tables, sensitivity, specificity, ROC curves.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/probabilites/#page"}, "about": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#roc-curve", "name": "ROC curve", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/roc-curve/"}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Teaching", "item": "https://www.cyrilvoyant.com/teaching/"}, {"@type": "ListItem", "position": 3, "name": "Biostatistics", "item": "https://www.cyrilvoyant.com/teaching/biostatistics/"}, {"@type": "ListItem", "position": 4, "name": "Chapter 1", "item": "https://www.cyrilvoyant.com/teaching/biostatistics/probabilities/"}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/teaching/biostatistics/probabilities/#chapter", "name": "Biostatistics 1: probability, Bayes' theorem and ROC curves", "description": "Why health needs statistics, probability vocabulary, counting, conditional probability and Bayes' theorem, contingency tables, sensitivity, specificity, ROC curves.", "inLanguage": "en", "learningResourceType": "Course chapter (summary, interactive experiments and FAQ; slides in French)", "educationalLevel": "First year of health studies (PASS, UE8)", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/deed.en", "isBasedOn": {"@id": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/probabilites/#chapter"}, "isPartOf": {"@id": "https://www.cyrilvoyant.com/teaching/biostatistics/#course"}, "encoding": {"@type": "MediaObject", "encodingFormat": "application/pdf", "inLanguage": "fr", "contentUrl": "https://www.cyrilvoyant.com/assets/biostat/Biostatistique-probabilites.pdf"}}, {"@type": "FAQPage", "@id": "https://www.cyrilvoyant.com/teaching/biostatistics/probabilities/#faq", "inLanguage": "en", "mainEntity": [{"@type": "Question", "name": "Why does prevalence change the predictive value?", "acceptedAnswer": {"@type": "Answer", "text": "With Se = Sp = 99% and a prevalence of 1/1000, among 1000 people one expects 0.99 true positives and 9.99 false positives, hence a PPV close to 9%. This illustrates Bayes' theorem; clinical management depends on context and protocol."}}, {"@type": "Question", "name": "What does an AUC of 0.8 mean?", "acceptedAnswer": {"@type": "Answer", "text": "For a score oriented toward the presence of disease, AUC = P(score of a sick person > score of a healthy person) + 0.5 P(tie). An AUC of 0.8 describes this ranking, not the individual probability of being sick, nor the quality at a given threshold."}}, {"@type": "Question", "name": "Does the best threshold always maximize Se + Sp?", "acceptedAnswer": {"@type": "Answer", "text": "No. Youden's index and the distance to the ideal corner optimize different criteria; neither automatically encodes the clinical cost of errors. A decision needs, among other things, the prevalence and the respective consequences of false positives and false negatives."}}, {"@type": "Question", "name": "Why is the Bayesian approach used to adjust a dose?", "acceptedAnswer": {"@type": "Answer", "text": "It combines knowledge of the population (a prior distribution of the pharmacokinetic parameters) with the patient's own measurements: a few blood samples are enough for an individual estimate, which is refined with each new measurement."}}]}, {"@type": "WebPage", "@id": "https://www.cyrilvoyant.com/teaching/#page", "url": "https://www.cyrilvoyant.com/teaching/", "name": "Teaching", "description": "Five open courses under CC BY 4.0: solar forecasting (Mines Paris – PSL), biostatistics and physics for health studies, industrial physics, heat transfer for foods.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-3"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#freezing", "name": "Freezing", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/freezing-energy-power/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#cop", "name": "Coefficient of performance (COP)", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/refrigerator-carnot-cop/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#elm", "name": "Extreme learning machine (ELM)", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/why-extreme-learning-machines/"}], "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/enseignement/#page"}, "mentions": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#biot-number", "name": "Biot number", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/biot-cooling/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#normal-distribution", "name": "Normal distribution", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/normal-distribution/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#persistence", "name": "Persistence", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/stories/variability-memory-forecastability/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#r-squared", "name": "Coefficient of determination R²", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/correlation-significance-r-squared/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#smart-persistence", "name": "Smart persistence", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/stories/evaluate-solar-forecast-persistence/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#attenuation", "name": "Attenuation", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/attenuation-half-value-layer/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#blend", "name": "BLEND", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/forecasting-with-less/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#chi-square-test", "name": "Chi-square test", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/chi-square-test/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#compton-effect", "name": "Compton scattering", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/compton-scattering/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#half-value-layer", "name": "Half-value layer (HVL)", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/attenuation-half-value-layer/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#nice", "name": "NICE", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/nice-forecast-evaluation/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#nrmse", "name": "nRMSE", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/stories/variability-memory-forecastability/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#roc-curve", "name": "ROC curve", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/roc-curve/"}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Teaching", "item": "https://www.cyrilvoyant.com/teaching/"}]}, {"@type": "CollectionPage", "@id": "https://www.cyrilvoyant.com/teaching/open-courses/#page", "url": "https://www.cyrilvoyant.com/teaching/open-courses/", "name": "Open courses in French: biostatistics, medical physics, industrial physics and food heat transfer", "description": "Chapter index, in English, of four complete courses taught in French under CC BY 4.0: biostatistics and physics for health studies, industrial physics and refrigeration, heat transfer for foods.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#freezing", "name": "Freezing", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/freezing-energy-power/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#chi-square-test", "name": "Chi-square test", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/chi-square-test/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#normal-distribution", "name": "Normal distribution", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/normal-distribution/"}], "mentions": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#roc-curve", "name": "ROC curve", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/roc-curve/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#attenuation", "name": "Attenuation", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/attenuation-half-value-layer/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#biot-number", "name": "Biot number", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/biot-cooling/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#cop", "name": "Coefficient of performance (COP)", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/refrigerator-carnot-cop/"}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Teaching", "item": "https://www.cyrilvoyant.com/teaching/"}, {"@type": "ListItem", "position": 3, "name": "Open courses", "item": "https://www.cyrilvoyant.com/teaching/open-courses/"}]}, {"@type": "ItemList", "name": "Open courses in French: biostatistics, medical physics, industrial physics and food heat transfer", "itemListElement": [{"@type": "ListItem", "position": 1, "item": {"@type": "Course", "name": "Biostatistics for health studies", "description": "Probabilities and Bayesian reasoning, diagnostic tests (sensitivity, specificity, ROC curves: receiver operating characteristic, the share of sick people detected against the share of healthy people wrongly flagged as the threshold varies), descriptive statistics, the normal distribution and hypothesis tests, correlation, linear regression and χ² tests, with medical examples.", "url": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/", "inLanguage": "fr", "provider": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "hasPart": [{"@type": "CreativeWork", "name": "Probabilities, conditional probabilities, contingency tables and ROC curves", "url": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/probabilites/"}, {"@type": "CreativeWork", "name": "Descriptive statistics, the normal distribution and hypothesis tests", "url": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/statistiques-descriptives/"}, {"@type": "CreativeWork", "name": "Correlation, linear regression and χ² tests", "url": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/correlation-regression/"}]}}, {"@type": "ListItem", "position": 2, "item": {"@type": "Course", "name": "Physics for health studies: electromagnetic waves, X-rays and imaging", "description": "The nature of electromagnetic waves and of the photon, the energy levels of the atom, absorption, emission and spectroscopy (up to pulse oximetry), the production of X-rays, their interactions with matter and attenuation, then radiography and computed tomography (CT) scanning; two corrected exercise sessions.", "url": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/", "inLanguage": "fr", "provider": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "hasPart": [{"@type": "CreativeWork", "name": "Course: electromagnetic waves and the physical bases of imaging", "url": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/"}, {"@type": "CreativeWork", "name": "Exercise session 1, corrected", "url": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed1-corrige/"}, {"@type": "CreativeWork", "name": "Exercise session 2, corrected", "url": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed2-corrige/"}]}}, {"@type": "ListItem", "position": 3, "item": {"@type": "Course", "name": "Industrial physics: thermodynamics, water vapor and refrigeration", "description": "Quantities and changes of state, ideal and real gases, Clapeyron, entropy and Mollier diagrams, water vapor and humidity, engine cycles, then the refrigeration cycle, its coefficient of performance and its refrigerants; with the handouts.", "url": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/", "inLanguage": "fr", "provider": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "hasPart": [{"@type": "CreativeWork", "name": "General notions of thermodynamics", "url": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/notions-de-thermodynamique/"}, {"@type": "CreativeWork", "name": "Ideal gases, real gases and diagrams", "url": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/gaz-parfaits-et-reels/"}, {"@type": "CreativeWork", "name": "Water vapor", "url": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/vapeur-d-eau/"}, {"@type": "CreativeWork", "name": "Thermodynamic engine cycles", "url": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-moteurs/"}, {"@type": "CreativeWork", "name": "Refrigeration cycles", "url": "https: