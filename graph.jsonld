{"@context": {"@vocab": "https://schema.org/", "conformsTo": {"@id": "http://purl.org/dc/terms/conformsTo", "@type": "@id"}}, "@graph": [{"@type": "ProfilePage", "@id": "https://www.cyrilvoyant.com/about#page", "url": "https://www.cyrilvoyant.com/about/", "name": "About Cyril Voyant", "description": "Background, current research, projects, recognition, publications, code and contact.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "license": "https://creativecommons.org/licenses/by/4.0/", "mainEntity": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/", "givenName": "Cyril", "familyName": "Voyant", "jobTitle": "Research Director", "image": "https://cyrilvoyant.github.io/assets/cyril-voyant-200.jpg", "affiliation": {"@type": "Organization", "name": "Mines Paris – PSL, Centre O.I.E.", "url": "https://www.oie.minesparis.psl.eu/"}, "sameAs": ["https://orcid.org/0000-0003-0242-7377", "https://www.wikidata.org/wiki/Q58251573", "https://scholar.google.com/citations?user=aUlP6agAAAAJ", "https://cv.hal.science/cyril-voyant", "https://github.com/cyrilvoyant", "https://www.linkedin.com/in/cyril-voyant-2a7767192/", "https://www.cyrilvoyant.com/", "https://cyrilvoyant.github.io/"]}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "About", "item": "https://www.cyrilvoyant.com/about/"}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/ai-in-research#page", "url": "https://www.cyrilvoyant.com/ai-in-research/", "name": "AI in research: the AI Act, a lab charter and a toolbox for researchers", "description": "Generative AI now writes code, drafts papers and reviews data in every laboratory. The European AI Act sets rules for what we build and what we transfer. Here is what changes for researchers, the timeline in Europe and in France, how the rest of the world compares, who is responsible when research code becomes a product, and a toolbox a lab can adopt in a few hours per project.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-5"}], "datePublished": "2026-10-23", "dateModified": "2026-10-24", "version": "1.2", "keywords": ["Demonstrate trust", "Research practice"], "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/ia-dans-la-recherche#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Stories", "item": "https://www.cyrilvoyant.com/stories/"}, {"@type": "ListItem", "position": 3, "name": "AI in research: the AI Act, a lab charter and a toolbox for researchers", "item": "https://www.cyrilvoyant.com/ai-in-research/"}]}, {"@type": "FAQPage", "@id": "https://www.cyrilvoyant.com/ai-in-research/#faq", "inLanguage": "en", "mainEntity": [{"@type": "Question", "name": "Is scientific research exempt from the AI Act?", "acceptedAnswer": {"@type": "Answer", "text": "The exclusions depend on the system's purpose and stage, not simply on the user's status as a researcher. Article 2 covers systems specifically developed and put into service solely for scientific research, and certain pre-market research activities. Real-world testing is outside the latter exclusion. Reassess the scope before transfer or deployment."}}, {"@type": "Question", "name": "Which high-risk AI deadlines should a laboratory track?", "acceptedAnswer": {"@type": "Answer", "text": "As checked on October 23, 2026, the revised timeline provides December 2, 2027 for Annex III high-risk uses and August 2, 2028 for high-risk AI embedded in regulated products under Annex I. Other obligations have their own dates. Identify the relevant system and provision before applying a deadline."}}, {"@type": "Question", "name": "Who is responsible when laboratory code is transferred?", "acceptedAnswer": {"@type": "Answer", "text": "Identify the provider, deployer and other actors for the actual system. For high-risk systems, Article 25 specifies circumstances in which rebranding, substantial modification or a changed intended purpose can make another actor the provider. Contracts should document roles; they do not replace the applicable statutory obligations."}}, {"@type": "Question", "name": "What should a laboratory document first?", "acceptedAnswer": {"@type": "Answer", "text": "Record the purpose, people responsible, data provenance, model and code versions, validation results and limits. Use data and model cards, an AI-use statement and a project register. Before a transfer, review roles and documentation with the institution's legal service. These are practical recommendations, not a compliance certification."}}]}, {"@type": "AboutPage", "@id": "https://www.cyrilvoyant.com/approach#page", "url": "https://www.cyrilvoyant.com/approach/", "name": "Understand before you compute: the approach of Cyril Voyant", "description": "Medicine, energy, language: very different questions, one method. People and their question at the centre; a model we understand at the core; every tool, artificial intelligence included, around it. Complexity is added only when it brings a measurable gain.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-2"}], "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/approche#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "The approach", "item": "https://www.cyrilvoyant.com/approach/"}]}, {"@type": "WebPage", "@id": "https://www.cyrilvoyant.com/cite#page", "url": "https://www.cyrilvoyant.com/cite/", "name": "Cite and reuse our work: licences and citation templates", "description": "Articles, software, courses, data and texts of this site: the licence of each and how to cite it, with the affiliation to the O.I.E. centre of Mines Paris – PSL.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/citer#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Cite", "item": "https://www.cyrilvoyant.com/cite/"}]}, {"@type": "WebPage", "@id": "https://www.cyrilvoyant.com/collaborate#page", "url": "https://www.cyrilvoyant.com/collaborate/", "name": "Collaborate: research projects, studies and adaptation of the tools", "description": "Answer a call for projects together, fund a study or a doctorate through Mines Paris – PSL, or start an academic collaboration with a clear valorization objective.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/collaborer#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Collaborate", "item": "https://www.cyrilvoyant.com/collaborate/"}]}, {"@type": "ContactPoint", "contactType": "research collaboration", "email": "cyril.voyant@minesparis.psl.eu", "availableLanguage": ["English", "French"], "areaServed": "Worldwide"}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/complex-valued-forecasting#page", "url": "https://www.cyrilvoyant.com/complex-valued-forecasting/", "name": "Forecasting irradiance and its uncertainty with complex numbers", "description": "A complex autoregression with six coefficients forecasts both solar irradiance and its volatility; set α and see the width of the intervals. 2022 paper, Journal of Renewable and Sustainable Energy.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/prevision-complexe#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Complex-valued forecasting", "item": "https://www.cyrilvoyant.com/complex-valued-forecasting/"}]}, {"@type": "ScholarlyArticle", "@id": "https://doi.org/10.1063/5.0128131", "name": "Complex-valued time series based solar irradiance forecast", "datePublished": "2022-11", "isPartOf": {"@type": "Periodical", "name": "Journal of Renewable and Sustainable Energy"}, "author": [{"@type": "Person", "name": "Cyril Voyant", "@id": "https://person.cyrilvoyant.com/#cyril-voyant"}, {"@type": "Person", "name": "Philippe Lauret", "sameAs": "https://orcid.org/0000-0003-2959-6146"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "name": "Jean-Laurent Duchaud", "sameAs": "https://orcid.org/0000-0001-7490-7260"}, {"@type": "Person", "name": "Luis Garcia-Gutierrez", "sameAs": "https://orcid.org/0000-0002-3480-1784"}, {"@type": "Person", "name": "Ghjuvan Antone Faggianelli", "sameAs": "https://orcid.org/0000-0002-9954-5910"}]}, {"@type": "ProfilePage", "@id": "https://www.cyrilvoyant.com/cv#page", "url": "https://www.cyrilvoyant.com/cv/", "name": "Curriculum vitae", "description": "Curriculum vitae of Cyril Voyant, Research Director at Mines Paris – PSL.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "license": "https://creativecommons.org/licenses/by/4.0/", "mainEntity": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/", "givenName": "Cyril", "familyName": "Voyant", "jobTitle": "Research Director", "image": "https://cyrilvoyant.github.io/assets/cyril-voyant-200.jpg", "affiliation": {"@type": "Organization", "name": "Mines Paris – PSL, Centre O.I.E.", "url": "https://www.oie.minesparis.psl.eu/"}, "sameAs": ["https://orcid.org/0000-0003-0242-7377", "https://www.wikidata.org/wiki/Q58251573", "https://scholar.google.com/citations?user=aUlP6agAAAAJ", "https://cv.hal.science/cyril-voyant", "https://github.com/cyrilvoyant", "https://www.linkedin.com/in/cyril-voyant-2a7767192/", "https://www.cyrilvoyant.com/", "https://cyrilvoyant.github.io/"]}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "About", "item": "https://www.cyrilvoyant.com/about/"}, {"@type": "ListItem", "position": 3, "name": "Curriculum vitae", "item": "https://www.cyrilvoyant.com/cv/"}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/data#page", "url": "https://www.cyrilvoyant.com/data/", "name": "Models live in the data: qualify, certify, license", "description": "With AI, methods are within everyone's reach; what gives a result its value is data that are qualified, certified and clearly licensed. Basic rules, the example of Webservice-Energy and a tree to choose a licence.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/donnees#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Data", "item": "https://www.cyrilvoyant.com/data/"}]}, {"@type": "DefinedTermSet", "@id": "https://www.cyrilvoyant.com/data/#glossary", "name": "Glossary: data, licences, FAIR", "inLanguage": "en", "hasDefinedTerm": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/data/#glossary-fair", "name": "FAIR", "description": "Findable, accessible, interoperable, reusable: four principles so that data serve beyond those who produced them.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/data/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/data/#glossary-metadata", "name": "Metadata", "description": "Data about the data: origin, instrument, units, period, time step, processing, licence.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/data/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/data/#glossary-doi", "name": "DOI", "description": "A persistent identifier for a digital object (article, dataset, software); the address remains valid even if the website changes. DataCite assigns them to research data.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/data/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/data/#glossary-ogc", "name": "OGC", "description": "Open Geospatial Consortium: open standards for geographic services, among them WMS (maps), WFS (features), WCS (grids) and WPS (remote processing).", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/data/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/data/#glossary-inspire-iso-19115", "name": "INSPIRE, ISO 19115", "description": "The European directive on geographic information and the international standard for its metadata.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/data/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/data/#glossary-thredds-opendap", "name": "THREDDS, OPeNDAP", "description": "A scientific data server and the protocol that reads only the useful part (an area, a period) without downloading everything.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/data/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/data/#glossary-netcdf-cf", "name": "NetCDF-CF", "description": "A file format for scientific grids and series, with conventions (CF) that fix variable names, units and coordinates.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/data/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/data/#glossary-stac", "name": "STAC", "description": "SpatioTemporal Asset Catalog: a standard way to catalogue satellite imagery and cloud-native data.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/data/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/data/#glossary-geo-copernicus-cams-c3s", "name": "GEO, Copernicus, CAMS, C3S", "description": "The Group on Earth Observations (an intergovernmental partnership), the European Earth observation programme and two of its services: atmosphere (CAMS) and climate change (C3S).", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/data/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/data/#glossary-cc-by", "name": "CC BY", "description": "Creative Commons Attribution: anyone may copy, adapt and reuse, commercially too, provided the author is credited. Meant for texts, figures and data.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/data/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/data/#glossary-cc-by-nc", "name": "CC BY-NC", "description": "The same, for non-commercial uses only.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/data/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/data/#glossary-mit", "name": "MIT", "description": "A very permissive software licence: free use, modification, redistribution and sale, provided the copyright notice and the licence text are kept; no warranty.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/data/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/data/#glossary-apache-2-0", "name": "Apache 2.0", "description": "Permissive like MIT, plus an explicit patent licence from contributors and a duty to flag modified files.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/data/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/data/#glossary-bsd", "name": "BSD", "description": "A family of permissive licences close to MIT; the three-clause version also forbids using the authors' names to promote a derived product.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/data/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/data/#glossary-gpl", "name": "GPL", "description": "A copyleft licence: any derived software that is distributed must be under the GPL, with its source code.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/data/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/data/#glossary-polyform-noncommercial", "name": "PolyForm Noncommercial", "description": "A software licence that allows any non-commercial use: personal use, research, experiment, teaching, and use by non-commercial organizations (educational institutions, public research, charities, government bodies). Commercial use needs another agreement with the author. The licence must travel with redistributed code.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/data/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/data/#glossary-open-source-osi", "name": "Open source (OSI)", "description": "The Open Source Initiative definition: an open-source licence may not restrict any field of use; a non-commercial licence is therefore not \"open source\", even if the code is open to read.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/data/#glossary"}}]}, {"@type": "DataCatalog", "name": "Webservice-Energy", "url": "https://www.webservice-energy.org", "license": "https://creativecommons.org/licenses/by/4.0/", "creator": [{"@type": "Person", "name": "Lionel Ménard", "sameAs": ["https://orcid.org/0009-0002-2156-8538", "https://www.minesparis.psl.eu/annuaire-de-la-recherche/chercheur/lionel-menard/"]}, {"@type": "Person", "name": "Raphaël Jolivet", "sameAs": "https://www.linkedin.com/in/raphaeljolivet/"}], "publisher": {"@type": "Organization", "name": "Centre O.I.E., Mines Paris – PSL", "url": "https://www.oie.minesparis.psl.eu/"}, "description": "Spatial data infrastructure for energy, environment and Earth observation (catalogue, THREDDS, OGC services, WPS, STAC, libinsitu)."}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/fr/actualites/forecasting-with-less#page", "url": "https://www.cyrilvoyant.com/fr/actualites/forecasting-with-less/", "name": "BLEND : une meilleure persistance sans entraîner de réseau neuronal", "description": "Introduire la phase quotidienne dans une prévision de persistance améliore les résultats sur les séries solaires étudiées, avec des écarts qui s’accentuent aux horizons plus longs.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-2"}], "keywords": ["Hybrider", "Énergie"], "translationOfWork": {"@id": "https://www.cyrilvoyant.com/latest-publications-and-news/forecasting-with-less#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Récits", "item": "https://www.cyrilvoyant.com/fr/recits/"}, {"@type": "ListItem", "position": 3, "name": "BLEND : une meilleure persistance sans entraîner de réseau neuronal", "item": "https://www.cyrilvoyant.com/fr/actualites/forecasting-with-less/"}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/fr/actualites/gamma-index-forecast-validation#page", "url": "https://www.cyrilvoyant.com/fr/actualites/gamma-index-forecast-validation/", "name": "L'indice γ : valider des prévisions solaires décalées au-delà des erreurs ponctuelles", "description": "Dans l’expérience synthétique du travail gamma-index, plus de 80 % des pixels restent acceptables malgré un déplacement spatial d’environ deux kilomètres, un décalage de dix minutes et un bruit ajouté. Le RMSE pixel à pixel donne pourtant une impression de forte erreur.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-5"}], "keywords": ["Démontrer la confiance", "Énergie"], "translationOfWork": {"@id": "https://www.cyrilvoyant.com/latest-publications-and-news/gamma-index-forecast-validation#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Récits", "item": "https://www.cyrilvoyant.com/fr/recits/"}, {"@type": "ListItem", "position": 3, "name": "L'indice γ : valider des prévisions solaires décalées au-delà des erreurs ponctuelles", "item": "https://www.cyrilvoyant.com/fr/actualites/gamma-index-forecast-validation/"}]}, {"@type": "CollectionPage", "@id": "https://www.cyrilvoyant.com/fr/actualites#page", "url": "https://www.cyrilvoyant.com/fr/actualites/", "name": "Actualités : publications, logiciels et essais", "description": "Toutes les actualités de recherche de Cyril Voyant sur une page : articles et coauteurs, logiciels, nominations et essais, filtrables par thème et par année.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "translationOfWork": {"@id": "https://www.cyrilvoyant.com/latest-publications-and-news#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Actualités", "item": "https://www.cyrilvoyant.com/fr/actualites/"}]}, {"@type": "ItemList", "name": "Actualités", "numberOfItems": 24, "itemListElement": [{"@type": "ListItem", "position": 1, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#scientific-publishing-trust", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#scientific-publishing-trust", "headline": "Édition scientifique : sans vérification des données et du code, pas de confiance", "inLanguage": "fr", "abstract": "Les articles indexés ont crû d'environ 47 % entre 2016 et 2022, la relecture repose sur un travail gratuit et 2023 a battu le record des rétractations. Un court essai sur ce qui existe, des données FAIR à l'AI Act, et ce qui manque : vérifier les données et le code publiés.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2026-10-24"}}, {"@type": "ListItem", "position": 2, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#electre-carnot-mines-electrification", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#electre-carnot-mines-electrification", "headline": "ELECTRE, projet phare de l'institut Carnot M.I.N.E.S : électrifier les usages, journée de clôture le 18 novembre 2026", "inLanguage": "fr", "abstract": "ELECTRE fédère une quinzaine de laboratoires, centres et instituts de l'institut Carnot M.I.N.E.S autour de 13 projets de recherche (2023-2026) sur l'électrification des usages, des matériaux au stockage, aux procédés industriels et aux limites de l'électrification. Sa journée de clôture a lieu le 18 novembre 2026 à Mines Paris – PSL, Sophia Antipolis.", "author": [{"@type": "Person", "name": "Delphine Gilges-Crampont"}, {"@type": "Person", "name": "Annette Massias"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2026-10-23", "image": "https://www.cyrilvoyant.com/assets/news/electre.png"}}, {"@type": "ListItem", "position": 3, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#visiting-professor-at-the-university-of-kragujevac-serbia", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#visiting-professor-at-the-university-of-kragujevac-serbia", "headline": "Professeur invité à l'université de Kragujevac (Serbie)", "inLanguage": "en", "abstract": "Nommé professeur invité à la faculté d'ingénierie de l'université de Kragujevac, avec mon collègue et ami Gilles Notton.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}], "datePublished": "2026", "image": "https://www.cyrilvoyant.com/assets/img/e127601c2891.png"}}, {"@type": "ListItem", "position": 4, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#tunnel-load-simulator-an-open-source-generator-for-synthetic-road-tunnel", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#tunnel-load-simulator-an-open-source-generator-for-synthetic-road-tunnel", "headline": "Tunnel Load Simulator : générer la consommation électrique des tunnels routiers", "inLanguage": "en", "abstract": "Application libre (Streamlit), développée dans le projet SmartTunnel, qui produit des profils de charge électrique synthétiques pour les tunnels routiers : éclairage, ventilation, auxiliaires, trafic, saisons et événements aléatoires.", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "datePublished": "2026-05-08", "image": "https://www.cyrilvoyant.com/assets/img/e326492cab74.jpg"}}, {"@type": "ListItem", "position": 5, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#when-sunlight-stops-being-direct", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#when-sunlight-stops-being-direct", "headline": "Quand la lumière du soleil n'est plus directe : prévoir la fraction diffuse", "inLanguage": "en", "abstract": "Le rayonnement diffus est l'une des composantes les plus difficiles de la ressource solaire, surtout là où aérosols, humidité et contrastes climatiques sont forts. Mesure et prévision de la fraction diffuse en Arabie saoudite, avec un modèle hybride par empilement.", "author": [{"@type": "Person", "name": "Haifa Harrouch"}, {"@type": "Person", "name": "Nadjem Bailek", "sameAs": "https://orcid.org/0000-0001-9051-8548"}, {"@type": "Person", "name": "Bilel Zerouali"}, {"@type": "Person", "name": "Ilyes Abidi"}, {"@type": "Person", "name": "Hanene Guesmi"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Jihad A. Younis"}, {"@type": "Person", "name": "Maher Jebali & Rabab Triki"}], "datePublished": "2026-04-28", "image": "https://www.cyrilvoyant.com/assets/img/500e36c2208c.png"}}, {"@type": "ListItem", "position": 6, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#revisiting-persistence-symmetry-constrained-forecasting-of-periodically", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#revisiting-persistence-symmetry-constrained-forecasting-of-periodically", "headline": "Revisiter la persistance : BLEND, une prévision sous contrainte de symétrie pour les processus énergétiques périodiques", "inLanguage": "en", "abstract": "La persistance revisitée pour les séries à statistiques périodiques, comme le cycle journalier du rayonnement solaire. BLEND combine la dernière observation et l'observation alignée sur la même phase du cycle.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Candice Banes", "sameAs": "https://orcid.org/0009-0003-6656-8168"}, {"@type": "Person", "name": "Luis Garcia-Gutierrez", "sameAs": "https://orcid.org/0000-0002-3480-1784"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "name": "Milan Despotovic", "sameAs": "https://orcid.org/0000-0003-3144-5945"}, {"@type": "Person", "name": "Zaher Mundher Yaseen", "sameAs": "https://orcid.org/0000-0003-3344-214X"}], "datePublished": "2026-04-24", "image": "https://www.cyrilvoyant.com/assets/img/e8e0bf76adbb.jpg"}}, {"@type": "ListItem", "position": 7, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#from-pixels-to-tolerances-rethinking-forecast-validation-with-the-index", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#from-pixels-to-tolerances-rethinking-forecast-validation-with-the-index", "headline": "Des pixels aux tolérances : valider les prévisions avec l'indice γ", "inLanguage": "en", "abstract": "Les métriques classiques comme le RMSE jugent une prévision comme si chaque pixel devait coïncider parfaitement dans l'espace et le temps. L'indice γ accepte un décalage toléré, comme le fait un expert.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2026-03-28", "image": "https://www.cyrilvoyant.com/assets/img/7f20ac04a02f.png"}}, {"@type": "ListItem", "position": 8, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#excellence-scientifique-a-l-ere-de-l-ia-du-seo-au-geo", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#excellence-scientifique-a-l-ere-de-l-ia-du-seo-au-geo", "headline": "Excellence scientifique à l’ère de l’IA : du SEO au GEO", "inLanguage": "fr", "abstract": "La production scientifique mondiale connaît une croissance sans précédent, amplifiée par l’essor des modèles d’intelligence artificielle générative. Dans ce contexte, la question n’est plus seulement de produire du savoir, mais d’en garantir la visibilité, la robustesse et la réutilisabilité.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2026", "image": "https://www.cyrilvoyant.com/assets/img/0983e8b6d15c.jpg"}}, {"@type": "ListItem", "position": 9, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#coherent-multi-energy-forecasting-for-real-time-grid-management-a-parsimonious", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#coherent-multi-energy-forecasting-for-real-time-grid-management-a-parsimonious", "headline": "Prévoir toutes les énergies d'un réseau d'un seul coup : l'approche parcimonieuse MIMO-ELM", "inLanguage": "en", "abstract": "Une prévision à court terme rapide, transparente et opérationnelle de la demande et de la production de plusieurs sources d'énergie.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Milan Despotovic", "sameAs": "https://orcid.org/0000-0003-3144-5945"}, {"@type": "Person", "name": "Luis Garcia-Gutierrez", "sameAs": "https://orcid.org/0000-0002-3480-1784"}, {"@type": "Person", "name": "Mohammed Asloune", "sameAs": "https://orcid.org/0009-0004-0183-2156"}, {"@type": "Person", "name": "Yves-Marie Saint-Drenan", "sameAs": "https://orcid.org/0000-0003-1471-1092"}, {"@type": "Person", "name": "Jean-Laurent Duchaud", "sameAs": "https://orcid.org/0000-0001-7490-7260"}, {"@type": "Person", "name": "Ghjuvan Antone Faggianelli", "sameAs": "https://orcid.org/0000-0002-9954-5910"}, {"@type": "Person", "name": "Elena Magliaro"}], "datePublished": "2026-02-26", "image": "https://www.cyrilvoyant.com/assets/img/8a4ca1238d62.png"}}, {"@type": "ListItem", "position": 10, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#invisible-research-has-no-impact-engineering-scientific-influence-in-the-ai-era", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#invisible-research-has-no-impact-engineering-scientific-influence-in-the-ai-era", "headline": "Une recherche invisible n'a pas d'impact : construire l'influence scientifique à l'ère de l'IA", "inLanguage": "en", "abstract": "La recherche est passée de la rareté à la saturation : produire du savoir n'est plus le goulot d'étranglement ; être trouvé, jugé crédible et réutilisé, si.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2026", "image": "https://www.cyrilvoyant.com/assets/img/4c8ef733ef53.jpg"}}, {"@type": "ListItem", "position": 11, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#appointed-associate-editor-for-scientific-reports-nature-portfolio", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#appointed-associate-editor-for-scientific-reports-nature-portfolio", "headline": "Nommé éditeur associé de Scientific Reports (Nature Portfolio)", "inLanguage": "en", "abstract": "Une revue pluridisciplinaire qui couvre tous les domaines scientifiques ; ce rôle prolonge mon parcours de directeur de recherche à Mines Paris – PSL (centre O.I.E.).", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "datePublished": "2026", "image": "https://www.cyrilvoyant.com/assets/img/fd09837e8068.jpg"}}, {"@type": "ListItem", "position": 12, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#quality-control-framework-for-tilted-solar-irradiance", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#quality-control-framework-for-tilted-solar-irradiance", "headline": "Contrôle qualité des mesures de rayonnement solaire sur plan incliné", "inLanguage": "en", "abstract": "Un cadre de contrôle qualité pour le rayonnement mesuré sur plan incliné, issu de la thèse de Mohammed Asloune (université de Corse et Mines Paris – PSL).", "author": [{"@type": "Person", "name": "Mohammed Asloune", "sameAs": "https://orcid.org/0009-0004-0183-2156"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2025-12-20", "image": "https://www.cyrilvoyant.com/assets/img/597be8654483.jpg"}}, {"@type": "ListItem", "position": 13, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#towards-personalized-radio-iodine-therapy-modeling-dynamics-and-clinical", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#towards-personalized-radio-iodine-therapy-modeling-dynamics-and-clinical", "headline": "Vers une iodothérapie personnalisée : modélisation, dynamique et perspectives cliniques", "inLanguage": "en", "abstract": "Une contribution doctorale de Marie Fusella Giuntini, avec les universités d'Aix-Marseille et de Corse, Mines Paris – PSL et l'hôpital de la Timone : deux articles, un modèle mécaniste et une revue des approches de modélisation.", "author": [{"@type": "Person", "name": "Marie Fusella Giuntini"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "David Taieb"}, {"@type": "Person", "name": "Dominique Barbolosi"}], "datePublished": "2025", "image": "https://www.cyrilvoyant.com/assets/img/81ce5b8cbd78.png"}}, {"@type": "ListItem", "position": 14, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#grateful-to-be-included-in-the-2025-stanford-elsevier-top-2-scientists-ranking", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#grateful-to-be-included-in-the-2025-stanford-elsevier-top-2-scientists-ranking", "headline": "Dans le classement Stanford-Elsevier 2025 des 2 % de chercheurs les plus cités", "inLanguage": "en", "abstract": "Une reconnaissance pour les travaux menés à Mines Paris – PSL en prévision solaire, systèmes photovoltaïques, IA pour l'énergie et physique médicale.", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "datePublished": "2025", "image": "https://www.cyrilvoyant.com/assets/img/c8454c0e0d6c.png"}}, {"@type": "ListItem", "position": 15, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#transfer-learning-for-wind-speed-forecasting-a-scalable-approach-for-data", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#transfer-learning-for-wind-speed-forecasting-a-scalable-approach-for-data", "headline": "Apprentissage par transfert pour prévoir le vent là où les données manquent", "inLanguage": "en", "abstract": "Réutiliser des modèles entraînés sur des sites riches en données permet de prévoir la vitesse du vent sur des sites qui en ont peu : sur 4 830 expériences, une précision comparable à l'apprentissage direct (écart de nRMSE inférieur à 0,01).", "author": [{"@type": "Person", "name": "Milan Despotović", "sameAs": "https://orcid.org/0000-0003-3144-5945"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2025-10-13", "image": "https://www.cyrilvoyant.com/assets/img/435a8e9d3433.png"}}, {"@type": "ListItem", "position": 16, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#from-trends-to-insights-a-text-mining-analysis-of-solar-energy-forecasting-2017", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#from-trends-to-insights-a-text-mining-analysis-of-solar-energy-forecasting-2017", "headline": "Prévision solaire : 500 articles (2017-2023) analysés par fouille de textes", "inLanguage": "en", "abstract": "La fouille de textes de 500 articles cartographie la recherche mondiale en prévision solaire : forte montée de l'IA et de l'apprentissage profond, portée par la Chine, les États-Unis et l'Inde, et métriques déterministes encore dominantes.", "author": [{"@type": "Person", "name": "Mohammed Asloune", "sameAs": "https://orcid.org/0009-0004-0183-2156"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2025-10-01", "image": "https://www.cyrilvoyant.com/assets/img/b0d486d8a45b.png"}}, {"@type": "ListItem", "position": 17, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#a-simple-method-for-quickly-estimating-solar-irradiance-forecast-errors", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#a-simple-method-for-quickly-estimating-solar-irradiance-forecast-errors", "headline": "Estimer rapidement l'erreur d'une prévision solaire à partir de la seule variabilité du site", "inLanguage": "en", "abstract": "Des modèles linéaires prédisent l'erreur de prévision du rayonnement à partir de la variabilité locale, mesurée par l'écart-type des variations horaires de l'indice de ciel clair.", "author": [{"@type": "Person", "name": "Philippe Lauret", "sameAs": "https://orcid.org/0000-0003-2959-6146"}, {"@type": "Person", "name": "Mathieu David"}, {"@type": "Person", "name": "Josselin Le Gal La Salle"}, {"@type": "Person", "name": "Elke Lorenz"}, {"@type": "Person", "name": "Richard Perez"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2025-08-22", "image": "https://www.cyrilvoyant.com/assets/img/85e5d66681cc.png"}}, {"@type": "ListItem", "position": 18, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#new-release-lql-equiv-open-source-software-for-biologically-equivalent-dose", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#new-release-lql-equiv-open-source-software-for-biologically-equivalent-dose", "headline": "Nouvelle version de LQL-Equiv, logiciel libre de calcul de dose biologiquement équivalente en radiothérapie", "inLanguage": "en", "abstract": "Logiciel libre écrit en MATLAB par Cyril Voyant et Daniel Julian : calcul voxel par voxel de l'EQD₂ et de la BED avec le modèle linéaire-quadratique-linéaire.", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "datePublished": "2025-08-04", "image": "https://www.cyrilvoyant.com/assets/img/82d8378219df.png"}}, {"@type": "ListItem", "position": 19, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#improving-clinical-decision-making-in-radiotherapy-a-comparative-analysis-of", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#improving-clinical-decision-making-in-radiotherapy-a-comparative-analysis-of", "headline": "Aider la décision clinique en radiothérapie : modèles de dose LQ et LQL comparés", "inLanguage": "en", "abstract": "Un article collectif qui compare les modèles linéaire-quadratique (LQ) et linéaire-quadratique-linéaire (LQL) ; méthodes, résultats et limites cliniques dans l'article publié.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "D. Julian"}, {"@type": "Person", "name": "S. Muraro"}, {"@type": "Person", "name": "V. Bodez"}, {"@type": "Person", "name": "M. Pinpin"}, {"@type": "Person", "name": "D. Leschi"}, {"@type": "Person", "name": "R. Oozeer"}, {"@type": "Person", "name": "G. Wided"}, {"@type": "Person", "name": "M.-A. Acquaviva"}, {"@type": "Person", "name": "S. Prapant"}, {"@type": "Person", "name": "O. Gahbiche"}, {"@type": "Person", "name": "N. Bouaouina"}], "datePublished": "2025-06-24", "image": "https://www.cyrilvoyant.com/assets/img/a65616587f74.jpg"}}, {"@type": "ListItem", "position": 20, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#stochastic-coefficient-of-variation-assessing-the-variability-and", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#stochastic-coefficient-of-variation-assessing-the-variability-and", "headline": "Coefficient de variation stochastique : mesurer la variabilité et la prévisibilité du rayonnement solaire", "inLanguage": "en", "abstract": "Le sCV et la prévisibilité F séparent les fluctuations aléatoires des tendances déterministes que l'écart-type mélange, pour caractériser un site avant de comparer des modèles.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Alan Julien", "sameAs": "https://orcid.org/0009-0003-0247-0663"}, {"@type": "Person", "name": "Milan Despotovic", "sameAs": "https://orcid.org/0000-0003-3144-5945"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "name": "Luis Antonio Garcia-Gutierrez", "sameAs": "https://orcid.org/0000-0002-3480-1784"}, {"@type": "Person", "name": "Claudio Francesco Nicolosi", "sameAs": "https://orcid.org/0009-0001-2962-6643"}, {"@type": "Person", "name": "Philippe Blanc", "sameAs": "https://orcid.org/0000-0002-6345-0004"}, {"@type": "Person", "name": "Jamie Bright", "sameAs": "https://orcid.org/0000-0002-9465-3453"}], "datePublished": "2025-07-17", "image": "https://www.cyrilvoyant.com/assets/img/85aa63526c77.jpg"}}, {"@type": "ListItem", "position": 21, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#nice-k-metrics-unified-and-multidimensional-framework-for-evaluating", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#nice-k-metrics-unified-and-multidimensional-framework-for-evaluating", "headline": "Métriques NICEᵏ : un cadre unifié pour évaluer les prévisions solaires déterministes", "inLanguage": "en", "abstract": "Le RMSE, le MAE et les scores de compétence ne saisissent pas toute la qualité d'une prévision solaire. Les métriques NICEᵏ rapportent les erreurs à celles d'une référence explicite, la persistance.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Milan Despotovic", "sameAs": "https://orcid.org/0000-0003-3144-5945"}, {"@type": "Person", "name": "Luis Garcia-Gutierrez", "sameAs": "https://orcid.org/0000-0002-3480-1784"}, {"@type": "Person", "name": "Rodrigo Amaro e Silva", "sameAs": "https://orcid.org/0000-0002-2813-150X"}, {"@type": "Person", "name": "Philippe Lauret", "sameAs": "https://orcid.org/0000-0003-2959-6146"}, {"@type": "Person", "name": "Ted Soubdhan", "sameAs": "https://orcid.org/0000-0002-6402-8438"}, {"@type": "Person", "name": "Nadjem Bailek", "sameAs": "https://orcid.org/0000-0001-9051-8548"}], "datePublished": "2025-09-25", "image": "https://www.cyrilvoyant.com/assets/img/82ce1d4d17e8.png"}}, {"@type": "ListItem", "position": 22, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#on-the-importance-of-clearsky-model-in-short-term-solar-radiation-forecasting", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#on-the-importance-of-clearsky-model-in-short-term-solar-radiation-forecasting", "headline": "Le choix du modèle de ciel clair compte pour la prévision solaire à court terme", "inLanguage": "en", "abstract": "Les modèles de ciel clair servent partout en énergie solaire, mais leur usage en prévision pose des difficultés : erreurs de synchronisation, choix de l'indice de ciel clair, effets sur les scores.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Milan Despotovic", "sameAs": "https://orcid.org/0000-0003-3144-5945"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "name": "Yves-Marie Saint-Drenan", "sameAs": "https://orcid.org/0000-0003-1471-1092"}, {"@type": "Person", "name": "Mohammed Asloune", "sameAs": "https://orcid.org/0009-0004-0183-2156"}, {"@type": "Person", "name": "Luis Garcia-Gutierrez", "sameAs": "https://orcid.org/0000-0002-3480-1784"}], "datePublished": "2025-04-11", "image": "https://www.cyrilvoyant.com/assets/img/05e996273651.jpg"}}, {"@type": "ListItem", "position": 23, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#comparative-study-of-feature-selection-techniques-for-machine-learning-based", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#comparative-study-of-feature-selection-techniques-for-machine-learning-based", "headline": "Sélection des variables d'entrée pour prévoir le rayonnement solaire par apprentissage automatique : cas de l'Algérie", "inLanguage": "en", "abstract": "Plusieurs techniques de sélection de variables comparées pour la prévision du rayonnement solaire par apprentissage automatique, dans les conditions climatiques algériennes.", "author": [{"@type": "Person", "name": "Saïd Benkaciali"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2025-07-12", "image": "https://www.cyrilvoyant.com/assets/img/98c7979fb52e.png"}}, {"@type": "ListItem", "position": 24, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#academic-visibility-why-publishing-isn-t-enough-anymore", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#academic-visibility-why-publishing-isn-t-enough-anymore", "headline": "Visibilité académique : pourquoi publier ne suffit plus", "inLanguage": "en", "abstract": "Un article sans grand espoir cité des centaines de fois, un autre, jugé meilleur, resté dans l'ombre : après vingt ans de recherche, publier ne suffit plus, il faut être trouvé et lu.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2025", "image": "https://www.cyrilvoyant.com/assets/img/0e72a8bbd5be.png"}}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/fr/actualites/nice-forecast-evaluation#page", "url": "https://www.cyrilvoyant.com/fr/actualites/nice-forecast-evaluation/", "name": "Métriques NICE : quand le RMSE masque une différence entre prévisions solaires", "description": "À trente minutes, le tableau de notre étude NICE rapporte une nRMSE médiane arrondie de 0,19 pour un modèle ELM comme pour un modèle autorégressif. Le score composite NICEΣ donne pourtant 0,75 contre 0,77, avec une différence statistiquement significative dans le test rapporté.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-5"}], "keywords": ["Démontrer la confiance", "Énergie"], "translationOfWork": {"@id": "https://www.cyrilvoyant.com/latest-publications-and-news/nice-forecast-evaluation#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Récits", "item": "https://www.cyrilvoyant.com/fr/recits/"}, {"@type": "ListItem", "position": 3, "name": "Métriques NICE : quand le RMSE masque une différence entre prévisions solaires", "item": "https://www.cyrilvoyant.com/fr/actualites/nice-forecast-evaluation/"}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/fr/actualites/why-extreme-learning-machines#page", "url": "https://www.cyrilvoyant.com/fr/actualites/why-extreme-learning-machines/", "name": "MIMO-ELM : sept signaux énergétiques de la Corse prévus par un seul modèle", "description": "À une heure d’horizon, notre modèle MIMO-ELM atteint une nRMSE de 0,179 pour le solaire et de 0,051 pour le thermique, avec R² supérieur à 0,98 pour ces deux séries. La demande totale conserve des prévisions jugées fiables jusqu’à cinq heures dans l’étude.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-3"}], "keywords": ["Apprendre frugalement", "Énergie"], "translationOfWork": {"@id": "https://www.cyrilvoyant.com/latest-publications-and-news/why-extreme-learning-machines#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Récits", "item": "https://www.cyrilvoyant.com/fr/recits/"},