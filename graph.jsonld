url": "https://doi.org/10.1016/j.apenergy.2026.127599"}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/fr/recits/satellite-irradiance/#page", "url": "https://www.cyrilvoyant.com/fr/recits/satellite-irradiance/", "name": "Prévision satellite de l'éclairement : une maille, un voisinage ou tout le champ", "description": "Un satellite voit l'éclairement de toute une région, heure par heure. La tentation est de donner toute la carte au modèle de prévision. Garder le même modèle et ne changer que ce qu'il lit montre ce que la carte apporte vraiment.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-3"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#elm", "name": "Extreme Learning Machine (ELM)", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/actualites/why-extreme-learning-machines/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#nrmse", "name": "nRMSE", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/recits/variabilite-memoire-previsibilite/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#persistence", "name": "Persistance", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/recits/variabilite-memoire-previsibilite/"}], "keywords": ["Apprendre frugalement", "Énergie"], "translationOfWork": {"@id": "https://www.cyrilvoyant.com/stories/satellite-irradiance/#page"}, "mentio