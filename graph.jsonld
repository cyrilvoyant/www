son", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "keywords": ["Compute directly", "Energy"], "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/recits/variabilite-memoire-previsibilite/#page"}, "about": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#persistence", "name": "Persistence", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/stories/variability-memory-forecastability/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#scv", "name": "sCV", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/why-forecast-solar-power/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#blend", "name": "BLEND", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/forecasting-with-less/"}], "mentions": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#cyclic-persistence", "name": "Cyclic persistence", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/forecasting-with-less/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#nice", "name": "NICE", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/nice-forecast-evaluation/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#clear-sky-index", "name": "Clear-sky index", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.co