Biffi"}, {"@type": "Person", "name": "Delphine Leschi"}, {"@type": "Person", "name": "Jérome Briançon"}, {"@type": "Person", "name": "Céline Lantieri Marcovici"}], "isPartOf": {"@type": "Periodical", "name": "Reports of Practical Oncology and Radiotherapy"}}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/fr/recits/questioning-research/#page", "url": "https://www.cyrilvoyant.com/fr/recits/questioning-research/", "name": "Se questionner sur nos façons de faire de la recherche : influence, intégrité, excellence", "description": "La recherche doit aussi examiner ses méthodes : influence indépendante de la taille, intégrité et excellence, chacune comparée à une référence explicite.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-5"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#fair", "name": "Principes FAIR", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/outils/autoevaluation-fair/"}], "keywords": ["Démontrer la confiance", "Pratique de la recherche"], "translationOfWork": {"@id": "https://www.cyrilvoyant.com/stories/questioning-research/#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Récits", "item": "https://www.cyrilvoyant.com/fr/recits/"}, {"@type": "ListItem", "position": 3, "name": "Se questionner sur nos façons de faire de la recherche : influence, intégrité, excellence", "item": "https://www.cyrilvoyant.com/fr/recits/questioning-research/"}]}, {"@type": "ScholarlyArticle", "@id": "https://doi.org/10.1098/rsos.260870", "url": "https://doi.org/10.1098/rsos.260870", "name": "Science-wide mapping of institutions based on affiliated authors' impact and research integrity proxies", "author": [{"@type": "Person", "name": "John P. A. Ioannidis", "sameAs": "https://orcid.org/0000-0003-3118-6859"}, {"@type": "Person", "name": "Jeroen Baas", "sameAs": "https://orcid.org/0000-0001-8005-4153"}, {"@type": "Person", "name": "Roy Boverhof", "sameAs": "https://orcid.org/0000-0002-7299-680X"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2026-10-14", "isPartOf": {"@type": "Periodical", "name": "Royal Society Open Science", "issn": "2054-5703"}, "volumeNumber": "13", "pagination": "260870", "license": "https://creativecommons.org/licenses/by/4.0/", "isAccessibleForFree": true, "isBasedOn": {"@id": "https://doi.org/10.17632/jn5j7gjpzj.1"}}, {"@type": "Dataset", "@id": "https://doi.org/10.17632/jn5j7gjpzj.1", "url": "https://data.mendeley.com/datasets/jn5j7gjpzj/1", "identifier": "https://doi.org/10.17632/jn5j7gjpzj.1", "name": "Data for \"Science-wide mapping and ranking of institutions based on affiliated authors\"", "description": "Institution-level data built from the August 2025 update of the science-wide author databases of standardized citation indicators (Scopus): authors, top-cited authors and research-integrity proxies (retractions, self-citations, discontinued titles) per institution.", "creator": [{"@type": "Person", "name": "Jeroen Baas", "sameAs": "https://orcid.org/0000-0001-8005-4153"}, {"@type": "Person", "name": "John P. A. Ioannidis", "sameAs": "https://orcid.org/0000-0003-3118-6859"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Roy Boverhof", "sameAs": "https://orcid.org/0000-0002-7299-680X"}], "publisher": {"@type": "Organization", "name": "Elsevier Data Repository (Mendeley Data)"}, "datePublished": "2025-12-17", "version": "1", "license": "https://creativecommons.org/licenses/by-nc-sa/4.0/", "isAccessibleForFree": true}, {"@type": "SoftwareSourceCode", "@id": "https://github.com/cyrilvoyant/influence-index-bibliometrics", "codeRepository": "https://github.com/cyrilvoyant/influence-index-bibliometrics", "name": "Influence Index: a log-based measure of research influence for institutions (MATLAB, processed data)", "identifier": "https://doi.org/10.5281/zenodo.19706465", "description": "I = log2(p / p0), p = X / N, p0 = 0.02: share of Top 2 % authors of an institution against a 2 % reference, on a doubling scale.", "programmingLanguage": "MATLAB", "license": "https://opensource.org/licenses/MIT", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Jeroen Baas", "sameAs": "https://orcid.org/0000-0001-8005-4153"}, {"@type": "Person", "name": "Roy Boverhof", "sameAs": "https://orcid.org/0000-0002-7299-680X"}, {"@type": "Person", "name": "Paolo Stringari", "sameAs": "https://orcid.org/0000-0002-5403-9328"}, {"@type": "Person", "name": "Mathilde Marchand-Lasserre", "sameAs": "https://orcid.org/0009-0003-9067-9570"}, {"@type": "Person", "name": "John P. A. Ioannidis", "sameAs": "https://orcid.org/0000-0003-3118-6859"}], "isBasedOn": {"@id": "https://doi.org/10.17632/jn5j7gjpzj.1"}}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/fr/recits/reference-prevision-solaire-deep-learning/#page", "url": "https://www.cyrilvoyant.com/fr/recits/reference-prevision-solaire-deep-learning/", "name": "Quelle référence une prévision solaire doit-elle battre ? Quand le deep learning vaut-il la peine ?", "description": "Tester la persistance, puis une référence qui connaît la phase, une autorégression et un ELM. Garder un réseau profond seulement s'il gagne à protocole égal.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-5"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#elm", "name": "Extreme Learning Machine (ELM)", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/actualites/why-extreme-learning-machines/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#nrmse", "name": "nRMSE", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/recits/variabilite-memoire-previsibilite/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#persistence", "name": "Persistance", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/recits/variabilite-memoire-previsibilite/"}], "keywords": ["Démontrer la confiance", "Énergie"], "translationOfWork": {"@id": "https://www.cyrilvoyant.com/stories/solar-forecast-baseline-deep-learning/#page"}, "mentions": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#smart-persistence", "name": "Persistance de l'indice de ciel clair", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/recits/evaluer-prevision-solaire-persistance/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#blend", "name": "BLEND", 