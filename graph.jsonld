twareSourceCode", "name": "NICEᵏ: normalized forecast errors compared with simple persistence (MATLAB)", "identifier": "https://doi.org/10.5281/zenodo.23562549", "codeRepository": "https://github.com/cyrilvoyant/nice-metrics", "license": "MIT"}}, {"@type": "ListItem", "position": 2, "item": {"@type": "SoftwareSourceCode", "name": "sCV and F: variability and forecastability of solar irradiance (MATLAB)", "identifier": "https://doi.org/10.5281/zenodo.23562553", "codeRepository": "https://github.com/cyrilvoyant/solar-variability-scv", "license": "MIT"}}, {"@type": "ListItem", "position": 3, "item": {"@type": "SoftwareSourceCode", "name": "The γ-index: tolerance-based validation of spatio-temporal forecast fields (MATLAB)", "identifier": "https://doi.org/10.5281/zenodo.21755936", "codeRepository": "https://github.com/cyrilvoyant/temporal-gamma-index", "license": "MIT"}}, {"@type": "ListItem", "position": 4, "item": {"@type": "SoftwareSourceCode", "name": "ARTU: second-order autoregressive reference method for solar radiation forecasting", "identifier": "https://doi.org/10.5281/zenodo.21755931", "codeRepository": "https://github.com/cyrilvoyant/ARTU", "license": "MIT"}}, {"@type": "ListItem", "position": 5, "item": {"@type": "SoftwareSourceCode", "name": "BLEND and CLIPER: persistence operators for cyclostationary energy processes (MATLAB)", "identifier": "https://doi.org/10.5281/zenodo.18812333", "codeRepository": "https://github.com/cyrilvoyant/cyclostationary-forecasting-matlab", "license": "MIT"}}, {"@type": "ListItem", "position": 6, "item": {"@type": "SoftwareSourceCode", "name": "Per-cell, spatial and compressed forecasters of satellite solar irradiance: benchmark code (MATLAB, Python)", "identifier": "https://doi.org/10.5281/zenodo.23562557", "codeRepository": "https://github.com/cyrilvoyant/cell-vs-field-irradiance", "license": "MIT"}}, {"@type": "ListItem", "position": 7, "item": {"@type": "SoftwareSourceCode", "name": "MIMO-ELM forecasting of the Corsican electricity mix (MATLAB, Python, EDF open data)", "identifier": "https://doi.org/10.5281/zenodo.23562559", "codeRepository": "https://github.com/cyrilvoyant/Data_Viz_2024", "license": "GPL-3.0"}}, {"@type": "ListItem", "position": 8, "item": {"@type": "SoftwareSourceCode", "name": "PV_ELM_pred: benchmark of persistence, BLEND, autoregression and ELM variants for PV forecasting (Python)", "identifier": "https://doi.org/10.5281/zenodo.21487267", "codeRepository": "https://github.com/cyrilvoyant/PV_ELM_pred", "license": "MIT"}}, {"@type": "ListItem", "position": 9, "item": {"@type": "SoftwareSourceCode", "name": "Make_Stationary: deseasonalization benchmark for renewable-energy time series (MATLAB)", "identifier": "https://doi.org/10.5281/zenodo.21490743", "codeRepository": "https://github.com/cyrilvoyant/Make_Stationary", "license": "GPL-3.0"}}, {"@type": "ListItem", "position": 10, "item": {"@type": "SoftwareSourceCode", "name": "Filter and wrapper diagnostics of dimensionality reduction for endogenous PV power forecasting (MATLAB)", "identifier": "https://doi.org/10.5281/zenodo.21755938", "codeRepository": "https://github.com/cyrilvoyant/pv-dimensionality-reduction", "license": "MIT"}}, {"@type": "ListItem", "position": 11, "item": {"@type": "SoftwareSourceCode", "name": "RAIR-Sim: compartmental simulator of radioactive iodine therapy response in metastatic thyroid cancer (MATLAB)", "identifier": "https://doi.org/10.5281/zenodo.21496197", "codeRepository": "https://github.com/cyrilvoyant/CTD_SIMU_RAI", "license": "MIT"}}, {"@type": "ListItem", "position": 12, "item": {"@type": "SoftwareSourceCode", "name": "Influence Index: a log-based measure of research influence for institutions (MATLAB, processed data)", "identifier": "https://doi.org/10.5281/zenodo.19706465", "codeRepository": "https://github.com/cyrilvoyant/influence-index-bibliometrics", "license": "MIT"}}, {"@type": "ListItem", "position": 13, "item": {"@type": "SoftwareSourceCode", "name": "LQL-Equiv 2014: biologically equivalent dose calculation in radiotherapy (MATLAB application)", "identifier": "https://doi.org/10.5281/zenodo.16739882", "codeRepository": "https://github.com/cyrilvoyant/LQ-Equiv", "license": "MIT"}}, {"@type": "ListItem", "position": 14, "item": {"@type": "SoftwareSourceCode", "name": "Tunnel Load Simulator: synthetic electricity demand of road tunnels (Python, Streamlit)", "identifier": "https://doi.org/10.5281/zenodo.20080042", "codeRepository": "https://github.com/cyrilvoyant/tunnel-load-simulator", "license": "MIT"}}, {"@type": "ListItem", "position": 15, "item": {"@type": "SoftwareSourceCode", "name": "LQL-Equiv-web 3.0: biologically equivalent doses in radiotherapy (Python, browser)", "identifier": "https://doi.org/10.5281/zenodo.21948623", "codeRepository": "https://github.com/cyrilvoyant/LQL-Equiv-web", "license": "MIT"}}]}, {"@type": "DefinedTermSet", "name": "Les mots de cette page", "inLanguage": "fr", "hasDefinedTerm": [{"@type": "DefinedTerm", "name": "DOI", "description": "Identifiant permanent d'un article ou d'un logiciel archivé : le lien reste valable même si le site change."}, {"@type": "DefinedTerm", "name": "Persistance / persistence", "description": "La prévision recopie la dernière valeur connue ; c'est la référence à battre."}, {"@type": "DefinedTerm", "name": "BLEND, CLIPER", "description": "Deux mélanges de références simples : la persistance avec la valeur d'un cycle plus tôt (BLEND), ou avec la moyenne (CLIPER)."}, {"@type": "DefinedTerm", "name": "ELM", "description": "Extreme learning machine : réseau de neurones à une couche cachée, aux poids d'entrée tirés au hasard ; seuls les poids de sortie sont calculés."}, {"@type": "DefinedTerm", "name": "MIMO", "description": "Plusieurs entrées, plusieurs sorties : un seul modèle prévoit plusieurs signaux."}, {"@type": "DefinedTerm", "name": "NICE", "description": "L'erreur d'une prévision divisée par celle de la persistance ; entre 0 et 1, la prévision apporte quelque chose."}, {"@type": "DefinedTerm", "name": "sCV, F", "description": "La variabilité due aux nuages et la prévisibilité d'un signal, calculées avant tout modèle."}, {"@type": "DefinedTerm", "name": "Indice γ / γ-index", "description": "Un test qui accepte de petits décalages en espace, en temps et en intensité."}, {"@type": "DefinedTerm", "name": "LQ, LQL", "description": "Modèles linéaire-quadratique et linéaire-quadratique-linéaire de l'effet d'une dose de rayonnement sur les tissus."}, {"@type": "DefinedTerm", "name": "BNCT", "description": "Thérapie par capture neutronique du bore."}, {"@type": "DefinedTerm", "name": "PV, EDF", "description": "Photovoltaïque ; Électricité de France."}, {"@type": "DefinedTerm", "name": "MATLAB", "description": "Un langage et un environnement de calcul numérique."}, {"@type": "DefinedTerm", "name": "CC BY 4.0", "description": "Licence Creative Commons Attribution : réutilisation libre, à condition de citer les auteurs."}, {"@type": "DefinedTerm", "name": "AI Act", "description": "Le règlement européen sur l'intelligence artificielle."}, {"@type": "DefinedTerm", "name": "RTVACOS", "description": "Sept critères : rigueur, transparence, visibilité, adoption, collaboration, diffusion, pertinence sociétale."}, {"@type": "DefinedTerm", "name": "ROC", "description": "Courbe ROC (receiver operating characteristic) : la sensibilité d'un test selon son taux de faux positifs."}, {"@type": "DefinedTerm", "name": "PASS, UE, B.U.T.", "description": "Parcours d'accès spécifique santé (première année des études de santé) ; unité d'enseignement ; bachelor universitaire de technologie."}]}, {"@type": ["WebPage", "CollectionPage"], "@id": "https://www.cyrilvoyant.com/glossary/#page", "url": "https://www.cyrilvoyant.com/glossary/", "name": "Glossary: forecasting, dose, physics and statistics", "description": "82 notions defined in one or two sentences, with unit, related notions and the page that details them: NICE, BLEND, BED, EQD2, Monte Carlo, p-value.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "dateModified": "2026-11-03", "mainEntity": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Glossary", "item": "https://www.cyrilvoyant.com/glossary/"}]}, {"@type": "DefinedTermSet", "@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts", "name": "Site concepts", "description": "82 notions defined in one or two sentences, with unit, related notions and the page that details them: NICE, BLEND, BED, EQD2, Monte Carlo, p-value.", "url": "https://www.cyrilvoyant.com/glossary/", "inLanguage": "en", "license": "https://creativecommons.org/licenses/by/4.0/", "creator": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "hasDefinedTerm": [{"@id": "https://www.cyrilvoyant.com/ontology/#forecasting"}, {"@id": "https://www.cyrilvoyant.com/ontology/#radiotherapy"}, {"@id": "https://www.cyrilvoyant.com/ontology/#medical-physics"}, {"@id": "https://www.cyrilvoyant.com/ontology/#statistics"}, {"@id": "https://www.cyrilvoyant.com/ontology/#thermal-physics"}, {"@id": "https://www.cyrilvoyant.com/ontology/#forecast-evaluation"}, {"@id": "https://www.cyrilvoyant.com/ontology/#persistence"}, {"@id": "https://www.cyrilvoyant.com/ontology/#cyclic-persistence"}, {"@id": "https://www.cyrilvoyant.com/ontology/#smart-persistence"}, {"@id": "https://www.cyrilvoyant.com/ontology/#climatological-mean"}, {"@id": "https://www.cyrilvoyant.com/ontology/#convex-combination"}, {"@id": "https://www.cyrilvoyant.com/ontology/#cliper"}, {"@id": "https://www.cyrilvoyant.com/ontology/#blend"}, {"@id": "https://www.cyrilvoyant.com/ontology/#artu"}, {"@id": "https://www.cyrilvoyant.com/ontology/#ar2"}, {"@id": "https://www.cyrilvoyant.com/ontology/#elm"}, {"@id": "https://www.cyrilvoyant.com/ontology/#mimo"}, {"@id": "https://www.cyrilvoyant.com/ontology/#horizon"}, {"@id": "https://www.cyrilvoyant.com/ontology/#clear-sky-index"}, {"@id": "https://www.cyrilvoyant.com/ontology/#difference-to-trend"}, {"@id": "https://www.cyrilvoyant.com/ontology/#ratio-to-trend"}, {"@id": "https://www.cyrilvoyant.com/ontology/#deseasonalization"}, {"@id": "https://www.cyrilvoyant.com/ontology/#rmse"}, {"@id": "https://www.cyrilvoyant.com/ontology/#mae"}, {"@id": "https://www.cyrilvoyant.com/ontology/#nrmse"}, {"@id": "https://www.cyrilvoyant.com/ontology/#nmae"}, {"@id": "https://www.cyrilvoyant.com/ontology/#nice"}, {"@id": "https://www.cyrilvoyant.com/ontology/#scv"}, {"@id": "https://www.cyrilvoyant.com/ontology/#forecastability-f"}, {"@id": "https://www.cyrilvoyant.com/ontology/#gamma-index"}, {"@id": "https://www.cyrilvoyant.com/ontology/#brownian-motion"}, {"@id": "https://www.cyrilvoyant.com/ontology/#memory-phi"}, {"@id": "https://www.cyrilvoyant.com/ontology/#malr"}, {"@id": "https://www.cyrilvoyant.com/ontology/#no-free-lunch"}, {"@id": "https://www.cyrilvoyant.com/ontology/#simulated-data"}, {"@id": "https://www.cyrilvoyant.com/ontology/#monte-carlo"}, {"@id": "https://www.cyrilvoyant.com/ontology/#percentile-band-p10-p90"}, {"@id": "https://www.cyrilvoyant.com/ontology/#tls"}, {"@id": "https://www.cyrilvoyant.com/ontology/#lq-model"}, {"@id": "https://www.cyrilvoyant.com/ontology/#lql-model"}, {"@id": "https://www.cyrilvoyant.com/ontology/#bed"}, {"@id": "https://www.cyrilvoyant.com/ontology/#eqd2"}, {"@id": "https://www.cyrilvoyant.com/ontology/#alpha-beta"}, {"@id": "https://www.cyrilvoyant.com/ontology/#transition-dose"}, {"@id": "https://www.cyrilvoyant.com/ontology/#fractionation"}, {"@id": "https://www.cyrilvoyant.com/ontology/#gray"}, {"@id": "https://www.cyrilvoyant.com/ontology/#lql-equiv"}, {"@id": "https://www.cyrilvoyant.com/ontology/#bnct"}, {"@id": "https://www.cyrilvoyant.com/ontology/#cross-section"}, {"@id": "https://www.cyrilvoyant.com/ontology/#macroscopic-cross-section"}, {"@id": "https://www.cyrilvoyant.com/ontology/#mean-free-path"}, {"@id": "https://www.cyrilvoyant.com/ontology/#compton-effect"}, {"@id": "https://www.cyrilvoyant.com/ontology/#attenuation"}, {"@id": "https://www.cyrilvoyant.com/ontology/#half-value-layer"}, {"@id": "https://www.cyrilvoyant.com/ontology/#thyroglobulin"}, {"@id": "https://www.cyrilvoyant.com/ontology/#doubling-time"}, {"@id": "https://www.cyrilvoyant.com/ontology/#p-value"}, {"@id": "https://www.cyrilvoyant.com/ontology/#student-t-test"}, {"@id": "https://www.cyrilvoyant.com/ontology/#chi-square-test"}, {"@id": "https://www.cyrilvoyant.com/ontology/#normal-distribution"}, {"@id": "https://www.cyrilvoyant.com/ontology/#roc-curve"}, {"@id": "https://www.cyrilvoyant.com/ontology/#r-squared"}, {"@id": "https://www.cyrilvoyant.com/ontology/#pearson-correlation"}, {"@id": "https://www.cyrilvoyant.com/ontology/#confidence-interval"}, {"@id": "https://www.cyrilvoyant.com/ontology/#prediction-interval"}, {"@id": "https://www.cyrilvoyant.com/ontology/#influential-point"}, {"@id": "https://www.cyrilvoyant.com/ontology/#biot-number"}, {"@id": "https://www.cyrilvoyant.com/ontology/#cop"}, {"@id": "https://www.cyrilvoyant.com/ontology/#carnot-efficiency"}, {"@id": "https://www.cyrilvoyant.com/ontology/#freezing"}, {"@id": "https://www.cyrilvoyant.com/ontology/#latent-heat"}, {"@id": "https://www.cyrilvoyant.com/ontology/#sensible-heat"}, {"@id": "https://www.cyrilvoyant.com/ontology/#research-data"}, {"@id": "https://www.cyrilvoyant.com/ontology/#fair"}, {"@id": "https://www.cyrilvoyant.com/ontology/#findable"}, {"@id": "https://www.cyrilvoyant.com/ontology/#accessible"}, {"@id": "https://www.cyrilvoyant.com/ontology/#interoperable"}, {"@id": "https://www.cyrilvoyant.com/ontology/#reusable"}, {"@id": "https://www.cyrilvoyant.com/ontology/#persistent-identifier"}, {"@id": "https://www.cyrilvoyant.com/ontology/#metadata"}, {"@id": "https://www.cyrilvoyant.com/ontology/#data-license"}, {"@id": "https://www.cyrilvoyant.com/ontology/#data-management-plan"}, {"@id": "https://www.cyrilvoyant.com/ontology/#jarque-bera"}, {"@id": "https://www.cyrilvoyant.com/ontology/#z-test"}, {"@id": "https://www.cyrilvoyant.com/ontology/#picp"}, {"@id": "https://www.cyrilvoyant.com/ontology/#split-conformal"}, {"@id": "https://www.cyrilvoyant.com/ontology/#gti"}, {"@id": "https://www.cyrilvoyant.com/ontology/#pv-curtailment"}]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#forecasting", "name": "Forecasting and evaluation", "description": "An error only makes sense against a reference: describe the signal, choose simple references, measure the gain, then add complexity only if the gain justifies it.", "termCode": "forecasting", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#forecasting", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["solar forecasting"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#radiotherapy", "name": "Radiotherapy", "description": "When the link between a radiotherapy schedule and its biological effect is known, it is computed directly with an explicit model, with no training data.", "termCode": "radiotherapy", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#radiotherapy", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["biological dose"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#medical-physics", "name": "Medical physics", "description": "How a beam of photons or neutrons crosses matter and deposits energy in it, from simple models to transport simulations.", "termCode": "medical-physics", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#medical-physics", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["radiation physics"], "sameAs": "http://www.wikidata.org/entity/Q1120908"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#statistics", "name": "Statistics", "description": "Compare a difference with its uncertainty, measure an association or a prediction, and read a result without over-interpreting it.", "termCode": "statistics", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#statistics", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["biostatistics"], "sameAs": "http://www.wikidata.org/entity/Q12483"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#thermal-physics", "name": "Thermal physics and thermodynamics", "description": "Heat exchange, engine and refrigeration cycles and Carnot limits, to size a cooling, a freezing or a heat engine.", "termCode": "thermal-physics", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#thermal-physics", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["industrial thermal physics"], "sameAs": "http://www.wikidata.org/entity/Q619452"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#forecast-evaluation", "name": "Forecast evaluation", "description": "An error only makes sense against a reference: same targets, stated scope, several error norms, then a test of the difference.", "termCode": "forecast-evaluation", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#forecast-evaluation", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["forecast verification"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#persistence", "name": "Persistence", "description": "The forecast copies the last known value. It is the minimal reference of any forecast.", "termCode": "persistence", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#persistence", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["simple persistence", "naive forecast"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#cyclic-persistence", "name": "Cyclic persistence", "description": "The forecast copies the value one cycle earlier, at the same moment of the cycle.", "termCode": "cyclic-persistence", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#cyclic-persistence", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["cyclic persistence"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#smart-persistence", "name": "Smart persistence", "description": "Persistence applied to the clear-sky index (SP: persistence of the clear-sky index), rather than to raw irradiance.", "termCode": "smart-persistence", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#smart-persistence", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["clear-sky-index persistence"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#climatological-mean", "name": "Mean", "description": "The forecast is always the mean of the past.", "termCode": "climatological-mean", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#climatological-mean", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["mean of the past", "climatological mean"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#convex-combination", "name": "Convex combination", "description": "Two forecasts weighed by positive weights adding up to 1, computed on the past. Persistence and the mean: CLIPER. Persistence and cyclic persistence: BLEND.", "termCode": "convex-combination", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#convex-combination", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["positive weights summing to 1"], "sameAs": "http://www.wikidata.org/entity/Q2627315"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#cliper", "name": "CLIPER", "description": "The convex combination of persistence and the mean. Same idea as BLEND, another partner.", "termCode": "cliper", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#cliper", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#blend", "name": "BLEND", "description": "The convex combination of persistence and cyclic persistence: two positive weights adding up to 1, λ and 1 − λ, computed at each moment of the cycle.", "termCode": "blend", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#blend", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["cyclostationary persistence"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#artu", "name": "ARTU", "description": "A second-order reference on the ratio to trend: two autocorrelations and a table give its three weights, on the last value, the value h steps earlier and the mean.", "termCode": "artu", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#artu", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["second-order reference"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#ar2", "name": "AR(2)", "description": "A regression on the last two known values. Raw: without removing the cycle. It measures what removing the cycle brings.", "termCode": "ar2", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#ar2", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["second-order autoregression"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#elm", "name": "Extreme learning machine (ELM)", "description": "The Extreme Learning Machine retains a random hidden layer and fits its output coefficients analytically, avoiding iterative deep-network training.", "termCode": "elm", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#elm", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["ELM", "frugal learner"], "sameAs": "http://www.wikidata.org/entity/Q21948731"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#mimo", "name": "MIMO (multiple-input multiple-output)", "description": "A multiple-input multiple-output architecture: one model reads the recent history of several signals and forecasts them together.", "termCode": "mimo", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#mimo", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["MIMO-ELM"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#horizon", "name": "Forecast horizon", "description": "The number of steps between the last known value and the value to forecast.", "termCode": "horizon", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#horizon", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["horizon"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#clear-sky-index", "name": "Clear-sky index", "description": "In solar forecasting, the ratio to the clear-sky trend: irradiance divided by clear-sky irradiance.", "termCode": "clear-sky-index", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#clear-sky-index", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["ratio to the clear-sky trend"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#difference-to-trend", "name": "Difference to trend", "description": "We study y − c, the gap to the cycle c. Suited to additive noise.", "termCode": "difference-to-trend", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#difference-to-trend", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["difference to trend"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#ratio-to-trend", "name": "Ratio to trend", "description": "We study y / c. Suited to multiplicative noise. With c as clear sky: the clear-sky index.", "termCode": "ratio-to-trend", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#ratio-to-trend", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["ratio to trend"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#deseasonalization", "name": "Deseasonalization", "description": "A known cycle is not forecast: remove it, forecast the rest, put it back.", "termCode": "deseasonalization", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#deseasonalization", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["removing the cycle", "seasonal adjustment"], "sameAs": "http://www.wikidata.org/entity/Q622893"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#rmse", "name": "RMSE", "description": "The root mean squared error. It gives large errors more weight than the MAE.", "termCode": "rmse", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#rmse", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["root mean squared error"], "sameAs": "http://www.wikidata.org/entity/Q29037"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#mae", "name": "MAE", "description": "The mean absolute error: the average of the absolute gaps between forecast and observation.", "termCode": "mae", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#mae", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["mean absolute error"], "sameAs": "http://www.wikidata.org/entity/Q6803609"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#nrmse", "name": "nRMSE", "description": "The RMSE divided by the mean of the signal (0 for a perfect forecast).", "termCode": "nrmse", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#nrmse", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["normalized RMSE"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#nmae", "name": "nMAE", "description": "The mean absolute error divided by the mean of the signal.", "termCode": "nmae", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#nmae", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["normalized MAE"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#nice", "name": "NICE", "description": "The forecast error divided by that of persistence, at the same dates and horizon. 0: perfect. 1: as much error as persistence. Above 1 it is written “> 1”: worse than persistence.", "termCode": "nice", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#nice", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["NICEᵏ", "NICEΣ", "NICE index"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#scv", "name": "sCV", "description": "A dimensionless departure from the clear-sky curve, normalized by that curve’s scale and the chosen diffuse floor. 0: clear sky; 1: the reference case of equally likely random switching between clear sky and that floor, not an upper bound.", "termCode": "scv", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#scv", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["stochastic coefficient of variation"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#forecastability-f", "name": "Forecastability F", "description": "F = 1 + sCV × (ρmax − 1), between 1 − sCV and 1. The higher it is, the easier that horizon is to forecast.", "termCode": "forecastability-f", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#forecastability-f", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["F indicator", "forecastability"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#gamma-index", "name": "γ-index", "description": "For each forecast pixel, the distance to the nearest observation in space, time and intensity, each divided by its tolerance. γ ≤ 1: accepted.", "termCode": "gamma-index", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#gamma-index", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["gamma index"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#brownian-motion", "name": "Brownian motion", "description": "Each value is the previous one plus a random draw: memory φ = 1. Persistence wins on it.", "termCode": "brownian-motion", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#brownian-motion", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#memory-phi", "name": "Memory φ", "description": "The correlation between two neighbouring values of the noise. 0: none. 1: total.", "termCode": "memory-phi", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#memory-phi", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["noise memory"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#malr", "name": "MALR (mean absolute log return)", "description": "A parameter borrowed from econometrics that describes the size of relative changes. This empirical diagnostic does not replace testing the model at the intended site and horizon.", "termCode": "malr", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#malr", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["mean absolute log return"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#no-free-lunch", "name": "“No free lunch”", "description": "Under a uniform average over all functions of a finite problem, the average performance of the search algorithms considered coincides. This precise framework is not the distribution of real solar problems.", "termCode": "no-free-lunch", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#no-free-lunch", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["no free lunch theorems"], "sameAs": "http://www.wikidata.org/entity/Q255847"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#simulated-data", "name": "Simulated data", "description": "When there are no measurements yet, no model can be trained or validated, but what is known can be simulated: a first estimate, not a measurement.", "termCode": "simulated-data", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#simulated-data", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["synthetic data"], "sameAs": "http://www.wikidata.org/entity/Q7662746"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#monte-carlo", "name": "Monte Carlo", "description": "Simulating many times with different random draws. More histories reduce the statistical error, as 1/√N for N histories; they correct neither a wrong geometry nor wrong physical data.", "termCode": "monte-carlo", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#monte-carlo", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["Monte Carlo method", "Monte-Carlo"], "sameAs": "http://www.wikidata.org/entity/Q232207"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#percentile-band-p10-p90", "name": "P10–P90 band", "description": "P10 and P90 are the 10th and 90th percentiles of the simulated results: the P10–P90 band contains the central 80 %. It describes variation between runs under the chosen parameters, not all uncertainty about a real system.", "termCode": "percentile-band-p10-p90", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#percentile-band-p10-p90", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["P10 and P90", "median and P10–P90 band"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#tls", "name": "Tunnel Load Simulator (TLS)", "description": "An open-source application that builds the electricity demand of a road tunnel from its geometry, traffic, lighting and ventilation, says how uncertain it is and states its limits.", "termCode": "tls", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#tls", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["TLS", "tunnel load simulator"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#lq-model", "name": "Linear-quadratic model (LQ)", "description": "The BED of a fraction grows along a curve with dose, at all doses: the LQ curve keeps bending upward as the dose per fraction grows.", "termCode": "lq-model", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#lq-model", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["LQ"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#lql-model", "name": "Linear-quadratic-linear model (LQL)", "description": "The same curve as LQ up to the transition dose, then a straight line. Below the transition dose, the two models are identical.", "termCode": "lql-model", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#lql-model", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["LQL"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#bed", "name": "Biologically effective dose (BED)", "description": "Dose in grays that makes different fractionations comparable. For n fractions of dose d, the LQ model gives BED = n · d · (1 + d / (α/β)).", "termCode": "bed", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#bed", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["BED", "biological effective dose"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#eqd2", "name": "Equivalent dose in 2 Gy fractions (EQD2)", "description": "The translation of the BED into a dose given in 2 Gy fractions: EQD2 = BED / (1 + 2/(α/β)).", "termCode": "eqd2", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#eqd2", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["EQD2"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#alpha-beta", "name": "α/β ratio", "description": "A tissue-specific parameter: it describes how sensitive a tissue is to the size of each fraction. The lower it is, the more sensitive the tissue is to the dose per fraction (about 3.9 Gy for the rectum).", "termCode": "alpha-beta", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#alpha-beta", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["α/β"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#transition-dose", "name": "Transition dose dT", "description": "The dose per fraction at which the LQL model changes from a curve to a straight line (7.8 Gy for the rectum). In the LQL-Equiv library it equals 2 α/β.", "termCode": "transition-dose", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#transition-dose", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["dT"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#fractionation", "name": "Fractionation", "description": "For n fractions (the number of treatment sessions), each delivering a dose d in grays, physical dose is not enough to predict the biological effect, which also depends on the dose received at each fraction.", "termCode": "fractionation", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#fractionation", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["fractions", "treatment schedule"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#gray", "name": "Gray (Gy)", "description": "The unit of absorbed physical dose: the energy deposited per kilogram of tissue.", "termCode": "gray", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#gray", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#lql-equiv", "name": "LQL-Equiv", "description": "A free, open-source (MIT) calculator of BED and EQD2 under the LQ and LQL models, in the browser. A research and teaching tool, not a medical device.", "termCode": "lql-equiv", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#lql-equiv", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["BED and EQD2 calculator"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#bnct", "name": "BNCT (boron neutron capture therapy)", "description": "A compound carries boron-10 to the target tissue; when this boron captures a neutron, an alpha particle and a lithium-7 nucleus deposit their energy over a few micrometres.", "termCode": "bnct", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#bnct", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["boron neutron capture therapy"], "sameAs": "http://www.wikidata.org/entity/Q71676169"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#cross-section", "name": "Cross section", "description": "It says how readily a nucleus reacts with a neutron of energy E. It is expressed as an area, often in barns, without being the size of the nucleus or, by itself, the probability of capture.", "termCode": "cross-section", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#cross-section", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["neutron cross section", "σ(E)"], "sameAs": "http://www.wikidata.org/entity/Q751259"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#macroscopic-cross-section", "name": "Macroscopic cross section", "description": "The cross section multiplied by the number of nuclei per unit volume: an inverse length. For a mixture, Σ adds these products nucleus by nucleus.", "termCode": "macroscopic-cross-section", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#macroscopic-cross-section", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["Σ"], "sameAs": "http://www.wikidata.org/entity/Q98280520"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#mean-free-path", "name": "Mean free path", "description": "The inverse of the macroscopic cross section, L = 1/Σ: the average distance between two collisions.", "termCode": "mean-free-path", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#mean-free-path", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["L = 1/Σ"], "sameAs": "http://www.wikidata.org/entity/Q756307"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#compton-effect", "name": "Compton scattering", "description": "The scattering of a photon on an electron: the photon loses energy and the electron receives a kinetic energy K. The rest energy of the electron is 511 keV.", "termCode": "compton-effect", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#compton-effect", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["Compton effect"], "sameAs": "http://www.wikidata.org/entity/Q171516"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#attenuation", "name": "Attenuation", "description": "Each thickness equal to the half-value layer halves what remains: it is an exponential decay, not a subtraction.", "termCode": "attenuation", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#attenuation", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["exponential decay"], "sameAs": "http://www.wikidata.org/entity/Q2357982"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#half-value-layer", "name": "Half-value layer (HVL)", "description": "The thickness of material that halves the intensity transmitted without scattering: HVL = ln 2 / μ, with μ the linear attenuation coefficient.", "termCode": "half-value-layer", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#half-value-layer", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["HVL", "half-value thickness"], "sameAs": "http://www.wikidata.org/entity/Q127526"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#thyroglobulin", "name": "Thyroglobulin (Tg)", "description": "The blood marker followed by the radioiodine therapy model.", "termCode": "thyroglobulin", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#thyroglobulin", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["Tg"], "sameAs": "http://www.wikidata.org/entity/Q412228"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#doubling-time", "name": "Doubling time", "description": "The time, in months, for the number of tumour cells to double without treatment: 9.8 months for the refractory profile, 66.6 for the responder profile in the paper.", "termCode": "doubling-time", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#doubling-time", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["Td"], "sameAs": "http://www.wikidata.org/entity/Q1424376"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#p-value", "name": "p-value", "description": "The probability, if the means are equal (or ρ = 0) and the model is correct, of a result at least as extreme. It is not the probability that the hypothesis is true; it does not measure the importance of an association.", "termCode": "p-value", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#p-value", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["p value"], "sameAs": "http://www.wikidata.org/entity/Q253255"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#student-t-test", "name": "Student t-test", "description": "The test divides the difference between two means by its standard error: the same difference can stand out from sampling chance or drown in it. Significant does not mean important.", "termCode": "student-t-test", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#student-t-test", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["t-test"], "sameAs": "http://www.wikidata.org/entity/Q309479"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#chi-square-test", "name": "Chi-square test", "description": "The statistic is the sum of the contributions (O−E)²/E, with O the observed count and E the count expected under the tested hypothesis. A small p-value says the departure is hardly compatible with the hypothesis, not that it is large.", "termCode": "chi-square-test", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#chi-square-test", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["chi-squared test", "χ²"], "sameAs": "http://www.wikidata.org/entity/Q1071004"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#normal-distribution", "name": "Normal distribution", "description": "The z-score is the number of standard deviations between x and the mean; Φ(z) is the probability that a standard normal variable stays below z: the area to the left of z.", "termCode": "normal-distribution", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#normal-distribution", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["Gaussian distribution", "z-score"], "sameAs": "http://www.wikidata.org/entity/Q133871"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#roc-curve", "name": "ROC curve", "description": "Sensitivity against the false-positive rate 1 − Sp as the threshold varies. The area under the curve (AUC) summarizes the test without choosing a threshold.", "termCode": "roc-curve", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#roc-curve", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["AUC", "sensitivity and specificity"], "sameAs": "http://www.wikidata.org/entity/Q327120"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#r-squared", "name": "Coefficient of determination R²", "description": "The share of variation described by the line (1 for a perfect forecast). It does not measure the importance of the association.", "termCode": "r-squared", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#r-squared", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["R²"], "sameAs": "http://www.wikidata.org/entity/Q192830"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#pearson-correlation", "name": "Pearson correlation", "description": "The Pearson correlation in the scatter (r) and in the population (ρ).", "termCode": "pearson-correlation", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#pearson-correlation", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["correlation coefficient r"], "sameAs": "http://www.wikidata.org/entity/Q1136628"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#confidence-interval", "name": "Confidence interval", "description": "It brackets the mean of y at x₀ (95 % band, Student quantile with n − 2 degrees of freedom).", "termCode": "confidence-interval", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#confidence-interval", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "sameAs": "http://www.wikidata.org/entity/Q208498"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#prediction-interval", "name": "Prediction interval", "description": "It brackets a new observation at x₀: add 1 under the root, hence a band wider than the confidence interval.", "termCode": "prediction-interval", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#prediction-interval", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "sameAs": "http://www.wikidata.org/entity/Q1106171"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#influential-point", "name": "Influential point", "description": "A point that moves the least-squares line; leverage is its potential weight, greater the farther it lies in x.", "termCode": "influential-point", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#influential-point", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["leverage"], "sameAs": "http://www.wikidata.org/entity/Q16908492"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#biot-number", "name": "Biot number", "description": "Internal conduction resistance compared with surface convection resistance.", "termCode": "biot-number", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#biot-number", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["Bi"], "sameAs": "http://www.wikidata.org/entity/Q864844"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#cop", "name": "Coefficient of performance (COP)", "description": "Heat extracted from the cold reservoir per unit of work supplied. COP > 1 is normal: it is not a percentage efficiency. Carnot limit: the maximum COP of a reversible machine between two reservoirs.", "termCode": "cop", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#cop", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["COP"], "sameAs": "http://www.wikidata.org/entity/Q902090"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#carnot-efficiency", "name": "Carnot efficiency", "description": "Efficiency η is the work W divided by the heat received Qhot; ηCarnot is its limit, reached by a reversible cycle, with no friction and no temperature gap during exchanges.", "termCode": "carnot-efficiency", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#carnot-efficiency", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["Carnot engine", "Carnot limit"], "sameAs": "http://www.wikidata.org/entity/Q93949862"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#freezing", "name": "Freezing", "description": "The energy to remove to freeze a mass of water: sensible heat (mcΔT) plus latent heat, with no temperature change in this model; average power is energy divided by duration.", "termCode": "freezing", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#freezing", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["freezing energy"], "sameAs": "http://www.wikidata.org/entity/Q108000"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#latent-heat", "name": "Latent heat", "description": "The heat removed to freeze the water, with no temperature change in this model.", "termCode": "latent-heat", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#latent-heat", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "sameAs": "http://www.wikidata.org/entity/Q207721"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#sensible-heat", "name": "Sensible heat", "description": "The heat exchanged when temperature changes: the term mcΔT, with c the specific heat capacity and ΔT the temperature change.", "termCode": "sensible-heat", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#sensible-heat", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "sameAs": "http://www.wikidata.org/entity/Q1480581"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#research-data", "name": "Research data", "description": "The measurements, observations and simulations on which results rest: a model is only as good as its data, which must be qualified, described and licensed.", "termCode": "research-data", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#research-data", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["scientific data"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#fair", "name": "FAIR principles", "description": "Four principles that make data findable, accessible, interoperable and reusable, by humans and by machines.", "termCode": "fair", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#fair", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["FAIR", "FAIR data"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#findable", "name": "Findable", "description": "First FAIR principle: data with a persistent identifier, described by rich metadata and listed in a catalog or repository where they can be searched.", "termCode": "findable", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#findable", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["F in FAIR"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#accessible", "name": "Accessible", "description": "Second FAIR principle: data and metadata retrievable from their identifier through an open, standard protocol (for example HTTPS), with authentication where needed; the metadata remain accessible even when the data no longer are.", "termCode": "accessible", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#accessible", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["A in FAIR"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#interoperable", "name": "Interoperable", "description": "Third FAIR principle: data and metadata in shared formats and vocabularies (for example NetCDF-CF), readable by other software and linked to other data.", "termCode": "interoperable", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#interoperable", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["I in FAIR", "interoperability"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#reusable", "name": "Reusable", "description": "Fourth FAIR principle: data that others can reuse, thanks to a clear license, a described provenance and community standards.", "termCode": "reusable", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#reusable", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["R in FAIR"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#persistent-identifier", "name": "Persistent identifier", "description": "Identifier that designates an object (dataset, software, article, person) for the long term, even if its web address changes: DOI (Digital Object Identifier) for data and publications, ORCID for researchers.", "termCode": "persistent-identifier", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#persistent-identifier", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["PID", "DOI"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#metadata", "name": "Metadata", "description": "Data that describe data: title, authors, period, place, variables, units, instrument, time step, processing; what one needs to know to find and reuse a dataset without opening the file.", "termCode": "metadata", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#metadata", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["metadata record"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#data-license", "name": "Data license", "description": "Text that states what anyone may do with the data (copy, modify, redistribute, commercial use or not), for example CC BY (Creative Commons Attribution); without a license, nobody knows what they may do.", "termCode": "data-license", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#data-license", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["CC BY license"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#data-management-plan", "name": "Data management plan", "description": "Document that describes how the data of a project will be produced, described, stored and shared, often required by funders; it prepares FAIR data from the start of the project.", "termCode": "data-management-plan", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#data-management-plan", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["DMP"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#jarque-bera", "name": "Jarque–Bera test", "description": "Combines skewness and excess kurtosis to assess normality. The chi-square cutoff is asymptotic.", "termCode": "jarque-bera", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#jarque-bera", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#z-test", "name": "z test", "description": "Compares a sample mean with a reference value in standard-error units when the population standard deviation is known.", "termCode": "z-test", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#z-test", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#picp", "name": "Prediction interval coverage probability (PICP)", "description": "Fraction of test observations that fall between the bounds of their prediction intervals.", "termCode": "picp", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#picp", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#split-conformal", "name": "Split conformal prediction", "description": "Calibrates a margin on errors from a set separate from training. The theoretical guarantee assumes exchangeable scores.", "termCode": "split-conformal", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#split-conformal", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#gti", "name": "Global tilted irradiance (GTI)", "description": "Incident solar power per unit area in the tilted plane of a photovoltaic array, measured in W/m².", "termCode": "gti", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#gti", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#pv-curtailment", "name": "Photovoltaic curtailment", "description": "A limit on exported power below what the array could produce. The announcement may or may not be known at forecast issue time.", "termCode": "pv-curtailment", "inLanguage": "en", "url": "https://www.cyrilvoyant.com/glossary/#pv-curtailment", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}}, {"@type": "WebPage", "@id": "https://www.cyrilvoyant.com/#page", "url": "https://www.cyrilvoyant.com/", "name": "Understand before you compute", "description": "Cyril Voyant, Mines Paris–PSL: rigorous science with sufficient tools; add complexity only when it brings a demonstrated benefit.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-2"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#persistence", "name": "Persistence", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/stories/variability-memory-forecastability/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#elm", "name": "Extreme learning machine (ELM)", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/why-extreme-learning-machines/"}], "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/#page"}, "mentions": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#gamma-index", "name": "γ-index", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/gamma-index-forecast-validation/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#prediction-interval", "name": "Prediction interval", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/regression-intervals/"}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}]}, {"@type": "WebSite", "@id": "https://www.cyrilvoyant.com/#website", "url": "https://www.cyrilvoyant.com/", "name": "Cyril Voyant", "inLanguage": ["en", "fr"], "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/", "givenName": "Cyril", "familyName": "Voyant", "jobTitle": ["Research Director", "Directeur de Recherche (DR2)", "Visiting Professor"], "image": "https://cyrilvoyant.github.io/assets/cyril-voyant-200.jpg", "worksFor": {"@type": "Organization", "@id": "https://www.minesparis.psl.eu/#organization", "name": "Mines Paris – PSL University", "url": "https://www.minesparis.psl.eu/"}, "affiliation": [{"@type": "Organization", "@id": "https://www.minesparis.psl.eu/#organization", "name": "Mines Paris – PSL University", "url": "https://www.minesparis.psl.eu/"}, {"@type": "Organization", "@id": "https://www.oie.minesparis.psl.eu/#organization", "name": "Centre Observation, Impacts, Énergie (O.I.E.)", "url": "https://www.oie.minesparis.psl.eu/"}, {"@type": "Organization", "@id": "https://fin.kg.ac.rs/#organization", "name": "Faculty of Engineering, University of Kragujevac", "url": "https://fin.kg.ac.rs/en/"}], "hasOccupation": [{"@type": "Occupation", "name": "Editorial Board Member, Scientific Reports"}, {"@type": "Occupation", "name": "Editorial Board Member, Sustainability"}], "memberOf": [{"@type": "Organization", "name": "European Technology and Innovation Platform for Photovoltaics (ETIP PV)", "url": "https://etip-pv.eu/"}, {"@type": "Organization", "name": "Scientific Reports (Nature Portfolio), Editorial Board", "url": "https://www.nature.com/srep/about/editors"}, {"@type": "Organization", "name": "Sustainability (MDPI), Editorial Board, Energy Sustainability section", "url": "https://www.mdpi.com/journal/sustainability/sectioneditors/energy_sustainability"}], "mainEntityOfPage": "https://www.cyrilvoyant.com/", "sameAs": ["https://orcid.org/0000-0003-0242-7377", "https://www.wikidata.org/wiki/Q58251573", "https://scholar.google.com/citations?user=aUlP6agAAAAJ", "https://cv.hal.science/cyril-voyant", "https://github.com/cyrilvoyant", "https://www.linkedin.com/in/cyril-voyant-2a7767192/", "https://person.cyrilvoyant.com/", "https://www.cyrilvoyant.com/", "https://cyrilvoyant.github.io/"], "knowsAbout": ["Hybrid modeling", "Solar forecasting", "Forecast evaluation", "Frugal artificial intelligence", "Radiobiology", "Medical physics", "Language models as interfaces to scientific codes"]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/forecasting-with-less/#page", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/forecasting-with-less/", "name": "BLEND: a better persistence forecast without training a neural network", "description": "Accounting for daily phase (the time of day) improves persistence forecasts (which repeat the last measurement) on the solar series studied, with differences widening at longer lead times (the delay between the last measurement and the forecast time).", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-2"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#blend", "name": "BLEND", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/forecasting-with-less/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#persistence", "name": "Persistence", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/stories/variability-memory-forecastability/"}], "keywords": ["Hybridize", "Energy"], "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/actualites/forecasting-with-less/#page"}, "mentions": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#cliper", "name": "CLIPER", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/forecasting-with-less/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#cyclic-persistence", "name": "Cyclic persistence", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/forecasting-with-less/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#nrmse", "name": "nRMSE", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/stories/variability-memory-forecastability/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#convex-combination", "name": "Convex combination", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/stories/variability-memory-forecastability/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#horizon", "name": "Forecast horizon", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/stories/variability-memory-forecastability/"}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Stories", "item": "https://www.cyrilvoyant.com/stories/"}, {"@type": "ListItem", "position": 3, "name": "BLEND: a better persistence forecast without training a neural network", "item": "https://www.cyrilvoyant.com/latest-publications-and-news/forecasting-with-less/"}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/gamma-index-forecast-validation/#page", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/gamma-index-forecast-validation/", "name": "The γ-index: validating displaced solar forecasts beyond pointwise errors", "description": "In the synthetic experiment of the gamma-index paper (the γ-index accepts a forecast pixel, a point of the forecast map, when an observation close enough in space, time and intensity agrees with it), more than 80% of pixels remain acceptable despite an approximately two-kilometre spatial…", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-5"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#gamma-index", "name": "γ-index", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/gamma-index-forecast-validation/"}], "keywords": ["Demonstrate trust", "Energy"], "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/actualites/gamma-index-forecast-validation/#page"}, "mentions": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#rmse", "name": "RMSE", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/stories/evaluate-solar-forecast-persistence/"}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Stories", "item": "https://www.cyrilvoyant.com/stories/"}, {"@type": "ListItem", "position": 3, "name": "The γ-index: validating displaced solar forecasts beyond pointwise errors", "item": "https://www.cyrilvoyant.com/latest-publications-and-news/gamma-index-forecast-validation/"}]}, {"@type": "CollectionPage", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#page", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/", "name": "News: publications, software and essays", "description": "All research news of Cyril Voyant on one page: papers with their co-authors, software releases, appointments and essays, filterable by theme and year.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/actualites/#page"}, "about": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#nice", "name": "NICE", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/nice-forecast-evaluation/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#elm", "name": "Extreme learning machine (ELM)", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "htt