-news/gamma-index-forecast-validation/#page"}, "mentions": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#rmse", "name": "RMSE", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/recits/evaluer-prevision-solaire-persistance/"}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Récits", "item": "https://www.cyrilvoyant.com/fr/recits/"}, {"@type": "ListItem", "position": 3, "name": "L'indice γ : valider des prévisions solaires décalées au-delà des erreurs ponctuelles", "item": "https://www.cyrilvoyant.com/fr/actualites/gamma-index-forecast-validation/"}]}, {"@type": "CollectionPage", "@id": "https://www.cyrilvoyant.com/fr/actualites/#page", "url": "https://www.cyrilvoyant.com/fr/actualites/", "name": "Actualités : publications, logiciels et essais", "description": "Toutes les actualités de recherche de Cyril Voyant sur une page : articles et coauteurs, logiciels, nominations et essais, filtrables par thème et par année.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "translationOfWork": {"@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#page"}, "about": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#nice", "name": "NICE", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/outils/nice/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#elm", "name": "Extreme Learning Machine (ELM)", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/actualites/why-extreme-learning-machines/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#metadata", "name": "Métadonnées", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/donnees/"}], "mentions": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#nmae", "name": "nMAE", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/recits/variabilite-memoire-previsibilite/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#nrmse", "name": "nRMSE", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/recits/variabilite-memoire-previsibilite/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#rmse", "name": "RMSE", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/recits/evaluer-prevision-solaire-persistance/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#scv", "name": "sCV", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/outils/variabilite-previsibilite/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#forecastability-f", "name": "Prévisibilité F", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/outils/variabilite-previsibilite/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#gamma-index", "name": "Indice γ", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/outils/indice-gamma/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#persistence", "name": "Persistance", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/recits/variabilite-memoire-previsibilite/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#mimo", "name": "MIMO (multi-entrée multi-sortie)", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/actualites/why-extreme-learning-machines/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#bed", "name": "Dose biologique efficace (BED)", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/outils/doses-lq-lql/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#blend", "name": "BLEND", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/outils/blend/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#lql-equiv", "name": "LQL-Equiv", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/recits/lql-equiv/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#clear-sky-index", "name": "Indice de ciel clair", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/recits/variabilite-memoire-previsibilite/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#lql-model", "name": "Modèle linéaire-quadratique-linéaire (LQL)", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/outils/doses-lq-lql/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#tls", "name": "Tunnel Load Simulator (TLS)", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/recits/tunnel-load-simulator/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#fair", "name": "Principes FAIR", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/outils/autoevaluation-fair/"}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Actualités", "item": "https://www.cyrilvoyant.com/fr/actualites/"}]}, {"@type": "ItemList", "name": "Actualités", "numberOfItems": 24, "itemListElement": [{"@type": "ListItem", "position": 1, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance/", "headline": "Édition scientifique : sans vérification des données et du code, pas de confiance", "inLanguage": "fr", "abstract": "Les articles indexés ont crû d'environ 47 % entre 2016 et 2022, la relecture repose sur un travail gratuit et 2023 a battu le record des rétractations. Un court essai sur ce qui existe, des données FAIR à l'AI Act, et ce qui manque : vérifier les données et le code publiés.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2026-10-24", "image": "https://www.cyrilvoyant.com/assets/articles/scientific-publishing-growth.svg"}}, {"@type": "ListItem", "position": 2, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/fr/actualites/", "headline": "ELECTRE, projet phare de l'institut Carnot M.I.N.E.S : électrifier les usages, journée de clôture le 18 novembre 2026", "inLanguage": "fr", "abstract": "ELECTRE fédère une quinzaine de laboratoires, centres et instituts de l'institut Carnot M.I.N.E.S autour de 13 projets de recherche (2023-2026) sur l'électrification des usages, des matériaux au stockage, aux procédés industriels et aux limites de l'électrification. Sa journée de clôture a lieu le 18 novembre 2026 à Mines Paris – PSL, Sophia Antipolis.", "author": [{"@type": "Person", "name": "Delphine Gilges-Crampont", "sameAs": "https://www.idref.fr/292140282"}, {"@type": "Person", "name": "Annette Massias", "sameAs": "https://www.linkedin.com/in/annette-massias-46544630/"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2026-10-23", "image": "https://www.cyrilvoyant.com/assets/news/electre.png"}}, {"@type": "ListItem", "position": 3, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/fr/actualites/", "headline": "Professeur invité à l'université de Kragujevac (Serbie)", "inLanguage": "en", "abstract": "Nommé professeur invité à la faculté d'ingénierie de l'université de Kragujevac, avec mon collègue et ami Gilles Notton.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}], "datePublished": "2026", "image": "https://www.cyrilvoyant.com/assets/img/e127601c2891.png"}}, {"@type": "ListItem", "position": 4, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/fr/actualites/", "headline": "Tunnel Load Simulator : générer la consommation électrique des tunnels routiers", "inLanguage": "en", "abstract": "Application libre (Streamlit), développée dans le projet SmartTunnel, qui produit des profils de charge électrique synthétiques pour les tunnels routiers : éclairage, ventilation, auxiliaires, trafic, saisons et événements aléatoires.", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "datePublished": "2026-05-08", "image": "https://www.cyrilvoyant.com/assets/img/e326492cab74.jpg"}}, {"@type": "ListItem", "position": 5, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/fr/actualites/", "headline": "Quand la lumière du soleil n'est plus directe : prévoir la fraction diffuse", "inLanguage": "en", "abstract": "Le rayonnement diffus est l'une des composantes les plus difficiles de la ressource solaire, surtout là où aérosols, humidité et contrastes climatiques sont forts. Mesure et prévision de la fraction diffuse en Arabie saoudite, avec un modèle hybride par empilement.", "author": [{"@type": "Person", "name": "Haifa Harrouch", "sameAs": "https://orcid.org/0009-0001-5988-4803"}, {"@type": "Person", "name": "Nadjem Bailek", "sameAs": "https://orcid.org/0000-0001-9051-8548"}, {"@type": "Person", "name": "Bilel Zerouali", "sameAs": "https://orcid.org/0000-0003-4735-9750"}, {"@type": "Person", "name": "Ilyes Abidi", "sameAs": "https://orcid.org/0000-0002-9769-0188"}, {"@type": "Person", "name": "Hanene Guesmi", "sameAs": "https://orcid.org/0009-0000-2389-1406"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Jihad A. Younis", "sameAs": "https://orcid.org/0000-0001-7116-3251"}, {"@type": "Person", "name": "Maher Jebali & Rabab Triki"}], "datePublished": "2026-04-28", "image": "https://www.cyrilvoyant.com/assets/img/500e36c2208c.png"}}, {"@type": "ListItem", "position": 6, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/fr/actualites/forecasting-with-less/", "headline": "Revisiter la persistance : BLEND, une prévision sous contrainte de symétrie pour les processus énergétiques périodiques", "inLanguage": "en", "abstract": "La persistance revisitée pour les séries à statistiques périodiques, comme le cycle journalier de l'éclairement solaire. BLEND combine la dernière observation et l'observation alignée sur la même phase du cycle. La persistance est la prévision qui recopie la dernière valeur connue.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Candice Banes", "sameAs": "https://orcid.org/0009-0003-6656-8168"}, {"@type": "Person", "name": "Luis Garcia-Gutierrez", "sameAs": "https://orcid.org/0000-0002-3480-1784"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "name": "Milan Despotovic", "sameAs": "https://orcid.org/0000-0003-3144-5945"}, {"@type": "Person", "name": "Zaher Mundher Yaseen", "sameAs": "https://orcid.org/0000-0003-3344-214X"}], "datePublished": "2026-04-24", "image": "https://www.cyrilvoyant.com/assets/img/e8e0bf76adbb.jpg"}}, {"@type": "ListItem", "position": 7, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/fr/actualites/gamma-index-forecast-validation/", "headline": "Des pixels aux tolérances : valider les prévisions avec l'indice γ", "inLanguage": "en", "abstract": "Les métriques classiques comme la RMSE (racine de l'erreur quadratique moyenne) jugent une prévision comme si chaque pixel devait coïncider parfaitement dans l'espace et le temps. L'indice γ accepte un décalage toléré, comme le fait un expert.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2026-03-28", "image": "https://www.cyrilvoyant.com/assets/img/7f20ac04a02f.png"}}, {"@type": "ListItem", "position": 8, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/fr/actualites/", "headline": "Excellence scientifique à l’ère de l’IA : du SEO au GEO", "inLanguage": "fr", "abstract": "La production scientifique mondiale connaît une croissance sans précédent, amplifiée par l’essor des modèles d’intelligence artificielle générative. Dans ce contexte, la question n’est plus seulement de produire du savoir, mais d’en garantir la visibilité, la robustesse et la réutilisabilité.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2026", "image": "https://www.cyrilvoyant.com/assets/img/0983e8b6d15c.jpg"}}, {"@type": "ListItem", "position": 9, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/fr/actualites/why-extreme-learning-machines/", "headline": "Prévoir toutes les énergies d'un réseau d'un seul coup : l'approche parcimonieuse MIMO-ELM", "inLanguage": "en", "abstract": "Une prévision à court terme rapide, transparente et opérationnelle de la demande et de la production de plusieurs sources d'énergie par un seul modèle (MIMO : multi-entrée multi-sortie) à extreme learning machine.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Milan Despotovic", "sameAs": "https://orcid.org/0000-0003-3144-5945"}, {"@type": "Person", "name": "Luis Garcia-Gutierrez", "sameAs": "https://orcid.org/0000-0002-3480-1784"}, {"@type": "Person", "name": "Mohammed Asloune", "sameAs": "https://orcid.org/0009-0004-0183-2156"}, {"@type": "Person", "name": "Yves-Marie Saint-Drenan", "sameAs": "https://orcid.org/0000-0003-1471-1092"}, {"@type": "Person", "name": "Jean-Laurent Duchaud", "sameAs": "https://orcid.org/0000-0001-7490-7260"}, {"@type": "Person", "name": "Ghjuvan Antone Faggianelli", "sameAs": "https://orcid.org/0000-0002-9954-5910"}, {"@type": "Person", "name": "Elena Magliaro", "sameAs": "https://orcid.org/0009-0009-8057-1957"}], "datePublished": "2026-02-26", "image": "https://www.cyrilvoyant.com/assets/img/8a4ca1238d62.png"}}, {"@type": "ListItem", "position": 10, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/fr/actualites/", "headline": "Une recherche invisible n'a pas d'impact : construire l'influence scientifique à l'ère de l'IA", "inLanguage": "en", "abstract": "La recherche est passée de la rareté à la saturation : produire du savoir n'est plus le goulot d'étranglement ; être trouvé, jugé crédible et réutilisé, si.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2026", "image": "https://www.cyrilvoyant.com/assets/img/4c8ef733ef53.jpg"}}, {"@type": "ListItem", "position": 11, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/fr/actualites/", "headline": "Nommé membre du comité éditorial de Scientific Reports (Nature Portfolio)", "inLanguage": "en", "abstract": "Une revue pluridisciplinaire qui couvre tous les domaines scientifiques ; ce rôle prolonge mon parcours de directeur de recherche à Mines Paris – PSL (centre O.I.E.).", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "datePublished": "2026", "image": "https://www.cyrilvoyant.com/assets/img/fd09837e8068.jpg"}}, {"@type": "ListItem", "position": 12, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/fr/actualites/", "headline": "Contrôle qualité des mesures d'éclairement solaire sur plan incliné", "inLanguage": "en", "abstract": "Un cadre de contrôle qualité pour l'éclairement mesuré sur plan incliné, issu de la thèse de Mohammed Asloune (université de Corse et Mines Paris – PSL).", "author": [{"@type": "Person", "name": "Mohammed Asloune", "sameAs": "https://orcid.org/0009-0004-0183-2156"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2025-12-20", "image": "https://www.cyrilvoyant.com/assets/img/597be8654483.jpg"}}, {"@type": "ListItem", "position": 13, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/fr/actualites/", "headline": "Vers une iodothérapie personnalisée : modélisation, dynamique et perspectives cliniques", "inLanguage": "en", "abstract": "Une contribution doctorale de Marie Fusella Giuntini, avec les universités d'Aix-Marseille et de Corse, Mines Paris – PSL et l'hôpital de la Timone : deux articles, un modèle mécaniste et une revue des approches de modélisation.", "author": [{"@type": "Person", "name": "Marie Fusella Giuntini", "sameAs": "https://orcid.org/0009-0002-2031-4077"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "David Taieb", "sameAs": "https://orcid.org/0000-0002-0400-7600"}, {"@type": "Person", "name": "Dominique Barbolosi", "sameAs": "https://www.idref.fr/033468540"}], "datePublished": "2025-12-10", "image": "https://www.cyrilvoyant.com/assets/img/81ce5b8cbd78.png"}}, {"@type": "ListItem", "position": 14, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/fr/actualites/", "headline": "Dans la mise à jour 2025 de la base de citations Stanford–Elsevier (2 % les plus cités)", "inLanguage": "fr", "abstract": "La mise à jour 2025 de la base Stanford–Elsevier d'indicateurs de citation (Ioannidis, version 8) inclut Cyril Voyant : score composite parmi les 100 000 premiers ou dans les 2 % supérieurs du sous-domaine. Ce qu'elle mesure, et ce qu'elle ne mesure pas, est détaillé plus bas.", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "datePublished": "2025", "image": "https://www.cyrilvoyant.com/assets/img/c8454c0e0d6c.png"}}, {"@type": "ListItem", "position": 15, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/fr/actualites/", "headline": "Apprentissage par transfert pour prévoir le vent là où les données manquent", "inLanguage": "en", "abstract": "Réutiliser des modèles entraînés sur des sites riches en données permet de prévoir la vitesse du vent sur des sites qui en ont peu : sur 4 830 expériences, une précision comparable à l'apprentissage direct (écart de nRMSE inférieur à 0,01).", "author": [{"@type": "Person", "name": "Milan Despotović", "sameAs": "https://orcid.org/0000-0003-3144-5945"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2025-10-13", "image": "https://www.cyrilvoyant.com/assets/img/435a8e9d3433.png"}}, {"@type": "ListItem", "position": 16, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/fr/actualites/", "headline": "Prévision solaire : 500 articles (2017-2023) analysés par fouille de textes", "inLanguage": "en", "abstract": "La fouille de textes de 500 articles cartographie la recherche mondiale en prévision solaire : forte montée de l'IA et de l'apprentissage profond, portée par la Chine, les États-Unis et l'Inde, et métriques déterministes encore dominantes.", "author": [{"@type": "Person", "name": "Mohammed Asloune", "sameAs": "https://orcid.org/0009-0004-0183-2156"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2025-10-01", "image": "https://www.cyrilvoyant.com/assets/img/b0d486d8a45b.png"}}, {"@type": "ListItem", "position": 17, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/fr/actualites/", "headline": "Estimer rapidement l'erreur d'une prévision solaire à partir de la seule variabilité du site", "inLanguage": "en", "abstract": "Des modèles linéaires prédisent l'erreur de prévision de l'éclairement à partir de la variabilité locale, mesurée par l'écart-type des variations horaires de l'indice de ciel clair.", "author": [{"@type": "Person", "name": "Philippe Lauret", "sameAs": "https://orcid.org/0000-0003-2959-6146"}, {"@type": "Person", "name": "Mathieu David", "sameAs": "https://orcid.org/0000-0002-7382-1294"}, {"@type": "Person", "name": "Josselin Le Gal La Salle", "sameAs": "https://orcid.org/0000-0003-0126-3796"}, {"@type": "Person", "name": "Elke Lorenz", "sameAs": "https://orcid.org/0000-0002-7475-1048"}, {"@type": "Person", "name": "Richard Perez", "sameAs": "https://orcid.org/0000-0001-8064-3281"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2025-08-22", "image": "https://www.cyrilvoyant.com/assets/img/85e5d66681cc.png"}}, {"@type": "ListItem", "position": 18, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/fr/actualites/", "headline": "Nouvelle version de LQL-Equiv, logiciel libre de calcul de dose biologique efficace en radiothérapie", "inLanguage": "en", "abstract": "Logiciel libre écrit en MATLAB par Cyril Voyant et Daniel Julian : calcul voxel par voxel de l'EQD₂ et de la BED avec le modèle linéaire-quadratique-linéaire.", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "datePublished": "2025-08-04", "image": "https://www.cyrilvoyant.com/assets/img/82d8378219df.png"}}, {"@type": "ListItem", "position": 19, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/fr/actualites/", "headline": "Aider la décision clinique en radiothérapie : modèles de dose LQ et LQL comparés", "inLanguage": "en", "abstract": "Un article collectif qui compare les modèles linéaire-quadratique (LQ) et linéaire-quadratique-linéaire (LQL) ; méthodes, résultats et limites cliniques dans l'article publié.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "D. Julian"}, {"@type": "Person", "name": "S. Muraro"}, {"@type": "Person", "name": "V. Bodez"}, {"@type": "Person", "name": "M. Pinpin"}, {"@type": "Person", "name": "D. Leschi"}, {"@type": "Person", "name": "R. Oozeer"}, {"@type": "Person", "name": "G. Wided"}, {"@type": "Person", "name": "M.-A. Acquaviva"}, {"@type": "Person", "name": "S. Prapant"}, {"@type": "Person", "name": "O. Gahbiche"}, {"@type": "Person", "name": "N. Bouaouina"}], "datePublished": "2025-06-24", "image": "https://www.cyrilvoyant.com/assets/img/a65616587f74.jpg"}}, {"@type": "ListItem", "position": 20, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/fr/actualites/why-forecast-solar-power/", "headline": "Coefficient de variation stochastique : mesurer la variabilité et la prévisibilité de l'éclairement solaire", "inLanguage": "en", "abstract": "Le sCV (coefficient de variation stochastique) et la prévisibilité F (comprise entre 1 − sCV et 1) séparent les fluctuations aléatoires des tendances déterministes que l'écart-type mélange, pour caractériser un site avant de comparer des modèles.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Alan Julien", "sameAs": "https://orcid.org/0009-0003-0247-0663"}, {"@type": "Person", "name": "Milan Despotovic", "sameAs": "https://orcid.org/0000-0003-3144-5945"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "name": "Luis Antonio Garcia-Gutierrez", "sameAs": "https://orcid.org/0000-0002-3480-1784"}, {"@type": "Person", "name": "Claudio Francesco Nicolosi", "sameAs": "https://orcid.org/0009-0001-2962-6643"}, {"@type": "Person", "name": "Philippe Blanc", "sameAs": "https://orcid.org/0000-0002-6345-0004"}, {"@type": "Person", "name": "Jamie Bright", "sameAs": "https://orcid.org/0000-0002-9465-3453"}], "datePublished": "2025-07-17", "image": "https://www.cyrilvoyant.com/assets/img/85aa63526c77.jpg"}}, {"@type": "ListItem", "position": 21, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/fr/actualites/nice-forecast-evaluation/", "headline": "Métriques NICEᵏ : un cadre unifié pour évaluer les prévisions solaires déterministes", "inLanguage": "en", "abstract": "La RMSE (racine de l'erreur quadratique moyenne), la MAE (erreur absolue moyenne) et les scores de compétence ne saisissent pas toute la qualité d'une prévision solaire. Les métriques NICEᵏ rapportent les erreurs à celles d'une référence explicite, la persistance (qui recopie la dernière valeur connue).", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Milan Despotovic", "sameAs": "https://orcid.org/0000-0003-3144-5945"}, {"@type": "Person", "name": "Luis Garcia-Gutierrez", "sameAs": "https://orcid.org/0000-0002-3480-1784"}, {"@type": "Person", "name": "Rodrigo Amaro e Silva", "sameAs": "https://orcid.org/0000-0002-2813-150X"}, {"@type": "Person", "name": "Philippe Lauret", "sameAs": "https://orcid.org/0000-0003-2959-6146"}, {"@type": "Person", "name": "Ted Soubdhan", "sameAs": "https://orcid.org/0000-0002-6402-8438"}, {"@type": "Person", "name": "Nadjem Bailek", "sameAs": "https://orcid.org/0000-0001-9051-8548"}], "datePublished": "2025-09-25", "image": "https://www.cyrilvoyant.com/assets/img/82ce1d4d17e8.png"}}, {"@type": "ListItem", "position": 22, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/fr/actualites/", "headline": "Le choix du modèle de ciel clair compte pour la prévision solaire à court terme", "inLanguage": "en", "abstract": "Les modèles de ciel clair servent partout en énergie solaire, mais leur usage en prévision pose des difficultés : erreurs de synchronisation, choix de l'indice de ciel clair, effets sur les scores.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Milan Despotovic", "sameAs": "https://orcid.org/0000-0003-3144-5945"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "name": "Yves-Marie Saint-Drenan", "sameAs": "https://orcid.org/0000-0003-1471-1092"}, {"@type": "Person", "name": "Mohammed Asloune", "sameAs": "https://orcid.org/0009-0004-0183-2156"}, {"@type": "Person", "name": "Luis Garcia-Gutierrez", "sameAs": "https://orcid.org/0000-0002-3480-1784"}], "datePublished": "2025-04-11", "image": "https://www.cyrilvoyant.com/assets/img/05e996273651.jpg"}}, {"@type": "ListItem", "position": 23, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/fr/actualites/", "headline": "Sélection des variables d'entrée pour prévoir l'éclairement solaire par apprentissage automatique : cas de l'Algérie", "inLanguage": "en", "abstract": "Plusieurs techniques de sélection de variables comparées pour la prévision de l'éclairement solaire par apprentissage automatique, dans les conditions climatiques algériennes.", "author": [{"@type": "Person", "name": "Saïd Benkaciali", "sameAs": "https://scholar.google.com/citations?user=-1EkSPwAAAAJ"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2025-07-12", "image": "https://www.cyrilvoyant.com/assets/img/98c7979fb52e.png"}}, {"@type": "ListItem", "position": 24, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/fr/actualites/", "headline": "Visibilité académique : pourquoi publier ne suffit plus", "inLanguage": "en", "abstract": "Un article sans grand espoir cité des centaines de fois, un autre, jugé meilleur, resté dans l'ombre : après vingt ans de recherche, publier ne suffit plus, il faut être trouvé et lu.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2025", "image": "https://www.cyrilvoyant.com/assets/img/0e72a8bbd5be.png"}}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/fr/actualites/nice-forecast-evaluation/#page", "url": "https://www.cyrilvoyant.com/fr/actualites/nice-forecast-evaluation/", "name": "Métriques NICE : quand la RMSE masque une différence entre prévisions solaires", "description": "À trente minutes d’horizon (le délai entre la dernière mesure et l’instant prévu), le tableau de notre étude NICE rapporte une nRMSE médiane arrondie (la RMSE divisée par la moyenne du signal) de 0,19 pour un modèle ELM (extreme learning machine, un petit réseau à couche cachée aléatoire) comme…", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-5"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#nice", "name": "NICE", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/outils/nice/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#rmse", "name": "RMSE", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/recits/evaluer-prevision-solaire-persistance/"}], "keywords": ["Démontrer la confiance", "Énergie"], "translationOfWork": {"@id": "https://www.cyrilvoyant.com/latest-publications-and-news/nice-forecast-evaluation/#page"}, "mentions": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#persistence", "name": "Persistance", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/recits/variabilite-memoire-previsibilite/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#elm", "name": "Extreme Learning Machine (ELM)", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/actualites/why-extreme-learning-machines/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#nrmse", "name": "nRMSE", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/recits/variabilite-memoire-previsibilite/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#artu", "name": "ARTU", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/outils/artu/"}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Récits", "item": "https://www.cyrilvoyant.com/fr/recits/"}, {"@type": "ListItem", "position": 3, "name": "Métriques NICE : quand la RMSE masque une différence entre prévisions solaires", "item": "https://www.cyrilvoyant.com/fr/actualites/nice-forecast-evaluation/"}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/fr/actualites/why-extreme-learning-machines/#page", "url": "https://www.cyrilvoyant.com/fr/actualites/why-extreme-learning-machines/", "name": "MIMO-ELM : sept signaux énergétiques de la Corse prévus par un seul modèle", "description": "À une heure d’horizon (le délai entre la dernière mesure et l’instant prévu), notre modèle MIMO-ELM (un seul modèle multi-entrée multi-sortie, fondé sur une extreme learning machine, qui prévoit plusieurs signaux ensemble) atteint une nRMSE (la RMSE divisée par la moyenne du signal ; 0 : prévision…", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-3"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#mimo", "name": "MIMO (multi-entrée multi-sortie)", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/actualites/why-extreme-learning-machines/"}], "keywords": ["Apprendre frugalement", "Énergie"], "translationOfWork": {"@id": "https://www.cyrilvoyant.com/latest-publications-and-news/why-extreme-learning-machines/#page"}, "mentions": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#elm", "name": "Extreme Learning Machine (ELM)", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/actualites/why-extreme-learning-machines/"}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Récits", "item": "https://www.cyrilvoyant.com/fr/recits/"}, {"@type": "ListItem", "position": 3, "name": "MIMO-ELM : sept signaux énergétiques de la Corse prévus par un seul modèle", "item": "https://www.cyrilvoyant.com/fr/actualites/why-extreme-learning-machines/"}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/fr/actualites/why-forecast-solar-power/#page", "url": "https://www.cyrilvoyant.com/fr/actualites/why-forecast-solar-power/", "name": "sCV et F : variabilité et prévisibilité de l'éclairement solaire", "description": "Sur 68 stations météorologiques espagnoles, notre indice de prévisibilité F (sans unité : plus il est proche de 1, plus le signal garde de mémoire exploitable) conserve une relation inverse avec l’erreur de prévision, examinée sur dix modèles et 24 horizons (le délai entre la dernière mesure et…", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-2"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#scv", "name": "sCV", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/outils/variabilite-previsibilite/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#forecastability-f", "name": "Prévisibilité F", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/outils/variabilite-previsibilite/"}], "keywords": ["Calculer directement", "Énergie"], "translationOfWork": {"@id": "https://www.cyrilvoyant.com/latest-publications-and-news/why-forecast-solar-power/#page"}, "mentions": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#horizon", "name": "Horizon de prévision", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/recits/variabilite-memoire-previsibilite/"}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", 