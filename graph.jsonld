nt.com/ontology/", "url": "https://www.cyrilvoyant.com/data/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#mimo", "name": "MIMO (multiple-input multiple-output)", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/why-extreme-learning-machines/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#bed", "name": "Biologically effective dose (BED)", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/stories/lql-equiv/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#lql-equiv", "name": "LQL-Equiv", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/stories/lql-equiv/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#persistence", "name": "Persistence", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/stories/variability-memory-forecastability/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#blend", "name": "BLEND", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/forecasting-with-less/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#horizon", "name": "Forecast horizon", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/stories/variability-memory-forecastability/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#tls", "name": "Tunnel Load Simulator (TLS)", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/stories/tunnel-load-simulator/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#fair", "name": "FAIR principles", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/fair-self-assessment/"}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "News", "item": "https://www.cyrilvoyant.com/latest-publications-and-news/"}]}, {"@type": "ItemList", "name": "News", "numberOfItems": 24, "itemListElement": [{"@type": "ListItem", "position": 1, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/scientific-publishing-trust/", "headline": "Scientific publishing: no verification of data and code, no trust", "inLanguage": "en", "abstract": "Indexed articles grew by about 47% between 2016 and 2022, peer review relies on unpaid work and 2023 set a record of retractions. A short essay on what exists, from FAIR data to the AI Act, and what is missing: checking the data and code behind what is published.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2026-10-24", "image": "https://www.cyrilvoyant.com/assets/articles/scientific-publishing-growth.svg"}}, {"@type": "ListItem", "position": 2, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/", "headline": "ELECTRE, flagship project of the Carnot M.I.N.E.S institute: electrifying uses, closing workshop on 18 November 2026", "inLanguage": "en", "abstract": "ELECTRE brings together about fifteen laboratories, centres and institutes of the Carnot M.I.N.E.S institute around 13 research projects (2023–2026) on the electrification of uses, from materials to storage, industrial processes and the limits of electrification. Its closing workshop is on 18 November 2026, Mines Paris – PSL, Sophia Antipolis.", "author": [{"@type": "Person", "name": "Delphine Gilges-Crampont", "sameAs": "https://www.idref.fr/292140282"}, {"@type": "Person", "name": "Annette Massias", "sameAs": "https://www.linkedin.com/in/annette-massias-46544630/"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2026-10-23", "image": "https://www.cyrilvoyant.com/assets/news/electre.png"}}, {"@type": "ListItem", "position": 3, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/", "headline": "Visiting Professor at the University of Kragujevac, Serbia", "inLanguage": "en", "abstract": "I have been appointed Visiting Professor at the Faculty of Engineering, University of Kragujevac, together with my colleague and friend Prof. Gilles Notton.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}], "datePublished": "2026", "image": "https://www.cyrilvoyant.com/assets/img/e127601c2891.png"}}, {"@type": "ListItem", "position": 4, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/", "headline": "Tunnel Load Simulator: an open-source generator for synthetic road-tunnel electricity demand", "inLanguage": "en", "abstract": "The Tunnel Load Simulator is an open-source Streamlit application developed within the SmartTunnel project to generate synthetic electrical load profiles for road tunnels. It combines simplified representations of lighting, ventilation, auxiliary loads, traffic patterns, seasonal effects and stochastic events such as pollution episodes or accidents.", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "datePublished": "2026-05-08", "image": "https://www.cyrilvoyant.com/assets/img/e326492cab74.jpg"}}, {"@type": "ListItem", "position": 5, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/", "headline": "When Sunlight Stops Being Direct", "inLanguage": "en", "abstract": "Diffuse solar radiation remains one of the most complex components of the solar resource, particularly in regions affected by aerosols, humidity, and strong climatic contrasts.", "author": [{"@type": "Person", "name": "Haifa Harrouch", "sameAs": "https://orcid.org/0009-0001-5988-4803"}, {"@type": "Person", "name": "Nadjem Bailek", "sameAs": "https://orcid.org/0000-0001-9051-8548"}, {"@type": "Person", "name": "Bilel Zerouali", "sameAs": "https://orcid.org/0000-0003-4735-9750"}, {"@type": "Person", "name": "Ilyes Abidi", "sameAs": "https://orcid.org/0000-0002-9769-0188"}, {"@type": "Person", "name": "Hanene Guesmi", "sameAs": "https://orcid.org/0009-0000-2389-1406"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Jihad A. Younis", "sameAs": "https://orcid.org/0000-0001-7116-3251"}, {"@type": "Person", "name": "Maher Jebali & Rabab Triki"}], "datePublished": "2026-04-28", "image": "https://www.cyrilvoyant.com/assets/img/500e36c2208c.png"}}, {"@type": "ListItem", "position": 6, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/forecasting-with-less/", "headline": "Revisiting Persistence: Symmetry-Constrained Forecasting of Periodically Correlated Energy Processes", "inLanguage": "en", "abstract": "This work revisits persistence forecasting (repeating the last observation) for periodically varying statistics, including the daily cycle of solar irradiance. BLEND combines the latest observation with an observation aligned to the target phase of the cycle.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Candice Banes", "sameAs": "https://orcid.org/0009-0003-6656-8168"}, {"@type": "Person", "name": "Luis Garcia-Gutierrez", "sameAs": "https://orcid.org/0000-0002-3480-1784"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "name": "Milan Despotovic", "sameAs": "https://orcid.org/0000-0003-3144-5945"}, {"@type": "Person", "name": "Zaher Mundher Yaseen", "sameAs": "https://orcid.org/0000-0003-3344-214X"}], "datePublished": "2026-04-24", "image": "https://www.cyrilvoyant.com/assets/img/e8e0bf76adbb.jpg"}}, {"@type": "ListItem", "position": 7, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/gamma-index-forecast-validation/", "headline": "From Pixels to Tolerances: Rethinking Forecast Validation with the γ-Index", "inLanguage": "en", "abstract": "Classical metrics like RMSE (root mean squared error) evaluate forecasts as if every pixel must match perfectly in space and time. Machines optimize for that. Humans do not think that way.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2026-03-28", "image": "https://www.cyrilvoyant.com/assets/img/7f20ac04a02f.png"}}, {"@type": "ListItem", "position": 8, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/", "headline": "Excellence scientifique à l’ère de l’IA : du SEO au GEO", "inLanguage": "fr", "abstract": "La production scientifique mondiale connaît une croissance sans précédent, amplifiée par l’essor des modèles d’intelligence artificielle générative. Dans ce contexte, la question n’est plus seulement de produire du savoir, mais d’en garantir la visibilité, la robustesse et la réutilisabilité.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2026", "image": "https://www.cyrilvoyant.com/assets/img/0983e8b6d15c.jpg"}}, {"@type": "ListItem", "position": 9, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/why-extreme-learning-machines/", "headline": "Coherent Multi-Energy Forecasting for Real-Time Grid Management: A Parsimonious MIMO-ELM Approach", "inLanguage": "en", "abstract": "Fast, transparent, and operational short-term forecasting of demand and generation across multiple energy sources, by one model (MIMO: multiple-input multiple-output) built on an extreme learning machine.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Milan Despotovic", "sameAs": "https://orcid.org/0000-0003-3144-5945"}, {"@type": "Person", "name": "Luis Garcia-Gutierrez", "sameAs": "https://orcid.org/0000-0002-3480-1784"}, {"@type": "Person", "name": "Mohammed Asloune", "sameAs": "https://orcid.org/0009-0004-0183-2156"}, {"@type": "Person", "name": "Yves-Marie Saint-Drenan", "sameAs": "https://orcid.org/0000-0003-1471-1092"}, {"@type": "Person", "name": "Jean-Laurent Duchaud", "sameAs": "https://orcid.org/0000-0001-7490-7260"}, {"@type": "Person", "name": "Ghjuvan Antone Faggianelli", "sameAs": "https://orcid.org/0000-0002-9954-5910"}, {"@type": "Person", "name": "Elena Magliaro", "sameAs": "https://orcid.org/0009-0009-8057-1957"}], "datePublished": "2026-02-26", "image": "https://www.cyrilvoyant.com/assets/img/8a4ca1238d62.png"}}, {"@type": "ListItem", "position": 10, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/", "headline": "Invisible Research Has No Impact: Engineering Scientific Influence in the AI Era", "inLanguage": "en", "abstract": "The research landscape has shifted from scarcity to saturation: producing knowledge is no longer the bottleneck: being discovered, trusted, and reused is.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2026", "image": "https://www.cyrilvoyant.com/assets/img/4c8ef733ef53.jpg"}}, {"@type": "ListItem", "position": 11, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/", "headline": "Appointed Editorial Board Member of Scientific Reports (Nature Portfolio)", "inLanguage": "en", "abstract": "This role aligns with my trajectory as Research Director at Mines Paris – PSL O.I.E. (since 2024). Scientific Reports covers all scientific domains.", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "datePublished": "2026", "image": "https://www.cyrilvoyant.com/assets/img/fd09837e8068.jpg"}}, {"@type": "ListItem", "position": 12, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/", "headline": "Quality Control Framework for Tilted Solar Irradiance", "inLanguage": "en", "abstract": "This work is part of the doctoral research of Mohammed Asloune (University of Corsica & Mines Paris – PSL).", "author": [{"@type": "Person", "name": "Mohammed Asloune", "sameAs": "https://orcid.org/0009-0004-0183-2156"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2025-12-20", "image": "https://www.cyrilvoyant.com/assets/img/597be8654483.jpg"}}, {"@type": "ListItem", "position": 13, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/", "headline": "Towards Personalized Radio-Iodine Therapy: Modeling, Dynamics, and Clinical Perspectives", "inLanguage": "en", "abstract": "A doctoral contribution by Marie Fusella Giuntini, in collaboration with Aix-Marseille, Corsica Universities, Mines Paris – PSL, and La Timone Hospital: Marie Fusella Giuntini, Cyril Voyant, David Taieb and Dominique Barbolosi.", "author": [{"@type": "Person", "name": "Marie Fusella Giuntini", "sameAs": "https://orcid.org/0009-0002-2031-4077"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "David Taieb", "sameAs": "https://orcid.org/0000-0002-0400-7600"}, {"@type": "Person", "name": "Dominique Barbolosi", "sameAs": "https://www.idref.fr/033468540"}], "datePublished": "2025-12-10", "image": "https://www.cyrilvoyant.com/assets/img/81ce5b8cbd78.png"}}, {"@type": "ListItem", "position": 14, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/", "headline": "Listed in the 2025 update of the Stanford–Elsevier citation database (top 2 %)", "inLanguage": "en", "abstract": "The 2025 update of the Stanford–Elsevier database of standardized citation indicators (Ioannidis, version 8) includes Cyril Voyant: a composite citation score in the top 100,000 overall or the top 2 % of the sub-field. What it measures, and what it does not, is below.", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "datePublished": "2025", "image": "https://www.cyrilvoyant.com/assets/img/c8454c0e0d6c.png"}}, {"@type": "ListItem", "position": 15, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/", "headline": "Transfer Learning for Wind Speed Forecasting: A Scalable Approach for Data-Scarce Environments", "inLanguage": "en", "abstract": "This paper demonstrates that transfer learning can accurately forecast wind speed in data-scarce regions by reusing models trained on data-rich sites. Across 4,830 experiments, transfer learning (TL) achieved accuracy comparable to direct learning (ΔnRMSE < 0.01). The approach offers a scalable, low-data solution for expanding wind forecasting to under-instrumented areas.", "author": [{"@type": "Person", "name": "Milan Despotović", "sameAs": "https://orcid.org/0000-0003-3144-5945"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2025-10-13", "image": "https://www.cyrilvoyant.com/assets/img/435a8e9d3433.png"}}, {"@type": "ListItem", "position": 16, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/", "headline": "From Trends to Insights: A Text Mining Analysis of Solar Energy Forecasting (2017–2023)", "inLanguage": "en", "abstract": "The study applies text mining to 500 papers (2017–2023) to map global trends in solar energy forecasting. It reveals a strong rise of AI and deep learning, led by China, the USA, and India, and shows that deterministic metrics still dominate probabilistic ones. The work delivers a reproducible overview and standardized terminology, advancing transparency and collaboration in solar forecasting research .", "author": [{"@type": "Person", "name": "Mohammed Asloune", "sameAs": "https://orcid.org/0009-0004-0183-2156"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2025-10-01", "image": "https://www.cyrilvoyant.com/assets/img/b0d486d8a45b.png"}}, {"@type": "ListItem", "position": 17, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/", "headline": "A Simple Method for Quickly Estimating Solar Irradiance Forecast Errors", "inLanguage": "en", "abstract": "The team developed linear models that predict solar irradiance forecast errors using only solar variability at a specific location. This variability is measured by the standard deviation of hourly changes in the clear sky index, essentially capturing how much solar conditions fluctuate hour to hour.", "author": [{"@type": "Person", "name": "Philippe Lauret", "sameAs": "https://orcid.org/0000-0003-2959-6146"}, {"@type": "Person", "name": "Mathieu David", "sameAs": "https://orcid.org/0000-0002-7382-1294"}, {"@type": "Person", "name": "Josselin Le Gal La Salle", "sameAs": "https://orcid.org/0000-0003-0126-3796"}, {"@type": "Person", "name": "Elke Lorenz", "sameAs": "https://orcid.org/0000-0002-7475-1048"}, {"@type": "Person", "name": "Richard Perez", "sameAs": "https://orcid.org/0000-0001-8064-3281"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2025-08-22", "image": "https://www.cyrilvoyant.com/assets/img/85e5d66681cc.png"}}, {"@type": "ListItem", "position": 18, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/", "headline": "New Release: LQL-Equiv: Open‑Source Software for Biologically Equivalent Dose Calculation in Radiotherapy", "inLanguage": "en", "abstract": "LQL‑Equiv is a free & open‑source software (GNU‑based) written in MATLAB and distributed as a standalone executable, developed by Cyril Voyant & Daniel Julian. It computes voxel‑wise Equivalent Dose in 2 Gy fractions (EQD₂) and Biologically Effective Dose (BED) using a Linear‑Quadratic‑Linear (LQL) model that explicitly accounts for fraction size, overall treatment time, and cellular repopulation effects, outperforming standard LQ-based calculators.", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "datePublished": "2025-08-04", "image": "https://www.cyrilvoyant.com/assets/img/82d8378219df.png"}}, {"@type": "ListItem", "position": 19, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/", "headline": "Improving Clinical Decision-Making in Radiotherapy: A Comparative Analysis of Linear-Quadratic LQ and Linear-Quadratic-Linear LQL Dose Models", "inLanguage": "en", "abstract": "This collaborative paper compares the linear-quadratic (LQ) and linear-quadratic-linear (LQL) dose models in radiotherapy. Read the published article for the methods, results and clinical limitations.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "D. Julian"}, {"@type": "Person", "name": "S. Muraro"}, {"@type": "Person", "name": "V. Bodez"}, {"@type": "Person", "name": "M. Pinpin"}, {"@type": "Person", "name": "D. Leschi"}, {"@type": "Person", "name": "R. Oozeer"}, {"@type": "Person", "name": "G. Wided"}, {"@type": "Person", "name": "M.-A. Acquaviva"}, {"@type": "Person", "name": "S. Prapant"}, {"@type": "Person", "name": "O. Gahbiche"}, {"@type": "Person", "name": "N. Bouaouina"}], "datePublished": "2025-06-24", "image": "https://www.cyrilvoyant.com/assets/img/a65616587f74.jpg"}}, {"@type": "ListItem", "position": 20, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/why-forecast-solar-power/", "headline": "Stochastic Coefficient of Variation: Assessing the Variability and Forecastability of Solar Irradiance", "inLanguage": "en", "abstract": "This work presents a robust framework for quantifying solar irradiance variability and forecastability through the Stochastic Coefficient of Variation (sCV) and the Forecastability (F). Traditional metrics, such as the standard deviation, fail to isolate stochastic fluctuations from deterministic trends in solar irradiance. By considering clear-sky irradiance as a dynamic upper bound of measurement, sCV provides a normalized, dimensionless measure of variability that theoretically ranges from 0 ", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Alan Julien", "sameAs": "https://orcid.org/0009-0003-0247-0663"}, {"@type": "Person", "name": "Milan Despotovic", "sameAs": "https://orcid.org/0000-0003-3144-5945"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "name": "Luis Antonio Garcia-Gutierrez", "sameAs": "https://orcid.org/0000-0002-3480-1784"}, {"@type": "Person", "name": "Claudio Francesco Nicolosi", "sameAs": "https://orcid.org/0009-0001-2962-6643"}, {"@type": "Person", "name": "Philippe Blanc", "sameAs": "https://orcid.org/0000-0002-6345-0004"}, {"@type": "Person", "name": "Jamie Bright", "sameAs": "https://orcid.org/0000-0002-9465-3453"}], "datePublished": "2025-07-17", "image": "https://www.cyrilvoyant.com/assets/img/85aa63526c77.jpg"}}, {"@type": "ListItem", "position": 21, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/nice-forecast-evaluation/", "headline": "NICE^k Metrics: Unified and Multidimensional Framework for Evaluating Deterministic Solar Forecasting Accuracy", "inLanguage": "en", "abstract": "Accurate solar energy output prediction is fundamental to integrating renewable energy sources into electrical grids, maintaining system stability, and enabling effective energy management. However, conventional error metrics—such as Root Mean Squared Error (RMSE), Mean Absolute Error (MAE), and Skill Scores (SS)—fail to capture the multidimensional complexity of solar irradiance forecasting. These metrics lack sensitivity to forecastability, rely on arbitrary baselines (e.g., clear-sky models),", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Milan Despotovic", "sameAs": "https://orcid.org/0000-0003-3144-5945"}, {"@type": "Person", "name": "Luis Garcia-Gutierrez", "sameAs": "https://orcid.org/0000-0002-3480-1784"}, {"@type": "Person", "name": "Rodrigo Amaro e Silva", "sameAs": "https://orcid.org/0000-0002-2813-150X"}, {"@type": "Person", "name": "Philippe Lauret", "sameAs": "https://orcid.org/0000-0003-2959-6146"}, {"@type": "Person", "name": "Ted Soubdhan", "sameAs": "https://orcid.org/0000-0002-6402-8438"}, {"@type": "Person", "name": "Nadjem Bailek", "sameAs": "https://orcid.org/0000-0001-9051-8548"}], "datePublished": "2025-09-25", "image": "https://www.cyrilvoyant.com/assets/img/82ce1d4d17e8.png"}}, {"@type": "ListItem", "position": 22, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/", "headline": "On the importance of clearsky model in short-term solar radiation forecasting", "inLanguage": "en", "abstract": "Clearsky models are widely used in solar energy for many applications such as quality control, resource assessment, satellite-base irradiance estimation and forecasting. However, their use in forecasting and nowcasting is associated with a number of challenges. Synchronization errors, reliance on the Clearsky index (ratio of the global horizontal irradiance to its cloud-free counterpart) and high sensitivity of the clearsky model to errors in aerosol optical depth at low solar elevation limit th", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Milan Despotovic", "sameAs": "https://orcid.org/0000-0003-3144-5945"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "name": "Yves-Marie Saint-Drenan", "sameAs": "https://orcid.org/0000-0003-1471-1092"}, {"@type": "Person", "name": "Mohammed Asloune", "sameAs": "https://orcid.org/0009-0004-0183-2156"}, {"@type": "Person", "name": "Luis Garcia-Gutierrez", "sameAs": "https://orcid.org/0000-0002-3480-1784"}], "datePublished": "2025-04-11", "image": "https://www.cyrilvoyant.com/assets/img/05e996273651.jpg"}}, {"@type": "ListItem", "position": 23, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/", "headline": "Comparative Study of Feature Selection Techniques for Machine Learning-Based Solar Irradiation Forecasting to Facilitate the Sustainable Development of Photovoltaics: Application to Algerian Climatic Conditions", "inLanguage": "en", "abstract": "Forecasting future solar power plant production is essential to continue the development of photovoltaic energy and increase its share in the energy mix for a more sustainable future. Accurate solar radiation forecasting greatly improves the balance maintenance between energy supply and demand and grid management performance. This study assesses the influence of input selection on short-term global horizontal irradiance (GHI) forecasting across two contrasting Algerian climates: arid Ghardaïa an", "author": [{"@type": "Person", "name": "Saïd Benkaciali", "sameAs": "https://scholar.google.com/citations?user=-1EkSPwAAAAJ"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2025-07-12", "image": "https://www.cyrilvoyant.com/assets/img/98c7979fb52e.png"}}, {"@type": "ListItem", "position": 24, "item": {"@type": "BlogPosting", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/", "headline": "Academic Visibility: Why Publishing Isn't Enough Anymore", "inLanguage": "en", "abstract": "I've experienced this troubling phenomenon firsthand: an article I had little hope for exploded with hundreds of citations, while another piece I considered my best work remained in obscurity. After twenty years of research, one thing is clear: in a rapidly evolving academic ecosystem, publishing alone is no longer sufficient.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2025", "image": "https://www.cyrilvoyant.com/assets/img/0e72a8bbd5be.png"}}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/nice-forecast-evaluation/#page", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/nice-forecast-evaluation/", "name": "NICE metrics: when RMSE hides a difference between solar forecasts", "description": "At a thirty-minute horizon (the delay between the last measurement and the forecast time), the NICE study reports a rounded median nRMSE (the RMSE divided by the mean of the signal) of 0.19 for both an ELM (extreme learning machine, a small network with a random hidden layer) and an autoregressive…", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-5"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#nice", "name": "NICE", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/nice-forecast-evaluation/"}, {"@type": "DefinedTerm", "@id": "