/j.apm.2026.116988", "url": "https://doi.org/10.1016/j.apm.2026.116988", "author": [{"@id": "https://person.cyrilvoyant.com/#cyril-voyant"}, {"@type": "Person", "name": "Candice Banes", "sameAs": "https://orcid.org/0009-0003-6656-8168"}, {"@type": "Person", "name": "Luis Garcia-Gutierrez", "sameAs": "https://orcid.org/0000-0002-3480-1784"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "name": "Milan Despotovic", "sameAs": "https://orcid.org/0000-0003-3144-5945"}, {"@type": "Person", "name": "Zaher Mundher Yaseen", "sameAs": "https://orcid.org/0000-0003-3344-214X"}], "isPartOf": {"@type": "Periodical", "name": "Applied Mathematical Modelling"}, "datePublished": "2026"}, {"@type": "ScholarlyArticle", "name": "Benchmarks for solar radiation time series forecasting", "identifier": "https://doi.org/10.1016/j.renene.2022.04.065", "url": "https://doi.org/10.1016/j.renene.2022.04.065", "author": [{"@id": "https://person.cyrilvoyant.com/#cyril-voyant"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "name": "Jean-Laurent Duchaud", "sameAs": "https://orcid.org/0000-0001-7490-7260"}, {"@type": "Person", "name": "Luis Antonio Garcia-Gutierrez", "sameAs": "https://orcid.org/0000-0002-3480-1784"}, {"@type": "Person", "name": "Jamie M. Bright", "sameAs": "https://orcid.org/0000-0002-9465-3453"}, {"@type": "Person", "name": "Dazhi Yang", "sameAs": "https://orcid.org/0000-0003-2162-6873"}], "isPartOf": {"@type": "Periodical", "name": "Renewable Energy"}, "datePublished": "2022"}], "isBasedOn": "https://cyrilvoyant.github.io/methods/persistence-blend.html#try-it", "learningResourceType": "Calculateur scientifique interactif"}, {"@type": "WebPage", "@id": "https://www.cyrilvoyant.com/fr/outils/comparateur-previsions#page", "url": "https://www.cyrilvoyant.com/fr/outils/comparateur-previsions/", "name": "Comparer des prévisions photovoltaïques : p