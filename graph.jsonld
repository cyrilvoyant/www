rilvoyant.com/ontology/#scv", "name": "sCV", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/why-forecast-solar-power/"}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "About", "item": "https://www.cyrilvoyant.com/about/"}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/ai-in-research/#page", "url": "https://www.cyrilvoyant.com/ai-in-research/", "name": "AI in research: the AI Act, a lab charter and a toolbox for researchers", "description": "The European AI Act for researchers: what changes, the timeline, who is responsible when code is transferred, and ten tools for a laboratory.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-5"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#data-management-plan", "name": "Data management plan", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/fair-self-assessment/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#nice", "name": "NICE", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/nice-forecast-evaluation/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#nrmse", "name": "nRMSE", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/stories/variability-memory-forecastability/"}], "datePublished": "2026-10-23", "dateModified": "2026-10-24", "version": "1.2", "keywords": ["Demonstrate trust", "Research practice"], "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/ia-dans-la-recherche/#page"}, "mentions": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#fair", "name": "FAIR principles", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/tools/fair-self-assessment/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#persistence", "name": "Persistence", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/stories/variability-memory-forecastability/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#elm", "name": "Extreme learning machine (ELM)", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/why-extreme-learning-machines/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#nmae", "name": "nMAE", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/stories/variability-memory-forecastability/"}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Stories", "item": "https://www.cyrilvoyant.com/stories/"}, {"@type": "ListItem", "position": 3, "name": "AI in research: the AI Act, a lab charter and a toolbox for researchers", "item": "https://www.cyrilvoyant.com/ai-in-research/"}]}, {"@type": "FAQPage", "@id": "https://www.cyrilvoyant.com/ai-in-research/#faq", "inLanguage": "en", "mainEntity": [{"@type": "Question", "name": "Is scientific research exempt from the AI Act?", "acceptedAnswer": {"@type": "Answer", "text": "The exclusions depend on the system's purpose and stage, not simply on the user's status as a researcher. Article 2 covers systems specifically developed and put into service solely for scientific research, and certain pre-market research activities. Real-world testing is outside the latter exclusion. Reassess the scope before transfer or deployment."}}, {"@type": "Question", "name": "Which high-risk AI deadlines should a laboratory track?", "acceptedAnswer": {"@type": "Answer", "text": "As checked on October 23, 2026, the revised timeline provides December 2, 2027 for Annex III high-risk uses and August 2, 2028 for high-risk AI embedded in regulated products under Annex I. Other obligations have their own dates. Identify the relevant system and provision before applying a deadline."}}, {"@type": "Question", "name": "Who is responsible when laboratory code is transferred?", "acceptedAnswer": {"@type": "Answer", "text": "Identify the provider, deployer and other actors for the actual system. For high-risk systems, Article 25 specifies circumstances in which rebranding, substantial modification or a changed intended purpose can make another actor the provider. Contracts should document roles; they do not replace the applicable statutory obligations."}}, {"@type": "Question", "name": "What should a laboratory document first?", "acceptedAnswer": {"@type": "Answer", "text": "Record the purpose, people responsible, data provenance, model and code versions, validation results and limits. Use data and model cards, an AI-use statement and a project register. Before a transfer, review roles and documentation with the institution's legal service. These are practical recommendations, not a compliance certification."}}]}, {"@type": "AboutPage", "@id": "https://www.cyrilvoyant.com/approach/#page", "url": "https://www.cyrilvoyant.com/approach/", "name": "Understand before you compute: my approach", "description": "Cyril Voyant's approach: start from the problem, use known relationships directly, add data only where the model falls short, and keep a more complex method only when its gain is demonstrated.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-2"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#persistence", "name": "Persistence", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/stories/variability-memory-forecastability/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#elm", "name": "Extreme learning machine (ELM)", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/why-extreme-learning-machines/"}], "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/approche/#page"}, "mentions": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#convex-combination", "name": "Convex combination", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/stories/variability-memory-forecastability/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#scv", "name": "sCV", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/why-forecast-solar-power/"}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "The approach", "item": "https://www.cyrilvoyant.com/approach/"}]}, {"@context": "https://schema.org", "@type": "ItemList", "name": "The complexity ladder, step by step", "inLanguage": "en", "itemListOrder": "https://schema.org/ItemListOrderAscending", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Compute directly", "description": "The link between inputs and outputs is known: a physical law, a published and validated model. When no measurements exist, simulate from what is known.", "url": "https://www.cyrilvoyant.com/stories/lql-equiv/"}, {"@type": "ListItem", "position": 2, "name": "Hybridize", "description": "An explicit model exists but does not explain everything: keep it, and let learning estimate only what is missing.", "url": "https://www.cyrilvoyant.com/stories/thyroid-radioiodine/"}, {"@type": "ListItem", "position": 3, "name": "Learn frugally", "description": "The useful relations are not known well enough, but data exist. Start with the lightest tool that does the job, such as an ELM (extreme learning machine: a small neural network whose output weights alone are fitted).", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/why-extreme-learning-machines/"}, {"@type": "ListItem", "position": 4, "name": "AI in its place", "description": "Deep networks, only if they beat frugal learning under the same protocol. Language models, to read a request written in plain language, never to compute.", "url": "https://www.cyrilvoyant.com/stories/websemantic/"}, {"@type": "ListItem", "position": 5, "name": "Demonstrate trust", "description": "At every step, before any use: evaluate against an explicit reference, publish code, data and limits.", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/nice-forecast-evaluation/"}]}, {"@type": "CollectionPage", "@id": "https://www.cyrilvoyant.com/bib/#page", "url": "https://www.cyrilvoyant.com/bib/", "name": "Cite these papers: BibTeX, RIS and CSL-JSON", "description": "Official BibTeX records of the 30 papers by Cyril Voyant presented on this site: one file per paper, the full bibliography, RIS and CSL-JSON.", "inLanguage": "en", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant"}, "license": "https://creativecommons.org/licenses/by/4.0/", "dateModified": "2026-11-04", "mainEntity": {"@type": "ItemList", "numberOfItems": 30, "itemListElement": [{"@type": "ListItem", "position": 1, "item": {"@type": "ScholarlyArticle", "@id": "https://doi.org/10.1016/j.renene.2025.125090", "name": "Quality control of tilted solar irradiance: Asystematic and generalizable procedure", "author": [{"@type": "Person", "name": "Mohammed Asloune"}, {"@type": "Person", "name": "Gilles Notton"}, {"@type": "Person", "name": "Cyril Voyant"}], "datePublished": "2026", "isPartOf": {"@type": "Periodical", "name": "Renewable Energy"}, "identifier": "doi:10.1016/j.renene.2025.125090", "encoding": {"@type": "MediaObject", "encodingFormat": "application/x-bibtex", "contentUrl": "https://www.cyrilvoyant.com/bib/Asloune2026Quality.bib"}}}, {"@type": "ListItem", "position": 2, "item": {"@type": "ScholarlyArticle", "@id": "https://doi.org/10.1016/j.softx.2026.102946", "name": "Tunnel Load Simulator: A Monte Carlo framework for synthetic electrical demand modeling of road tunnels", "author": [{"@type": "Person", "name": "Haytham El-Houari"}, {"@type": "Person", "name": "Cyril Voyant"}], "datePublished": "2026", "isPartOf": {"@type": "Periodical", "name": "SoftwareX"}, "identifier": "doi:10.1016/j.softx.2026.102946", "encoding": {"@type": "MediaObject", "encodingFormat": "application/x-bibtex", "contentUrl": "https://www.cyrilvoyant.com/bib/ElHouari2026Tunnel.bib"}}}, {"@type": "ListItem", "position": 3, "item": {"@type": "ScholarlyArticle", "@id": "https://doi.org/10.1038/s41598-026-56267-1", "name": "A computational framework for optimizing radioiodine therapy protocols in metastatic thyroid cancer", "author": [{"@type": "Person", "name": "Marie 