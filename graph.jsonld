iple-2"}], "translationOfWork": {"@id": "https://www.cyrilvoyant.com/approach#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "L'approche", "item": "https://www.cyrilvoyant.com/fr/approche/"}]}, {"@type": "WebPage", "@id": "https://www.cyrilvoyant.com/fr/citer#page", "url": "https://www.cyrilvoyant.com/fr/citer/", "name": "Citer et réutiliser nos travaux : licences et modèles de citation", "description": "Articles, logiciels, cours, données et textes du site : la licence de chacun et la façon de le citer, avec l'affiliation au centre O.I.E. de Mines Paris – PSL.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "translationOfWork": {"@id": "https://www.cyrilvoyant.com/cite#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Citer", "item": "https://www.cyrilvoyant.com/fr/citer/"}]}, {"@type": "WebPage", "@id": "https://www.cyrilvoyant.com/fr/collaborer#page", "url": "https://www.cyrilvoyant.com/fr/collaborer/", "name": "Collaborer : projets de recherche, études et adaptation des outils", "description": "Répondre ensemble à un appel à projets, financer une étude ou une thèse avec Mines Paris – PSL, ou engager une collaboration académique avec un objectif clair de valorisation.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "translationOfWork": {"@id": "https://www.cyrilvoyant.com/collaborate#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Collaborer", "item": "https://www.cyrilvoyant.com/fr/collaborer/"}]}, {"@type": "ContactPoint", "contactType": "research collaboration", "email": "cyril.voyant@minesparis.psl.eu", "availableLanguage": ["English", "French"], "areaServed": "Worldwide"}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/fr/donnees#page", "url": "https://www.cyrilvoyant.com/fr/donnees/", "name": "Les modèles sont dans les données : qualifier, certifier, licencier", "description": "Avec l'IA, les méthodes sont à portée de tous ; ce qui fait la valeur d'un résultat, ce sont des données qualifiées, certifiées et sous licence claire. Règles de base, l'exemple de Webservice-Energy et un arbre pour choisir une licence.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "translationOfWork": {"@id": "https://www.cyrilvoyant.com/data#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Données", "item": "https://www.cyrilvoyant.com/fr/donnees/"}]}, {"@type": "DefinedTermSet", "@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary", "name": "Glossaire : données, licences, FAIR", "inLanguage": "fr", "hasDefinedTerm": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary-fair", "name": "FAIR", "description": "Trouvable, accessible, interopérable, réutilisable : quatre principes pour que des données servent au-delà de ceux qui les ont produites.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary-m-tadonn-es", "name": "Métadonnées", "description": "Les données qui décrivent les données : origine, instrument, unités, période, pas de temps, traitements, licence.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary-doi", "name": "DOI", "description": "Identifiant pérenne d'un objet numérique (article, jeu de données, logiciel) ; l'adresse reste valable même si le site change. DataCite en attribue aux données de la recherche.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary-ogc", "name": "OGC", "description": "Open Geospatial Consortium : normes ouvertes des services géographiques, dont WMS (cartes), WFS (objets), WCS (grilles) et WPS (traitements à distance).", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary-inspire-iso-19115", "name": "INSPIRE, ISO 19115", "description": "La directive européenne sur l'information géographique et la norme internationale de ses métadonnées.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary-thredds-opendap", "name": "THREDDS, OPeNDAP", "description": "Un serveur de données scientifiques et le protocole qui permet d'en lire seulement la partie utile (une zone, une période) sans tout télécharger.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary-netcdf-cf", "name": "NetCDF-CF", "description": "Un format de fichier pour les grilles et séries scientifiques, avec des conventions (CF) qui fixent noms de variables, unités et coordonnées.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary-stac", "name": "STAC", "description": "SpatioTemporal Asset Catalog : une façon standard de cataloguer images satellite et données « cloud-native ».", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary-geo-copernicus-cams-c3s", "name": "GEO, Copernicus, CAMS, C3S", "description": "Le Group on Earth Observations (partenariat intergouvernemental), le programme européen d'observation de la Terre et deux de ses services : atmosphère (CAMS) et changement climatique (C3S).", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary-cc-by", "name": "CC BY", "description": "Licence Creative Commons Attribution : chacun peut copier, modifier et réutiliser, y compris commercialement, à condition de citer l'auteur. Pensée pour les textes, figures et données.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary-cc-by-nc", "name": "CC BY-NC", "description": "La même, réservée aux usages non commerciaux.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary-mit", "name": "MIT", "description": "Licence de logiciel très permissive : usage, modification, redistribution et vente libres, à condition de garder la mention de copyright et le texte de la licence ; aucune garantie.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary-apache-2-0", "name": "Apache 2.0", "description": "Permissive comme MIT, avec en plus une licence explicite sur les brevets des contributeurs et l'obligation de signaler les fichiers modifiés.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary-bsd", "name": "BSD", "description": "Famille de licences permissives proches de MIT ; la version à trois clauses interdit en plus d'utiliser le nom des auteurs pour promouvoir un produit dérivé.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary-gpl", "name": "GPL", "description": "Licence « copyleft » : tout logiciel dérivé distribué doit l'être sous GPL, avec son code source.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary-polyform-noncommercial", "name": "PolyForm Noncommercial", "description": "Licence de logiciel qui autorise tout usage non commercial : usage personnel, recherche, expérimentation, enseignement, et usage par des organisations non commerciales (établissements d'enseignement, recherche publique, associations, administrations). L'usage commercial demande un autre accord avec l'auteur. La licence doit accompagner le code redistribué.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary-open-source-osi", "name": "Open source (OSI)", "description": "Définition de l'Open Source Initiative : une licence open source ne peut restreindre aucun domaine d'usage ; une licence non commerciale n'est donc pas « open source », même si le code est ouvert à la lecture.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/fr/donnees/#glossary"}}]}, {"@type": "DataCatalog", "name": "Webservice-Energy", "url": "https://www.webservice-energy.org", "license": "https://creativecommons.org/licenses/by/4.0/", "creator": [{"@type": "Person", "name": "Lionel Ménard", "sameAs": ["https://orcid.org/0009-0002-2156-8538", "https://www.minesparis.psl.eu/annuaire-de-la-recherche/chercheur/lionel-menard/"]}, {"@type": "Person", "name": "Raphaël Jolivet", "sameAs": "https://www.linkedin.com/in/raphaeljolivet/"}], "publisher": {"@type": "Organization", "name": "Centre O.I.E., Mines Paris – PSL", "url": "https://www.oie.minesparis.psl.eu/"}, "description": "Spatial data infrastructure for energy, environment and Earth observation (catalogue, THREDDS, OGC services, WPS, STAC, libinsitu)."}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance#page", "url": "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance/", "name": "Édition scientifique : sans vérification des données et du code, pas de confiance", "description": "Trop d'articles, relecture gratuite, rétractations record, IA générative : ce qui existe (FAIR, OSTP, Conseil de l'UE, CoARA, AI Act, loi République numérique) et ce qui manque, la vérification des données et du code.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "translationOfWork": {"@id": "https://www.cyrilvoyant.com/scientific-publishing-trust#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Édition scientifique", "item": "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance/"}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance#essay", "headline": "Édition scientifique : sans vérification des données et du code, pas de confiance", "datePublished": "2026-10-24", "dateModified": "2026-10-24", "inLanguage": "fr", "keywords": ["édition scientifique", "science ouverte", "reproductibilité", "vérification du code", "données FAIR", "AI Act", "MLOps", "évaluation par les pairs", "IA générative"], "mainEntityOfPage": {"@id": "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance#page"}, "author": {"@id": "https://person.cyrilvoyant.com/#cyril-voyant"}, "license": "https://creativecommons.org/licenses/by/4.0/", "citation": [{"@type": "CreativeWork", "name": "Hanson, Gómez Barreiro, Crosetto, Brockington (2024). The strain on scientific publishing. Quantitative Science Studies 5(4)", "url": "https://doi.org/10.1162/qss_a_00327"}, {"@type": "CreativeWork", "name": "Larivière, Haustein, Mongeon (2015). The oligopoly of academic publishers in the digital era. PLoS ONE 10(6)", "url": "https://doi.org/10.1371/journal.pone.0127502"}, {"@type": "CreativeWork", "name": "RELX (2026). RELX 2025 results", "url": "https://www.relx.com/media/press-releases/year-2026/relx-2025-results"}, {"@type": "CreativeWork", "name": "Aczel, Szaszi, Holcombe (2021). A billion-dollar donation: estimating the cost of researchers' time spent on peer review. Research Integrity and Peer Review 6", "url": "https://doi.org/10.1186/s41073-021-00118-2"}, {"@type": "CreativeWork", "name": "Van Noorden (2023). More than 10,000 research papers were retracted in 2023, a new record. Nature 624", "url": "https://doi.org/10.1038/d41586-023-03974-8"}, {"@type": "CreativeWork", "name": "NIH (2023). NOT-OD-23-149: generative AI prohibited in NIH peer review", "url": "https://grants.nih.gov/grants/guide/notice-files/NOT-OD-23-149.html"}, {"@type": "CreativeWork", "name": "OSTP (2022). Ensuring free, immediate, and equitable access to federally funded research", "url": "https://bidenwhitehouse.archives.gov/wp-content/uploads/2022/08/08-2022-OSTP-Public-Access-Memo.pdf"}, {"@type": "CreativeWork", "name": "Wilkinson et al. (2016). The FAIR Guiding Principles for scientific data management and stewardship. Scientific Data 3", "url": "https://doi.org/10.1038/sdata.2016.18"}, {"@type": "CreativeWork", "name": "Journal of Open Source Software: open review on GitHub", "url": "https://joss.readthedocs.io/"}, {"@type": "CreativeWork", "name": "Nüst, Eglen (2021). CODECHECK: an open science initiative for the independent execution of computations. F1000Research 10", "url": "https://doi.org/10.12688/f1000research.51738.2"}, {"@type": "CreativeWork", "name": "ReScience C: reproducible replications in computational science", "url": "https://rescience.github.io/"}, {"@type": "CreativeWork", "name": "Council of the EU (2023). Conclusions on high-quality, transparent, open, trustworthy and equitable scholarly publishing (9616/23)", "url": "https://european-research-area.ec.europa.eu/documents/council-conclusions-high-quality-transparent-open-trustworthy-and-equitable-scholarly"}, {"@type": "CreativeWork", "name": "Science Europe, cOAlition S, OPERAS, ANR (2022). Action Plan for Diamond Open Access", "url": "https://doi.org/10.5281/zenodo.6282402"}, {"@type": "CreativeWork", "name": "European Commission. Open Research Europe", "url": "https://open-research-europe.ec.europa.eu/"}, {"@type": "CreativeWork", "name": "CoARA. Agreement on Reforming Research Assessment (2022)", "url": "https://coara.eu/agreement/the-agreement-full-text/"}, {"@type": "CreativeWork", "name": "Regulation (EU) 2024/1689 (AI Act)", "url": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"}, {"@type": "CreativeWork", "name": "Loi n° 2016-1321 pour une République numérique, article 30 (art. L533-4 du code de la recherche)", "url": "https://www.legifrance.gouv.fr/jorf/id/JORFTEXT000033202746"}, {"@type": "CreativeWork", "name": "Deuxième Plan national pour la science ouverte 2021-2024", "url": "https://www.enseignementsup-recherche.gouv.fr/fr/une-politique-ambitieuse-pour-la-science-ouverte-50735"}, {"@type": "CreativeWork", "name": "Software Heritage, l'archive universelle du code source", "url": "https://www.softwareheritage.org/"}, {"@type": "CreativeWork", "name": "SoftwareX: research software publications and reuse", "url": "https://www.sciencedirect.com/journal/softwarex"}]}, {"@type": "FAQPage", "@id": "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance#faq", "inLanguage": "fr", "mainEntity": [{"@type": "Question", "name": "L'édition scientifique va-t-elle si mal ?", "acceptedAnswer": {"@type": "Answer", "text": "Le nombre d'articles indexés a crû d'environ 47 % entre 2016 et 2022, plus vite que le nombre de chercheurs ; la relecture, gratuite, ne suit plus, et plus de 10 000 articles ont été rétractés en 2023, un record."}}, {"@type": "Question", "name": "Faut-il interdire l'IA dans l'écriture et la relecture ?", "acceptedAnswer": {"@type": "Answer", "text": "Non : il faut l'afficher. Comme pour tout autre outil, on déclare ce qui a été utilisé et pour quoi ; ce qui compte est que les résultats soient vérifiés, données et code compris."}}, {"@type": "Question", "name": "Pourquoi parler de l'AI Act à propos d'articles ?", "acceptedAnswer": {"@type": "Answer", "text": "Parce qu'il impose aux systèmes d'IA à haut risque ce qui manque aux articles : gouvernance des données, documentation technique, journalisation, système de gestion de la qualité et surveillance après la mise sur le marché."}}, {"@type": "Question", "name": "Faut-il créer de nouvelles revues ?", "acceptedAnswer": {"@type": "Answer", "text": "Pas forcément. Le manque est dans la vérification et dans la reconnaissance du travail d'édition, pas dans le nombre de titres."}}]}, {"@type": "DefinedTermSet", "@id": "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance/#glossary", "name": "Glossaire de l'édition scientifique", "inLanguage": "fr", "hasDefinedTerm": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance/#glossary-acc-s-ouvert-diamant", "name": "Accès ouvert diamant", "description": "Revues gratuites pour les auteurs comme pour les lecteurs, financées par des institutions.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance/#glossary-apc-article-processing-charge", "name": "APC (Article Processing Charge)", "description": "Frais payés par les auteurs, ou leur institution, pour publier un article en accès ouvert.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance/#glossary-codecheck", "name": "CODECHECK", "description": "Un tiers exécute le code d'un article et certifie que les figures et tableaux annoncés sont régénérés ; il ne juge pas la validité scientifique.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance/#glossary-coara", "name": "CoARA", "description": "Coalition européenne pour réformer l'évaluation de la recherche : reconnaître la diversité des contributions, pas seulement le nombre d'articles.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance/#glossary-doi", "name": "DOI", "description": "Identifiant pérenne d'un article, d'un jeu de données ou d'une version de logiciel.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance/#glossary-fabrique-d-articles-paper-mill", "name": "Fabrique d'articles (paper mill)", "description": "Organisation qui vend des articles fabriqués ou falsifiés, souvent glissés dans des numéros spéciaux.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance/#glossary-fair", "name": "FAIR", "description": "Faciles à trouver, accessibles, interopérables, réutilisables : des principes pour les données, pas une licence.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance/#glossary-mlops", "name": "MLOps", "description": "Pratiques d'ingénierie pour versionner, tracer, déployer et surveiller des modèles d'apprentissage.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance/#glossary-reproductibilit", "name": "Reproductibilité", "description": "Retrouver un résultat avec les mêmes données et le même code ; la réplication le retrouve avec de nouvelles données.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance/#glossary-r-tractation", "name": "Rétractation", "description": "Retrait officiel d'un article publié, pour erreur grave ou fraude ; l'article reste visible, marqué comme rétracté.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance/#glossary"}}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours#page", "url": "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours/", "name": "Cours : transferts thermiques, refroidissement et congélation des aliments", "description": "Concepts fondamentaux, conduction, convection, nombre de Biot, propriétés thermiques des aliments, puissance frigorifique, quantité d'eau à congeler et bilan énergétique.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/"}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Enseignement", "item": "https://www.cyrilvoyant.com/fr/enseignement/"}, {"@type": "ListItem", "position": 3, "name": "Bases thermiques des aliments", "item": "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/"}, {"@type": "ListItem", "position": 4, "name": "Chapitre 1", "item": "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours/"}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours/#chapter", "name": "Cours : transferts thermiques, refroidissement et congélation des aliments", "description": "Concepts fondamentaux, conduction, convection, nombre de Biot, propriétés thermiques des aliments, puissance frigorifique, quantité d'eau à congeler et bilan énergétique.", "inLanguage": "fr", "learningResourceType": "Diaporama de cours", "educationalLevel": "B.U.T. Génie biologique, parcours Sciences de l'aliment et biotechnologie (SAB), 1ʳᵉ année", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/deed.fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/#course"}, "encoding": {"@type": "MediaObject", "encodingFormat": "application/pdf", "contentUrl": "https://www.cyrilvoyant.com/assets/legacy/bases-thermiques-aliments/bases-thermiques-aliments-cours-diaporama.pdf"}}, {"@type": "FAQPage", "@id": "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours/#faq", "inLanguage": "fr", "mainEntity": [{"@type": "Question", "name": "Que change concrètement un nombre de Biot élevé ?", "acceptedAnswer": {"@type": "Answer", "text": "La résistance interne domine : la surface suit vite le fluide tandis que le cœur traîne ; la loi exponentielle à température uniforme ne vaut plus, il faut une solution de conduction transitoire et surveiller la température à cœur, qui fixe la sécurité sanitaire."}}, {"@type": "Question", "name": "Pourquoi la puissance de congélation est-elle si supérieure à celle de réfrigération pour une même masse ?", "acceptedAnswer": {"@type": "Answer", "text": "Le palier de changement d'état ajoute la chaleur latente de l'eau congelée, environ 333 kJ par kilogramme de glace formée, soit l'équivalent de dizaines de degrés de refroidissement ; à durée égale, la puissance doit suivre."}}, {"@type": "Question", "name": "Pourquoi la température de début de congélation d'un aliment est-elle inférieure à 0 °C ?", "acceptedAnswer": {"@type": "Answer", "text": "Les solutés abaissent le point de congélation de l'eau ; à mesure que la glace se forme, la solution restante se concentre et son point de congélation baisse encore, si bien qu'une fraction d'eau reste liquide même à basse température."}}, {"@type": "Question", "name": "Augmenter la vitesse de l'air suffit-il à accélérer un refroidissement ?", "acceptedAnswer": {"@type": "Answer", "text": "Seulement tant que la résistance de surface 1/h domine ; quand le Biot devient grand, la conduction interne limite et souffler plus fort ne gagne presque rien, il vaut mieux réduire l'épaisseur du produit."}}]}, {"@type": "CollectionPage", "@id": "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments#page", "url": "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/", "name": "Bases de thermique pour le génie industriel alimentaire : transferts, refroidissement et congélation", "description": "Bases thermiques des aliments : un cours de 24 diapositives, B.U.T. Génie biologique, parcours Sciences de l'aliment et biotechnologie (SAB), 1ʳᵉ année.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/"}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Enseignement", "item": "https://www.cyrilvoyant.com/fr/enseignement/"}, {"@type": "ListItem", "position": 3, "name": "Bases thermiques des aliments", "item": "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/"}]}, {"@type": "Course", "@id": "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/#course", "name": "Bases de thermique pour le génie industriel alimentaire : transferts, refroidissement et congélation", "description": "Bases thermiques des aliments : un cours de 24 diapositives, B.U.T. Génie biologique, parcours Sciences de l'aliment et biotechnologie (SAB), 1ʳᵉ année. Les transferts thermiques appliqués aux aliments : conduction, convection et nombre de Biot, propriétés thermiques des aliments, puissance frigorifique et quantité d'eau à congeler, puis le bilan énergétique d'un refroidissement ou d'une congélation.", "inLanguage": "fr", "educationalLevel": "B.U.T. Génie biologique, parcours Sciences de l'aliment et biotechnologie (SAB), 1ʳᵉ année", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "provider": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/deed.fr", "teaches": ["transfert thermique", "conduction", "convection", "nombre de Biot", "propriétés thermiques des aliments", "puissance frigorifique", "congélation", "bilan énergétique"], "hasPart": [{"@id": "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/cours/#chapter", "@type": "LearningResource", "name": "Cours : transferts thermiques, refroidissement et congélation des aliments"}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/correlation-regression#page", "url": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/correlation-regression/", "name": "Chapitre 3 : corrélation, régression linéaire et tests du χ²", "description": "La covariance et la corrélation de Pearson, la droite de régression et le coefficient de détermination, la significativité de r, le χ² d'ajustement et le χ² d'indépendance, avec des exercices.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/"}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Enseignement", "item": "https://www.cyrilvoyant.com/fr/enseignement/"}, {"@type": "ListItem", "position": 3, "name": "Biostatistique", "item": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/"}, {"@type": "ListItem", "position": 4, "name": "Chapitre 3", "item": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/correlation-regression/"}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/correlation-regression/#chapter", "name": "Chapitre 3 : corrélation, régression linéaire et tests du χ²", "description": "La covariance et la corrélation de Pearson, la droite de régression et le coefficient de détermination, la significativité de r, le χ² d'ajustement et le χ² d'indépendance, avec des exercices.", "inLanguage": "fr", "learningResourceType": "Diaporama de cours", "educationalLevel": "Première année des études de santé (PASS, UE8)", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/deed.fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/#course"}, "encoding": {"@type": "MediaObject", "encodingFormat": "application/pdf", "contentUrl": "https://www.cyrilvoyant.com/assets/biostat/Biostatistique-correlation-regression.pdf"}}, {"@type": "FAQPage", "@id": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/correlation-regression/#faq", "inLanguage": "fr", "mainEntity": [{"@type": "Question", "name": "Quelle différence entre intervalle de confiance et de prévision ?", "acceptedAnswer": {"@type": "Answer", "text": "Dans une régression linéaire simple à erreurs indépendantes normales de variance constante : IC95 de la moyenne = ŷ0 ± t(n−2;0,975) se √[1/n + (x0−x̄)²/Sxx]. Pour une future observation, ajouter 1 sous la racine. Ici Sxx = Σ(xi−x̄)² et se² = Σrésidu²/(n−2). L’intervalle de prévision conserve donc la dispersion individuelle ; 1,96 n’est qu’une approximation asymptotique du quantile."}}, {"@type": "Question", "name": "Un r significatif suffit-il à rendre une prévision utile ?", "acceptedAnswer": {"@type": "Answer", "text": "Non : avec 1000 couples, r = 0,1 peut être significatif tout en n’expliquant que 1 % de la variation dans une régression simple avec constante. Rejeter ρ = 0 sous un modèle ne démontre ni causalité, ni utilité prédictive ; celle-ci se mesure aussi sur des données non utilisées pour ajuster le modèle."}}, {"@type": "Question", "name": "Pourquoi une seule valeur aberrante peut-elle tout changer ?", "acceptedAnswer": {"@type": "Answer", "text": "Les moindres carrés pèsent le carré des écarts : un point éloigné en x a un bras de levier qui tire la pente et gonfle ou crée r. On regarde toujours le nuage et les résidus avant de conclure."}}, {"@type": "Question", "name": "Que faire lorsque les effectifs attendus du χ² sont faibles ?", "acceptedAnswer": {"@type": "Answer", "text": "L’approximation asymptotique peut être médiocre ; examiner la taille et la structure du tableau. Un regroupement justifié ou une méthode exacte peuvent convenir, notamment Fisher pour un tableau 2×2 dans son cadre. La correction de continuité de Yates ne garantit pas de résoudre le problème des faibles effectifs."}}]}, {"@type": "CollectionPage", "@id": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique#page", "url": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/", "name": "Biostatistique pour les études de santé : le cours en trois chapitres", "description": "Un cours de biostatistique en trois chapitres et 246 diapositives, pour la première année des études de santé (PASS, unité d'enseignement UE8).", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/"}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Enseignement", "item": "https://www.cyrilvoyant.com/fr/enseignement/"}, {"@type": "ListItem", "position": 3, "name": "Biostatistique", "item": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/"}]}, {"@type": "Course", "@id": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/#course", "name": "Biostatistique pour les études de santé (PASS, UE8)", "description": "Un cours de biostatistique en trois chapitres et 246 diapositives, pour la première année des études de santé (PASS, unité d'enseignement UE8). Il va des probabilités et du raisonnement bayésien aux tests diagnostiques (sensibilité, spécificité, courbes ROC), à la statistique descriptive, à la loi normale et aux tests d'hypothèses, puis à la corrélation, à la régression linéaire et aux tests du χ², avec des exemples médicaux.", "inLanguage": "fr", "courseCode": "UE8", "educationalLevel": "Première année des études de santé (PASS)", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/deed.fr", "provider": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "hasPart": [{"@id": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/probabilites/#chapter", "@type": "LearningResource", "name": "Chapitre 1 : probabilités, probabilités conditionnelles, tableaux de contingence et courbes ROC"}, {"@id": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/statistiques-descriptives/#chapter", "@type": "LearningResource", "name": "Chapitre 2 : statistique descriptive, loi normale et tests d'hypothèses"}, {"@id": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/correlation-regression/#chapter", "@type": "LearningResource", "name": "Chapitre 3 : corrélation, régression linéaire et tests du χ²"}], "teaches": ["probabilités", "probabilités conditionnelles", "théorème de Bayes", "sensibilité et spécificité", "courbe ROC", "statistique descriptive", "loi normale", "test d'hypothèses", "corrélation de Pearson", "régression linéaire", "test du χ²"]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/probabilites#page", "url": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/probabilites/", "name": "Chapitre 1 : probabilités, probabilités conditionnelles, tableaux de contingence et courbes ROC", "description": "Pourquoi la santé a besoin de statistique, le vocabulaire des probabilités, le dénombrement, les probabilités conditionnelles et l'approche bayésienne, les tableaux de contingence, la sensibilité, la spécificité et les courbes ROC.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/"}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Enseignement", "item": "https://www.cyrilvoyant.com/fr/enseignement/"}, {"@type": "ListItem", "position": 3, "name": "Biostatistique", "item": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/"}, {"@type": "ListItem", "position": 4, "name": "Chapitre 1", "item": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/probabilites/"}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/probabilites/#chapter", "name": "Chapitre 1 : probabilités, probabilités conditionnelles, tableaux de contingence et courbes ROC", "description": "Pourquoi la santé a besoin de statistique, le vocabulaire des probabilités, le dénombrement, les probabilités conditionnelles et l'approche bayésienne, les tableaux de contingence, la sensibilité, la spécificité et les courbes ROC.", "inLanguage": "fr", "learningResourceType": "Diaporama de cours", "educationalLevel": "Première année des études de santé (PASS, UE8)", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/deed.fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/#course"}, "encoding": {"@type": "MediaObject", "encodingFormat": "application/pdf", "contentUrl": "https://www.cyrilvoyant.com/assets/biostat/Biostatistique-probabilites.pdf"}}, {"@type": "FAQPage", "@id": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/probabilites/#faq", "inLanguage": "fr", "mainEntity": [{"@type": "Question", "name": "Pourquoi la prévalence modifie-t-elle la valeur prédictive ?", "acceptedAnswer": {"@type": "Answer", "text": "Avec Se = Sp = 99 % et une prévalence de 1/1000, sur 1000 personnes on attend 0,99 vrai positif et 9,99 faux positifs, soit une VPP proche de 9 %. C’est une illustration de Bayes ; la conduite clinique dépend du contexte et du protocole."}}, {"@type": "Question", "name": "Que signifie une AUC de 0,8 ?", "acceptedAnswer": {"@type": "Answer", "text": "Avec un score orienté vers la présence de la maladie, AUC = P(score malade > score non-malade) + 0,5 P(égalité). Une AUC de 0,8 décrit ce classement, pas la probabilité individuelle d’être malade ni la qualité à un seuil précis."}}, {"@type": "Question", "name": "Le meilleur seuil maximise-t-il toujours Se + Sp ?", "acceptedAnswer": {"@type": "Answer", "text": "Non. Youden et la distance au coin idéal optimisent des critères différents ; ils ne codent pas automatiquement le coût clinique des erreurs. Une décision demande notamment la prévalence et les conséquences respectives des faux positifs et faux négatifs."}}, {"@type": "Question", "name": "Pourquoi l'approche bayésienne sert-elle à ajuster une posologie ?", "acceptedAnswer": {"@type": "Answer", "text": "Elle combine la connaissance de la population (distribution a priori des paramètres pharmacocinétiques) et les dosages du patient : quelques prélèvements suffisent pour une estimation individuelle, que l'on affine à chaque nouvelle mesure."}}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/statistiques-descriptives#page", "url": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/statistiques-descriptives/", "name": "Chapitre 2 : statistique descriptive, loi normale et tests d'hypothèses", "description": "Les échelles de mesure, les représentations graphiques, la tendance centrale et la dispersion, la loi normale et la table de l'écart réduit, les intervalles, les hypothèses et le test de comparaison de moyennes.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/"}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Enseignement", "item": "https://www.cyrilvoyant.com/fr/enseignement/"}, {"@type": "ListItem", "position": 3, "name": "Biostatistique", "item": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/"}, {"@type": "ListItem", "position": 4, "name": "Chapitre 2", "item": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/statistiques-descriptives/"}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/statistiques-descriptives/#chapter", "name": "Chapitre 2 : statistique descriptive, loi normale et tests d'hypothèses", "description": "Les échelles de mesure, les représentations graphiques, la tendance centrale et la dispersion, la loi normale et la table de l'écart réduit, les intervalles, les hypothèses et le test de comparaison de moyennes.", "inLanguage": "fr", "learningResourceType": "Diaporama de cours", "educationalLevel": "Première année des études de santé (PASS, UE8)", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/deed.fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/#course"}, "encoding": {"@type": "MediaObject", "encodingFormat": "application/pdf", "contentUrl": "https://www.cyrilvoyant.com/assets/biostat/Biostatistique-statistiques-descriptives.pdf"}}, {"@type": "FAQPage", "@id": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/statistiques-descriptives/#faq", "inLanguage": "fr", "mainEntity": [{"@type": "Question", "name": "Pourquoi diviser par n − 1 et non par n ?", "acceptedAnswer": {"@type": "Answer", "text": "Les écarts sont mesurés à la moyenne de l'échantillon, qui leur est la plus proche possible : diviser par n sous-estime systématiquement la variance. n − 1 corrige ce biais, car un degré de liberté a servi à estimer la moyenne."}}, {"@type": "Question", "name": "Une p-value de 0,03 donne-t-elle la probabilité que H0 soit vraie ?", "acceptedAnswer": {"@type": "Answer", "text": "Non. Sous H0 et les hypothèses du modèle, c’est la probabilité d’une statistique au moins aussi extrême que celle observée, selon le test choisi. Ce n’est ni P(H0 | données), ni une mesure de l’importance pratique de l’effet."}}, {"@type": "Question", "name": "Quand utilise-t-on la loi de Student pour une moyenne ?", "acceptedAnswer": {"@type": "Answer", "text": "Pour des observations indépendantes normales avec variance inconnue, (x̄ − μ0)/(s/√n) suit exactement une Student à n − 1 ddl, même à grand n. Sans normalité, l’approximation dépend de la taille et de la distribution ; les tests à deux groupes ou appariés ont leurs propres conditions."}}, {"@type": "Question", "name": "Un test de normalité suffit-il à choisir une méthode ?", "acceptedAnswer": {"@type": "Answer", "text": "Non : un grand échantillon détecte de faibles écarts et un petit échantillon manque de puissance. Il faut examiner les graphiques, les valeurs extrêmes, l’indépendance et la question d’inférence ; le théorème central limite ne répare pas une collecte biaisée ou toute dépendance."}}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/fr/enseignement/cours-prevision-solaire#page", "url": "https://www.cyrilvoyant.com/fr/enseignement/cours-prevision-solaire/", "name": "Cours de prévision solaire : prévoir la ressource solaire intermittente", "description": "Un cours de 59 diapositives sur la prévision du rayonnement solaire à une heure, donné dans le projet de recherche appliquée UE14 du cursus ingénieur civil de Mines Paris – PSL, sur dix ans de mesures horaires d'Ajaccio (Corse).", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-2"}], "translationOfWork": {"@id": "https://www.cyrilvoyant.com/teaching/solar-forecasting-course#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Enseignement", "item": "https://www.cyrilvoyant.com/fr/enseignement/"}, {"@type": "ListItem", "position": 3, "name": "Cours", "item": "https://www.cyrilvoyant.com/fr/enseignement/cours-prevision-solaire/"}]}, {"@type": "Course", "@id": "https://www.cyrilvoyant.com/fr/enseignement/cours-prevision-solaire/#course", "name": "Cours de prévision solaire : prévoir la ressource solaire intermittente", "description": "Un cours de 59 diapositives sur la prévision du rayonnement solaire à une heure, donné dans le projet de recherche appliquée UE14 du cursus ingénieur civil de Mines Paris – PSL, sur dix ans de mesures horaires d'Ajaccio (Corse). Il va du signal solaire et de l'indice de ciel clair aux modèles autorégressifs estimés par moindres carrés, puis aux Extreme Learning Machines, à l'apprentissage en ligne et à la frugalité, chaque modèle étant jugé contre la persistance ; sur l'année de test 2007, le nRMSE de jour vaut 22,0 % pour la persistance intelligente, 21,3 % pour l'AR(2) et 20,5 % pour un ELM.", "inLanguage": "fr", "courseCode": "UE14", "educationalLevel": "Engineering curriculum (Mines Paris – PSL)", "license": "https://creativecommons.org/licenses/by/4.0/", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "provider": {"@type": "CollegeOrUniversity", "name": "Mines Paris – PSL", "url": "https://www.minesparis.psl.eu/"}, "isBasedOn": "https://cyrilvoyant.github.io/teaching/solar-forecasting-basics.html", "hasPart": [{"@type": "LearningResource", "name": "Cours de prévision solaire : prévoir la ressource solaire intermittente (PowerPoint)", "encodingFormat": "application/vnd.openxmlformats-officedocument.presentationml.presentation", "contentUrl": "https://www.cyrilvoyant.com/assets/course/Prevision-de-la-Ressource-Solaire-Intermittente_FR.pptx"}, {"@type": "LearningResource", "name": "Cours de prévision solaire : prévoir la ressource solaire intermittente (PDF)", "encodingFormat": "application/pdf", "contentUrl": "https://www.cyrilvoyant.com/assets/course/Prevision-de-la-Ressource-Solaire-Intermittente_FR.pdf"}], "teaches": ["indice de ciel clair", "modèle autorégressif", "moindres carrés", "persistance", "évaluation des prévisions (nRMSE, score, NICE)", "Extreme Learning Machine", "apprentissage en ligne", "frugalité"]}, {"@type": "WebPage", "@id": "https://www.cyrilvoyant.com/fr/enseignement#page", "url": "https://www.cyrilvoyant.com/fr/enseignement/", "name": "Enseignement", "description": "Cinq cours en accès libre sous CC BY 4.0 : prévision solaire (Mines Paris – PSL), biostatistique et physique pour les études de santé, physique industrielle, thermique des aliments.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-3"}], "translationOfWork": {"@id": "https://www.cyrilvoyant.com/teaching#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Enseignement", "item": "https://www.cyrilvoyant.com/fr/enseignement/"}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques#page", "url": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques/", "name": "Chapitre 5 : les cycles frigorifiques", "description": "Le cycle en quatre étapes, les états du fluide, le cycle sur le diagramme de Mollier, COP et efficacité, froid industriel, fluides frigorigènes et réglementation.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/"}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Enseignement", "item": "https://www.cyrilvoyant.com/fr/enseignement/"}, {"@type": "ListItem", "position": 3, "name": "Physique industrielle", "item": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/"}, {"@type": "ListItem", "position": 4, "name": "Chapitre 5", "item": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques/"}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques/#chapter", "name": "Chapitre 5 : les cycles frigorifiques", "description": "Le cycle en quatre étapes, les états du fluide, le cycle sur le diagramme de Mollier, COP et efficacité, froid industriel, fluides frigorigènes et réglementation.", "inLanguage": "fr", "learningResourceType": "Diaporama de cours", "educationalLevel": "B.U.T. Génie biologique, parcours Sciences de l'aliment et biotechnologie (SAB), 2ᵉ année", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/deed.fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/#course"}, "encoding": {"@type": "MediaObject", "encodingFormat": "application/pdf", "contentUrl": "https://www.cyrilvoyant.com/assets/legacy/physique-industrielle/physique-industrielle-cycles-frigorifiques-diaporama.pdf"}}, {"@type": "FAQPage", "@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques/#faq", "inLanguage": "fr", "mainEntity": [{"@type": "Question", "name": "Pourquoi le COP chute-t-il quand l'écart entre chambre froide et extérieur augmente ?", "acceptedAnswer": {"@type": "Answer", "text": "La borne de Carnot T_f/(T_c − T_f) diminue quand l'écart grandit : congeler à −30 °C en été coûte bien plus de travail par kilojoule extrait que conserver à +4 °C ; d'où l'intérêt de condenser le plus froid possible et des cycles étagés pour les grands écarts."}}, {"@type": "Question", "name": "Dans quelles conditions le sous-refroidissement augmente-t-il le COP ?", "acceptedAnswer": {"@type": "Answer", "text": "À pressions et état d’aspiration inchangés, il diminue l’enthalpie à l’entrée du détendeur et augmente q0 sans changer le travail massique du compresseur. Le bilan réel doit aussi compter les auxiliaires et les éventuels changements du fonctionnement."}}, {"@type": "Question", "name": "La surchauffe à l’aspiration est-elle toujours utile ?", "acceptedAnswer": {"@type": "Answer", "text": "Elle protège le compresseur contre une arrivée de liquide. Elle augmente la chaleur utile seulement si elle se produit dans la zone à refroidir ; dans la conduite extérieure, elle ajoute une charge parasite. Son effet sur le COP dépend du fluide et du cycle."}}, {"@type": "Question", "name": "Pourquoi la détente est-elle isenthalpe et que perd-on ?", "acceptedAnswer": {"@type": "Answer", "text": "Le détendeur lamine le fluide sans échange de travail ni de chaleur : h se conserve, mais la détente est irréversible ; le travail qu'une turbine de détente aurait récupéré est perdu, ce qui justifie les éjecteurs ou les détendeurs à récupération sur les grandes installations, notamment au CO₂."}}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-moteurs#page", "url": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-moteurs/", "name": "Chapitre 4 : les cycles thermodynamiques moteurs", "description": "Premier et second principes, machines thermiques, équipements, cycles thermodynamiques, cycles des machines à vapeur et cycles complexes.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/"}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Enseignement", "item": "https://www.cyrilvoyant.com/fr/enseignement/"}, {"@type": "ListItem", "position": 3, "name": "Physique industrielle", "item": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/"}, {"@type": "ListItem", "position": 4, "name": "Chapitre 4", "item": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-moteurs/"}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-moteurs/#chapter", "name": "Chapitre 4 : les cycles thermodynamiques moteurs", "description": "Premier et second principes, machines thermiques, équipements, cycles thermodynamiques, cycles des machines à vapeur et cycles complexes.", "inLanguage": "fr", "learningResourceType": "Diaporama de cours", "educationalLevel": "B.U.T. Génie biologique, parcours Sciences de l'aliment et biotechnologie (SAB), 2ᵉ année", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/deed.fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/#course"}, "encoding": {"@type": "MediaObject", "encodingFormat": "application/pdf", "contentUrl": "https://www.cyrilvoyant.com/assets/legacy/physique-industrielle/physique-industrielle-cycles-moteurs-diaporama.pdf"}}, {"@type": "FAQPage", "@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-moteurs/#faq", "inLanguage": "fr", "mainEntity": [{"@type": "Question", "name": "Pourquoi aucun moteur réel n'atteint-il le rendement de Carnot ?", "acceptedAnswer": {"@type": "Answer", "text": "Le cycle de Carnot suppose des échanges de chaleur réversibles, donc à écart de température nul et infiniment lents ; un moteur réel échange sous des écarts finis, avec frottements et détentes irréversibles, qui créent de l'entropie et dégradent le travail récupérable."}}, {"@type": "Question", "name": "Pourquoi la régénération améliore-t-elle le rendement d'un cycle à vapeur ?", "acceptedAnswer": {"@type": "Answer", "text": "Préchauffer l'eau d'alimentation avec de la vapeur soutirée élève la température moyenne à laquelle la chaudière apporte la chaleur ; le cycle se rapproche d'un cycle de Carnot entre des températures plus élevées."}}, {"@type": "Question", "name": "Pourquoi comprimer fortement l’air dans un moteur Diesel ?", "acceptedAnswer": {"@type": "Answer", "text": "La compression chauffe l’air avant l’injection, afin de permettre l’auto-inflammation du carburant injecté. Dans un moteur à allumage commandé, l’auto-inflammation du mélange non brûlé peut provoquer du cliquetis ; il ne s’agit pas de classer simplement les carburants par facilité d’inflammation."}}, {"@type": "Question", "name": "Pourquoi l'eau est-elle le fluide de travail des grandes centrales ?", "acceptedAnswer": {"@type": "Answer", "text": "Elle est abondante, non toxique, stable, et sa chaleur latente de vaporisation est élevée : on transporte beaucoup d'énergie par kilogramme, et la pompe, qui comprime un liquide, consomme très peu de travail."}}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/gaz-parfaits-et-reels#page", "url": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/gaz-parfaits-et-reels/", "name": "Chapitre 2 : gaz parfaits, gaz réels et diagrammes", "description": "Le gaz parfait et ses limites, enthalpie et entropie, diagrammes de Clapeyron, entropique et de Mollier, lecture du diagramme P-h du R134a, interpolation.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/"}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Enseignement", "item": "https://www.cyrilvoyant.com/fr/enseignement/"}, {"@type": "ListItem", "position": 3, "name": "Physique industrielle", "item": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/"}, {"@type": "ListItem", "position": 4, "name": "Chapitre 2", "item": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/gaz-parfaits-et-reels/"}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/gaz-parfaits-et-reels/#chapter", "name": "Chapitre 2 : gaz parfaits, gaz réels et diagrammes", "description": "Le gaz parfait et ses limites, enthalpie et entropie, diagrammes de Clapeyron, entropique et de Mollier, lecture du diagramme P-h du R134a, interpolation.", "inLanguage": "fr", "learningResourceType": "Diaporama de cours", "educationalLevel": "B.U.T. Génie biologique, parcours Sciences de l'aliment et biotechnologie (SAB), 2ᵉ année", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/deed.fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/#course"}, "encoding": {"@type": "MediaObject", "encodingFormat": "application/pdf", "contentUrl": "https://www.cyrilvoyant.com/assets/legacy/physique-industrielle/physique-industrielle-gaz-parfaits-et-reels-diaporama.pdf"}}, {"@type": "FAQPage", "@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/gaz-parfaits-et-reels/#faq", "inLanguage": "fr", "mainEntity": [{"@type": "Question", "name": "Pourquoi les frigoristes préfèrent-ils le diagramme (ln p, h) ?", "acceptedAnswer": {"@type": "Answer", "text": "Les échanges au condenseur et à l'évaporateur y sont des horizontales (isobares), la détente un trait vertical (isenthalpe), et les énergies échangées se lisent directement comme des longueurs sur l'axe des enthalpies : le bilan du cycle se fait à la règle."}}, {"@type": "Question", "name": "Comment calculer l'enthalpie d'un mélange liquide-vapeur ?", "acceptedAnswer": {"@type": "Answer", "text": "Par la règle des moments : h = h_l + x (h_v − h_l), où h_l et h_v sont les enthalpies des liquide et vapeur saturés à la même pression ; le titre x se lit sur les isotitres ou se déduit d'un bilan."}}, {"@type": "Question", "name": "Quand l'interpolation linéaire dans une table devient-elle risquée ?", "acceptedAnswer": {"@type": "Answer", "text": "Près de la courbe de saturation et surtout du point critique, où les propriétés varient fortement et de façon non linéaire : il faut alors resserrer les pas de la table ou utiliser une équation d'état, plutôt que d'interpoler sur un grand intervalle."}}, {"@type": "Question", "name": "Peut-on traiter la vapeur d'un fluide frigorigène comme un gaz parfait ?", "acceptedAnswer": {"@type": "Answer", "text": "Seulement loin de la saturation et à basse pression ; dans un cycle frigorifique le fluide travaille justement au voisinage de la saturation, ce qui impose les diagrammes."}}]}, {"@type": "CollectionPage", "@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle#page", "url": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/", "name": "Physique industrielle : thermodynamique, vapeur d'eau et production de froid", "description": "Physique industrielle : un cours en 5 chapitres et 139 diapositives, B.U.T. Génie biologique, parcours Sciences de l'aliment et biotechnologie (SAB), 2ᵉ année.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/"}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Enseignement", "item": "https://www.cyrilvoyant.com/fr/enseignement/"}, {"@type": "ListItem", "position": 3, "name": "Physique industrielle", "item": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/"}]}, {"@type": "Course", "@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/#course", "name": "Physique industrielle : thermodynamique, vapeur d'eau et production de froid", "description": "Physique industrielle : un cours en 5 chapitres et 139 diapositives, B.U.T. Génie biologique, parcours Sciences de l'aliment et biotechnologie (SAB), 2ᵉ année. Les bases de thermodynamique d'un technicien de l'agroalimentaire : grandeurs et changements d'état, gaz parfaits et réels, diagrammes de Clapeyron, entropique et de Mollier, vapeur d'eau et humidité, cycles moteurs, puis le cycle frigorifique, son COP et ses fluides.", "inLanguage": "fr", "educationalLevel": "B.U.T. Génie biologique, parcours Sciences de l'aliment et biotechnologie (SAB), 2ᵉ année", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "provider": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/deed.fr", "teaches": ["thermodynamique", "changement d'état", "gaz parfait", "diagramme de Mollier", "vapeur d'eau", "humidité relative", "cycle thermodynamique", "cycle frigorifique", "coefficient de performance", "fluides frigorigènes"], "hasPart": [{"@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/notions-de-thermodynamique/#chapter", "@type": "LearningResource", "name": "Chapitre 1 : notions générales de thermodynamique"}, {"@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/gaz-parfaits-et-reels/#chapter", "@type": "LearningResource", "name": "Chapitre 2 : gaz parfaits, gaz réels et diagrammes"}, {"@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/vapeur-d-eau/#chapter", "@type": "LearningResource", "name": "Chapitre 3 : la vapeur d'eau"}, {"@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-moteurs/#chapter", "@type": "LearningResource", "name": "Chapitre 4 : les cycles thermodynamiques moteurs"}, {"@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/cycles-frigorifiques/#chapter", "@type": "LearningResource", "name": "Chapitre 5 : les cycles frigorifiques"}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/notions-de-thermodynamique#page", "url": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/notions-de-thermodynamique/", "name": "Chapitre 1 : notions générales de thermodynamique", "description": "Pression, température, travail et chaleur, chaleur sensible et latente, évaporation, ébullition, point triple et condensation.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/"}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Enseignement", "item": "https://www.cyrilvoyant.com/fr/enseignement/"}, {"@type": "ListItem", "position": 3, "name": "Physique industrielle", "item": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/"}, {"@type": "ListItem", "position": 4, "name": "Chapitre 1", "item": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/notions-de-thermodynamique/"}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/notions-de-thermodynamique/#chapter", "name": "Chapitre 1 : notions générales de thermodynamique", "description": "Pression, température, travail et chaleur, chaleur sensible et latente, évaporation, ébullition, point triple et condensation.", "inLanguage": "fr", "learningResourceType": "Diaporama de cours", "educationalLevel": "B.U.T. Génie biologique, parcours Sciences de l'aliment et biotechnologie (SAB), 2ᵉ année", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/deed.fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/#course"}, "encoding": {"@type": "MediaObject", "encodingFormat": "application/pdf", "contentUrl": "https://www.cyrilvoyant.com/assets/legacy/physique-industrielle/physique-industrielle-notions-de-thermodynamique-diaporama.pdf"}}, {"@type": "FAQPage", "@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/notions-de-thermodynamique/#faq", "inLanguage": "fr", "mainEntity": [{"@type": "Question", "name": "Pourquoi la chaleur latente compte-t-elle dans une congélation ?", "acceptedAnswer": {"@type": "Answer", "text": "Pour l’eau pure, 333 kJ/kg de glace formée représentent environ 80 °C de chaleur sensible de l’eau liquide. Dans un aliment, il faut multiplier par la masse d’eau effectivement congelée et ajouter les autres échanges ; la durée dépend aussi des résistances thermiques et de la géométrie."}}, {"@type": "Question", "name": "Quelle température d’évaporation faut-il choisir pour un fluide frigorigène ?", "acceptedAnswer": {"@type": "Answer", "text": "Elle doit être inférieure à celle du milieu à refroidir. La pression de saturation correspondante, la sécurité, l’impact environnemental et le cycle guident le choix ; bouillir sous 0 °C à pression atmosphérique n’est pas une condition universelle."}}, {"@type": "Question", "name": "La surfusion a-t-elle une conséquence pratique pour les aliments ?", "acceptedAnswer": {"@type": "Answer", "text": "Oui : un produit peut rester liquide sous sa température de congélation puis cristalliser brusquement ; la température mesurée remonte alors au palier, ce qui fausse une lecture naïve des courbes de congélation et influe sur la taille des cristaux."}}, {"@type": "Question", "name": "Pourquoi raisonner en pression absolue alors que les manomètres affichent une pression relative ?", "acceptedAnswer": {"@type": "Answer", "text": "Les relations d'état (gaz parfaits, tables de vapeur, relation pression-température de saturation) portent sur la pression absolue ; oublier la pression atmosphérique fausse d'environ 1 bar tous les points du cycle, ce qui est énorme côté basse pression."}}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/vapeur-d-eau#page", "url": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/vapeur-d-eau/", "name": "Chapitre 3 : la vapeur d'eau", "description": "Détente et compression, température et altitude, condensation, pression de vapeur saturante, humidité relative et chaleur latente.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/"}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Enseignement", "item": "https://www.cyrilvoyant.com/fr/enseignement/"}, {"@type": "ListItem", "position": 3, "name": "Physique industrielle", "item": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/"}, {"@type": "ListItem", "position": 4, "name": "Chapitre 3", "item": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/vapeur-d-eau/"}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/vapeur-d-eau/#chapter", "name": "Chapitre 3 : la vapeur d'eau", "description": "Détente et compression, température et altitude, condensation, pression de vapeur saturante, humidité relative et chaleur latente.", "inLanguage": "fr", "learningResourceType": "Diaporama de cours", "educationalLevel": "B.U.T. Génie biologique, parcours Sciences de l'aliment et biotechnologie (SAB), 2ᵉ année", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/deed.fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/#course"}, "encoding": {"@type": "MediaObject", "encodingFormat": "application/pdf", "contentUrl": "https://www.cyrilvoyant.com/assets/legacy/physique-industrielle/physique-industrielle-vapeur-d-eau-diaporama.pdf"}}, {"@type": "FAQPage", "@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/vapeur-d-eau/#faq", "inLanguage": "fr", "mainEntity": [{"@type": "Question", "name": "Pourquoi l’humidité relative peut-elle monter la nuit sans apport d’eau ?", "acceptedAnswer": {"@type": "Answer", "text": "À pression et rapport de mélange approximativement constants, la baisse de température réduit la pression de saturation : HR = 100 e/es augmente. À saturation, de l’eau peut se condenser ; sous zéro, une déposition de glace est également possible."}}, {"@type": "Question", "name": "D'où vient le coefficient 0,622 ?", "acceptedAnswer": {"@type": "Answer", "text": "C'est le rapport des masses molaires de l'eau et de l'air sec, 18,0/28,96 : il convertit un rapport de pressions partielles en rapport de masses."}}, {"@type": "Question", "name": "Pourquoi un évaporateur peut-il givrer ?", "acceptedAnswer": {"@type": "Answer", "text": "Sur une surface froide sous 0 °C, de la vapeur peut se déposer en glace ou des gouttelettes se condenser puis geler. Le dépôt ajoute une résistance thermique et perturbe l’écoulement de l’air ; l’humidité entrante joue donc sur le besoin de dégivrage."}}, {"@type": "Question", "name": "Pourquoi la chaleur latente intéresse-t-elle autant les procédés ?", "acceptedAnswer": {"@type": "Answer", "text": "Elle permet de transporter beaucoup d'énergie à température constante : condenser de la vapeur chauffe fortement une paroi sans la surchauffer, ce qui explique l'usage de la vapeur en cuisson et en stérilisation, et des fluides diphasiques en froid."}}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed1-corrige#page", "url": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed1-corrige/", "name": "Exercices dirigés 1 : les ondes électromagnétiques, corrigé", "description": "Neuf exercices corrigés pas à pas sur les ondes électromagnétiques : énergie et longueur d'onde du photon, électron-volt, fréquence et période, onde sinusoïdale, avec l'énoncé en PDF.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/"}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Enseignement", "item": "https://www.cyrilvoyant.com/fr/enseignement/"}, {"@type": "ListItem", "position": 3, "name": "Physique PASS", "item": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/"}, {"@type": "ListItem", "position": 4, "name": "Chapitre 2", "item": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed1-corrige/"}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed1-corrige/#chapter", "name": "Exercices dirigés 1 : les ondes électromagnétiques, corrigé", "description": "Neuf exercices corrigés pas à pas sur les ondes électromagnétiques : énergie et longueur d'onde du photon, électron-volt, fréquence et période, onde sinusoïdale, avec l'énoncé en PDF.", "inLanguage": "fr", "learningResourceType": "Diaporama de cours", "educationalLevel": "Première année des études de santé (PASS-PACES), bases physiques des explorations médicales, semestre 1", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/deed.fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/#course"}, "encoding": {"@type": "MediaObject", "encodingFormat": "application/pdf", "contentUrl": "https://www.cyrilvoyant.com/assets/legacy/physique-pass/physique-pass-ed1-corrige-diaporama.pdf"}}, {"@type": "FAQPage", "@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed1-corrige/#faq", "inLanguage": "fr", "mainEntity": [{"@type": "Question", "name": "Pourquoi raisonner en nombre de CDA plutôt qu'avec l'exponentielle ?", "acceptedAnswer": {"@type": "Answer", "text": "Parce que les traversées successives se composent par multiplication : 2 CDA de tumeur puis 3 CDA de tissu sain transmettent 1/2⁵ = 1/32, sans calculatrice ; l'exponentielle n'est nécessaire que pour une épaisseur qui n'est pas un multiple simple de la CDA."}}, {"@type": "Question", "name": "L’intensité d’une onde dépend-elle de sa phase ?", "acceptedAnswer": {"@type": "Answer", "text": "Pour une onde plane sinusoïdale isolée, moyennée sur de nombreuses périodes, ⟨E²⟩ = E0²/2 ne dépend pas de la phase initiale et I = ε0 c E0²/2 dans le vide. En superposition, les phases relatives interviennent dans les interférences."}}, {"@type": "Question", "name": "Pourquoi préciser les unités avant un calcul d’atténuation ?", "acceptedAnswer": {"@type": "Answer", "text": "L’exposant μx doit être sans dimension. Si μ est en cm⁻¹, exprimer x en cm ; une épaisseur en millimètres non convertie introduit un facteur dix dans l’exposant."}}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed2-corrige#page", "url": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed2-corrige/", "name": "Exercices dirigés 2 : les ondes électromagnétiques, corrigé", "description": "Neuf exercices corrigés pas à pas : niveaux d'énergie, absorption et émission, rayons X, atténuation et couche de demi-atténuation, avec l'énoncé en PDF.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/"}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Enseignement", "item": "https://www.cyrilvoyant.com/fr/enseignement/"}, {"@type": "ListItem", "position": 3, "name": "Physique PASS", "item": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/"}, {"@type": "ListItem", "position": 4, "name": "Chapitre 3", "item": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed2-corrige/"}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed2-corrige/#chapter", "name": "Exercices dirigés 2 : les ondes électromagnétiques, corrigé", "description": "Neuf exercices corrigés pas à pas : niveaux d'énergie, absorption et émission, rayons X, atténuation et couche de demi-atténuation, avec l'énoncé en PDF.", "inLanguage": "fr", "learningResourceType": "Diaporama de cours", "educationalLevel": "Première année des études de santé (PASS-PACES), bases physiques des explorations médicales, semestre 1", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/deed.fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/#course"}, "encoding": {"@type": "MediaObject", "encodingFormat": "application/pdf", "contentUrl": "https://www.cyrilvoyant.com/assets/legacy/physique-pass/physique-pass-ed2-corrige-diaporama.pdf"}}, {"@type": "FAQPage", "@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed2-corrige/#faq", "inLanguage": "fr", "mainEntity": [{"@type": "Question", "name": "Pourquoi le coefficient d'atténuation massique du plomb remonte-t-il au-delà de quelques MeV ?", "acceptedAnswer": {"@type": "Answer", "text": "La création de paires, nulle sous 1,022 MeV, croît avec l'énergie et avec Z² ; dans le plomb (Z = 82) elle devient dominante et rend un faisceau de 100 MeV moins pénétrant qu'un faisceau de quelques MeV."}}, {"@type": "Question", "name": "Un photon d'énergie supérieure à l'énergie d'ionisation ionise-t-il forcément l'atome ?", "acceptedAnswer": {"@type": "Answer", "text": "Non : l'énergie est une condition nécessaire, pas suffisante ; l'interaction a une probabilité (section efficace) qui dépend de l'énergie et de la couche, d'où une lecture statistique de l'atténuation."}}, {"@type": "Question", "name": "Pourquoi distinguer He et He⁺ dans un modèle hydrogénoïde ?", "acceptedAnswer": {"@type": "Answer", "text": "La loi −13,6 Z²/n² eV décrit un système à un électron. He⁺ en possède un ; He neutre en possède deux et les interactions électroniques empêchent d’utiliser directement cette formule pour sa première ionisation."}}]}, {"@type": "CollectionPage", "@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass#page", "url": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/", "name": "Physique pour les études de santé : ondes électromagnétiques, rayons X et imagerie", "description": "Physique PASS : un cours en 3 chapitres et 159 diapositives, Première année des études de santé (PASS-PACES), bases physiques des explorations médicales, semestre 1.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/"}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Enseignement", "item": "https://www.cyrilvoyant.com/fr/enseignement/"}, {"@type": "ListItem", "position": 3, "name": "Physique PASS", "item": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/"}]}, {"@type": "Course", "@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/#course", "name": "Physique pour les études de santé : ondes électromagnétiques, rayons X et imagerie", "description": "Physique PASS : un cours en 3 chapitres et 159 diapositives, Première année des études de santé (PASS-PACES), bases physiques des explorations médicales, semestre 1. Les bases physiques de l'imagerie médicale : la nature des ondes électromagnétiques et du photon, les niveaux d'énergie de l'atome, l'absorption, l'émission et la spectroscopie (jusqu'à l'oxymétrie de pouls), la production des rayons X, leurs interactions avec la matière et l'atténuation, puis la radiologie et le scanner. Avec deux séances d'exercices dirigés corrigées.", "inLanguage": "fr", "educationalLevel": "Première année des études de santé (PASS-PACES), bases physiques des explorations médicales, semestre 1", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "provider": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/deed.fr", "teaches": ["ondes électromagnétiques", "photon", "électron-volt", "niveaux d'énergie", "spectroscopie", "oxymétrie de pouls", "rayons X", "tube de Coolidge", "effet photoélectrique", "effet Compton", "création de paires", "couche de demi-atténuation", "scanner X"], "hasPart": [{"@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#chapter", "@type": "LearningResource", "name": "Cours : les ondes électromagnétiques et les bases physiques de l'imagerie"}, {"@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed1-corrige/#chapter", "@type": "LearningResource", "name": "Exercices dirigés 1 : les ondes électromagnétiques, corrigé"}, {"@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ed2-corrige/#chapter", "@type": "LearningResource", "name": "Exercices dirigés 2 : les ondes électromagnétiques, corrigé"}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques#page", "url": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/", "name": "Cours : les ondes électromagnétiques et les bases physiques de l'imagerie", "description": "De l'onde au photon, du spectre aux niveaux d'énergie, de la spectroscopie aux rayons X, de l'atténuation au scanner.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/"}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Enseignement", "item": "https://www.cyrilvoyant.com/fr/enseignement/"}, {"@type": "ListItem", "position": 3, "name": "Physique PASS", "item": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/"}, {"@type": "ListItem", "position": 4, "name": "Chapitre 1", "item": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/"}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#chapter", "name": "Cours : les ondes électromagnétiques et les bases physiques de l'imagerie", "description": "De l'onde au photon, du spectre aux niveaux d'énergie, de la spectroscopie aux rayons X, de l'atténuation au scanner.", "inLanguage": "fr", "learningResourceType": "Diaporama de cours", "educationalLevel": "Première année des études de santé (PASS-PACES), bases physiques des explorations médicales, semestre 1", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/deed.fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/#course"}, "encoding": {"@type": "MediaObject", "encodingFormat": "application/pdf", "contentUrl": "https://www.cyrilvoyant.com/assets/legacy/physique-pass/physique-pass-ondes-electromagnetiques-diaporama.pdf"}}, {"@type": "FAQPage", "@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#faq", "inLanguage": "fr", "mainEntity": [{"@type": "Question", "name": "Pourquoi l'os est-il si contrasté à basse tension et beaucoup moins à haute tension ?", "acceptedAnswer": {"@type": "Answer", "text": "À basse énergie l'effet photoélectrique domine, en Z³/E³ : le calcium de l'os absorbe beaucoup plus que les tissus mous. À haute énergie l'effet Compton domine, qui dépend surtout de la densité électronique, presque identique d'un tissu à l'autre."}}, {"@type": "Question", "name": "Comment doubler l’énergie maximale sans changer la puissance rayonnée du tube ?", "acceptedAnswer": {"@type": "Answer", "text": "Dans l’approximation F = KiZU², à matériau et coefficient K inchangés, doubler U et diviser i par quatre conserve F. L’énergie maximale double ; le spectre et le rendement changent aussi. La proportionnalité du nombre de photons au courant vaut à tension et durée fixées."}}, {"@type": "Question", "name": "Pourquoi l'électron Compton n'emporte-t-il jamais toute l'énergie du photon ?", "acceptedAnswer": {"@type": "Answer", "text": "La conservation de l'énergie et de la quantité de mouvement impose un photon diffusé ; l'énergie transférée est maximale en rétrodiffusion, E_c,max = E₀ · 2α/(1 + 2α) avec α = E₀/(m_e c²), toujours inférieure à E₀."}}, {"@type": "Question", "name": "Pourquoi filtrer le faisceau à la sortie du tube ?", "acceptedAnswer": {"@type": "Answer", "text": "Les photons de basse énergie sont absorbés dans les premiers centimètres de tissu : ils irradient le patient sans contribuer à l'image. La filtration les retire et durcit le faisceau, au prix d'une légère perte de contraste."}}]}, {"@type": "WebPage", "@id": "https://www.cyrilvoyant.com/fr/excellence-rtvacos#page", "url": "https://www.cyrilvoyant.com/fr/excellence-rtvacos/", "name": "RTVACOS : l'arbre de l'excellence scientifique, une boîte à outils pour chercheurs", "description": "Un miroir interactif du cadre RTVACOS : quatre fondations (rigueur, transparence, visibilité, adoption) comme racines, trois amplificateurs comme branches. Cochez vos pratiques, l'arbre pousse ; pas de note.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "translationOfWork": {"@id": "https://www.cyrilvoyant.com/research-excellence-rtvacos#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Excellence (RTVACOS)", "item": "https://www.cyrilvoyant.com/fr/excellence-rtvacos/"}]}, {"@type": "ScholarlyArticle", "name": "Beyond Publish and Pray: Engineering Research Excellence", "url": "https://doi.org/10.2139/ssrn.6877118", "datePublished": "2026", "author": [{"@type": "Person", "name": "Cyril Voyant", "@id": "https://person.cyrilvoyant.com/#cyril-voyant"}, {"@type": "Person", "name": "Rodrigo Amaro e Silva", "sameAs": "https://orcid.org/0000-0002-2813-150X"}, {"@type": "Person", "name": "Nicolas Fichaux", "sameAs": "https://orcid.org/0009-0008-2824-0387"}, {"@type": "Person", "name": "Lionel Ménard", "sameAs": "https://orcid.org/0009-0002-2156-8538"}, {"@type": "Person", "name": "Sylvain Cros", "sameAs": "https://orcid.org/0000-0002-7702-2123"}, {"@type": "Person", "name": "Rodanthi-Elisavet Mamouri", "sameAs": "https://orcid.org/0000-0003-4836-8560"}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/fr/ia-dans-la-recherche#page", "url": "https://www.cyrilvoyant.com/fr/ia-dans-la-recherche/", "name": "L'IA dans la recherche : AI Act, charte de laboratoire et boîte à outils", "description": "L'IA générative écrit du code, rédige des articles et trie des données dans tous les laboratoires. Le règlement européen sur l'IA (AI Act) encadre ce que nous construisons et ce que nous transférons. Voici ce qui change pour les chercheurs, le calendrier européen et français, la comparaison avec le reste du monde, la question de la responsabilité quand un code de recherche devient un produit, et une boîte à outils qu'un laboratoire peut adopter en quelques heures par projet.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-5"}], "datePublished": "2026-10-23", "dateModified": "2026-10-24", "version": "1.2", "keywords": ["Démontrer la confiance", "Pratique de la recherche"], "translationOfWork": {"@id": "https://www.cyrilvoyant.com/ai-in-research#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Récits", "item": "https://www.cyrilvoyant.com/fr/recits/"}, {"@type": "ListItem", "position": 3, "name": "L'IA dans la recherche : AI Act, charte de laboratoire et boîte à outils", "item": "https://www.cyrilvoyant.com/fr/ia-dans-la-recherche/"}]}, {"@type": "FAQPage", "@id": "https://www.cyrilvoyant.com/fr/ia-dans-la-recherche/#faq", "inLanguage": "fr", "mainEntity": [{"@type": "Question", "name": "La recherche scientifique est-elle exemptée de l'AI Act ?", "acceptedAnswer": {"@type": "Answer", "text": "Les exclusions dépendent de la finalité du système et de son stade, pas seulement du statut de chercheur. L'article 2 vise les systèmes développés et mis en service à la seule fin de recherche scientifique, ainsi que certaines activités de recherche avant commercialisation. Les essais en conditions réelles sont exclus de cette seconde exemption. Le périmètre doit être réévalué avant un transfert ou un déploiement."}}, {"@type": "Question", "name": "Quelles échéances pour l'IA à haut risque faut-il suivre au laboratoire ?", "acceptedAnswer": {"@type": "Answer", "text": "Au 23 octobre 2026, le calendrier révisé prévoit le 2 décembre 2027 pour les usages à haut risque de l'annexe III et le 2 août 2028 pour l'IA à haut risque intégrée aux produits réglementés de l'annexe I. D'autres obligations ont leur propre calendrier. Il faut identifier le système et la disposition concernés avant de retenir une échéance."}}, {"@type": "Question", "name": "Qui est responsable quand un code de laboratoire est transféré ?", "acceptedAnswer": {"@type": "Answer", "text": "Il faut identifier le fournisseur, le déployeur et les autres acteurs du système réel. Pour les systèmes à haut risque, l'article 25 précise les circonstances dans lesquelles un changement de marque, une modification substantielle ou un changement de finalité peut faire d'un autre acteur le fournisseur. Le contrat documente les rôles sans remplacer les obligations légales applicables."}}, {"@type": "Question", "name": "Que documenter en premier au laboratoire ?", "acceptedAnswer": {"@type": "Answer", "text": "Consigner la finalité, les responsables, l'origine des données, les versions du modèle et du code, les tests et les limites. Préparer des fiches de données et de modèle, une déclaration d'usage de l'IA et un registre des projets. Avant un transfert, revoir les rôles et le dossier avec le service juridique. Ce sont des recommandations pratiques, pas une certification de conformité."}}]}, {"@type": "WebPage", "@id": "https://www.cyrilvoyant.com/fr/#page", "url": "https://www.cyrilvoyant.com/fr/", "name": "Comprendre avant de calculer", "description": "Cyril Voyant, physicien et directeur de recherche à Mines Paris – PSL : calculer directement quand le lien est connu, hybrider quand le modèle ne suffit pas, monter l'échelle de la complexité seulement si elle paie.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-2"}], "translationOfWork": {"@id": "https://www.cyrilvoyant.com/#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}]}, {"@type": "WebSite", "@id": "https://www.cyrilvoyant.com/#website", "url": "https://www.cyrilvoyant.com/", "name": "Cyril Voyant", "inLanguage": ["en", "fr"], "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "jobTitle": "Research Director", "affiliation": {"@type": "Organization", "name": "Mines Paris – PSL, Centre O.I.E."}, "sameAs": ["https://orcid.org/0000-0003-0242-7377", "https://www.wikidata.org/wiki/Q58251573", "https://scholar.google.com/citations?user=aUlP6agAAAAJ", "https://person.cyrilvoyant.com/", "https://cyrilvoyant.github.io/"], "knowsAbout": ["Concentric modeling", "Hybrid modeling", "Solar forecasting", "Forecast evaluation", "Frugal artificial intelligence", "Radiobiology", "Medical physics", "Language models as interfaces to scientific codes"]}, {"@type": "CollectionPage", "@id": "https://www.cyrilvoyant.com/fr/le-fil#page", "url": "https://www.cyrilvoyant.com/fr/le-fil/", "name": "Le fil : cinq étapes, du calcul direct à la confiance", "description": "Le fil des recherches de Cyril Voyant en cinq étapes : calculer quand le lien est connu, hybrider, apprendre frugalement, l'IA à sa place, démontrer la confiance. Chaque étape mène à ses récits.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-2"}], "translationOfWork": {"@id": "https://www.cyrilvoyant.com/the-thread#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Le fil", "item": "https://www.cyrilvoyant.com/fr/le-fil/"}]}, {"@type": "ItemList", "itemListElement": [{"@type": "ListItem", "position": 1, "url": "https://www.cyrilvoyant.com/fr/recits/lql-equiv/", "name": "Calculer plutôt qu'apprendre : l'équivalence de dose en radiothérapie"}, {"@type": "ListItem", "position": 2, "url": "https://www.cyrilvoyant.com/fr/recits/tunnel-load-simulator/", "name": "Simuler ce que l'on ne peut pas encore mesurer : les tunnels routiers"}, {"@type": "ListItem", "position": 3, "url": "https://www.cyrilvoyant.com/fr/actualites/why-forecast-solar-power/", "name": "Le ciel change, mais à quel point reste-t-il prévisible ?"}, {"@type": "ListItem", "position": 4, "url": "https://www.cyrilvoyant.com/fr/recits/thyroid-radioiodine/", "name": "Cancer de la thyroïde et iode radioactif : le modèle d'abord"}, {"@type": "ListItem", "position": 5, "url": "https://www.cyrilvoyant.com/fr/actualites/forecasting-with-less/", "name": "Une meilleure persistance, sans entraîner un réseau neuronal"}, {"@type": "ListItem", "position": 6, "url": "https://www.cyrilvoyant.com/fr/actualites/why-extreme-learning-machines/", "name": "Sept sorties, six ans de données : ce que montre MIMO-ELM"}, {"@type": "ListItem", "position": 7, "url": "https://www.cyrilvoyant.com/fr/recits/satellite-irradiance/", "name": "Prévision satellite : une maille ou tout le champ ?"}, {"@type": "ListItem", "position": 8, "url": "https://www.cyrilvoyant.com/prevision-solaire-modeles-frugaux/", "name": "Prévision solaire : modèles frugaux"}, {"@type": "ListItem", "position": 9, "url": "https://www.cyrilvoyant.com/prevision-pv-reduction-dimension/", "name": "Prévision PV : réduire la dimension"}, {"@type": "ListItem", "position": 10, "url": "https://www.cyrilvoyant.com/fr/recits/websemantic/", "name": "Au modèle de langage la lecture, au code validé le calcul"}, {"@type": "ListItem", "position": 11, "url": "https://www.cyrilvoyant.com/fr/recits/questioning-research/", "name": "Se questionner sur nos façons de faire de la recherche"}, {"@type": "ListItem", "position": 12, "url": "https://www.cyrilvoyant.com/fr/ia-dans-la-recherche/", "name": "L'IA dans la recherche : AI Act, charte et boîte à outils"}, {"@type": "ListItem", "position": 13, "url": "https://www.cyrilvoyant.com/fr/actualites/nice-forecast-evaluation/", "name": "Même nRMSE, modèles différents : ce que révèle NICE"}, {"@type": "ListItem", "position": 14, "url": "https://www.cyrilvoyant.com/fr/actualites/gamma-index-forecast-validation/", "name": "Une prévision décalée peut rester exploitable : le test gamma"}, {"@type": "ListItem", "position": 15, "url": "https://www.cyrilvoyant.com/latest-publications-and-news/academic-visibility-why-publishing-isn-t-enough-anymore/", "name": "Visibilité académique : publier ne suffit plus (en anglais)"}, {"@type": "ListItem", "position": 16, "url": "https://www.cyrilvoyant.com/fr/actualites/excellence-scientifique-a-l-ere-de-l-ia-du-seo-au-geo/", "name": "Excellence scientifique à l'ère de l'IA : du SEO au GEO"}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/fr/outils/artu#page", "url": "https://www.cyrilvoyant.com/fr/outils/artu/", "n