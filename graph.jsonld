3453"}]}], "isBasedOn": "https://cyrilvoyant.github.io/methods/solar-variability-scv.html#try-it", "learningResourceType": "Calculateur scientifique interactif"}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/fr/prevision-complexe/#page", "url": "https://www.cyrilvoyant.com/fr/prevision-complexe/", "name": "Prévoir l'éclairement et son incertitude avec des nombres complexes", "description": "Une autorégression complexe à six coefficients prévoit à la fois l'éclairement solaire et sa volatilité ; réglez α et voyez la largeur des intervalles. Article de 2022, Journal of Renewable and Sustainable Energy.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "translationOfWork": {"@id": "https://www.cyrilvoyant.com/complex-valued-forecasting/#page"}, "about": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#nrmse", "name": "nRMSE", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/recits/variabilite-memoire-previsibilite/"}], "mentions": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#prediction-interval", "name": "Intervalle de prévision", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/animations/intervalles-regression/"}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Prévision complexe", "item": "https://www.cyrilvoyant.com/fr/prevision-complexe/"}]}, {"@type": "ScholarlyArti