rilvoyant.github.io/approach.html#principle-2"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#bed", "name": "Biologically effective dose (BED)", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/stories/lql-equiv/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#eqd2", "name": "Equivalent dose in 2 Gy fractions (EQD2)", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/stories/lql-equiv/"}], "keywords": ["Compute directly", "Medicine"], "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/recits/calculateur-bed-eqd2-lq-lql/#page"}, "mentions": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#gray", "name": "Gray (Gy)", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/stories/lql-equiv/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#alpha-beta", "name": "α/β ratio", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/stories/lql-equiv/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#lql-equiv", "name": "LQL-Equiv", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/stories/lql-equiv/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#lq-model", "name": "Linear-quadratic model (LQ)", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/stories/lql-equiv/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#lql-model", "name": "Linear-quadratic-linear model (LQL)", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/stories/lql-equiv/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#transition-dose", "name": "Transition dose dT", "inDefinedTermSet": "http