Item", "position": 2, "name": "Prévision complexe", "item": "https://www.cyrilvoyant.com/fr/prevision-complexe/"}]}, {"@type": "ScholarlyArticle", "@id": "https://doi.org/10.1063/5.0128131", "name": "Complex-valued time series based solar irradiance forecast", "datePublished": "2022-11", "isPartOf": {"@type": "Periodical", "name": "Journal of Renewable and Sustainable Energy"}, "author": [{"@type": "Person", "name": "Cyril Voyant", "@id": "https://person.cyrilvoyant.com/#cyril-voyant"}, {"@type": "Person", "name": "Philippe Lauret", "sameAs": "https://orcid.org/0000-0003-2959-6146"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "name": "Jean-Laurent Duchaud", "sameAs": "https://orcid.org/0000-0001-7490-7260"}, {"@type": "Person", "name": "Luis Garcia-Gutierrez", "sameAs": "https://orcid.org/0000-0002-3480-1784"}, {"@type": "Person", "name": "Ghjuvan Antone Faggianelli", "sameAs": "https://orcid.org/0000-0002-9954-5910"}]}, {"@type": "CollectionPage", "@id": "https://www.cyrilvoyant.com/fr/recits#page", "url": "https://www.cyrilvoyant.com/fr/recits/", "name": "Recherche : questions, résultats et méthodes", "description": "Chaque récit suit le même plan : le constat, la question, la théorie en clair, la place sur l'échelle de la complexité, un exemple chiffré, les apports et les limites. Le détail technique et le code sont sur le site des méthodes.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-2"}], "translationOfWork": {"@id": "h