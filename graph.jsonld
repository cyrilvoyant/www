lvoyant.com/fr/recits/websemantic/", "name": "Au modèle de langage la lecture, au code validé le calcul"}, {"@type": "ListItem", "position": 11, "url": "https://www.cyrilvoyant.com/fr/recits/questioning-research/", "name": "Se questionner sur nos façons de faire de la recherche"}, {"@type": "ListItem", "position": 12, "url": "https://www.cyrilvoyant.com/fr/ia-dans-la-recherche/", "name": "L'IA dans la recherche : AI Act, charte et boîte à outils"}, {"@type": "ListItem", "position": 13, "url": "https://www.cyrilvoyant.com/fr/actualites/nice-forecast-evaluation/", "name": "Même nRMSE, modèles différents : ce que révèle NICE"}, {"@type": "ListItem", "position": 14, "url": "https://www.cyrilvoyant.com/fr/actualites/gamma-index-forecast-validation/", "name": "Une prévision décalée peut rester exploitable : le test gamma"}, {"@type": "ListItem", "position": 15, "url": "https://www.cyrilvoyant.com/latest-publications-and-news/academic-visibility-why-publishing-isn-t-enough-anymore/", "name": "Visibilité académique : publier ne suffit plus (en anglais)"}, {"@type": "ListItem", "position": 16, "url": "https://www.cyrilvoyant.com/fr/actualites/excellence-scientifique-a-l-ere-de-l-ia-du-seo-au-geo/", "name": "Excellence scientifique à l'ère de l'IA : du SEO au GEO"}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/fr/recits/lql-equiv#page", "url": "https://www.cyrilvoyant.com/fr/recits/lql-equiv/", "name": "Calculer plutôt qu'apprendre : l'équivalence de dose en radiothérapie avec LQL-Equiv", "description": "Quand le lien entre un schéma de radiothérapie et son effet biologique est connu, on le calcule directement. Ni données ni intelligence artificielle : un modèle que l'on comprend, vérifié cas par cas.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-2"}], "keywords": ["Calculer directement", "Médecine"], "translationOfWork": {"@id": "https://www.cyrilvoyant.com/stories/lql-equiv#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Récits", "item": "https://www.cyrilvoyant.com/fr/recits/"}, {"@type": "ListItem", "position": 3, "name": "Calculer plutôt qu'apprendre : l'équivalence de dose en radiothérapie avec LQL-Equiv", "item": "https://www.cyrilvoyant.com/fr/recits/lql-equiv/"}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/fr/recits/questioning-research#page", "url": "https://www.cyrilvoyant.com/fr/recits/questioning-research/", "name": "Se questionner sur nos façons de faire de la recherche : influence, intégrité, excellence", "description": "Dans un monde en pleine mutation, la recherche doit aussi examiner ses propres méthodes. La même démarche s'applique : comparer à une référence explicite, regarder ce qu'un nombre unique cache, et énoncer les limites.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-5"}], "keywords": ["Démontrer la confiance", "Pratique de la recherche"], "translationOfWork": {"@id": "https://www.cyrilvoyant.com/stories/questioning-research#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Récits", "item": "https://www.cyrilvoyant.com/fr/recits/"}, {"@type": "ListItem", "position": 3, "name": "Se questionner sur nos façons de faire de la recherche : influence, intégrité, excellence", "item": "https://www.cyrilvoyant.com/fr/recits/questioning-research/"}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/fr/recits/satellite-irradiance#page", "url": "https://www.cyrilvoyant.com/fr/recits/satellite-irradiance/", "name": "Prévision satellite du rayonnement : une maille, un voisinage ou tout le champ", "description": "Un satellite voit le rayonnement de toute une région, heure par heure. La tentation est de donner toute la carte au modèle de prévision. Garder le même modèle et ne changer que ce qu'il lit montre ce que la carte apporte vraiment.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-3"}], "keywords": ["Apprendre frugalement", "Énergie"], "translationOfWork": {"@id": "https://www.cyrilvoyant.com/stories/satellite-irradiance#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Récits", "item": "https://www.cyrilvoyant.com/fr/recits/"}, {"@type": "ListItem", "position": 3, "name": "Prévision satellite du rayonnement : une maille, un voisinage ou tout le champ", "item": "https://www.cyrilvoyant.com/fr/recits/satellite-irradiance/"}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/fr/recits/thyroid-radioiodine#page", "url": "https://www.cyrilvoyant.com/fr/recits/thyroid-radioiodine/", "name": "Cancer de la thyroïde et iode radioactif : le modèle d'abord, n'apprendre que ce qui manque", "description": "Combien de séances d'iode radioactif, à quel intervalle, avec quelle activité ? Un modèle intelligible de trois équations explore ces questions avant de traiter un patient. L'apprentissage ne sera ajouté que là où le modèle ne suffit pas.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-2"}], "keywords": ["Hybrider", "Médecine"], "translationOfWork": {"@id": "https://www.cyrilvoyant.com/stories/thyroid-radioiodine#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Récits", "item": "https://www.cyrilvoyant.com/fr/recits/"}, {"@type": "ListItem", "position": 3, "name": "Cancer de la thyroïde et iode radioactif : le modèle d'abord, n'apprendre que ce qui manque", "item": "https://www.cyrilvoyant.com/fr/recits/thyroid-radioiodine/"}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/fr/recits/tunnel-load-simulator#page", "url": "https://www.cyrilvoyant.com/fr/recits/tunnel-load-simulator/", "name": "Simuler ce que l'on ne peut pas encore mesurer : la consommation électrique des tunnels routiers", "description": "L'exploitant d'un tunnel dispose rarement de mesures détaillées de sa consommation, surtout au stade de la conception. Le Tunnel Load Simulator construit la demande à partir de ce que l'on sait du tunnel, dit à quel point elle est incertaine et en énonce les limites.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-2"}], "keywords": ["Calculer directement", "Énergie"], "translationOfWork": {"@id": "https://www.cyrilvoyant.com/stories/tunnel-load-simulator#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Récits", "item": "https://www.cyrilvoyant.com/fr/recits/"}, {"@type": "ListItem", "position": 3, "name": "Simuler ce que l'on ne peut pas encore mesurer : la consommation électrique des tunnels routiers", "item": "https://www.cyrilvoyant.com/fr/recits/tunnel-load-simulator/"}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/fr/recits/websemantic#page", "url": "https://www.cyrilvoyant.com/fr/recits/websemantic/", "name": "Au modèle de langage la lecture, au code validé le calcul : WebSemantic", "description": "Les modèles de langage comprennent bien une demande écrite en mots simples. Ils ne remplacent pas un code scientifique validé. WebSemantic donne à chacun son rôle, et interroge la personne dès qu'il manque quelque chose.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-4"}], "keywords": ["L'IA à sa place", "Langage"], "translationOfWork": {"@id": "https://www.cyrilvoyant.com/stories/websemantic#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Récits", "item": "https://www.cyrilvoyant.com/fr/recits/"}, {"@type": "ListItem", "position": 3, "name": "Au modèle de langage la lecture, au code validé le calcul : WebSemantic", "item": "https://www.cyrilvoyant.com/fr/recits/websemantic/"}]}, {"@type": "CollectionPage", "@id": "https://www.cyrilvoyant.com/fr/vue-d-ensemble#page", "url": "https://www.cyrilvoyant.com/fr/vue-d-ensemble/", "name": "Cyril Voyant, vue d'ensemble : recherche, logiciels, cours et outils en accès libre", "description": "Tout ce qui est public, au même endroit : idées directrices, axes de recherche, 15 logiciels avec DOI et équipes, cinq cours sous CC BY 4.0, outils interactifs, essais. À réutiliser librement en citant.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "translationOfWork": {"@id": "https://www.cyrilvoyant.com/overview#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Vue d'ensemble", "item": "https://www.cyrilvoyant.com/fr/vue-d-ensemble/"}]}, {"@type": "ItemList", "name": "Les logiciels, avec leur DOI et leur équipe", "itemListElement": [{"@type": "ListItem", "position": 1, "item": {"@type": "SoftwareSourceCode", "name": "NICEᵏ: normalized forecast errors compared with simple persistence (MATLAB)", "identifier": "https://doi.org/10.5281/zenodo.23562549", "codeRepository": "https://github.com/cyrilvoyant/nice-metrics", "license": "MIT"}}, {"@type": "ListItem", "position": 2, "item": {"@type": "SoftwareSourceCode", "name": "sCV and F: variability and forecastability of solar irradiance (MATLAB)", "identifier": "https://doi.org/10.5281/zenodo.23562553", "codeRepository": "https://github.com/cyrilvoyant/solar-variability-scv", "license": "MIT"}}, {"@type": "ListItem", "position": 3, "item": {"@type": "SoftwareSourceCode", "name": "The γ-index: tolerance-based validation of spatio-temporal forecast fields (MATLAB)", "identifier": "https://doi.org/10.5281/zenodo.21755936", "codeRepository": "https://github.com/cyrilvoyant/temporal-gamma-index", "license": "MIT"}}, {"@type": "ListItem", "position": 4, "item": {"@type": "SoftwareSourceCode", "name": "ARTU: second-order autoregressive reference method for solar radiation forecasting", "identifier": "https://doi.org/10.5281/zenodo.21755931", "codeRepository": "https://github.com/cyrilvoyant/ARTU", "license": "MIT"}}, {"@type": "ListItem", "position": 5, "item": {"@type": "SoftwareSourceCode", "name": "BLEND and CLIPER: persistence operators for cyclostationary energy processes (MATLAB)", "identifier": "https://doi.org/10.5281/zenodo.18812333", "codeRepository": "https://github.com/cyrilvoyant/cyclostationary-forecasting-matlab", "license": "MIT"}}, {"@type": "ListItem", "position": 6, "item": {"@type": "SoftwareSourceCode", "name": "Per-cell, spatial and compressed forecasters of satellite solar irradiance: benchmark code (MATLAB, Python)", "identifier": "https://doi.org/10.5281/zenodo.23562557", "codeRepository": "https://github.com/cyrilvoyant/cell-vs-field-irradiance", "license": "MIT"}}, {"@type": "ListItem", "position": 7, "item": {"@type": "SoftwareSourceCode", "name": "MIMO-ELM forecasting of the Corsican electricity mix (MATLAB, Python, EDF open data)", "identifier": "https://doi.org/10.5281/zenodo.23562559", "codeRepository": "https://github.com/cyrilvoyant/Data_Viz_2024", "license": "GPL-3.0"}}, {"@type": "ListItem", "position": 8, "item": {"@type": "SoftwareSourceCode", "name": "PV_ELM_pred: benchmark of persistence, BLEND, autoregression and ELM variants for PV forecasting (Python)", "identifier": "https://doi.org/10.5281/zenodo.21487267", "codeRepository": "https://github.com/cyrilvoyant/PV_ELM_pred", "license": "MIT"}}, {"@type": "ListItem", "position": 9, "item": {"@type": "SoftwareSourceCode", "name": "Make_Stationary: deseasonalization benchmark for renewable-energy time series (MATLAB)", "identifier": "https://doi.org/10.5281/zenodo.21490743", "codeRepository": "https://github.com/cyrilvoyant/Make_Stationary", "license": "GPL-3.0"}}, {"@type": "ListItem", "position": 10, "item": {"@type": "SoftwareSourceCode", "name": "Filter and wrapper diagnostics of dimensionality reduction for endogenous PV power forecasting (MATLAB)", "identifier": "https://doi.org/10.5281/zenodo.21755938", "codeRepository": "https://github.com/cyrilvoyant/pv-dimensionality-reduction", "license": "MIT"}}, {"@type": "ListItem", "position": 11, "item": {"@type": "SoftwareSourceCode", "name": "RAIR-Sim: compartmental simulator of radioactive iodine therapy response in metastatic thyroid cancer (MATLAB)", "identifier": "https://doi.org/10.5281/zenodo.21496197", "codeRepository": "https://github.com/cyrilvoyant/CTD_SIMU_RAI", "license": "MIT"}}, {"@type": "ListItem", "position": 12, "item": {"@type": "SoftwareSourceCode", "name": "Influence Index: a log-based measure of research influence for institutions (MATLAB, processed data)", "identifier": "https://doi.org/10.5281/zenodo.19706465", "codeRepository": "https://github.com/cyrilvoyant/influence-index-bibliometrics", "license": "MIT"}}, {"@type": "ListItem", "position": 13, "item": {"@type": "SoftwareSourceCode", "name": "LQL-Equiv 2014: biologically equivalent dose calculation in radiotherapy (MATLAB application)", "identifier": "https://doi.org/10.5281/zenodo.16739882", "codeRepository": "https://github.com/cyrilvoyant/LQ-Equiv", "license": "MIT"}}, {"@type": "ListItem", "position": 14, "item": {"@type": "SoftwareSourceCode", "name": "Tunnel Load Simulator: synthetic electricity demand of road tunnels (Python, Streamlit)", "identifier": "https://doi.org/10.5281/zenodo.20080042", "codeRepository": "https://github.com/cyrilvoyant/tunnel-load-simulator", "license": "MIT"}}, {"@type": "ListItem", "position": 15, "item": {"@type": "SoftwareSourceCode", "name": "LQL-Equiv-web 3.0: biologically equivalent doses in radiotherapy (Python, browser)", "identifier": "https://doi.org/10.5281/zenodo.21948623", "codeRepository": "https://github.com/cyrilvoyant/LQL-Equiv-web", "license": "MIT"}}]}, {"@type": "WebPage", "@id": "https://www.cyrilvoyant.com/#page", "url": "https://www.cyrilvoyant.com/", "name": "Understand before you compute", "description": "Cyril Voyant, physicist and Research Director at Mines Paris – PSL: compute directly when the link is known, hybridise when the model falls short, climb the complexity ladder only if it pays.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-2"}], "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}]}, {"@type": "WebSite", "@id": "https://www.cyrilvoyant.com/#website", "url": "https://www.cyrilvoyant.com/", "name": "Cyril Voyant", "inLanguage": ["en", "fr"], "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "jobTitle": "Research Director", "affiliation": {"@type": "Organization", "name": "Mines Paris – PSL, Centre O.I.E."}, "sameAs": ["https://orcid.org/0000-0003-0242-7377", "https://www.wikidata.org/wiki/Q58251573", "https://scholar.google.com/citations?user=aUlP6agAAAAJ", "https://person.cyrilvoyant.com/", "https://cyrilvoyant.github.io/"], "knowsAbout": ["Concentric modeling", "Hybrid modeling", "Solar forecasting", "Forecast evaluation", "Frugal artificial intelligence", "Radiobiology", "Medical physics", "Language models as interfaces to scientific codes"]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/forecasting-with-less#page", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/forecasting-with-less/", "name": "BLEND: a better persistence forecast without training a neural network", "description": "Accounting for daily phase improves persistence forecasts on the solar series studied, with differences widening at longer lead times. In our Applied Mathematical Modelling paper, BLEND supplies this baseline directly from raw irradiance, without normalising observations by an external clear-sky…", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-2"}], "keywords": ["Hybridize", "Energy"], "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/actualites/forecasting-with-less#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Stories", "item": "https://www.cyrilvoyant.com/stories/"}, {"@type": "ListItem", "position": 3, "name": "BLEND: a better persistence forecast without training a neural network", "item": "https://www.cyrilvoyant.com/latest-publications-and-news/forecasting-with-less/"}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/gamma-index-forecast-validation#page", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/gamma-index-forecast-validation/", "name": "The γ-index: validating displaced solar forecasts beyond pointwise errors", "description": "In the gamma-index paper’s synthetic experiment, more than 80% of pixels remain acceptable despite an approximately two-kilometre spatial displacement, a ten-minute time shift and added noise. Pixelwise RMSE nevertheless suggests substantial error.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-5"}], "keywords": ["Demonstrate trust", "Energy"], "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/actualites/gamma-index-forecast-validation#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Stories", "item": "https://www.cyrilvoyant.com/stories/"}, {"@type": "ListItem", "position": 3, "name": "The γ-index: validating displaced solar forecasts beyond pointwise errors", "item": "https://www.cyrilvoyant.com/latest-publications-and-news/gamma-index-forecast-validation/"}]}, {"@type": "CollectionPage", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news#page", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/", "name": "News: publications, software and essays", "description": "All research news of Cyril Voyant on one page: papers with their co-authors, software releases, appointments and essays, filterable by theme and year.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/actualites#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "News", "item": "https://www.cyrilvoyant.com/latest-publications-and-news/"}]}, {"@type": "ItemList", "name": "News", "numberOfItems": 24, "itemListElement": [{"@type": "ListItem", "position": 1, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#scientific-publishing-trust", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#scientific-publishing-trust", "headline": "Scientific publishing: no verification of data and code, no trust", "inLanguage": "en", "abstract": "Indexed articles grew by about 47% between 2016 and 2022, peer review relies on unpaid work and 2023 set a record of retractions. A short essay on what exists, from FAIR data to the AI Act, and what is missing: checking the data and code behind what is published.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2026-10-24"}}, {"@type": "ListItem", "position": 2, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#electre-carnot-mines-electrification", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#electre-carnot-mines-electrification", "headline": "ELECTRE, flagship project of the Carnot M.I.N.E.S institute: electrifying uses, closing workshop on 18 November 2026", "inLanguage": "en", "abstract": "ELECTRE brings together about fifteen laboratories, centres and institutes of the Carnot M.I.N.E.S institute around 13 research projects (2023–2026) on the electrification of uses, from materials to storage, industrial processes and the limits of electrification. Its closing workshop is on 18 November 2026, Mines Paris – PSL, Sophia Antipolis.", "author": [{"@type": "Person", "name": "Delphine Gilges-Crampont"}, {"@type": "Person", "name": "Annette Massias"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2026-10-23", "image": "https://www.cyrilvoyant.com/assets/news/electre.png"}}, {"@type": "ListItem", "position": 3, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#visiting-professor-at-the-university-of-kragujevac-serbia", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#visiting-professor-at-the-university-of-kragujevac-serbia", "headline": "Visiting Professor at the University of Kragujevac, Serbia", "inLanguage": "en", "abstract": "I am honoured to have been appointed Visiting Professor at the Faculty of Engineering, University of Kragujevac, together with my colleague and friend Prof. Gilles Notton.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}], "datePublished": "2026", "image": "https://www.cyrilvoyant.com/assets/img/e127601c2891.png"}}, {"@type": "ListItem", "position": 4, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#tunnel-load-simulator-an-open-source-generator-for-synthetic-road-tunnel", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#tunnel-load-simulator-an-open-source-generator-for-synthetic-road-tunnel", "headline": "Tunnel Load Simulator: an open-source generator for synthetic road-tunnel electricity demand", "inLanguage": "en", "abstract": "The Tunnel Load Simulator is an open-source Streamlit application developed within the SmartTunnel project to generate synthetic electrical load profiles for road tunnels. It combines simplified representations of lighting, ventilation, auxiliary loads, traffic patterns, seasonal effects and stochastic events such as pollution episodes or accidents.", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "datePublished": "2026-05-08", "image": "https://www.cyrilvoyant.com/assets/img/e326492cab74.jpg"}}, {"@type": "ListItem", "position": 5, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#when-sunlight-stops-being-direct", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#when-sunlight-stops-being-direct", "headline": "When Sunlight Stops Being Direct", "inLanguage": "en", "abstract": "Diffuse solar radiation remains one of the most complex components of the solar resource, particularly in regions affected by aerosols, humidity, and strong climatic contrasts.", "author": [{"@type": "Person", "name": "Haifa Harrouch"}, {"@type": "Person", "name": "Nadjem Bailek", "sameAs": "https://orcid.org/0000-0001-9051-8548"}, {"@type": "Person", "name": "Bilel Zerouali"}, {"@type": "Person", "name": "Ilyes Abidi"}, {"@type": "Person", "name": "Hanene Guesmi"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Jihad A. Younis"}, {"@type": "Person", "name": "Maher Jebali & Rabab Triki"}], "datePublished": "2026-04-28", "image": "https://www.cyrilvoyant.com/assets/img/500e36c2208c.png"}}, {"@type": "ListItem", "position": 6, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#revisiting-persistence-symmetry-constrained-forecasting-of-periodically", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#revisiting-persistence-symmetry-constrained-forecasting-of-periodically", "headline": "Revisiting Persistence: Symmetry-Constrained Forecasting of Periodically Correlated Energy Processes", "inLanguage": "en", "abstract": "This work revisits persistence forecasting for periodically varying statistics, including the daily cycle of solar irradiance. BLEND combines the latest observation with an observation aligned to the target phase of the cycle.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Candice Banes", "sameAs": "https://orcid.org/0009-0003-6656-8168"}, {"@type": "Person", "name": "Luis Garcia-Gutierrez", "sameAs": "https://orcid.org/0000-0002-3480-1784"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "name": "Milan Despotovic", "sameAs": "https://orcid.org/0000-0003-3144-5945"}, {"@type": "Person", "name": "Zaher Mundher Yaseen", "sameAs": "https://orcid.org/0000-0003-3344-214X"}], "datePublished": "2026-04-24", "image": "https://www.cyrilvoyant.com/assets/img/e8e0bf76adbb.jpg"}}, {"@type": "ListItem", "position": 7, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#from-pixels-to-tolerances-rethinking-forecast-validation-with-the-index", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#from-pixels-to-tolerances-rethinking-forecast-validation-with-the-index", "headline": "From Pixels to Tolerances: Rethinking Forecast Validation with the γ-Index", "inLanguage": "en", "abstract": "Classical metrics like RMSE evaluate forecasts as if every pixel must match perfectly in space and time. Machines optimize for that. Humans do not think that way.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2026-03-28", "image": "https://www.cyrilvoyant.com/assets/img/7f20ac04a02f.png"}}, {"@type": "ListItem", "position": 8, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#excellence-scientifique-a-l-ere-de-l-ia-du-seo-au-geo", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#excellence-scientifique-a-l-ere-de-l-ia-du-seo-au-geo", "headline": "Excellence scientifique à l’ère de l’IA : du SEO au GEO", "inLanguage": "fr", "abstract": "La production scientifique mondiale connaît une croissance sans précédent, amplifiée par l’essor des modèles d’intelligence artificielle générative. Dans ce contexte, la question n’est plus seulement de produire du savoir, mais d’en garantir la visibilité, la robustesse et la réutilisabilité.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2026", "image": "https://www.cyrilvoyant.com/assets/img/0983e8b6d15c.jpg"}}, {"@type": "ListItem", "position": 9, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#coherent-multi-energy-forecasting-for-real-time-grid-management-a-parsimonious", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#coherent-multi-energy-forecasting-for-real-time-grid-management-a-parsimonious", "headline": "Coherent Multi-Energy Forecasting for Real-Time Grid Management: A Parsimonious MIMO-ELM Approach", "inLanguage": "en", "abstract": "Fast, transparent, and operational short-term forecasting of demand and generation across multiple energy sources.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Milan Despotovic", "sameAs": "https://orcid.org/0000-0003-3144-5945"}, {"@type": "Person", "name": "Luis Garcia-Gutierrez", "sameAs": "https://orcid.org/0000-0002-3480-1784"}, {"@type": "Person", "name": "Mohammed Asloune", "sameAs": "https://orcid.org/0009-0004-0183-2156"}, {"@type": "Person", "name": "Yves-Marie Saint-Drenan", "sameAs": "https://orcid.org/0000-0003-1471-1092"}, {"@type": "Person", "name": "Jean-Laurent Duchaud", "sameAs": "https://orcid.org/0000-0001-7490-7260"}, {"@type": "Person", "name": "Ghjuvan Antone Faggianelli", "sameAs": "https://orcid.org/0000-0002-9954-5910"}, {"@type": "Person", "name": "Elena Magliaro"}], "datePublished": "2026-02-26", "image": "https://www.cyrilvoyant.com/assets/img/8a4ca1238d62.png"}}, {"@type": "ListItem", "position": 10, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#invisible-research-has-no-impact-engineering-scientific-influence-in-the-ai-era", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#invisible-research-has-no-impact-engineering-scientific-influence-in-the-ai-era", "headline": "Invisible Research Has No Impact: Engineering Scientific Influence in the AI Era", "inLanguage": "en", "abstract": "The research landscape has shifted from scarcity to saturation: producing knowledge is no longer the bottleneck: being discovered, trusted, and reused is.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2026", "image": "https://www.cyrilvoyant.com/assets/img/4c8ef733ef53.jpg"}}, {"@type": "ListItem", "position": 11, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#appointed-associate-editor-for-scientific-reports-nature-portfolio", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#appointed-associate-editor-for-scientific-reports-nature-portfolio", "headline": "Appointed Associate Editor for Scientific Reports (Nature Portfolio)", "inLanguage": "en", "abstract": "This role aligns with my trajectory as Research Director at Mines Paris–PSL O.I.E. (since 2024), with >130 peer-reviewed publications (h-index ~35, >7000 citations, Stanford Top 2%). Scientific Reports covers all scientific domains.", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "datePublished": "2026", "image": "https://www.cyrilvoyant.com/assets/img/fd09837e8068.jpg"}}, {"@type": "ListItem", "position": 12, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#quality-control-framework-for-tilted-solar-irradiance", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#quality-control-framework-for-tilted-solar-irradiance", "headline": "Quality Control Framework for Tilted Solar Irradiance", "inLanguage": "en", "abstract": "This work is part of the doctoral research of Mohammed Asloun (University of Corsica & Mines-PSL).", "author": [{"@type": "Person", "name": "Mohammed Asloune", "sameAs": "https://orcid.org/0009-0004-0183-2156"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2025-12-20", "image": "https://www.cyrilvoyant.com/assets/img/597be8654483.jpg"}}, {"@type": "ListItem", "position": 13, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#towards-personalized-radio-iodine-therapy-modeling-dynamics-and-clinical", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#towards-personalized-radio-iodine-therapy-modeling-dynamics-and-clinical", "headline": "Towards Personalized Radio-Iodine Therapy: Modeling, Dynamics, and Clinical Perspectives", "inLanguage": "en", "abstract": "A doctoral contribution by Marie Fusella Giuntini, in collaboration with Aix-Marseille, Corsica Universities, Mines-PSL, and la Timone Hospital : Marie Fusella Giuntini, Cyril Voyant, David Taieb and Dominique Barbolosi.", "author": [{"@type": "Person", "name": "Marie Fusella Giuntini"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "David Taieb"}, {"@type": "Person", "name": "Dominique Barbolosi"}], "datePublished": "2025", "image": "https://www.cyrilvoyant.com/assets/img/81ce5b8cbd78.png"}}, {"@type": "ListItem", "position": 14, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#grateful-to-be-included-in-the-2025-stanford-elsevier-top-2-scientists-ranking", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#grateful-to-be-included-in-the-2025-stanford-elsevier-top-2-scientists-ranking", "headline": "Grateful to be included in the 2025 Stanford-Elsevier Top 2% Scientists ranking.", "inLanguage": "en", "abstract": "Proud to contribute to research in solar forecasting, PV systems, AI for energy, and medical physics at Mines Paris – PSL.", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "datePublished": "2025", "image": "https://www.cyrilvoyant.com/assets/img/c8454c0e0d6c.png"}}, {"@type": "ListItem", "position": 15, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#transfer-learning-for-wind-speed-forecasting-a-scalable-approach-for-data", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#transfer-learning-for-wind-speed-forecasting-a-scalable-approach-for-data", "headline": "Transfer Learning for Wind Speed Forecasting: A Scalable Approach for Data-Scarce Environments", "inLanguage": "en", "abstract": "This paper demonstrates that transfer learning can accurately forecast wind speed in data-scarce regions by reusing models trained on data-rich sites. Across 4,830 experiments, TL achieved accuracy comparable to direct learning (ΔnRMSE < 0.01). The approach offers a scalable, low-data solution for expanding wind forecasting to under-instrumented areas.", "author": [{"@type": "Person", "name": "Milan Despotović", "sameAs": "https://orcid.org/0000-0003-3144-5945"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2025-10-13", "image": "https://www.cyrilvoyant.com/assets/img/435a8e9d3433.png"}}, {"@type": "ListItem", "position": 16, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#from-trends-to-insights-a-text-mining-analysis-of-solar-energy-forecasting-2017", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#from-trends-to-insights-a-text-mining-analysis-of-solar-energy-forecasting-2017", "headline": "From Trends to Insights: A Text Mining Analysis of Solar Energy Forecasting (2017–2023)", "inLanguage": "en", "abstract": "The study applies text mining to 500 papers (2017–2023) to map global trends in solar energy forecasting. It reveals a strong rise of AI and deep learning, led by China, the USA, and India, and shows that deterministic metrics still dominate probabilistic ones. The work delivers a reproducible overview and standardized terminology, advancing transparency and collaboration in solar forecasting research .", "author": [{"@type": "Person", "name": "Mohammed Asloune", "sameAs": "https://orcid.org/0009-0004-0183-2156"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2025-10-01", "image": "https://www.cyrilvoyant.com/assets/img/b0d486d8a45b.png"}}, {"@type": "ListItem", "position": 17, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#a-simple-method-for-quickly-estimating-solar-irradiance-forecast-errors", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#a-simple-method-for-quickly-estimating-solar-irradiance-forecast-errors", "headline": "A Simple Method for Quickly Estimating Solar Irradiance Forecast Errors", "inLanguage": "en", "abstract": "Researchers have developed linear models that predict solar irradiance forecast errors using only solar variability at a specific location. This variability is measured by the standard deviation of hourly changes in the clear sky index, essentially capturing how much solar conditions fluctuate hour to hour.", "author": [{"@type": "Person", "name": "Philippe Lauret", "sameAs": "https://orcid.org/0000-0003-2959-6146"}, {"@type": "Person", "name": "Mathieu David"}, {"@type": "Person", "name": "Josselin Le Gal La Salle"}, {"@type": "Person", "name": "Elke Lorenz"}, {"@type": "Person", "name": "Richard Perez"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2025-08-22", "image": "https://www.cyrilvoyant.com/assets/img/85e5d66681cc.png"}}, {"@type": "ListItem", "position": 18, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#new-release-lql-equiv-open-source-software-for-biologically-equivalent-dose", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#new-release-lql-equiv-open-source-software-for-biologically-equivalent-dose", "headline": "New Release: LQL-Equiv: Open‑Source Software for Biologically Equivalent Dose Calculation in Radiotherapy", "inLanguage": "en", "abstract": "LQL‑Equiv is a free & open‑source software (GNU‑based) written in MATLAB and distributed as a standalone executable, developed by Cyril Voyant & Daniel Julian. It computes voxel‑wise Equivalent Dose in 2 Gy fractions (EQD₂) and Biologically Effective Dose (BED) using a Linear‑Quadratic‑Linear (LQL) model that explicitly accounts for fraction size, overall treatment time, and cellular repopulation effects, outperforming standard LQ-based calculators.", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "datePublished": "2025-08-04", "image": "https://www.cyrilvoyant.com/assets/img/82d8378219df.png"}}, {"@type": "ListItem", "position": 19, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#improving-clinical-decision-making-in-radiotherapy-a-comparative-analysis-of", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#improving-clinical-decision-making-in-radiotherapy-a-comparative-analysis-of", "headline": "Improving Clinical Decision-Making in Radiotherapy: A Comparative Analysis of Linear-Quadratic LQ and Linear-Quadratic-Linear LQL Dose Models", "inLanguage": "en", "abstract": "This collaborative paper compares the linear-quadratic (LQ) and linear-quadratic-linear (LQL) dose models in radiotherapy. Read the published article for the methods, results and clinical limitations.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "D. Julian"}, {"@type": "Person", "name": "S. Muraro"}, {"@type": "Person", "name": "V. Bodez"}, {"@type": "Person", "name": "M. Pinpin"}, {"@type": "Person", "name": "D. Leschi"}, {"@type": "Person", "name": "R. Oozeer"}, {"@type": "Person", "name": "G. Wided"}, {"@type": "Person", "name": "M.-A. Acquaviva"}, {"@type": "Person", "name": "S. Prapant"}, {"@type": "Person", "name": "O. Gahbiche"}, {"@type": "Person", "name": "N. Bouaouina"}], "datePublished": "2025-06-24", "image": "https://www.cyrilvoyant.com/assets/img/a65616587f74.jpg"}}, {"@type": "ListItem", "position": 20, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#stochastic-coefficient-of-variation-assessing-the-variability-and", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#stochastic-coefficient-of-variation-assessing-the-variability-and", "headline": "Stochastic Coefficient of Variation: Assessing the Variability and Forecastability of Solar Irradiance", "inLanguage": "en", "abstract": "This work presents a robust framework for quantifying solar irradiance variability and forecastability through the Stochastic Coefficient of Variation (sCV) and the Forecastability (F). Traditional metrics, such as the standard deviation, fail to isolate stochastic fluctuations from deterministic trends in solar irradiance. By considering clear-sky irradiance as a dynamic upper bound of measurement, sCV provides a normalized, dimensionless measure of variability that theoretically ranges from 0 ", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Alan Julien", "sameAs": "https://orcid.org/0009-0003-0247-0663"}, {"@type": "Person", "name": "Milan Despotovic", "sameAs": "https://orcid.org/0000-0003-3144-5945"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "name": "Luis Antonio Garcia-Gutierrez", "sameAs": "https://orcid.org/0000-0002-3480-1784"}, {"@type": "Person", "name": "Claudio Francesco Nicolosi", "sameAs": "https://orcid.org/0009-0001-2962-6643"}, {"@type": "Person", "name": "Philippe Blanc", "sameAs": "https://orcid.org/0000-0002-6345-0004"}, {"@type": "Person", "name": "Jamie Bright", "sameAs": "https://orcid.org/0000-0002-9465-3453"}], "datePublished": "2025-07-17", "image": "https://www.cyrilvoyant.com/assets/img/85aa63526c77.jpg"}}, {"@type": "ListItem", "position": 21, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#nice-k-metrics-unified-and-multidimensional-framework-for-evaluating", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#nice-k-metrics-unified-and-multidimensional-framework-for-evaluating", "headline": "NICE^k Metrics: Unified and Multidimensional Framework for Evaluating Deterministic Solar Forecasting Accuracy", "inLanguage": "en", "abstract": "Accurate solar energy output prediction is fundamental to integrating renewable energy sources into electrical grids, maintaining system stability, and enabling effective energy management. However, conventional error metrics—such as Root Mean Squared Error (RMSE), Mean Absolute Error (MAE), and Skill Scores (SS)—fail to capture the multidimensional complexity of solar irradiance forecasting. These metrics lack sensitivity to forecastability, rely on arbitrary baselines (e.g., clear-sky models),", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Milan Despotovic", "sameAs": "https://orcid.org/0000-0003-3144-5945"}, {"@type": "Person", "name": "Luis Garcia-Gutierrez", "sameAs": "https://orcid.org/0000-0002-3480-1784"}, {"@type": "Person", "name": "Rodrigo Amaro e Silva", "sameAs": "https://orcid.org/0000-0002-2813-150X"}, {"@type": "Person", "name": "Philippe Lauret", "sameAs": "https://orcid.org/0000-0003-2959-6146"}, {"@type": "Person", "name": "Ted Soubdhan", "sameAs": "https://orcid.org/0000-0002-6402-8438"}, {"@type": "Person", "name": "Nadjem Bailek", "sameAs": "https://orcid.org/0000-0001-9051-8548"}], "datePublished": "2025-09-25", "image": "https://www.cyrilvoyant.com/assets/img/82ce1d4d17e8.png"}}, {"@type": "ListItem", "position": 22, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#on-the-importance-of-clearsky-model-in-short-term-solar-radiation-forecasting", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#on-the-importance-of-clearsky-model-in-short-term-solar-radiation-forecasting", "headline": "On the importance of clearsky model in short-term solar radiation forecasting", "inLanguage": "en", "abstract": "Clearsky models are widely used in solar energy for many applications such as quality control, resource assessment, satellite-base irradiance estimation and forecasting. However, their use in forecasting and nowcasting is associated with a number of challenges. Synchronization errors, reliance on the Clearsky index (ratio of the global horizontal irradiance to its cloud-free counterpart) and high sensitivity of the clearsky model to errors in aerosol optical depth at low solar elevation limit th", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, {"@type": "Person", "name": "Milan Despotovic", "sameAs": "https://orcid.org/0000-0003-3144-5945"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "name": "Yves-Marie Saint-Drenan", "sameAs": "https://orcid.org/0000-0003-1471-1092"}, {"@type": "Person", "name": "Mohammed Asloune", "sameAs": "https://orcid.org/0009-0004-0183-2156"}, {"@type": "Person", "name": "Luis Garcia-Gutierrez", "sameAs": "https://orcid.org/0000-0002-3480-1784"}], "datePublished": "2025-04-11", "image": "https://www.cyrilvoyant.com/assets/img/05e996273651.jpg"}}, {"@type": "ListItem", "position": 23, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#comparative-study-of-feature-selection-techniques-for-machine-learning-based", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#comparative-study-of-feature-selection-techniques-for-machine-learning-based", "headline": "Comparative Study of Feature Selection Techniques for Machine Learning-Based Solar Irradiation Forecasting to Facilitate the Sustainable Development of Photovoltaics: Application to Algerian Climatic Conditions", "inLanguage": "en", "abstract": "Forecasting future solar power plant production is essential to continue the development of photovoltaic energy and increase its share in the energy mix for a more sustainable future. Accurate solar radiation forecasting greatly improves the balance maintenance between energy supply and demand and grid management performance. This study assesses the influence of input selection on short-term global horizontal irradiance (GHI) forecasting across two contrasting Algerian climates: arid Ghardaïa an", "author": [{"@type": "Person", "name": "Saïd Benkaciali"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2025-07-12", "image": "https://www.cyrilvoyant.com/assets/img/98c7979fb52e.png"}}, {"@type": "ListItem", "position": 24, "item": {"@type": "BlogPosting", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/#academic-visibility-why-publishing-isn-t-enough-anymore", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/#academic-visibility-why-publishing-isn-t-enough-anymore", "headline": "Academic Visibility: Why Publishing Isn't Enough Anymore", "inLanguage": "en", "abstract": "I've experienced this troubling phenomenon firsthand: an article I had little hope for exploded with hundreds of citations, while another piece I considered my best work remained in obscurity. After twenty years of research, one thing is clear: in a rapidly evolving academic ecosystem, publishing alone is no longer sufficient.", "author": [{"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}], "datePublished": "2025", "image": "https://www.cyrilvoyant.com/assets/img/0e72a8bbd5be.png"}}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/nice-forecast-evaluation#page", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/nice-forecast-evaluation/", "name": "NICE metrics: when RMSE hides a difference between solar forecasts", "description": "At a thirty-minute horizon, the NICE study reports a rounded median nRMSE of 0.19 for both an ELM and an autoregressive model. The composite NICEΣ score nevertheless gives 0.75 versus 0.77, with a statistically significant difference in the reported test.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-5"}], "keywords": ["Demonstrate trust", "Energy"], "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/actualites/nice-forecast-evaluation#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Stories", "item": "https://www.cyrilvoyant.com/stories/"}, {"@type": "ListItem", "position": 3, "name": "NICE metrics: when RMSE hides a difference between solar forecasts", "item": "https://www.cyrilvoyant.com/latest-publications-and-news/nice-forecast-evaluation/"}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/why-extreme-learning-machines#page", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/why-extreme-learning-machines/", "name": "MIMO-ELM: seven energy signals of Corsica forecast by one model", "description": "At a one-hour horizon, our MIMO-ELM model achieves nRMSE values of 0.179 for solar generation and 0.051 for thermal generation, with R² above 0.98 for both series. Total-demand forecasts remain reliable up to five hours ahead within the study.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-3"}], "keywords": ["Learn frugally", "Energy"], "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/actualites/why-extreme-learning-machines#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Stories", "item": "https://www.cyrilvoyant.com/stories/"}, {"@type": "ListItem", "position": 3, "name": "MIMO-ELM: seven energy signals of Corsica forecast by one model", "item": "https://www.cyrilvoyant.com/latest-publications-and-news/why-extreme-learning-machines/"}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/latest-publications-and-news/why-forecast-solar-power#page", "url": "https://www.cyrilvoyant.com/latest-publications-and-news/why-forecast-solar-power/", "name": "sCV and F: how variable and how forecastable is solar irradiance", "description": "Across 68 Spanish weather stations, our forecastability indicator F retains an inverse relationship with forecast error, examined across ten models and 24 horizons.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-2"}], "keywords": ["Compute directly", "Energy"], "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/actualites/why-forecast-solar-power#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Stories", "item": "https://www.cyrilvoyant.com/stories/"}, {"@type": "ListItem", "position": 3, "name": "sCV and F: how variable and how forecastable is solar irradiance", "item": "https://www.cyrilvoyant.com/latest-publications-and-news/why-forecast-solar-power/"}]}, {"@type": "CollectionPage", "@id": "https://www.cyrilvoyant.com/overview#page", "url": "https://www.cyrilvoyant.com/overview/", "name": "Cyril Voyant at a glance: research, software, courses and tools, open to all", "description": "Everything public in one place: main ideas, research lines, 15 software packages with DOI and teams, five courses under CC BY 4.0, interactive tools, essays. Free to reuse with credit.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/vue-d-ensemble#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "At a glance", "item": "https://www.cyrilvoyant.com/overview/"}]}, {"@type": "ItemList", "name": "Software, with its DOI and its team", "itemListElement": [{"@type": "ListItem", "position": 1, "item": {"@type": "SoftwareSourceCode", "name": "NICEᵏ: normalized forecast errors compared with simple persistence (MATLAB)", "identifier": "https://doi.org/10.5281/zenodo.23562549", "codeRepository": "https://github.com/cyrilvoyant/nice-metrics", "license": "MIT"}}, {"@type": "ListItem", "position": 2, "item": {"@type": "SoftwareSourceCode", "name": "sCV and F: variability and forecastability of solar irradiance (MATLAB)", "identifier": "https://doi.org/10.5281/zenodo.23562553", "codeRepository": "https://github.com/cyrilvoyant/solar-variability-scv", "license": "MIT"}}, {"@type": "ListItem", "position": 3, "item": {"@type": "SoftwareSourceCode", "name": "The γ-index: tolerance-based validation of spatio-temporal forecast fields (MATLAB)", "identifier": "https://doi.org/10.5281/zenodo.21755936", "codeRepository": "https://github.com/cyrilvoyant/temporal-gamma-index", "license": "MIT"}}, {"@type": "ListItem", "position": 4, "item": {"@type": "SoftwareSourceCode", "name": "ARTU: second-order autoregressive reference method for solar radiation forecasting", "identifier": "https://doi.org/10.5281/zenodo.21755931", "codeRepository": "https://github.com/cyrilvoyant/ARTU", "license": "MIT"}}, {"@type": "ListItem", "position": 5, "item": {"@type": "SoftwareSourceCode", "name": "BLEND and CLIPER: persistence operators for cyclostationary energy processes (MATLAB)", "identifier": "https://doi.org/10.5281/zenodo.18812333", "codeRepository": "https://github.com/cyrilvoyant/cyclostationary-forecasting-matlab", "license": "MIT"}}, {"@type": "ListItem", "position": 6, "item": {"@type": "SoftwareSourceCode", "name": "Per-cell, spatial and compressed forecasters of satellite solar irradiance: benchmark code (MATLAB, Python)", "identifier": "https://doi.org/10.5281/zenodo.23562557", "codeRepository": "https://github.com/cyrilvoyant/cell-vs-field-irradiance", "license": "MIT"}}, {"@type": "ListItem", "position": 7, "item": {"@type": "SoftwareSourceCode", "name": "MIMO-ELM forecasting of the Corsican electricity mix (MATLAB, Python, EDF open data)", "identifier": "https://doi.org/10.5281/zenodo.23562559", "codeRepository": "https://github.com/cyrilvoyant/Data_Viz_2024", "license": "GPL-3.0"}}, {"@type": "ListItem", "position": 8, "item": {"@type": "SoftwareSourceCode", "name": "PV_ELM_pred: benchmark of persistence, BLEND, autoregression and ELM variants for PV forecasting (Python)", "identifier": "https://doi.org/10.5281/zenodo.21487267", "codeRepository": "https://github.com/cyrilvoyant/PV_ELM_pred", "license": "MIT"}}, {"@type": "ListItem", "position": 9, "item": {"@type": "SoftwareSourceCode", "name": "Make_Stationary: deseasonalization benchmark for renewable-energy time series (MATLAB)", "identifier": "https://doi.org/10.5281/zenodo.21490743", "codeRepository": "https://github.com/cyrilvoyant/Make_Stationary", "license": "GPL-3.0"}}, {"@type": "ListItem", "position": 10, "item": {"@type": "SoftwareSourceCode", "name": "Filter and wrapper diagnostics of dimensionality reduction for endogenous PV power forecasting (MATLAB)", "identifier": "https://doi.org/10.5281/zenodo.21755938", "codeRepository": "https://github.com/cyrilvoyant/pv-dimensionality-reduction", "license": "MIT"}}, {"@type": "ListItem", "position": 11, "item": {"@type": "SoftwareSourceCode", "name": "RAIR-Sim: compartmental simulator of radioactive iodine therapy response in metastatic thyroid cancer (MATLAB)", "identifier": "https://doi.org/10.5281/zenodo.21496197", "codeRepository": "https://github.com/cyrilvoyant/CTD_SIMU_RAI", "license": "MIT"}}, {"@type": "ListItem", "position": 12, "item": {"@type": "SoftwareSourceCode", "name": "Influence Index: a log-based measure of research influence for institutions (MATLAB, processed data)", "identifier": "https://doi.org/10.5281/zenodo.19706465", "codeRepository": "https://github.com/cyrilvoyant/influence-index-bibliometrics", "license": "MIT"}}, {"@type": "ListItem", "position": 13, "item": {"@type": "SoftwareSourceCode", "name": "LQL-Equiv 2014: biologically equivalent dose calculation in radiotherapy (MATLAB application)", "identifier": "https://doi.org/10.5281/zenodo.16739882", "codeRepository": "https://github.com/cyrilvoyant/LQ-Equiv", "license": "MIT"}}, {"@type": "ListItem", "position": 14, "item": {"@type": "SoftwareSourceCode", "name": "Tunnel Load Simulator: synthetic electricity demand of road tunnels (Python, Streamlit)", "identifier": "https://doi.org/10.5281/zenodo.20080042", "codeRepository": "https://github.com/cyrilvoyant/tunnel-load-simulator", "license": "MIT"}}, {"@type": "ListItem", "position": 15, "item": {"@type": "SoftwareSourceCode", "name": "LQL-Equiv-web 3.0: biologically equivalent doses in radiotherapy (Python, browser)", "identifier": "https://doi.org/10.5281/zenodo.21948623", "codeRepository": "https://github.com/cyrilvoyant/LQL-Equiv-web", "license": "MIT"}}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/prevision-pv-reduction-dimension#page", "url": "https://www.cyrilvoyant.com/prevision-pv-reduction-dimension/", "name": "Prévision PV : réduire la dimension", "description": "Prévoir la puissance électrique directement à partir de son historique évite de reconstruire toute la chaîne rayonnement–panneaux–onduleur. Mais une journée de mesures n’est pas nécessairement une journée d’informations indépendantes.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-3"}], "keywords": ["Apprendre frugalement", "Énergie"]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Récits", "item": "https://www.cyrilvoyant.com/fr/recits/"}, {"@type": "ListItem", "position": 3, "name": "Prévision PV : réduire la dimension", "item": "https://www.cyrilvoyant.com/prevision-pv-reduction-dimension/"}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/prevision-solaire-faire-simple#page", "url": "https://www.cyrilvoyant.com/prevision-solaire-faire-simple/", "name": "Prévision solaire : faire simple", "description": "Prévoir le solaire, c’est distinguer ce que l’on sait déjà — le mouvement du Soleil — de ce qu’il reste à anticiper : les nuages, la dynamique locale et l’état réel du système.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-2"}], "keywords": ["Calculer directement", "Énergie"]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Récits", "item": "https://www.cyrilvoyant.com/fr/recits/"}, {"@type": "ListItem", "position": 3, "name": "Prévision solaire : faire simple", "item": "https://www.cyrilvoyant.com/prevision-solaire-faire-simple/"}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/prevision-solaire-modeles-frugaux#page", "url": "https://www.cyrilvoyant.com/prevision-solaire-modeles-frugaux/", "name": "Prévision solaire : modèles frugaux", "description": "Un modèle de prévision ne se juge pas uniquement sur son erreur. Il doit aussi tenir dans le dispositif, répondre à temps et rester maintenable. La frugalité consiste à rechercher la capacité utile, en démontrant ce que chaque supplément de complexité apporte.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-3"}], "keywords": ["Apprendre frugalement", "Énergie"]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Récits", "item": "https://www.cyrilvoyant.com/fr/recits/"}, {"@type": "ListItem", "position": 3, "name": "Prévision solaire : modèles frugaux", "item": "https://www.cyrilvoyant.com/prevision-solaire-modeles-frugaux/"}]}, {"@type": "WebPage", "@id": "https://www.cyrilvoyant.com/research-excellence-rtvacos#page", "url": "https://www.cyrilvoyant.com/research-excellence-rtvacos/", "name": "RTVACOS: the research-excellence tree, a toolbox for researchers", "description": "An interactive mirror of the RTVACOS framework: four foundations (rigour, transparency, visibility, adoption) as roots, three amplifiers as branches. Tick your practices, the tree grows; no score.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/excellence-rtvacos#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Excellence (RTVACOS)", "item": "https://www.cyrilvoyant.com/research-excellence-rtvacos/"}]}, {"@type": "ScholarlyArticle", "name": "Beyond Publish and Pray: Engineering Research Excellence", "url": "https://doi.org/10.2139/ssrn.6877118", "datePublished": "2026", "author": [{"@type": "Person", "name": "Cyril Voyant", "@id": "https://person.cyrilvoyant.com/#cyril-voyant"}, {"@type": "Person", "name": "Rodrigo Amaro e Silva", "sameAs": "https://orcid.org/0000-0002-2813-150X"}, {"@type": "Person", "name": "Nicolas Fichaux", "sameAs": "https://orcid.org/0009-0008-2824-0387"}, {"@type": "Person", "name": "Lionel Ménard", "sameAs": "https://orcid.org/0009-0002-2156-8538"}, {"@type": "Person", "name": "Sylvain Cros", "sameAs": "https://orcid.org/0000-0002-7702-2123"}, {"@type": "Person", "name": "Rodanthi-Elisavet Mamouri", "sameAs": "https://orcid.org/0000-0003-4836-8560"}]}, {"@type": "CollectionPage", "@id": "https://www.cyrilvoyant.com/research-projects#page", "url": "https://www.cyrilvoyant.com/research-projects/", "name": "Research and projects", "description": "Research and projects of Cyril Voyant, Research Director at Mines Paris – PSL.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/"}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "About", "item": "https://www.cyrilvoyant.com/about/"}, {"@type": "ListItem", "position": 3, "name": "Research and projects", "item": "https://www.cyrilvoyant.com/research-projects/"}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/scientific-publishing-trust#page", "url": "https://www.cyrilvoyant.com/scientific-publishing-trust/", "name": "Scientific publishing: no verification of data and code, no trust", "description": "Too many articles, unpaid review, record retractions, generative AI: what exists (FAIR, OSTP, EU Council, CoARA, AI Act, French Digital Republic Act) and what is missing, checking data and code.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/edition-scientifique-confiance#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Scientific publishing", "item": "https://www.cyrilvoyant.com/scientific-publishing-trust/"}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/scientific-publishing-trust#essay", "headline": "Scientific publishing: no verification of data and code, no trust", "datePublished": "2026-10-24", "dateModified": "2026-10-24", "inLanguage": "en", "keywords": ["scholarly publishing", "open science", "reproducibility", "code verification", "FAIR data", "AI Act", "MLOps", "peer review", "generative AI"], "mainEntityOfPage": {"@id": "https://www.cyrilvoyant.com/scientific-publishing-trust#page"}, "author": {"@id": "https://person.cyrilvoyant.com/#cyril-voyant"}, "license": "https://creativecommons.org/licenses/by/4.0/", "citation": [{"@type": "CreativeWork", "name": "Hanson, Gómez Barreiro, Crosetto, Brockington (2024). The strain on scientific publishing. Quantitative Science Studies 5(4)", "url": "https://doi.org/10.1162/qss_a_00327"}, {"@type": "CreativeWork", "name": "Larivière, Haustein, Mongeon (2015). The oligopoly of academic publishers in the digital era. PLoS ONE 10(6)", "url": "https://doi.org/10.1371/journal.pone.0127502"}, {"@type": "CreativeWork", "name": "RELX (2026). RELX 2025 results", "url": "https://www.relx.com/media/press-releases/year-2026/relx-2025-results"}, {"@type": "CreativeWork", "name": "Aczel, Szaszi, Holcombe (2021). A billion-dollar donation: estimating the cost of researchers' time spent on peer review. Research Integrity and Peer Review 6", "url": "https://doi.org/10.1186/s41073-021-00118-2"}, {"@type": "CreativeWork", "name": "Van Noorden (2023). More than 10,000 research papers were retracted in 2023, a new record. Nature 624", "url": "https://doi.org/10.1038/d41586-023-03974-8"}, {"@type": "CreativeWork", "name": "NIH (2023). NOT-OD-23-149: generative AI prohibited in NIH peer review", "url": "https://grants.nih.gov/grants/guide/notice-files/NOT-OD-23-149.html"}, {"@type": "CreativeWork", "name": "OSTP (2022). Ensuring free, immediate, and equitable access to federally funded research", "url": "https://bidenwhitehouse.archives.gov/wp-content/uploads/2022/08/08-2022-OSTP-Public-Access-Memo.pdf"}, {"@type": "CreativeWork", "name": "Wilkinson et al. (2016). The FAIR Guiding Principles for scientific data management and stewardship. Scientific Data 3", "url": "https://doi.org/10.1038/sdata.2016.18"}, {"@type": "CreativeWork", "name": "Journal of Open Source Software: open review on GitHub", "url": "https://joss.readthedocs.io/"}, {"@type": "CreativeWork", "name": "Nüst, Eglen (2021). CODECHECK: an open science initiative for the independent execution of computations. F1000Research 10", "url": "https://doi.org/10.12688/f1000research.51738.2"}, {"@type": "CreativeWork", "name": "ReScience C: reproducible replications in computational science", "url": "https://rescience.github.io/"}, {"@type": "CreativeWork", "name": "Council of the EU (2023). Conclusions on high-quality, transparent, open, trustworthy and equitable scholarly publishing (9616/23)", "url": "https://european-research-area.ec.europa.eu/documents/council-conclusions-high-quality-transparent-open-trustworthy-and-equitable-scholarly"}, {"@type": "CreativeWork", "name": "Science Europe, cOAlition S, OPERAS, ANR (2022). Action Plan for Diamond Open Access", "url": "https://doi.org/10.5281/zenodo.6282402"}, {"@type": "CreativeWork", "name": "European Commission. Open Research Europe", "url": "https://open-research-europe.ec.europa.eu/"}, {"@type": "CreativeWork", "name": "CoARA. Agreement on Reforming Research Assessment (2022)", "url": "https://coara.eu/agreement/the-agreement-full-text/"}, {"@type": "CreativeWork", "name": "Regulation (EU) 2024/1689 (AI Act)", "url": "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"}, {"@type": "CreativeWork", "name": "Loi n° 2016-1321 pour une République numérique, article 30 (art. L533-4 du code de la recherche)", "url": "https://www.legifrance.gouv.fr/jorf/id/JORFTEXT000033202746"}, {"@type": "CreativeWork", "name": "Deuxième Plan national pour la science ouverte 2021-2024", "url": "https://www.enseignementsup-recherche.gouv.fr/fr/une-politique-ambitieuse-pour-la-science-ouverte-50735"}, {"@type": "CreativeWork", "name": "Software Heritage, l'archive universelle du code source", "url": "https://www.softwareheritage.org/"}, {"@type": "CreativeWork", "name": "SoftwareX: research software publications and reuse", "url": "https://www.sciencedirect.com/journal/softwarex"}]}, {"@type": "FAQPage", "@id": "https://www.cyrilvoyant.com/scientific-publishing-trust#faq", "inLanguage": "en", "mainEntity": [{"@type": "Question", "name": "Is scientific publishing really in trouble?", "acceptedAnswer": {"@type": "Answer", "text": "The number of indexed articles grew by about 47% between 2016 and 2022, faster than the number of researchers; unpaid peer review no longer keeps up, and more than 10,000 papers were retracted in 2023, a record."}}, {"@type": "Question", "name": "Should AI be banned from writing and reviewing?", "acceptedAnswer": {"@type": "Answer", "text": "No: it should be declared. As with any other tool, authors state what was used and for what; what matters is that results are checked, data and code included."}}, {"@type": "Question", "name": "Why bring the AI Act into a discussion of articles?", "acceptedAnswer": {"@type": "Answer", "text": "Because it requires of high-risk AI systems what articles lack: data governance, technical documentation, record-keeping, a quality management system and post-market monitoring."}}, {"@type": "Question", "name": "Do we need new journals?", "acceptedAnswer": {"@type": "Answer", "text": "Not necessarily. What is missing is verification and recognition of editorial work, not more titles."}}]}, {"@type": "DefinedTermSet", "@id": "https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary", "name": "Glossary of scholarly publishing", "inLanguage": "en", "hasDefinedTerm": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary-diamond-open-access", "name": "Diamond open access", "description": "Journals free for both authors and readers, funded by institutions.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary-apc-article-processing-charge", "name": "APC (Article Processing Charge)", "description": "Fee paid by authors, or their institution, to publish an article in open access.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary-codecheck", "name": "CODECHECK", "description": "A third party runs an article's code and certifies that the reported figures and tables are regenerated; it does not judge scientific validity.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary-coara", "name": "CoARA", "description": "European coalition to reform research assessment: recognize the diversity of contributions, not only article counts.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary-doi", "name": "DOI", "description": "Persistent identifier of an article, a dataset or a software version.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary-paper-mill", "name": "Paper mill", "description": "Organization selling fabricated or falsified articles, often slipped into special issues.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary-fair", "name": "FAIR", "description": "Findable, accessible, interoperable, reusable: principles for data, not a licence.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary-mlops", "name": "MLOps", "description": "Engineering practices to version, trace, deploy and monitor learning models.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary-reproducibility", "name": "Reproducibility", "description": "Recovering a result with the same data and code; replication recovers it with new data.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary-retraction", "name": "Retraction", "description": "Official withdrawal of a published article for serious error or fraud; the article stays visible, marked as retracted.", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/scientific-publishing-trust/#glossary"}}]}, {"@type": "CollectionPage", "@id": "https://www.cyrilvoyant.com/stories#page", "url": "https://www.cyrilvoyant.com/stories/", "name": "Research: questions, findings and methods", "description": "Every story follows the same plan: the finding, the question, the theory in plain words, where it sits on the complexity ladder, an example in figures, what it brings and its limits. Technical details and code are on the methods site.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-2"}], "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/recits#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Research", "item": "https://www.cyrilvoyant.com/stories/"}]}, {"@type": "ItemList", "itemListElement": [{"@type": "ListItem", "position": 1, "url": "https://www.cyrilvoyant.com/stories/lql-equiv/", "name": "Compute, don't learn: radiobiological dose equivalence"}, {"@type": "ListItem", "position": 2, "url": "https://www.cyrilvoyant.com/stories/tunnel-load-simulator/", "name": "Simulate what you cannot yet measure: road tunnels"}, {"@type": "ListItem", "position": 3, "url": "https://www.cyrilvoyant.com/latest-publications-and-news/why-forecast-solar-power/", "name": "How forecastable is the sun?"}, {"@type": "ListItem", "position": 4, "url": "https://www.cyrilvoyant.com/stories/thyroid-radioiodine/", "name": "Thyroid cancer and radioiodine: model first"}, {"@type": "ListItem", "position": 5, "url": "https://www.cyrilvoyant.com/latest-publications-and-news/forecasting-with-less/", "name": "Better persistence, without training a neural network"}, {"@type": "ListItem", "position": 6, "url": "https://www.cyrilvoyant.com/latest-publications-and-news/why-extreme-learning-machines/", "name": "Seven signals, one ELM"}, {"@type": "ListItem", "position": 7, "url": "https://www.cyrilvoyant.com/stories/satellite-irradiance/", "name": "Satellite forecasting: one cell or the whole field?"}, {"@type": "ListItem", "position": 8, "url": "https://www.cyrilvoyant.com/prevision-solaire-modeles-frugaux/", "name": "Frugal models for solar forecasting (in French)"}, {"@type": "ListItem", "position": 9, "url": "https://www.cyrilvoyant.com/prevision-pv-reduction-dimension/", "name": "Direct PV forecasting: reduce the dimension (in French)"}, {"@type": "ListItem", "position": 10, "url": "https://www.cyrilvoyant.com/stories/websemantic/", "name": "Let the language model read, let the validated code compute"}, {"@type": "ListItem", "position": 11, "url": "https://www.cyrilvoyant.com/stories/questioning-research/", "name": "Questioning how we do research: influence, integrity, excellence"}, {"@type": "ListItem", "position": 12, "url": "https://www.cyrilvoyant.com/ai-in-research/", "name": "AI in research: the AI Act, a lab charter and a toolbox"}, {"@type": "ListItem", "position": 13, "url": "https://www.cyrilvoyant.com/latest-publications-and-news/nice-forecast-evaluation/", "name": "When RMSE hides a difference"}, {"@type": "ListItem", "position": 14, "url": "https://www.cyrilvoyant.com/latest-publications-and-news/gamma-index-forecast-validation/", "name": "Beyond pointwise errors: the γ-index"}, {"@type": "ListItem", "position": 15, "url": "https://www.cyrilvoyant.com/latest-publications-and-news/academic-visibility-why-publishing-isn-t-enough-anymore/", "name": "Academic visibility: why publishing isn't enough anymore"}, {"@type": "ListItem", "position": 16, "url": "https://www.cyrilvoyant.com/fr/actualites/excellence-scientifique-a-l-ere-de-l-ia-du-seo-au-geo/", "name": "Research excellence in the age of AI: from SEO to GEO (in French)"}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/stories/lql-equiv#page", "url": "https://www.cyrilvoyant.com/stories/lql-equiv/", "name": "Compute, don't learn: radiobiological dose equivalence with LQL-Equiv", "description": "When the link between a radiotherapy schedule and its biological effect is known, it is computed directly. No data and no artificial intelligence are needed: only a model we understand, checked case by case.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-2"}], "keywords": ["Compute directly", "Medicine"], "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/recits/lql-equiv#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Stories", "item": "https://www.cyrilvoyant.com/stories/"}, {"@type": "ListItem", "position": 3, "name": "Compute, don't learn: radiobiological dose equivalence with LQL-Equiv", "item": "https://www.cyrilvoyant.com/stories/lql-equiv/"}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/stories/questioning-research#page", "url": "https://www.cyrilvoyant.com/stories/questioning-research/", "name": "Questioning how we do research: influence, integrity, excellence", "description": "Research in a changing world also has to examine its own methods. The same approach applies: compare with an explicit reference, look at what a single number hides, and state the limits.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-5"}], "keywords": ["Demonstrate trust", "Research practice"], "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/recits/questioning-research#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Stories", "item": "https://www.cyrilvoyant.com/stories/"}, {"@type": "ListItem", "position": 3, "name": "Questioning how we do research: influence, integrity, excellence", "item": "https://www.cyrilvoyant.com/stories/questioning-research/"}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/stories/satellite-irradiance#page", "url": "https://www.cyrilvoyant.com/stories/satellite-irradiance/", "name": "Satellite irradiance forecasting: one cell, a patch or the whole field", "description": "A satellite sees the irradiance of a whole region every hour. It is tempting to give a forecaster the whole map. Holding the forecaster fixed and changing only what it reads shows how much of that map actually helps.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-3"}], "keywords": ["Learn frugally", "Energy"], "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/recits/satellite-irradiance#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Stories", "item": "https://www.cyrilvoyant.com/stories/"}, {"@type": "ListItem", "position": 3, "name": "Satellite irradiance forecasting: one cell, a patch or the whole field", "item": "https://www.cyrilvoyant.com/stories/satellite-irradiance/"}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/stories/thyroid-radioiodine#page", "url": "https://www.cyrilvoyant.com/stories/thyroid-radioiodine/", "name": "Thyroid cancer and radioiodine: model first, learn only what is missing", "description": "How many sessions of radioactive iodine, how far apart, and at what activity? An intelligible model of three equations explores these questions before any patient is treated. Learning will be added only where the model is not enough.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-2"}], "keywords": ["Hybridize", "Medicine"], "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/recits/thyroid-radioiodine#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Stories", "item": "https://www.cyrilvoyant.com/stories/"}, {"@type": "ListItem", "position": 3, "name": "Thyroid cancer and radioiodine: model first, learn only what is missing", "item": "https://www.cyrilvoyant.com/stories/thyroid-radioiodine/"}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/stories/tunnel-load-simulator#page", "url": "https://www.cyrilvoyant.com/stories/tunnel-load-simulator/", "name": "Simulate what you cannot yet measure: the electricity demand of road tunnels", "description": "A tunnel's operator rarely has detailed load measurements, especially at the design stage. The Tunnel Load Simulator builds the demand from what is known about the tunnel, says how uncertain it is, and states its limits.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-2"}], "keywords": ["Compute directly", "Energy"], "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/recits/tunnel-load-simulator#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Stories", "item": "https://www.cyrilvoyant.com/stories/"}, {"@type": "ListItem", "position": 3, "name": "Simulate what you cannot yet measure: the electricity demand of road tunnels", "item": "https://www.cyrilvoyant.com/stories/tunnel-load-simulator/"}]}, {"@type": "Article", "@id": "https://www.cyrilvoyant.com/stories/websemantic#page", "url": "https://www.cyrilvoyant.com/stories/websemantic/", "name": "Let the language model read, let the validated code compute: WebSemantic", "description": "Language models are good at understanding a request written in plain words. They are not a substitute for a validated scientific code. WebSemantic gives each one its role, and asks the person whenever something is missing.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-4"}], "keywords": ["AI in its place", "Language"], "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/recits/websemantic#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Stories", "item": "https://www.cyrilvoyant.com/stories/"}, {"@type": "ListItem", "position": 3, "name": "Let the language model read, let the validated code compute: WebSemantic", "item": "https://www.cyrilvoyant.com/stories/websemantic/"}]}, {"@type": "WebPage", "@id": "https://www.cyrilvoyant.com/teaching#page", "url": "https://www.cyrilvoyant.com/teaching/", "name": "Teaching", "description": "Five open courses under CC BY 4.0: solar forecasting (Mines Paris – PSL), biostatistics and physics for health studies, industrial physics, heat transfer for foods.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-3"}], "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/enseignement#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Teaching", "item": "https://www.cyrilvoyant.com/teaching/"}]}, {"@type": "CollectionPage", "@id": "https://www.cyrilvoyant.com/teaching/open-courses#page", "url": "https://www.cyrilvoyant.com/teaching/open-courses/", "name": "Open courses in French: biostatistics, medical physics, industrial physics and food heat transfer", "description": "Four complete courses in French under CC BY 4.0: biostatistics and physics for health studies, industrial physics and refrigeration, heat transfer for foods; every slide with its text, decks and handouts as PDF.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/"}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Teaching", "item": "https://www.cyrilvoyant.com/teaching/"}, {"@type": "ListItem", "position": 3, "name": "Open courses", "item": "https://www.cyrilvoyant.com/teaching/open-courses/"}]}, {"@type": "ItemList", "name": "Open courses in French: biostatistics, medical physics, industrial physics and food heat transfer", "itemListElement": [{"@type": "ListItem", "position": 1, "item": {"@type": "Course", "name": "Biostatistics for health studies", "description": "Probabilities and Bayesian reasoning, diagnostic tests (sensitivity, specificity, ROC curves), descriptive statistics, the normal distribution and hypothesis tests, correlation, linear regression and χ² tests, with medical examples.", "url": "https://www.cyrilvoyant.com/fr/enseignement/biostatistique/", "inLanguage": "fr", "provider": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/"}}, {"@type": "ListItem", "position": 2, "item": {"@type": "Course", "name": "Physics for health studies: electromagnetic waves, X-rays and imaging", "description": "The nature of electromagnetic waves and of the photon, the energy levels of the atom, absorption, emission and spectroscopy (up to pulse oximetry), the production of X-rays, their interactions with matter and attenuation, then radiography and CT scanning; two corrected exercise sessions.", "url": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/", "inLanguage": "fr", "provider": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/"}}, {"@type": "ListItem", "position": 3, "item": {"@type": "Course", "name": "Industrial physics: thermodynamics, water vapor and refrigeration", "description": "Quantities and changes of state, ideal and real gases, Clapeyron, entropy and Mollier diagrams, water vapor and humidity, engine cycles, then the refrigeration cycle, its coefficient of performance and its refrigerants; with the handouts.", "url": "https://www.cyrilvoyant.com/fr/enseignement/physique-industrielle/", "inLanguage": "fr", "provider": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/"}}, {"@type": "ListItem", "position": 4, "item": {"@type": "Course", "name": "Heat transfer for food engineering: cooling and freezing", "description": "Conduction, convection and the Biot number, thermal properties of foods, refrigeration power and the amount of water to freeze, then the energy balance of cooling or freezing a product.", "url": "https://www.cyrilvoyant.com/fr/enseignement/bases-thermiques-aliments/", "inLanguage": "fr", "provider": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/"}}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/teaching/solar-forecasting-course#page", "url": "https://www.cyrilvoyant.com/teaching/solar-forecasting-course/", "name": "Solar forecasting course: forecasting the intermittent solar resource", "description": "A 59-slide course on forecasting solar irradiance one hour ahead, taught in the UE14 applied research project of the Mines Paris – PSL engineering curriculum, built on ten years of hourly measurements from Ajaccio (Corsica).", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-2"}], "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/enseignement/cours-prevision-solaire#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Teaching", "item": "https://www.cyrilvoyant.com/teaching/"}, {"@type": "ListItem", "position": 3, "name": "Course", "item": "https://www.cyrilvoyant.com/teaching/solar-forecasting-course/"}]}, {"@type": "Course", "@id": "https://www.cyrilvoyant.com/teaching/solar-forecasting-course/#course", "name": "Solar forecasting course: forecasting the intermittent solar resource", "description": "A 59-slide course on forecasting solar irradiance one hour ahead, taught in the UE14 applied research project of the Mines Paris – PSL engineering curriculum, built on ten years of hourly measurements from Ajaccio (Corsica). It goes from the solar signal and the clear-sky index to autoregressive models fitted by least squares, then to Extreme Learning Machines, online learning and frugality, every model judged against persistence; on the 2007 test year, the daytime nRMSE is 22.0 % for smart persistence, 21.3 % for AR(2) and 20.5 % for an ELM.", "inLanguage": "en", "courseCode": "UE14", "educationalLevel": "Engineering curriculum (Mines Paris – PSL)", "license": "https://creativecommons.org/licenses/by/4.0/", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "provider": {"@type": "CollegeOrUniversity", "name": "Mines Paris – PSL", "url": "https://www.minesparis.psl.eu/"}, "isBasedOn": "https://cyrilvoyant.github.io/teaching/solar-forecasting-basics.html", "hasPart": [{"@type": "LearningResource", "name": "Solar forecasting course: forecasting the intermittent solar resource (PowerPoint)", "encodingFormat": "application/vnd.openxmlformats-officedocument.presentationml.presentation", "contentUrl": "https://www.cyrilvoyant.com/assets/course/Forecasting-the-Intermittent-Solar-Resource_EN.pptx"}, {"@type": "LearningResource", "name": "Solar forecasting course: forecasting the intermittent solar resource (PDF)", "encodingFormat": "application/pdf", "contentUrl": "https://www.cyrilvoyant.com/assets/course/Forecasting-the-Intermittent-Solar-Resource_EN.pdf"}], "teaches": ["clear-sky index", "autoregressive model", "least squares", "persistence", "forecast evaluation (nRMSE, skill score, NICE)", "Extreme Learning Machine", "online learning", "frugality"]}, {"@type": "CollectionPage", "@id": "https://www.cyrilvoyant.com/the-thread#page", "url": "https://www.cyrilvoyant.com/the-thread/", "name": "The thread: five steps, from direct computation to trust", "description": "The thread of Cyril Voyant's research in five steps: compute when the link is known, hybridize, learn frugally, AI in its place, demonstrate trust. Each step leads to its stories.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "about": [{"@id": "https://cyrilvoyant.github.io/approach.html#principle-2"}], "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/le-fil#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "The thread", "item": "https://www.cyrilvoyant.com/the-thread/"}]}, {"@type": "ItemList", "itemListElement": [{"@type": "ListItem", "position": 1, "url": "https://www.cyrilvoyant.com/stories/lql-equiv/", "name": "Compute, don't learn: radiobiological dose equivalence"}, {"@type": "ListItem", "position": 2, "url": "https://www.cyrilvoyant.com/stories/tunnel-load-simulator/", "name": "Simulate what you cannot yet measure: road tunnels"}, {"@type": "ListItem", "position": 3, "url": "https://www.cyrilvoyant.com/latest-publications-and-news/why-forecast-solar-power/", "name": "How forecastable is the sun?"}, {"@type": "ListItem", "position": 4, "url": "https://www.cyrilvoyant.com/stories/thyroid-radioiodine/", "name": "Thyroid cancer and radioiodine: model first"}, {"@type": "ListItem", "position": 5, "url": "https://www.cyrilvoyant.com/latest-publications-and-news/forecasting-with-less/", "name": "Better persistence, without training a neural network"}, {"@type": "ListItem", "position": 6, "url": "https://www.cyrilvoyant.com/latest-publications-and-news/why-extreme-learning-machines/", "name": "Seven signals, one ELM"}, {"@type": "ListItem", "position": 7, "url": "https://www.cyrilvoyant.com/stories/satellite-irradiance/", "name": "Satellite forecasting: one cell or the whole field?"}, {"@type": "ListItem", "position": 8, "url": "https://www.cyrilvoyant.com/prevision-solaire-modeles-frugaux/", "name": "Frugal models for solar forecasting (in French)"}, {"@type": "ListItem", "position": 9, "url": "https://www.cyrilvoyant.com/prevision-pv-reduction-dimension/", "name": "Direct PV forecasting: reduce the dimension (in French)"}, {"@type": "ListItem", "position": 10, "url": "https://www.cyrilvoyant.com/stories/websemantic/", "name": "Let the language model read, let the validated code compute"}, {"@type": "ListItem", "position": 11, "url": "https://www.cyrilvoyant.com/stories/questioning-research/", "name": "Questioning how we do research: influence, integrity, excellence"}, {"@type": "ListItem", "position": 12, "url": "https://www.cyrilvoyant.com/ai-in-research/", "name": "AI in research: the AI Act, a lab charter and a toolbox"}, {"@type": "ListItem", "position": 13, "url": "https://www.cyrilvoyant.com/latest-publications-and-news/nice-forecast-evaluation/", "name": "When RMSE hides a difference"}, {"@type": "ListItem", "position": 14, "url": "https://www.cyrilvoyant.com/latest-publications-and-news/gamma-index-forecast-validation/", "name": "Beyond pointwise errors: the γ-index"}, {"@type": "ListItem", "position": 15, "url": "https://www.cyrilvoyant.com/latest-publications-and-news/academic-visibility-why-publishing-isn-t-enough-anymore/", "name": "Academic visibility: why publishing isn't enough anymore"}, {"@type": "ListItem", "position": 16, "url": "https://www.cyrilvoyant.com/fr/actualites/excellence-scientifique-a-l-ere-de-l-ia-du-seo-au-geo/", "name": "Research excellence in the age of AI: from SEO to GEO (in French)"}]}, {"@type": "WebPage", "@id": "https://www.cyrilvoyant.com/tools/forecast-comparison#page", "url": "https://www.cyrilvoyant.com/tools/forecast-comparison/", "name": "Compare photovoltaic forecasts: persistence, AR and ELM against horizon", "description": "Five models on public Palaiseau data, from 30 minutes to 6 hours: error against horizon, NICE metrics, forecast curves. Computed by the PV_ELM_pred code.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "workTranslation": {"@id": "https://www.cyrilvoyant.com/fr/outils/comparateur-previsions#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.cyrilvoyant.com/"}, {"@type": "ListItem", "position": 2, "name": "Tools", "item": "https://www.cyrilvoyant.com/tools/"}, {"@type": "ListItem", "position": 3, "name": "Forecast comparison", "item": "https://www.cyrilvoyant.com/tools/forecast-comparison/"}]}, {"@type": "SoftwareApplication", "name": "Compare photovoltaic forecasts: persistence, AR and ELM against horizon", "applicationCategory": "EducationalApplication", "operatingSystem": "Web browser", "isBasedOn": {"@id": "https://doi.org/10.5281/zenodo.21487267"}, "inLanguage": "en", "url": "https://www.cyrilvoyant.com/tools/forecast-comparison/"}, {"@type": "CollectionPage", "@id": "https://www.cyrilvoyant.com/tools#page", "url": "https://www.cyrilvoyant.com/tools/", "name": "Interactive tools: choose a question, explore a method", "description": "Calculators, teaching experiments and research applications, organized by domain and language.", "inLanguage": "en", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "P