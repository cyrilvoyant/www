w.cyrilvoyant.com/fr/lexique/#medical-physics", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["physique des rayonnements"], "sameAs": "http://www.wikidata.org/entity/Q1120908"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#statistics", "name": "Statistiques", "description": "Comparer un écart à son incertitude, mesurer une relation ou une prédiction, et lire un résultat sans le surinterpréter.", "termCode": "statistics", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#statistics", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["biostatistique"], "sameAs": "http://www.wikidata.org/entity/Q12483"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#thermal-physics", "name": "Thermique et thermodynamique", "description": "Échanges de chaleur, cycles moteurs et frigorifiques et limites de Carnot, pour dimensionner un refroidissement, une congélation ou une machine thermique.", "termCode": "thermal-physics", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#thermal-physics", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["thermique industrielle"], "sameAs": "http://www.wikidata.org/entity/Q619452"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#forecast-evaluation", "name": "Évaluation d'une prévision", "description": "Une erreur n'a de sens que face à une référence : mêmes cibles, périmètre annoncé, plusieurs normes d'erreur, puis un test de la différence.", "termCode": "forecast-evaluation", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#forecast-evaluation", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["vérification d'une prévision"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#persistence", "name": "Persistance", "description": "La prévision recopie la dernière valeur connue. C'est la référence minimale de toute prévision.", "termCode": "persistence", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#persistence", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["persistance simple"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#cyclic-persistence", "name": "Persistance cyclique", "description": "La prévision recopie la valeur un cycle plus tôt, au même moment du cycle.", "termCode": "cyclic-persistence", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#cyclic-persistence", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#smart-persistence", "name": "Persistance de l'indice de ciel clair", "description": "La persistance appliquée à l'indice de ciel clair (SP : persistance de l'indice de ciel clair), plutôt qu'à l'éclairement brut.", "termCode": "smart-persistence", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#smart-persistence", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["smart persistence", "persistance intelligente"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#climatological-mean", "name": "Moyenne", "description": "La prévision vaut toujours la moyenne du passé.", "termCode": "climatological-mean", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#climatological-mean", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["moyenne du passé", "moyenne climatologique"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#convex-combination", "name": "Combinaison convexe", "description": "Deux prévisions pesées par des poids positifs de somme 1, calculés sur le passé. Persistance et moyenne : CLIPER. Persistance et persistance cyclique : BLEND.", "termCode": "convex-combination", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#convex-combination", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["poids positifs de somme 1"], "sameAs": "http://www.wikidata.org/entity/Q2627315"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#cliper", "name": "CLIPER", "description": "La combinaison convexe de la persistance et de la moyenne. Même idée que BLEND, autre partenaire.", "termCode": "cliper", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#cliper", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#blend", "name": "BLEND", "description": "La combinaison convexe de la persistance et de la persistance cyclique : deux poids positifs de somme 1, λ et 1 − λ, calculés à chaque moment du cycle.", "termCode": "blend", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#blend", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["persistance cyclostationnaire"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#artu", "name": "ARTU", "description": "Une référence d'ordre deux sur le rapport à la tendance : deux autocorrélations et une table donnent ses trois poids, sur la dernière valeur, la valeur h pas plus tôt et la moyenne.", "termCode": "artu", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#artu", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#ar2", "name": "AR(2)", "description": "Une régression sur les deux dernières valeurs connues. Brute : sans retirer le cycle. Elle sert à mesurer ce que le retrait du cycle rapporte.", "termCode": "ar2", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#ar2", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["autorégression d'ordre 2"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#elm", "name": "Extreme Learning Machine (ELM)", "description": "Une Extreme Learning Machine garde une couche cachée aléatoire et ajuste les sorties par une résolution analytique, ce qui évite un entraînement profond itératif.", "termCode": "elm", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#elm", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["ELM", "apprentissage frugal"], "sameAs": "http://www.wikidata.org/entity/Q21948731"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#mimo", "name": "MIMO (multi-entrée multi-sortie)", "description": "Une architecture multi-entrée multi-sortie : un seul modèle lit l'historique récent de plusieurs signaux et les prévoit ensemble.", "termCode": "mimo", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#mimo", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["MIMO-ELM"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#horizon", "name": "Horizon de prévision", "description": "Le nombre de pas entre la dernière valeur connue et la valeur à prévoir.", "termCode": "horizon", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#horizon", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["horizon"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#clear-sky-index", "name": "Indice de ciel clair", "description": "En solaire, le rapport à la tendance de ciel clair : l'éclairement divisé par l'éclairement de ciel clair.", "termCode": "clear-sky-index", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#clear-sky-index", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["rapport à la tendance de ciel clair"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#difference-to-trend", "name": "Différence à la tendance", "description": "On étudie y − c, l'écart à la tendance c (ici périodique). Adapté à un bruit additif.", "termCode": "difference-to-trend", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#difference-to-trend", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#ratio-to-trend", "name": "Rapport à la tendance", "description": "On étudie y / c, avec ici une tendance périodique c. Adapté à un bruit multiplicatif. Avec c le ciel clair : l'indice de ciel clair.", "termCode": "ratio-to-trend", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#ratio-to-trend", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#deseasonalization", "name": "Désaisonnalisation", "description": "Un cycle connu ne se prévoit pas : on le retire, on prévoit le reste, on le remet.", "termCode": "deseasonalization", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#deseasonalization", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["retrait du cycle"], "sameAs": "http://www.wikidata.org/entity/Q622893"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#rmse", "name": "RMSE", "description": "La racine de l'erreur quadratique moyenne. Elle donne plus de poids aux grandes erreurs que la MAE.", "termCode": "rmse", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#rmse", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["racine de l'erreur quadratique moyenne"], "sameAs": "http://www.wikidata.org/entity/Q29037"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#mae", "name": "MAE", "description": "L'erreur absolue moyenne : la moyenne des écarts en valeur absolue entre prévision et observation.", "termCode": "mae", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#mae", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["erreur absolue moyenne"], "sameAs": "http://www.wikidata.org/entity/Q6803609"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#nrmse", "name": "nRMSE", "description": "La RMSE rapportée à la moyenne du signal (0 pour une prévision parfaite).", "termCode": "nrmse", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#nrmse", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["RMSE normalisée"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#nmae", "name": "nMAE", "description": "L'erreur absolue moyenne rapportée à la moyenne du signal.", "termCode": "nmae", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#nmae", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["MAE normalisée"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#nice", "name": "NICE", "description": "L'erreur de la prévision divisée par celle de la persistance, aux mêmes dates et au même horizon. 0 : parfaite. 1 : autant d'erreur que la persistance. Au-dessus de 1, on l'écrit « > 1 » : moins bonne que la persistance.", "termCode": "nice", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#nice", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["NICEᵏ", "NICEΣ", "indice NICE"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#scv", "name": "sCV", "description": "Indice sans unité d’écart à la courbe de ciel clair, normalisé par l’échelle de cette courbe et le plancher diffus retenu. 0 : ciel clair ; 1 : repère d’une alternance aléatoire équiprobable entre ciel clair et ce plancher, pas une borne supérieure.", "termCode": "scv", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#scv", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["coefficient de variation stochastique"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#forecastability-f", "name": "Prévisibilité F", "description": "F = 1 + sCV × (ρmax − 1), comprise entre 1 − sCV et 1. Plus elle est haute, plus cet horizon est facile à prévoir.", "termCode": "forecastability-f", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#forecastability-f", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["indicateur F", "prévisibilité"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#gamma-index", "name": "Indice γ", "description": "Pour chaque pixel prévu, la distance à l'observation la plus proche dans l'espace, le temps et l'intensité, chacun divisé par sa tolérance. γ ≤ 1 : accepté.", "termCode": "gamma-index", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#gamma-index", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["indice gamma"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#brownian-motion", "name": "Mouvement brownien", "description": "Chaque valeur est la précédente plus un tirage au hasard : mémoire φ = 1. La persistance y est la meilleure prévision.", "termCode": "brownian-motion", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#brownian-motion", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#memory-phi", "name": "Mémoire φ", "description": "La corrélation entre deux valeurs voisines du bruit. 0 : aucune. 1 : totale.", "termCode": "memory-phi", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#memory-phi", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["mémoire du bruit"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#malr", "name": "MALR (mean absolute log return)", "description": "Un paramètre issu de l'économétrie qui décrit l'amplitude des changements relatifs. Ce diagnostic empirique ne dispense pas de tester le modèle sur le site et à l'horizon visés.", "termCode": "malr", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#malr", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["rendement logarithmique absolu moyen"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#no-free-lunch", "name": "« No free lunch »", "description": "Sous une moyenne uniforme sur l'ensemble des fonctions d'un problème fini, les performances moyennes des algorithmes de recherche considérés coïncident. Ce cadre précis n'est pas la distribution des problèmes solaires réels.", "termCode": "no-free-lunch", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#no-free-lunch", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["théorèmes de no free lunch"], "sameAs": "http://www.wikidata.org/entity/Q255847"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#simulated-data", "name": "Données simulées", "description": "Quand on n'a pas encore de mesures, aucun modèle ne peut être entraîné ni validé, mais on peut simuler ce que l'on sait : une première estimation, pas une mesure.", "termCode": "simulated-data", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#simulated-data", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["données synthétiques"], "sameAs": "http://www.wikidata.org/entity/Q7662746"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#monte-carlo", "name": "Monte Carlo", "description": "Simuler de nombreuses fois avec des tirages aléatoires différents. Plus d'histoires réduisent l'erreur statistique, comme 1/√N pour N histoires ; elles ne corrigent ni une mauvaise géométrie ni de mauvaises données physiques.", "termCode": "monte-carlo", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#monte-carlo", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["méthode de Monte-Carlo", "Monte-Carlo"], "sameAs": "http://www.wikidata.org/entity/Q232207"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#percentile-band-p10-p90", "name": "Bande P10–P90", "description": "P10 et P90 sont les centiles 10 et 90 des résultats simulés : la bande P10–P90 contient les 80 % centraux. Elle décrit la variation entre simulations pour les paramètres choisis, pas toute l'incertitude sur un système réel.", "termCode": "percentile-band-p10-p90", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#percentile-band-p10-p90", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["P10 et P90", "médiane et bande P10–P90"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#tls", "name": "Tunnel Load Simulator (TLS)", "description": "Une application open source qui construit la consommation électrique d'un tunnel routier à partir de sa géométrie, du trafic, de l'éclairage et de la ventilation, dit à quel point elle est incertaine et en énonce les limites.", "termCode": "tls", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#tls", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["TLS", "simulateur de charge de tunnel"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#lq-model", "name": "Modèle linéaire-quadratique (LQ)", "description": "La BED d'une fraction croît en courbe avec la dose, à toutes les doses : la courbe LQ continue de s'infléchir vers le haut quand la dose par fraction augmente.", "termCode": "lq-model", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#lq-model", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["LQ"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#lql-model", "name": "Modèle linéaire-quadratique-linéaire (LQL)", "description": "La même courbe que le LQ jusqu'à la dose de transition, puis une droite. Sous la dose de transition, les deux modèles sont identiques.", "termCode": "lql-model", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#lql-model", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["LQL"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#bed", "name": "Dose biologique efficace (BED)", "description": "Dose en grays qui permet de comparer des fractionnements différents. Pour n fractions de dose d, le modèle LQ donne BED = n · d · (1 + d / (α/β)).", "termCode": "bed", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#bed", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["BED", "dose biologiquement efficace"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#eqd2", "name": "Dose équivalente en fractions de 2 Gy (EQD2)", "description": "La traduction de la BED en une dose délivrée par fractions de 2 Gy : EQD2 = BED / (1 + 2/(α/β)).", "termCode": "eqd2", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#eqd2", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["EQD2"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#alpha-beta", "name": "Rapport α/β", "description": "Paramètre propre au tissu : il décrit la sensibilité d'un tissu à la taille de chaque fraction. Plus il est faible, plus le tissu est sensible à la dose par fraction (environ 3,9 Gy pour le rectum).", "termCode": "alpha-beta", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#alpha-beta", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["α/β"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#transition-dose", "name": "Dose de transition dT", "description": "La dose par fraction où le modèle LQL passe de la courbe à la droite (7,8 Gy pour le rectum). Dans la bibliothèque de LQL-Equiv, elle vaut 2 α/β.", "termCode": "transition-dose", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#transition-dose", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["dT"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#fractionation", "name": "Fractionnement", "description": "Pour n fractions (le nombre de séances), chacune délivrant une dose d en grays, la dose physique ne suffit pas à prédire l'effet biologique, qui dépend aussi de la dose reçue à chaque fraction.", "termCode": "fractionation", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#fractionation", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["fractions", "schéma de traitement"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#gray", "name": "Gray (Gy)", "description": "L'unité de dose physique absorbée : l'énergie déposée par kilogramme de tissu.", "termCode": "gray", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#gray", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#lql-equiv", "name": "LQL-Equiv", "description": "Un calculateur gratuit et open source (MIT) de BED et d'EQD2 avec les modèles LQ et LQL, dans le navigateur. Outil de recherche et d'enseignement, pas un dispositif médical.", "termCode": "lql-equiv", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#lql-equiv", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["calculateur de BED et d'EQD2"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#bnct", "name": "BNCT (thérapie par capture neutronique du bore)", "description": "Un composé transporte du bore-10 vers les tissus visés ; quand ce bore capture un neutron, une particule alpha et un noyau de lithium-7 déposent leur énergie sur quelques micromètres.", "termCode": "bnct", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#bnct", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["thérapie par capture neutronique du bore"], "sameAs": "http://www.wikidata.org/entity/Q71676169"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#cross-section", "name": "Section efficace", "description": "Elle dit à quel point un noyau réagit facilement avec un neutron d'énergie E. Elle s'exprime comme une surface, souvent en barns, sans être la taille du noyau ni, à elle seule, la probabilité de capture.", "termCode": "cross-section", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#cross-section", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["σ(E)"], "sameAs": "http://www.wikidata.org/entity/Q751259"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#macroscopic-cross-section", "name": "Section efficace macroscopique", "description": "La section efficace multipliée par le nombre de noyaux par unité de volume : l'inverse d'une longueur. Pour un mélange, Σ additionne ces produits noyau par noyau.", "termCode": "macroscopic-cross-section", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#macroscopic-cross-section", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["Σ"], "sameAs": "http://www.wikidata.org/entity/Q98280520"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#mean-free-path", "name": "Libre parcours moyen", "description": "L'inverse de la section efficace macroscopique, L = 1/Σ : la distance moyenne entre deux collisions.", "termCode": "mean-free-path", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#mean-free-path", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["L = 1/Σ"], "sameAs": "http://www.wikidata.org/entity/Q756307"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#compton-effect", "name": "Effet Compton", "description": "La diffusion d'un photon sur un électron : le photon perd de l'énergie et l'électron reçoit une énergie cinétique K. L'énergie au repos de l'électron est 511 keV.", "termCode": "compton-effect", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#compton-effect", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["diffusion Compton"], "sameAs": "http://www.wikidata.org/entity/Q171516"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#attenuation", "name": "Atténuation", "description": "Chaque épaisseur égale à la couche de demi-atténuation divise par deux ce qui reste : c'est une décroissance exponentielle, pas une soustraction.", "termCode": "attenuation", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#attenuation", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["décroissance exponentielle"], "sameAs": "http://www.wikidata.org/entity/Q2357982"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#half-value-layer", "name": "Couche de demi-atténuation (CDA)", "description": "L'épaisseur de matériau qui divise par deux l'intensité transmise sans diffusion : CDA = ln 2 / μ, avec μ le coefficient d'atténuation linéique.", "termCode": "half-value-layer", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#half-value-layer", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["CDA", "épaisseur de demi-atténuation"], "sameAs": "http://www.wikidata.org/entity/Q127526"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#thyroglobulin", "name": "Thyroglobuline (Tg)", "description": "Le marqueur sanguin suivi par le modèle de la thérapie à l'iode radioactif.", "termCode": "thyroglobulin", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#thyroglobulin", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["Tg"], "sameAs": "http://www.wikidata.org/entity/Q412228"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#doubling-time", "name": "Temps de doublement", "description": "La durée, en mois, pour que le nombre de cellules tumorales double sans traitement : 9,8 mois pour le profil réfractaire, 66,6 pour le répondeur dans l'article.", "termCode": "doubling-time", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#doubling-time", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["Td"], "sameAs": "http://www.wikidata.org/entity/Q1424376"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#p-value", "name": "p-value", "description": "La probabilité, si les moyennes sont égales (ou ρ = 0) et le modèle correct, d'un résultat au moins aussi extrême. Ce n'est pas la probabilité que l'hypothèse soit vraie ; elle ne mesure pas l'importance d'un lien.", "termCode": "p-value", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#p-value", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["valeur p"], "sameAs": "http://www.wikidata.org/entity/Q253255"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#student-t-test", "name": "Test de Student", "description": "Le test divise l'écart entre deux moyennes par son erreur standard : un même écart peut se détacher du hasard d'échantillonnage, ou s'y noyer. Significatif ne veut pas dire important.", "termCode": "student-t-test", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#student-t-test", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["test t"], "sameAs": "http://www.wikidata.org/entity/Q309479"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#chi-square-test", "name": "Test du χ²", "description": "La statistique est la somme des contributions (O−E)²/E, avec O l'effectif observé et E l'effectif attendu sous l'hypothèse testée. Une petite p-value dit que l'écart est peu compatible avec l'hypothèse, pas qu'il est grand.", "termCode": "chi-square-test", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#chi-square-test", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["test du khi-deux", "χ²"], "sameAs": "http://www.wikidata.org/entity/Q1071004"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#normal-distribution", "name": "Loi normale", "description": "Le score z est le nombre d'écarts-types entre x et la moyenne ; Φ(z) est la probabilité qu'une variable normale centrée réduite reste en dessous de z : l'aire à gauche de z.", "termCode": "normal-distribution", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#normal-distribution", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["loi de Gauss", "score z"], "sameAs": "http://www.wikidata.org/entity/Q133871"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#roc-curve", "name": "Courbe ROC", "description": "La sensibilité en fonction du taux de faux positifs 1 − Sp, quand le seuil varie. L'aire sous la courbe (AUC) résume le test sans choisir de seuil.", "termCode": "roc-curve", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#roc-curve", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["AUC", "sensibilité et spécificité"], "sameAs": "http://www.wikidata.org/entity/Q327120"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#r-squared", "name": "Coefficient de détermination R²", "description": "La part de variation décrite par la droite (1 pour une prévision parfaite). Elle ne mesure pas l'importance du lien.", "termCode": "r-squared", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#r-squared", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["R²"], "sameAs": "http://www.wikidata.org/entity/Q192830"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#pearson-correlation", "name": "Corrélation de Pearson", "description": "La corrélation de Pearson dans le nuage de points (r) et dans la population (ρ).", "termCode": "pearson-correlation", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#pearson-correlation", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["coefficient de corrélation r"], "sameAs": "http://www.wikidata.org/entity/Q1136628"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#confidence-interval", "name": "Intervalle de confiance", "description": "Il encadre la moyenne des y en x₀ (bande à 95 %, quantile de Student à n − 2 degrés de liberté).", "termCode": "confidence-interval", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#confidence-interval", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "sameAs": "http://www.wikidata.org/entity/Q208498"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#prediction-interval", "name": "Intervalle de prévision", "description": "Il encadre une nouvelle observation en x₀ : on ajoute 1 sous la racine, d'où une bande plus large que l'intervalle de confiance.", "termCode": "prediction-interval", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#prediction-interval", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "sameAs": "http://www.wikidata.org/entity/Q1106171"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#influential-point", "name": "Point influent", "description": "Un point qui déplace la droite des moindres carrés ; le levier est son poids potentiel, d'autant plus grand qu'il est loin en x.", "termCode": "influential-point", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#influential-point", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["levier"], "sameAs": "http://www.wikidata.org/entity/Q16908492"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#biot-number", "name": "Nombre de Biot", "description": "La résistance de conduction interne comparée à la résistance de convection en surface.", "termCode": "biot-number", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#biot-number", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["Bi"], "sameAs": "http://www.wikidata.org/entity/Q864844"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#cop", "name": "Coefficient de performance (COP)", "description": "La chaleur extraite de la source froide par unité de travail reçu. COP > 1 est normal : ce n'est pas un rendement en pourcentage. Limite de Carnot : le COP maximal d'une machine réversible entre deux sources.", "termCode": "cop", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#cop", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["COP"], "sameAs": "http://www.wikidata.org/entity/Q902090"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#carnot-efficiency", "name": "Rendement de Carnot", "description": "Le rendement η est le travail W divisé par la chaleur reçue Qchaud ; ηCarnot est sa borne, atteinte par un cycle réversible, sans frottement ni écart de température lors des échanges.", "termCode": "carnot-efficiency", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#carnot-efficiency", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["moteur de Carnot", "limite de Carnot"], "sameAs": "http://www.wikidata.org/entity/Q93949862"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#freezing", "name": "Congélation", "description": "L'énergie à retirer pour geler une masse d'eau : chaleur sensible (mcΔT) plus chaleur latente, sans changement de température dans ce modèle ; la puissance moyenne est l'énergie divisée par la durée.", "termCode": "freezing", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#freezing", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["énergie de congélation"], "sameAs": "http://www.wikidata.org/entity/Q108000"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#latent-heat", "name": "Chaleur latente", "description": "La chaleur retirée pour geler l'eau, sans changement de température dans ce modèle.", "termCode": "latent-heat", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#latent-heat", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "sameAs": "http://www.wikidata.org/entity/Q207721"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#sensible-heat", "name": "Chaleur sensible", "description": "La chaleur échangée quand la température change : le terme mcΔT, avec c la capacité thermique massique et ΔT la variation de température.", "termCode": "sensible-heat", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#sensible-heat", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "sameAs": "http://www.wikidata.org/entity/Q1480581"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#research-data", "name": "Données de recherche", "description": "Les mesures, observations et simulations sur lesquelles reposent les résultats : un modèle ne vaut que ce que valent ses données, qui doivent être qualifiées, décrites et placées sous licence.", "termCode": "research-data", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#research-data", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["données scientifiques"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#fair", "name": "Principes FAIR", "description": "Quatre principes pour que des données soient trouvables (Findable), accessibles (Accessible), interopérables (Interoperable) et réutilisables (Reusable), par les humains comme par les machines.", "termCode": "fair", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#fair", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["FAIR", "données FAIR"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#findable", "name": "Trouvable", "description": "Premier principe FAIR : des données dotées d'un identifiant pérenne, décrites par des métadonnées riches et référencées dans un catalogue ou un entrepôt où l'on peut les chercher.", "termCode": "findable", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#findable", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["F de FAIR"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#accessible", "name": "Accessible", "description": "Deuxième principe FAIR : données et métadonnées récupérables à partir de leur identifiant par un protocole ouvert et standard (par exemple HTTPS), avec authentification si nécessaire ; les métadonnées restent accessibles même quand les données ne le sont plus.", "termCode": "accessible", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#accessible", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["A de FAIR"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#interoperable", "name": "Interopérable", "description": "Troisième principe FAIR : données et métadonnées dans des formats et des vocabulaires partagés (par exemple NetCDF-CF), lisibles par d'autres logiciels et reliées à d'autres données.", "termCode": "interoperable", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#interoperable", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["I de FAIR", "interopérabilité"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#reusable", "name": "Réutilisable", "description": "Quatrième principe FAIR : des données que d'autres peuvent réutiliser, grâce à une licence claire, une provenance décrite et le respect des normes de la communauté.", "termCode": "reusable", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#reusable", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["R de FAIR"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#persistent-identifier", "name": "Identifiant pérenne", "description": "Identifiant qui désigne durablement un objet (jeu de données, logiciel, article, personne), même si son adresse web change : DOI (Digital Object Identifier) pour les données et les publications, ORCID pour les chercheurs.", "termCode": "persistent-identifier", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#persistent-identifier", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["PID", "DOI"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#metadata", "name": "Métadonnées", "description": "Données qui décrivent des données : titre, auteurs, période, lieu, variables, unités, instrument, pas de temps, traitements ; ce qu'il faut savoir pour trouver et réutiliser un jeu de données sans ouvrir le fichier.", "termCode": "metadata", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#metadata", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["fiche de métadonnées"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#data-license", "name": "Licence de données", "description": "Texte qui dit ce que chacun a le droit de faire des données (copier, modifier, redistribuer, usage commercial ou non), par exemple CC BY (Creative Commons Attribution) ; sans licence, personne ne sait ce qu'il peut faire.", "termCode": "data-license", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#data-license", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["licence CC BY"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#data-management-plan", "name": "Plan de gestion des données", "description": "Document qui décrit comment les données d'un projet seront produites, décrites, conservées et partagées, souvent exigé par les financeurs ; il prépare des données FAIR dès le début du projet.", "termCode": "data-management-plan", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#data-management-plan", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}, "alternateName": ["PGD"]}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#jarque-bera", "name": "Test de Jarque-Bera", "description": "Combine l’asymétrie et l’excès d’aplatissement pour évaluer la normalité. Le seuil du χ² est asymptotique.", "termCode": "jarque-bera", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#jarque-bera", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#z-test", "name": "Test Z", "description": "Compare la moyenne observée à une valeur de référence en unités d’erreur standard, lorsque l’écart-type de population est connu.", "termCode": "z-test", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#z-test", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#picp", "name": "Couverture empirique des intervalles de prévision (PICP)", "description": "Proportion des observations de test qui tombent dans les bornes de leur intervalle de prévision.", "termCode": "picp", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#picp", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#split-conformal", "name": "Prédiction conforme par séparation", "description": "Calibre une marge sur des erreurs d’un ensemble distinct de l’apprentissage. La garantie théorique suppose des scores échangeables.", "termCode": "split-conformal", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#split-conformal", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#gti", "name": "Éclairement dans le plan des panneaux (GTI)", "description": "Puissance solaire incidente par unité de surface dans le plan incliné du champ photovoltaïque, en W/m².", "termCode": "gti", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#gti", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#pv-curtailment", "name": "Écrêtement de la production photovoltaïque", "description": "Limite imposée à la puissance injectée, en dessous de ce que le champ pourrait produire. L’annonce peut être connue ou inconnue au moment de la prévision.", "termCode": "pv-curtailment", "inLanguage": "fr", "url": "https://www.cyrilvoyant.com/fr/lexique/#pv-curtailment", "inDefinedTermSet": {"@id": "https://www.cyrilvoyant.com/ontology/#cv-concepts"}}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/fr/outils/artu/#page", "url": "https://www.cyrilvoyant.com/fr/outils/artu/", "name": "Explorer les coefficients et la table ARTU", "description": "ARTU prévoit avec trois poids lus dans une table à partir de deux autocorrélations. Bougez la mémoire et le bruit de mesure, voyez les poids changer.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "isBasedOn": {"@id": "https://cyrilvoyant.github.io/teaching/artu-worked-example.html#intuition"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Outils interactifs", "item": "https://www.cyrilvoyant.com/fr/outils/"}, {"@type": "ListItem", "position": 3, "name": "Explorer les coefficients et la table ARTU", "item": "https://www.cyrilvoyant.com/fr/outils/artu/"}]}, {"@type": "LearningResource", "name": "Explorer les coefficients et la table ARTU", "inLanguage": "fr", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "citation": [{"@type": "ScholarlyArticle", "name": "Benchmarks for solar radiation time series forecasting", "sameAs": "https://doi.org/10.1016/j.renene.2022.04.065", "author": [{"@type": "Person", "name": "Cyril Voyant", "@id": "https://person.cyrilvoyant.com/#cyril-voyant"}, {"@type": "Person", "name": "Gilles Notton", "sameAs": "https://orcid.org/0000-0002-6267-9632"}, {"@type": "Person", "name": "Jean-Laurent Duchaud", "sameAs": "https://orcid.org/0000-0001-7490-7260"}, {"@type": "Person", "name": "Luis Antonio García Gutiérrez", "sameAs": "https://orcid.org/0000-0002-3480-1784"}, {"@type": "Person", "name": "Jamie M. Bright", "sameAs": "https://orcid.org/0000-0002-9465-3453"}, {"@type": "Person", "name": "Dazhi Yang", "sameAs": "https://orcid.org/0000-0003-2162-6873"}]}], "isBasedOn": "https://cyrilvoyant.github.io/teaching/artu-worked-example.html#intuition", "learningResourceType": "Calculateur scientifique interactif"}, {"@type": "WebPage", "@id": "https://www.cyrilvoyant.com/fr/outils/attenuation-demi-epaisseur/#page", "url": "https://www.cyrilvoyant.com/fr/outils/attenuation-demi-epaisseur/", "name": "Atténuation et demi-atténuation : simulateur interactif", "description": "Avec une CDA de 2 cm et 6 cm de matériau, il reste 1/8 du faisceau, soit 12,5 %. Doublez l’épaisseur : 1/64, et non zéro.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "translationOfWork": {"@id": "https://www.cyrilvoyant.com/tools/attenuation-half-value-layer/#page"}}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Outils interactifs", "item": "https://www.cyrilvoyant.com/fr/outils/"}, {"@type": "ListItem", "position": 3, "name": "Atténuation et demi-atténuation : simulateur interactif", "item": "https://www.cyrilvoyant.com/fr/outils/attenuation-demi-epaisseur/"}]}, {"@type": "LearningResource", "@id": "https://www.cyrilvoyant.com/fr/animations/attenuation-demi-epaisseur/#learning", "name": "Atténuation et couche de demi-atténuation : simulation interactive", "inLanguage": "fr", "learningResourceType": "Interactive demonstration", "educationalUse": ["demonstration", "self study"], "teaches": "Combien de rayonnement reste-t-il après plusieurs couches de demi-atténuation ?", "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "isBasedOn": {"@id": "https://www.cyrilvoyant.com/fr/enseignement/physique-pass/ondes-electromagnetiques/#chapter"}, "educationalLevel": "Enseignement supérieur", "license": "https://creativecommons.org/licenses/by/4.0/", "url": "https://www.cyrilvoyant.com/fr/animations/attenuation-demi-epaisseur/", "description": "Avec une CDA de 2 cm et 6 cm de matériau, le modèle transmet 1/8, soit 12,5 %. Doublez l’épaisseur pour voir la décroissance exponentielle.", "mainEntityOfPage": {"@id": "https://www.cyrilvoyant.com/fr/animations/attenuation-demi-epaisseur/#page"}, "workTranslation": {"@id": "https://www.cyrilvoyant.com/tools/attenuation-half-value-layer/#learning"}, "isAccessibleForFree": true, "about": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#attenuation", "name": "Atténuation", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/animations/attenuation-demi-epaisseur/"}], "mentions": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#half-value-layer", "name": "Couche de demi-atténuation (CDA)", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/animations/attenuation-demi-epaisseur/"}]}, {"@type": "WebPage", "@id": "https://www.cyrilvoyant.com/fr/outils/autoevaluation-fair/#page", "url": "https://www.cyrilvoyant.com/fr/outils/autoevaluation-fair/", "name": "Autoévaluation FAIR des données de recherche en 20 questions", "description": "Vos données sont-elles trouvables, accessibles, interopérables et réutilisables (FAIR) ? 20 questions, 3 minutes, un score sur 20 et les priorités à traiter.", "inLanguage": "fr", "isPartOf": {"@id": "https://www.cyrilvoyant.com/#website"}, "author": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "publisher": {"@type": "Person", "@id": "https://person.cyrilvoyant.com/#cyril-voyant", "name": "Cyril Voyant", "url": "https://person.cyrilvoyant.com/"}, "license": "https://creativecommons.org/licenses/by/4.0/", "translationOfWork": {"@id": "https://www.cyrilvoyant.com/tools/fair-self-assessment/#page"}, "about": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#fair", "name": "Principes FAIR", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/outils/autoevaluation-fair/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#research-data", "name": "Données de recherche", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/donnees/"}], "mentions": [{"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#metadata", "name": "Métadonnées", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/donnees/"}, {"@type": "DefinedTerm", "@id": "https://www.cyrilvoyant.com/ontology/#data-management-plan", "name": "Plan de gestion des données", "inDefinedTermSet": "https://www.cyrilvoyant.com/ontology/", "url": "https://www.cyrilvoyant.com/fr/outils/autoevaluation-fair/"}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.cyrilvoyant.com/fr/"}, {"@type": "ListItem", "position": 2, "name": "Outils", "item": "https://www.cyrilvoyant.com/fr/outils/"}, {"@type": "ListItem", "position": 3, "name": "Autoévaluation FAIR", "item": "https://www.cyrilvoyant.com/fr/outils/autoevaluation-fair/"}]}, {"@type": ["WebApplication", "LearningResource"], "@id": "https://www.cyrilvoyant.com/fr/outils/autoevaluation-fair/#app", "name": "Autoévaluation FAIR", "headline": "Mes données sont-elles FAIR ? Une autoévaluation en 20 questions", "description": "En 3 minutes environ, situez un jeu de données au regard des principes FAIR : des données faciles à trouver (Findable), accessibles (Accessible), interopérables, c'est-à-dire lisibles par d'autres logiciels (Interoperable), et réutilisables (Reusable). Vingt questions, cinq par lettre ; l'outil donne un score sur 20 et indique les points à travailler en premier.", "url": "https://www.cyrilvoyant.com/fr/outils/autoevaluat