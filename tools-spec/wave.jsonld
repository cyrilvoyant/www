    "valueName": "amplitude-e0",
    "description": "Amplitude E₀ (V/m)",
    "valueRequired": false,
    "minValue": 0.5,
    "maxValue": 4,
    "defaultValue": 2,
    "stepValue": 0.1
   },
   {
    "@type": "PropertyValueSpecification",
    "valueName": "frequency",
    "description": "Frequency ν (MHz)",
    "valueRequired": false,
    "minValue": 10,
    "maxValue": 100,
    "defaultValue": 50,
    "stepValue": 1
   },
   {
