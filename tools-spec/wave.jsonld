  {
   "@type": "PropertyValue",
   "propertyID": "amplitude-e0",
   "name": "Amplitude E₀ (V/m)",
   "alternateName": "Amplitude E₀ (V/m)",
   "description": "Largest value of the electric field.",
   "value": 2,
   "minValue": 0.5,
   "maxValue": 4,
   "unitText": "V/m"
  },
  {
   "@type": "PropertyValue",
   "propertyID": "frequency",
   "name": "Frequency ν (MHz)",
   "alternateName": "Fréquence ν (MHz)",
   "description": "Oscillations per second, in millions.",
   "value": 50,
   "minValue": 10,
   "maxValue": 100,
   "unitText": "MHz"
  },
  {
   "@type": "PropertyValue",
   "propertyID": "time-phase-t",
   "name": "Time phase ωt (rad)",
   "alternateName": "Phase temporelle ωt (rad)",
   "description": "Moment in the oscillation: 6.28 rad is a full turn. It moves the curve without changing the four values below.",
   "value": 0,
   "minValue": 0,
   "maxValue": 6.28,
   "unitText": "rad"
  },
  {
   "@type": "PropertyValue",
   "propertyID": "preset:reference-2-v-m-50-mhz",
   "name": "Reference · 2 V/m, 50 MHz",
   "alternateName": "Référence · 2 V/m, 50 MHz",
   "value": "{\"amplitude-e0\": 2, \"frequency\": 50, \"time-phase-t\": 0}"
  },
  {
   "@type": "PropertyValue",
   "propertyID": "preset:doubled-amplitude-4-v-m",
   "name": "Doubled amplitude · 4 V/m",
   "alternateName": "Amplitude doublée · 4 V/m",
   "value": "{\"amplitude-e0\": 4, \"frequency\": 50, \"time-phase-t\": 0}"
  },
  {
   "@type": "PropertyValue",
   "propertyID": "preset:fm-radio-100-mhz",
   "name": "FM radio · 100 MHz",
   "alternateName": "Radio FM · 100 MHz",
   "value": "{\"amplitude-e0\": 2, \"frequency\": 100, \"time-phase-t\": 0}"
  },
  {
   "@type": "PropertyValue",
   "propertyID": "preset:shortwave-10-mhz",
   "name": "Shortwave · 10 MHz",
   "alternateName": "Ondes courtes · 10 MHz",
   "value": "{\"amplitude-e0\": 2, \"frequency\": 10, \"time-phase-t\": 0}"
  }
 ],
 "potentialAction": {
