 "url": "https://www.cyrilvoyant.com/tools/roc-curve/",
 "sameAs": [
  "https://www.cyrilvoyant.com/fr/animations/courbe-roc/",
  "https://www.cyrilvoyant.com/tools/roc-curve/"
