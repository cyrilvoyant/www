   "minValue": 0,
   "maxValue": 4,
   "unitText": "dimensionless"
  },
  {
   "@type": "PropertyValue",
   "propertyID": "test-threshold-s",
   "name": "Test threshold s",
   "alternateName": "Seuil s du test",
   "value": 1,
   "minValue": -3,
   "maxValue": 6,
   "unitText": "dimensionless"
  },
  {
   "@type": "PropertyValue",
   "propertyID": "prevalence",
   "name": "Prevalence (share with disease)",
   "alternateName": "Prévalence (part de malades)",
   "value": 0.1,
   "minValue": 0.001,
   "maxValue": 0.5,
   "unitText": "%"
  },
  {
   "@type": "PropertyValue",
   "propertyID": "preset:starting-setting-10-prevalence",
   "name": "Starting setting: 10% prevalence",
   "alternateName": "Réglage de départ : prévalence 10 %",
   "value": "{\"separation-d\": 1.8, \"test-threshold-s\": 1, \"prevalence\": 0.1}"
  },
  {
   "@type": "PropertyValue",
   "propertyID": "preset:good-test-rare-disease-1",
   "name": "Good test, rare disease (1%)",
   "alternateName": "Bon test, maladie rare (1 %)",
   "value": "{\"separation-d\": 2.55, \"test-threshold-s\": 1.3, \"prevalence\": 0.01}"
  },
  {
   "@type": "PropertyValue",
   "propertyID": "preset:same-test-30-prevalence",
   "name": "Same test, 30% prevalence",
   "alternateName": "Même test, prévalence 30 %",
   "value": "{\"separation-d\": 2.55, \"test-threshold-s\": 1.3, \"prevalence\": 0.3}"
  },
  {
   "@type": "PropertyValue",
   "propertyID": "preset:low-threshold-few-missed-cases",
   "name": "Low threshold: few missed cases",
   "alternateName": "Seuil bas : peu de malades manqués",
   "value": "{\"separation-d\": 2.55, \"test-threshold-s\": 0.5, \"prevalence\": 0.1}"
  },
  {
   "@type": "PropertyValue",
   "propertyID": "preset:high-threshold-few-false-alarms",
   "name": "High threshold: few false alarms",
   "alternateName": "Seuil haut : peu de fausses alertes",
   "value": "{\"separation-d\": 2.55, \"test-threshold-s\": 2.5, \"prevalence\": 0.1}"
  },
  {
   "@type": "PropertyValue",
   "propertyID": "preset:useless-test-d-0",
   "name": "Useless test: d = 0",
   "alternateName": "Test sans valeur : d = 0",
   "value": "{\"separation-d\": 0, \"test-threshold-s\": 0, \"prevalence\": 0.1}"
  },
  {
   "@type": "PropertyValue",
   "propertyID": "preset:well-separated-test-d-4",
   "name": "Well separated test: d = 4",
   "alternateName": "Test très séparé : d = 4",
   "value": "{\"separation-d\": 4, \"test-threshold-s\": 2, \"prevalence\": 0.1}"
  }
 ],
