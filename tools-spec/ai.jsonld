 "identifier": "ai",
 "name": "Explore AI responsibility provisions",
 "alternateName": "S’orienter dans les responsabilités liées à l’IA",
 "description": "Answer a few questions about one AI system to find the AI Act articles that apply: an orientation, not legal advice.",
 "url": "https://www.cyrilvoyant.com/ai-in-research/#role-helper",
 "sameAs": [
  "https://www.cyrilvoyant.com/fr/ia-dans-la-recherche/#role-helper",
