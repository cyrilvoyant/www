    "@type": "PropertyValueSpecification",
    "valueName": "hot-reservoir",
    "description": "Hot reservoir (°C)",
    "valueRequired": false,
    "minValue": 100,
    "maxValue": 700,
    "defaultValue": 400,
    "stepValue": 5
   },
   {
    "@type": "PropertyValueSpecification",
    "valueName": "cold-reservoir",
    "description": "Cold reservoir (°C)",
    "valueRequired": false,
    "minValue": -20,
    "maxValue": 80,
    "defaultValue": 20,
    "stepValue": 1
   },
   {
    "@type": "PropertyValueSpecification",
    "valueName": "heat-received-qhot",
    "description": "Heat received Qhot (J/cycle)",
    "valueRequired": false,
    "minValue": 100,
    "maxValue": 2000,
    "defaultValue": 1000,
    "stepValue": 10
   },
   {
    "@type": "PropertyValueSpecification",
    "valueName": "fraction-of-the-carnot-limit",
    "description": "Fraction of the Carnot limit",
    "valueRequired": false,
    "minValue": 0.1,
    "maxValue": 1,
    "defaultValue": 0.7,
    "stepValue": 0.05
   }
  ]
 }
