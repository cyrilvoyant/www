  {
   "@type": "PropertyValue",
   "propertyID": "frame",
   "name": "Does the project framework (contract, funder, chair) impose confidentiality or exclusivity?",
   "alternateName": "Le cadre du projet (contrat, financeur, chaire) impose-t-il la confidentialité ou l'exclusivité ?"
  },
  {
   "@type": "PropertyValue",
   "propertyID": "open",
   "name": "Does it impose openness (Horizon Europe, ANR, a chair with an openness clause)?",
   "alternateName": "Ce cadre impose-t-il l'ouverture (Horizon Europe, ANR, chaire avec clause d'ouverture) ?"
  },
  {
   "@type": "PropertyValue",
   "propertyID": "oss",
   "name": "Does the clause explicitly require \"open source\" (not only open access to the code)?",
   "alternateName": "La clause exige-t-elle explicitement l'« open source » (et pas seulement un accès ouvert au code) ?"
  },
  {
   "@type": "PropertyValue",
   "propertyID": "rev",
   "name": "Is the code meant for a software journal (SoftwareX, JOSS, JORS) or linked to a GPL library?",
   "alternateName": "Le code est-il destiné à une revue logicielle (SoftwareX, JOSS, JORS) ou lié à une bibliothèque sous GPL ?"
  }
 ],
